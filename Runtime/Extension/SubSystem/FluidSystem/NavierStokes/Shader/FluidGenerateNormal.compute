#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#pragma kernel GenerateNormal

//-------------------------------------------------------------------------------------------------
//Parameter
//-------------------------------------------------------------------------------------------------

Texture2D _VelocityTexture;

RWTexture2D<float2> _NormalTextureRW;

float _SimulationResolution;

///Generate normal XZ ,y= world up
[numthreads(8, 8, 1)]
void GenerateNormal(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadId.xy;

    _NormalTextureRW[id] = 0;

    float invResolution = rcp(_SimulationResolution);
    float2 uv = id * invResolution + 0.5 * invResolution;


    float2 uvL = uv - float2(1, 0) * invResolution;
    float2 uvR = uv + float2(1, 0) * invResolution;
    float2 uvT = uv + float2(0, 1) * invResolution;
    float2 uvB = uv - float2(0, 1) * invResolution;

    float4 L = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uvL, 0);
    float4 R = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uvR, 0);
    float4 T = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uvT, 0);
    float4 B = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uvB, 0);

    // float2 L_R = L - R;
    // float2 B_T = B - T;

    float4 LL = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uv - float2(2,0)*invResolution, 0);
    float4 RR = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uv + float2(2,0)*invResolution, 0);
    float4 TT = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uv + float2(0,2)*invResolution, 0);
    float4 BB = _VelocityTexture.SampleLevel(sampler_TrilinearClamp, uv - float2(0,2)*invResolution, 0);

    // Weighted difference (smooth 2-tap gradient)
    float2 gradX = (R - L) * 0.5 + (RR - LL) * 0.25;
    float2 gradY = (T - B) * 0.5 + (TT - BB) * 0.25;
    float2 n = sqrt(float2(dot(gradX, gradX), dot(gradY, gradY))) / invResolution;



    // float2 n = sqrt(float2(dot(L_R, L_R), dot(B_T, B_T))) / invResolution;

    _NormalTextureRW[id] = n;
}
