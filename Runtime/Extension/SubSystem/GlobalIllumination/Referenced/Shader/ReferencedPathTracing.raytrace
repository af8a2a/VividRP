#pragma max_recursion_depth 8

// SHARC shader variants
#pragma multi_compile _ SHARC_UPDATE
#pragma multi_compile _ SHARC_QUERY

// 64-bit atomics support (required for SHARC)
#pragma require Int64BufferAtomics
#pragma require Native16Bit

// Include the RayGen shader file (contains raygen + miss shader)
// Note: RayGen and Miss shaders can ONLY be compiled in .raytrace files
#include "ReferencedPathTracingRayGen.hlsl"

// Entry points defined in ReferencedPathTracingRayGen.hlsl:
// - [shader("raygeneration")] RayGenPathTracing()
// - [shader("miss")] MissShaderPathTracing() - Unified miss for both path tracing and shadow rays
//
// ClosestHit and AnyHit shaders are in:
// - ReferencedPathTracingRayHit.hlsl (unified for both path tracing and shadow rays)
// These are included by Lit.shader's PathTracingDXR pass
//
// The uber payload (PathTracingPayload) uses rayType field to distinguish:
// - PT_RAY_TYPE_PATH_TRACING: Full material evaluation
// - PT_RAY_TYPE_SHADOW: Visibility test only
