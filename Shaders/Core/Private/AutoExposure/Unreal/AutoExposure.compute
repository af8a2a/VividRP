#pragma kernel ClearHistogram
#pragma kernel BuildHistogram
#pragma kernel ResolveExposure
#pragma kernel ResolveBasicExposure

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/GlobalSamplers.hlsl"
#define HISTOGRAM_SIZE 64
#define HISTOGRAM_THREAD_GROUP_SIZE 64
#define HISTOGRAM_LOCAL_WEIGHT_SCALE (1u << 18)
#define HISTOGRAM_GLOBAL_WEIGHT_SCALE 64u
#define HISTOGRAM_LOCAL_TO_GLOBAL_SCALE (HISTOGRAM_LOCAL_WEIGHT_SCALE / HISTOGRAM_GLOBAL_WEIGHT_SCALE)

Texture2D<float4> _InputColor;
Texture2D<float4> _AutoExposureMeterMask;
Texture2D<float4> _AutoExposureCompensationCurve;

StructuredBuffer<float4> _PreviousExposureBuffer;
RWStructuredBuffer<uint> _HistogramBuffer;
RWStructuredBuffer<float4> _CurrentExposureBuffer;

float4 _AutoExposureParams0;
float4 _AutoExposureParams1;
float4 _AutoExposureParams2;
float4 _AutoExposureParams3;
float4 _AutoExposureCurveParams;
float4 _AutoExposureScreenSize;
float4 _UnrealAutoExposureMethodParams;

// Matches UE's default r.AutoExposure.LuminanceMethod=0 (uniform luminance).
static const float3 kLuminanceWeights = float3(1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0);
static const float kMiddleGrey = 0.18f;
// UE's extended-range default 0.78 / r.EyeAdaptation.LensAttenuation=0.78.
static const float kLuminanceMax = 1.0f;
static const float kEpsilon = 1e-4f;
static const float kCurveLuminanceEpsilon = 1e-6f;
static const float kBasicWeightEpsilon = 1e-10f;
static const float kBasicLogLuminanceMin = -10.0f;
static const float kBasicLogLuminanceMax = 20.0f;

groupshared uint s_GroupHistogram[HISTOGRAM_SIZE];
groupshared float2 s_GroupBasicLuminance[HISTOGRAM_THREAD_GROUP_SIZE];

float GetHistogramPositionFromLogLuminance(float logLuminance)
{
    return logLuminance * _AutoExposureParams2.x + _AutoExposureParams2.y;
}

float GetLogLuminanceFromHistogramPosition(float histogramPosition)
{
    return (histogramPosition - _AutoExposureParams2.y) / max(_AutoExposureParams2.x, kEpsilon);
}

float ResolveAverageSceneEV100FromLuminance(float averageSceneLuminance)
{
    const float normalizedLuminance =
        averageSceneLuminance / (kMiddleGrey * kLuminanceMax);
    return log2(max(normalizedLuminance, kCurveLuminanceEpsilon));
}

float SampleExposureCompensationCurveStops(float previousAverageSceneLuminance)
{
    if (_AutoExposureCurveParams.z < 0.5f
        || _UnrealAutoExposureMethodParams.z < 0.5f
        || previousAverageSceneLuminance <= 0.0f)
        return 0.0f;

    const float averageSceneEV100 = ResolveAverageSceneEV100FromLuminance(previousAverageSceneLuminance);
    const float curveUv = saturate((averageSceneEV100 - _AutoExposureCurveParams.x) * _AutoExposureCurveParams.y);
    return _AutoExposureCompensationCurve.SampleLevel(sampler_LinearClamp, float2(curveUv, 0.5f), 0.0f).r;
}

float ExponentialAdaption(float current, float target, float frameTime, float adaptationSpeed, float slopeModifier)
{
    const float factor = 1.0f - exp2(-frameTime * adaptationSpeed);
    return current + (target - current) * factor * slopeModifier;
}

float LinearAdaption(float current, float target, float frameTime, float adaptationSpeed)
{
    const float offset = frameTime * adaptationSpeed;
    return current < target ? min(target, current + offset) : max(target, current - offset);
}

float ComputeAdaptedExposure(float oldExposure, float targetExposure)
{
    const float logTargetExposure = log2(max(targetExposure, kEpsilon));
    const float logOldExposure = log2(max(oldExposure, kEpsilon));
    const float logDiff = logTargetExposure - logOldExposure;

    const float adaptationSpeed = logDiff > 0.0f ? _AutoExposureParams1.x : _AutoExposureParams1.y;
    const float slopeModifier = logDiff > 0.0f ? _AutoExposureParams3.x : _AutoExposureParams3.y;
    const float absLogDiff = abs(logDiff);

    const float exponential = ExponentialAdaption(logOldExposure, logTargetExposure, _AutoExposureParams1.w, adaptationSpeed, slopeModifier);
    const float Linear = LinearAdaption(logOldExposure, logTargetExposure, _AutoExposureParams1.w, adaptationSpeed);
    const float adaptedLogExposure = absLogDiff > _AutoExposureParams3.z ? Linear : exponential;
    const float adaptedExposure = exp2(adaptedLogExposure);

    return lerp(adaptedExposure, targetExposure, _AutoExposureParams2.w);
}

[numthreads(HISTOGRAM_SIZE, 1, 1)]
void ClearHistogram(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x >= HISTOGRAM_SIZE)
        return;

    _HistogramBuffer[dispatchThreadId.x] = 0;
}

void InterlockedAddFloat(uint bufferIndex, float value)
{
    if (value == 0.0f)
        return;

    uint expectedBits = _HistogramBuffer[bufferIndex];
    uint originalBits;

    [allow_uav_condition]
    while (true)
    {
        const uint desiredBits = asuint(asfloat(expectedBits) + value);
        InterlockedCompareExchange(
            _HistogramBuffer[bufferIndex],
            expectedBits,
            desiredBits,
            originalBits);

        if (originalBits == expectedBits)
            return;

        expectedBits = originalBits;
    }
}

[numthreads(HISTOGRAM_THREAD_GROUP_SIZE, 1, 1)]
void BuildHistogram(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    const uint laneIndex = groupThreadId.x;
    const bool useBasicMethod = _UnrealAutoExposureMethodParams.x > 0.5f;
    const uint width = (uint)_AutoExposureScreenSize.x;
    const uint height = (uint)_AutoExposureScreenSize.y;
    const uint rowIndex = groupId.x;
    const float preExposure = max(_PreviousExposureBuffer[0].x, kEpsilon);
    float2 basicLuminance = 0.0f;

    s_GroupHistogram[laneIndex] = 0u;
    s_GroupBasicLuminance[laneIndex] = 0.0f;
    GroupMemoryBarrierWithGroupSync();

    if (rowIndex < height)
    {
        for (uint columnIndex = laneIndex;
             columnIndex < width;
             columnIndex += HISTOGRAM_THREAD_GROUP_SIZE)
        {
            const uint2 pixelCoord = uint2(columnIndex, rowIndex);
            const float3 color = _InputColor.Load(int3(pixelCoord, 0)).rgb / preExposure;
            const float luminance = max(dot(color, kLuminanceWeights), _AutoExposureParams2.z);
            const float2 uv = (pixelCoord + 0.5f) * _AutoExposureScreenSize.zw;
            float meterMask = saturate(
                _AutoExposureMeterMask.SampleLevel(sampler_LinearClamp, uv, 0).r);

            if (useBasicMethod)
            {
                const float logLuminance = clamp(
                    log2(luminance),
                    kBasicLogLuminanceMin,
                    kBasicLogLuminanceMax);
                const float scaledLogLuminance =
                    GetHistogramPositionFromLogLuminance(logLuminance);
                const float bucketPosition =
                    saturate(scaledLogLuminance) * (HISTOGRAM_SIZE - 1);
                const uint lowerBucket = min(
                    (uint)floor(bucketPosition),
                    (uint)(HISTOGRAM_SIZE - 1));

                meterMask = max(meterMask, 0.05f);
                if (lowerBucket == 0u)
                {
                    meterMask *= saturate(
                        _UnrealAutoExposureMethodParams.y);
                }

                basicLuminance += float2(
                    scaledLogLuminance * meterMask,
                    meterMask);
                continue;
            }

            const float logLuminance = log2(luminance);
            const float histogramPosition = saturate(
                GetHistogramPositionFromLogLuminance(logLuminance));
            const float bucketPosition =
                histogramPosition * (HISTOGRAM_SIZE - 1);
            const uint lowerBucket = min(
                (uint)floor(bucketPosition),
                (uint)(HISTOGRAM_SIZE - 1));
            const uint upperBucket = min(
                lowerBucket + 1,
                (uint)(HISTOGRAM_SIZE - 1));
            const float upperBucketFraction = frac(bucketPosition);

            const uint totalWeight = (uint)round(
                meterMask * HISTOGRAM_LOCAL_WEIGHT_SCALE);
            uint upperWeight = (uint)round(
                (float)totalWeight * upperBucketFraction);
            uint lowerWeight = totalWeight - upperWeight;

            if (lowerBucket == 0u)
            {
                lowerWeight = (uint)round(
                    (float)lowerWeight
                    * saturate(_UnrealAutoExposureMethodParams.y));
            }

            if (lowerWeight > 0u)
                InterlockedAdd(s_GroupHistogram[lowerBucket], lowerWeight);

            if (upperWeight > 0u)
                InterlockedAdd(s_GroupHistogram[upperBucket], upperWeight);
        }
    }

    s_GroupBasicLuminance[laneIndex] = basicLuminance;
    GroupMemoryBarrierWithGroupSync();

    if (!useBasicMethod)
    {
        const uint localWeight = s_GroupHistogram[laneIndex];
        // Preserve UE-like high precision inside a row while keeping the
        // public 64-bin uint buffer safe for 8K-class frame sizes.
        const uint globalWeight =
            (localWeight + HISTOGRAM_LOCAL_TO_GLOBAL_SCALE / 2u)
            / HISTOGRAM_LOCAL_TO_GLOBAL_SCALE;
        if (globalWeight > 0u)
            InterlockedAdd(_HistogramBuffer[laneIndex], globalWeight);
        return;
    }

    [unroll]
    for (uint reductionStride = HISTOGRAM_THREAD_GROUP_SIZE / 2u;
         reductionStride > 0u;
         reductionStride >>= 1u)
    {
        if (laneIndex < reductionStride)
        {
            s_GroupBasicLuminance[laneIndex] +=
                s_GroupBasicLuminance[laneIndex + reductionStride];
        }

        GroupMemoryBarrierWithGroupSync();
    }

    if (laneIndex == 0u)
    {
        InterlockedAddFloat(0u, s_GroupBasicLuminance[0].x);
        InterlockedAddFloat(1u, s_GroupBasicLuminance[0].y);
    }
}

bool TryResolveHistogramAverageSceneLuminance(out float averageSceneLuminance)
{
    float histogramSum = 0.0f;

    [unroll]
    for (uint bucketIndex = 0; bucketIndex < HISTOGRAM_SIZE; ++bucketIndex)
        histogramSum += (float)_HistogramBuffer[bucketIndex];

    if (histogramSum <= kEpsilon)
    {
        averageSceneLuminance = 1.0f;
        return true;
    }

    float minFractionSum = histogramSum * _AutoExposureParams0.x;
    float maxFractionSum = histogramSum * _AutoExposureParams0.y;
    float2 sumWithoutOutliers = 0.0f;

    [unroll]
    for (uint bucketIndex = 0; bucketIndex < HISTOGRAM_SIZE; ++bucketIndex)
    {
        float localValue = (float)_HistogramBuffer[bucketIndex];

        const float subtractedLow = min(localValue, minFractionSum);
        localValue -= subtractedLow;
        minFractionSum -= subtractedLow;
        maxFractionSum -= subtractedLow;

        localValue = min(localValue, maxFractionSum);
        maxFractionSum -= localValue;

        const float logLuminanceAtBucket = GetLogLuminanceFromHistogramPosition((float)bucketIndex / (float)(HISTOGRAM_SIZE - 1));
        sumWithoutOutliers += float2(logLuminanceAtBucket, 1.0f) * localValue;
    }

    const float averageLogLuminance = sumWithoutOutliers.x / max(sumWithoutOutliers.y, kEpsilon);
    averageSceneLuminance = exp2(averageLogLuminance);
    return true;
}

bool TryResolveBasicAverageSceneLuminance(out float averageSceneLuminance)
{
    const float weightedScaledLogLuminance = asfloat(_HistogramBuffer[0]);
    const float totalWeight = max(
        asfloat(_HistogramBuffer[1]),
        kBasicWeightEpsilon);
    const float averageScaledLogLuminance =
        weightedScaledLogLuminance / totalWeight;
    const float averageLogLuminance =
        GetLogLuminanceFromHistogramPosition(
            averageScaledLogLuminance);
    averageSceneLuminance = exp2(averageLogLuminance);
    return true;
}

void WriteResolvedExposure(float averageSceneLuminance)
{
    const float targetAverageLuminance = clamp(
        averageSceneLuminance,
        _AutoExposureParams0.z,
        _AutoExposureParams0.w);

    const float targetExposure = targetAverageLuminance / kMiddleGrey;
    const float previousAverageSceneLuminance =
        _PreviousExposureBuffer[0].z;
    const float curveCompensationStops =
        SampleExposureCompensationCurveStops(
            previousAverageSceneLuminance);
    const float middleGreyExposureCompensation = _AutoExposureParams1.z * exp2(curveCompensationStops);
    const float oldExposureScale = _PreviousExposureBuffer[0].x;
    const float oldExposure =
        middleGreyExposureCompensation
        / max(oldExposureScale, kEpsilon);
    const float estimatedExposure = ComputeAdaptedExposure(oldExposure, targetExposure);
    const float smoothedExposure = clamp(
        estimatedExposure,
        _AutoExposureParams0.z / kMiddleGrey,
        _AutoExposureParams0.w / kMiddleGrey);

    const float smoothedExposureScale = middleGreyExposureCompensation / max(smoothedExposure, kEpsilon);
    const float targetExposureScale = middleGreyExposureCompensation / max(targetExposure, kEpsilon);

    _CurrentExposureBuffer[0] = float4(
        smoothedExposureScale,
        targetExposureScale,
        averageSceneLuminance,
        middleGreyExposureCompensation);
}

[numthreads(1, 1, 1)]
void ResolveExposure(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    float averageSceneLuminance;
    if (!TryResolveHistogramAverageSceneLuminance(averageSceneLuminance))
    {
        _CurrentExposureBuffer[0] = _PreviousExposureBuffer[0];
        return;
    }

    WriteResolvedExposure(averageSceneLuminance);
}

[numthreads(1, 1, 1)]
void ResolveBasicExposure(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    float averageSceneLuminance;
    if (!TryResolveBasicAverageSceneLuminance(averageSceneLuminance))
    {
        _CurrentExposureBuffer[0] = _PreviousExposureBuffer[0];
        return;
    }

    WriteResolvedExposure(averageSceneLuminance);
}
