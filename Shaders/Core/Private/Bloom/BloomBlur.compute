#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/Bloom/BloomCommon.hlsl"

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch

#pragma kernel KMain          MAIN=KMain
#pragma kernel KDownsample    MAIN=KDownsample  DOWNSAMPLE
#pragma kernel KSpdDownsample
#pragma kernel KFFTPrepareSource
#pragma kernel KFFTPrepareKernel
#pragma kernel KFFTStageHorizontal
#pragma kernel KFFTStageVertical
#pragma kernel KFFTWaveHorizontal32 VIVID_FFT_WAVE_32
#pragma kernel KFFTWaveVertical32 VIVID_FFT_WAVE_32
#pragma kernel KFFTWaveHorizontal64 VIVID_FFT_WAVE_64
#pragma kernel KFFTWaveVertical64 VIVID_FFT_WAVE_64
#pragma kernel KFFTMultiplyAndBitReverse
#pragma kernel KFFTResolve
#pragma kernel KFFTReduceEnergy
#pragma use_dxc
#pragma require Native16Bit
#pragma multi_compile _ UNITY_DEVICE_SUPPORTS_WAVE_32 UNITY_DEVICE_SUPPORTS_WAVE_64

#if defined(VIVID_FFT_WAVE_64) && defined(UNITY_DEVICE_SUPPORTS_WAVE_64) && defined(UNITY_HW_WAVE_SIZE) && UNITY_HW_WAVE_SIZE == 64
    #define VIVID_FFT_WAVE_SIZE 64
    #define VIVID_FFT_WAVE_LOG2_SIZE 6
    #define VIVID_FFT_USE_WAVE_INTRINSICS 1
#elif defined(VIVID_FFT_WAVE_32) && defined(UNITY_DEVICE_SUPPORTS_WAVE_32) && defined(UNITY_HW_WAVE_SIZE) && UNITY_HW_WAVE_SIZE == 32
    #define VIVID_FFT_WAVE_SIZE 32
    #define VIVID_FFT_WAVE_LOG2_SIZE 5
    #define VIVID_FFT_USE_WAVE_INTRINSICS 1
#else
    #define VIVID_FFT_WAVE_SIZE 0
    #define VIVID_FFT_WAVE_LOG2_SIZE 0
    #define VIVID_FFT_USE_WAVE_INTRINSICS 0
#endif

TEXTURE2D(_InputTexture);
SAMPLER(sampler_LinearClamp);

RW_TEXTURE2D(float4, _OutputTexture);

CBUFFER_START(cb0)
    float4 _TexelSize;      // xy: output size, zw: output texel size
    float4 _InputTexelSize; // xy: input  size, zw: input  texel size
CBUFFER_END

// 16x16 pixels with an 8x8 center. Each uint packs two halves to reduce LDS bank conflicts.
groupshared uint gs_cacheR[128];
groupshared uint gs_cacheG[128];
groupshared uint gs_cacheB[128];

float16_t3 BlurPixels(float16_t3 a, float16_t3 b, float16_t3 c, float16_t3 d, float16_t3 e, float16_t3 f, float16_t3 g, float16_t3 h, float16_t3 i)
{
    return float16_t(0.27343750) * (e    )
         + float16_t(0.21875000) * (d + f)
         + float16_t(0.10937500) * (c + g)
         + float16_t(0.03125000) * (b + h)
         + float16_t(0.00390625) * (a + i);
}

void Store2Pixels(uint index, float16_t3 pixel1, float16_t3 pixel2)
{
    gs_cacheR[index] = f32tof16(float(pixel1.r)) | f32tof16(float(pixel2.r)) << 16;
    gs_cacheG[index] = f32tof16(float(pixel1.g)) | f32tof16(float(pixel2.g)) << 16;
    gs_cacheB[index] = f32tof16(float(pixel1.b)) | f32tof16(float(pixel2.b)) << 16;
}

void Load2Pixels(uint index, out float16_t3 pixel1, out float16_t3 pixel2)
{
    uint rr = gs_cacheR[index];
    uint gg = gs_cacheG[index];
    uint bb = gs_cacheB[index];
    pixel1 = float16_t3(f16tof32(rr      ), f16tof32(gg      ), f16tof32(bb      ));
    pixel2 = float16_t3(f16tof32(rr >> 16), f16tof32(gg >> 16), f16tof32(bb >> 16));
}

void Store1Pixel(uint index, float16_t3 pixel)
{
    gs_cacheR[index] = f32tof16(float(pixel.r));
    gs_cacheG[index] = f32tof16(float(pixel.g));
    gs_cacheB[index] = f32tof16(float(pixel.b));
}

void Load1Pixel(uint index, out float16_t3 pixel)
{
    pixel = float16_t3(
        f16tof32(gs_cacheR[index]),
        f16tof32(gs_cacheG[index]),
        f16tof32(gs_cacheB[index]));
}

void BlurHorizontally(uint outIndex, uint leftMostIndex)
{
    float16_t3 s0, s1, s2, s3, s4, s5, s6, s7, s8, s9;
    Load2Pixels(leftMostIndex + 0, s0, s1);
    Load2Pixels(leftMostIndex + 1, s2, s3);
    Load2Pixels(leftMostIndex + 2, s4, s5);
    Load2Pixels(leftMostIndex + 3, s6, s7);
    Load2Pixels(leftMostIndex + 4, s8, s9);

    Store1Pixel(outIndex    , BlurPixels(s0, s1, s2, s3, s4, s5, s6, s7, s8));
    Store1Pixel(outIndex + 1, BlurPixels(s1, s2, s3, s4, s5, s6, s7, s8, s9));
}

void BlurVertically(uint2 pixelCoord, uint topMostIndex)
{
    float16_t3 s0, s1, s2, s3, s4, s5, s6, s7, s8;
    Load1Pixel(topMostIndex     , s0);
    Load1Pixel(topMostIndex +  8, s1);
    Load1Pixel(topMostIndex + 16, s2);
    Load1Pixel(topMostIndex + 24, s3);
    Load1Pixel(topMostIndex + 32, s4);
    Load1Pixel(topMostIndex + 40, s5);
    Load1Pixel(topMostIndex + 48, s6);
    Load1Pixel(topMostIndex + 56, s7);
    Load1Pixel(topMostIndex + 64, s8);

    float16_t3 blurred = BlurPixels(s0, s1, s2, s3, s4, s5, s6, s7, s8);

    blurred *= all(pixelCoord < uint2(_TexelSize.xy));
    _OutputTexture[pixelCoord] = float4(blurred, 1.0);
}

#define GROUP_SIZE 8

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void MAIN(uint2 groupId : SV_GroupID, uint2 groupThreadId : SV_GroupThreadID, uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 threadUL = (groupThreadId << 1) + (groupId << 3) - 4;

#if DOWNSAMPLE
    float2 offset = float2(threadUL);
    float16_t3 p00 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset                    + 0.5) * _TexelSize.zw, 0.0).xyz);
    float16_t3 p10 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset + float2(1.0, 0.0) + 0.5) * _TexelSize.zw, 0.0).xyz);
    float16_t3 p01 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset + float2(0.0, 1.0) + 0.5) * _TexelSize.zw, 0.0).xyz);
    float16_t3 p11 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset + float2(1.0, 1.0) + 0.5) * _TexelSize.zw, 0.0).xyz);
#else
    uint2 uthreadUL = uint2(max(0, threadUL));
    uint2 size = uint2(_InputTexelSize.xy) - 1u;
    float16_t3 p00 = float16_t3(_InputTexture[min(uthreadUL + uint2(0u, 0u), size)].xyz);
    float16_t3 p10 = float16_t3(_InputTexture[min(uthreadUL + uint2(1u, 0u), size)].xyz);
    float16_t3 p11 = float16_t3(_InputTexture[min(uthreadUL + uint2(1u, 1u), size)].xyz);
    float16_t3 p01 = float16_t3(_InputTexture[min(uthreadUL + uint2(0u, 1u), size)].xyz);
#endif

    uint destIdx = groupThreadId.x + (groupThreadId.y << 4u);
    Store2Pixels(destIdx     , p00, p10);
    Store2Pixels(destIdx + 8u, p01, p11);

    GroupMemoryBarrierWithGroupSync();

    uint row = groupThreadId.y << 4u;
    BlurHorizontally(row + (groupThreadId.x << 1u), row + groupThreadId.x + (groupThreadId.x & 4u));

    GroupMemoryBarrierWithGroupSync();

    BlurVertically(dispatchThreadId.xy, (groupThreadId.y << 3u) + groupThreadId.x);
}

#define A_GPU 1
#define A_HLSL 1
#define FFX_WAVE 1
#define FFX_HALF

#if defined(FFX_HALF)
#define A_HALF 1
#endif

#include "Packages/com.unity.render-pipelines.core/Runtime/PostProcessing/Shaders/ffx/ffx_a.hlsl"

#if !defined(UNITY_COMPILER_DXC)
    #error "BloomBlur.compute requires DXC (#pragma use_dxc) for the SPD wave path."
#endif

cbuffer spdConstants
{
    AU1 mips;
    AU1 numWorkGroups;
    AU2 workGroupOffset;
}

RWTexture2D<float4> _SpdMip0;
RWTexture2D<float4> _SpdMip1;
RWTexture2D<float4> _SpdMip2;
RWTexture2D<float4> _SpdMip3;
RWTexture2D<float4> _SpdMip4;
RWTexture2D<float4> _SpdMip5;
globallycoherent RWTexture2D<float4> _SpdMip6;
RWTexture2D<float4> _SpdMip7;
RWTexture2D<float4> _SpdMip8;
RWTexture2D<float4> _SpdMip9;
RWTexture2D<float4> _SpdMip10;
RWTexture2D<float4> _SpdMip11;
RWTexture2D<float4> _SpdMip12;

float4 _SpdSourceSize;
float4 _SpdMip6Size;

struct SpdGlobalAtomicBuffer
{
    uint counter;
};

globallycoherent RWStructuredBuffer<SpdGlobalAtomicBuffer> spdGlobalAtomic;

groupshared AU1 spdCounter;
groupshared AF1 spdIntermediateR[16][16];
groupshared AF1 spdIntermediateG[16][16];
groupshared AF1 spdIntermediateB[16][16];
groupshared AF1 spdIntermediateA[16][16];
groupshared AH2 spdIntermediateRG[16][16];
groupshared AH2 spdIntermediateBA[16][16];

uint2 ClampSpdCoord(ASU2 coord, float2 size)
{
    return min(uint2(coord), uint2(size) - 1u);
}

AF4 SpdLoadSourceImage(ASU2 tex)
{
    return _SpdMip0[ClampSpdCoord(tex, _SpdSourceSize.xy)];
}

AF4 SpdLoad(ASU2 tex)
{
    return _SpdMip6[ClampSpdCoord(tex, _SpdMip6Size.xy)];
}

void SpdStoreMip(ASU2 pix, AF4 outValue, AU1 mip)
{
    switch (mip)
    {
        case 0:
            _SpdMip1[pix] = outValue;
            break;
        case 1:
            _SpdMip2[pix] = outValue;
            break;
        case 2:
            _SpdMip3[pix] = outValue;
            break;
        case 3:
            _SpdMip4[pix] = outValue;
            break;
        case 4:
            _SpdMip5[pix] = outValue;
            break;
        case 5:
            _SpdMip6[pix] = outValue;
            break;
        case 6:
            _SpdMip7[pix] = outValue;
            break;
        case 7:
            _SpdMip8[pix] = outValue;
            break;
        case 8:
            _SpdMip9[pix] = outValue;
            break;
        case 9:
            _SpdMip10[pix] = outValue;
            break;
        case 10:
            _SpdMip11[pix] = outValue;
            break;
        case 11:
            _SpdMip12[pix] = outValue;
            break;
        default:
            break;
    }
}

void SpdStore(ASU2 pix, AF4 outValue, AU1 mip)
{
    SpdStoreMip(pix, outValue, mip);
}

void SpdIncreaseAtomicCounter(AU1 slice)
{
    InterlockedAdd(spdGlobalAtomic[0].counter, 1, spdCounter);
}

AU1 SpdGetAtomicCounter()
{
    return spdCounter;
}

void SpdResetAtomicCounter(AU1 slice)
{
    spdGlobalAtomic[0].counter = 0;
}

AF4 SpdLoadIntermediate(AU1 x, AU1 y)
{
    return AF4(
        spdIntermediateR[x][y],
        spdIntermediateG[x][y],
        spdIntermediateB[x][y],
        spdIntermediateA[x][y]);
}

void SpdStoreIntermediate(AU1 x, AU1 y, AF4 value)
{
    spdIntermediateR[x][y] = value.x;
    spdIntermediateG[x][y] = value.y;
    spdIntermediateB[x][y] = value.z;
    spdIntermediateA[x][y] = value.w;
}

AF4 SpdReduce4(AF4 v0, AF4 v1, AF4 v2, AF4 v3)
{
    return (v0 + v1 + v2 + v3) * 0.25;
}

AH4 SpdLoadSourceImageH(ASU2 tex)
{
    return AH4(_SpdMip0[ClampSpdCoord(tex, _SpdSourceSize.xy)]);
}

AH4 SpdLoadH(ASU2 tex)
{
    return AH4(_SpdMip6[ClampSpdCoord(tex, _SpdMip6Size.xy)]);
}

void SpdStoreH(ASU2 pix, AH4 outValue, AU1 mip)
{
    SpdStoreMip(pix, AF4(outValue), mip);
}

AH4 SpdLoadIntermediateH(AU1 x, AU1 y)
{
    return AH4(
        spdIntermediateRG[x][y].x,
        spdIntermediateRG[x][y].y,
        spdIntermediateBA[x][y].x,
        spdIntermediateBA[x][y].y);
}

void SpdStoreIntermediateH(AU1 x, AU1 y, AH4 value)
{
    spdIntermediateRG[x][y] = value.xy;
    spdIntermediateBA[x][y] = value.zw;
}

AH4 SpdReduce4H(AH4 v0, AH4 v1, AH4 v2, AH4 v3)
{
    return (v0 + v1 + v2 + v3) * AH1(0.25);
}

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/FidelityFX/ffx_spd.hlsl"

[numthreads(256, 1, 1)]
void KSpdDownsample(uint3 workGroupId : SV_GroupID, uint localThreadIndex : SV_GroupIndex)
{
    SpdDownsampleH(
        AU2(workGroupId.xy),
        AU1(localThreadIndex),
        AU1(mips),
        AU1(numWorkGroups),
        AU1(workGroupId.z),
        AU2(workGroupOffset));
}

// -----------------------------------------------------------------------------
// FFT convolution bloom
//
// This is a unitary radix-2 FFT. Both forward and inverse butterflies use
// 1/sqrt(2), so convolution resolve restores sqrt(width * height). The spatial
// kernel is wrapped around the origin before its transform, matching the
// periodic layout expected by frequency-domain convolution.

Texture2D<float4> _FFTSourceTexture;
Texture2D<float4> _FFTKernelTexture;
Texture2D<float4> _FFTRealInput;
Texture2D<float4> _FFTImagInput;
Texture2D<float4> _FFTKernelReal;
Texture2D<float4> _FFTKernelImag;
Texture2D<float4> _FFTEnergyInput;
Texture2D<float4> _FFTKernelEnergy;

RWTexture2D<float4> _FFTRealOutput;
RWTexture2D<float4> _FFTImagOutput;
RWTexture2D<float4> _FFTEnergyOutput;
RWTexture2D<float4> _FFTOutputTexture;

CBUFFER_START(fftConstants)
    float4 _FFTSize;         // xy: frequency size, zw: log2 frequency size
    float4 _FFTImageSize;    // xy: image size, zw: reciprocal image size
    float4 _FFTKernelParams; // x: diameter in pixels, y: center clamp, zw: center UV
    float4 _FFTInputSize;    // xy: reduction input size
    float4 _FFTOutputSize;   // xy: reduction output size
    float4 _BloomThreshold;
    uint _FFTStage;
    uint _FFTInverse;
    float _FFTResolveScale;
    float _FFTPadding;
CBUFFER_END

static const float k_FftUnitaryButterflyScale = 0.7071067811865475244;
static const uint k_FftWaveGroupSize = 256u;
static const uint k_FftWaveMaximumLength = 2048u;

uint ReverseFftIndex(uint index, uint bitCount)
{
    return bitCount == 0u ? 0u : reversebits(index) >> (32u - bitCount);
}

uint2 ReverseFftCoord(uint2 coord)
{
    return uint2(
        ReverseFftIndex(coord.x, uint(_FFTSize.z)),
        ReverseFftIndex(coord.y, uint(_FFTSize.w)));
}

void LoadFftButterfly(
    uint2 evenCoord,
    uint2 oddCoord,
    uint offset,
    uint span,
    out float3 outputReal,
    out float3 outputImag)
{
    float3 evenReal = _FFTRealInput[evenCoord].xyz;
    float3 evenImag = _FFTImagInput[evenCoord].xyz;
    float3 oddReal = _FFTRealInput[oddCoord].xyz;
    float3 oddImag = _FFTImagInput[oddCoord].xyz;
    uint halfSpan = span >> 1u;
    uint twiddleIndex = offset & (halfSpan - 1u);
    float direction = _FFTInverse != 0u ? 1.0 : -1.0;
    float angle = direction * TWO_PI * float(twiddleIndex) / float(span);
    float sine;
    float cosine;
    sincos(angle, sine, cosine);

    float3 twiddledReal = oddReal * cosine - oddImag * sine;
    float3 twiddledImag = oddReal * sine + oddImag * cosine;
    bool upperHalf = offset >= halfSpan;
    outputReal = (upperHalf ? evenReal - twiddledReal : evenReal + twiddledReal)
        * k_FftUnitaryButterflyScale;
    outputImag = (upperHalf ? evenImag - twiddledImag : evenImag + twiddledImag)
        * k_FftUnitaryButterflyScale;
}

void CalculateFftButterflyPair(
    float3 evenReal,
    float3 evenImag,
    float3 oddReal,
    float3 oddImag,
    uint twiddleIndex,
    uint span,
    out float3 lowerReal,
    out float3 lowerImaginary,
    out float3 upperReal,
    out float3 upperImaginary)
{
    float direction = _FFTInverse != 0u ? 1.0 : -1.0;
    float angle = direction * TWO_PI * float(twiddleIndex) / float(span);
    float sine;
    float cosine;
    sincos(angle, sine, cosine);

    float3 twiddledReal = oddReal * cosine - oddImag * sine;
    float3 twiddledImaginary = oddReal * sine + oddImag * cosine;
    lowerReal = (evenReal + twiddledReal) * k_FftUnitaryButterflyScale;
    lowerImaginary = (evenImag + twiddledImaginary) * k_FftUnitaryButterflyScale;
    upperReal = (evenReal - twiddledReal) * k_FftUnitaryButterflyScale;
    upperImaginary = (evenImag - twiddledImaginary) * k_FftUnitaryButterflyScale;
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTPrepareSource(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    uint2 frequencySize = uint2(_FFTSize.xy);
    if (any(coord >= frequencySize))
        return;

    float3 color = 0.0;
    uint2 imageSize = uint2(_FFTImageSize.xy);
    if (all(coord < imageSize))
    {
        float2 uv = (float2(coord) + 0.5) * _FFTImageSize.zw;
        color = max(_FFTSourceTexture.SampleLevel(sampler_LinearClamp, uv, 0.0).xyz, 0.0);
        color = QuadraticThreshold(
            color,
            _BloomThreshold.x,
            _BloomThreshold.yzw);
    }

    uint2 outputCoord = ReverseFftCoord(coord);
    _FFTRealOutput[outputCoord] = float4(color, 0.0);
    _FFTImagOutput[outputCoord] = 0.0;
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTPrepareKernel(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    uint2 frequencySize = uint2(_FFTSize.xy);
    if (any(coord >= frequencySize))
        return;

    int2 signedCoord = int2(coord);
    if (coord.x > frequencySize.x / 2u)
        signedCoord.x -= int(frequencySize.x);
    if (coord.y > frequencySize.y / 2u)
        signedCoord.y -= int(frequencySize.y);

    float kernelDiameter = max(_FFTKernelParams.x, 1.0);
    float2 centerUv = _FFTKernelParams.zw;
    float2 kernelUv = centerUv + float2(signedCoord) / kernelDiameter;
    float halfDiameter = kernelDiameter * 0.5;
    bool insideSupport = all(abs(float2(signedCoord)) <= halfDiameter);
    bool insideTexture = all(kernelUv >= 0.0) && all(kernelUv <= 1.0);

    float3 kernel = 0.0;
    if (insideSupport && insideTexture)
    {
        float3 centerValue = max(
            _FFTKernelTexture.SampleLevel(sampler_LinearClamp, centerUv, 0.0).xyz,
            0.0);
        float3 maximumScatter = max(centerValue * _FFTKernelParams.y, 1e-6);
        float3 sampledKernel = max(
            _FFTKernelTexture.SampleLevel(sampler_LinearClamp, kernelUv, 0.0).xyz,
            0.0);
        kernel = min(sampledKernel, maximumScatter);
    }

    uint2 outputCoord = ReverseFftCoord(coord);
    _FFTRealOutput[outputCoord] = float4(kernel, 0.0);
    _FFTImagOutput[outputCoord] = 0.0;
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTStageHorizontal(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    uint2 frequencySize = uint2(_FFTSize.xy);
    if (any(coord >= frequencySize))
        return;

    uint span = 1u << (_FFTStage + 1u);
    uint offset = coord.x & (span - 1u);
    uint blockStart = coord.x - offset;
    uint twiddleIndex = offset & ((span >> 1u) - 1u);
    uint2 evenCoord = uint2(blockStart + twiddleIndex, coord.y);
    uint2 oddCoord = uint2(evenCoord.x + (span >> 1u), coord.y);

    float3 outputReal;
    float3 outputImag;
    LoadFftButterfly(evenCoord, oddCoord, offset, span, outputReal, outputImag);
    _FFTRealOutput[coord] = float4(outputReal, 0.0);
    _FFTImagOutput[coord] = float4(outputImag, 0.0);
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTStageVertical(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    uint2 frequencySize = uint2(_FFTSize.xy);
    if (any(coord >= frequencySize))
        return;

    uint span = 1u << (_FFTStage + 1u);
    uint offset = coord.y & (span - 1u);
    uint blockStart = coord.y - offset;
    uint twiddleIndex = offset & ((span >> 1u) - 1u);
    uint2 evenCoord = uint2(coord.x, blockStart + twiddleIndex);
    uint2 oddCoord = uint2(coord.x, evenCoord.y + (span >> 1u));

    float3 outputReal;
    float3 outputImag;
    LoadFftButterfly(evenCoord, oddCoord, offset, span, outputReal, outputImag);
    _FFTRealOutput[coord] = float4(outputReal, 0.0);
    _FFTImagOutput[coord] = float4(outputImag, 0.0);
}

#if VIVID_FFT_USE_WAVE_INTRINSICS

// The primary FFT path uses one 256-thread group per scanline. The first
// log2(waveSize) stages stay in registers and exchange values with wave
// shuffles. Remaining stages update disjoint butterfly pairs in-place through
// 24 KiB of half-packed complex RGB LDS, staying within the common 32 KiB
// thread-group shared-memory limit.
groupshared uint gs_FftWaveR[k_FftWaveMaximumLength];
groupshared uint gs_FftWaveG[k_FftWaveMaximumLength];
groupshared uint gs_FftWaveB[k_FftWaveMaximumLength];

uint PackFftComplex(float realValue, float imaginaryValue)
{
    return f32tof16(realValue) | (f32tof16(imaginaryValue) << 16u);
}

float2 UnpackFftComplex(uint packedValue)
{
    return float2(
        f16tof32(packedValue),
        f16tof32(packedValue >> 16u));
}

void StoreWaveFftValue(
    uint index,
    float3 realValue,
    float3 imaginaryValue)
{
    gs_FftWaveR[index] = PackFftComplex(realValue.r, imaginaryValue.r);
    gs_FftWaveG[index] = PackFftComplex(realValue.g, imaginaryValue.g);
    gs_FftWaveB[index] = PackFftComplex(realValue.b, imaginaryValue.b);
}

void LoadWaveFftValue(
    uint index,
    out float3 realValue,
    out float3 imaginaryValue)
{
    float2 complexR = UnpackFftComplex(gs_FftWaveR[index]);
    float2 complexG = UnpackFftComplex(gs_FftWaveG[index]);
    float2 complexB = UnpackFftComplex(gs_FftWaveB[index]);
    realValue = float3(complexR.x, complexG.x, complexB.x);
    imaginaryValue = float3(complexR.y, complexG.y, complexB.y);
}

float2 ExecuteWaveFftButterfly(float2 value, uint sampleIndex, uint stage)
{
    uint halfSpan = 1u << stage;
    uint span = halfSpan << 1u;
    uint laneIndex = WaveGetLaneIndex();
    uint partnerLane = laneIndex ^ halfSpan;
    float2 partner = float2(
        WaveReadLaneAt(value.x, partnerLane),
        WaveReadLaneAt(value.y, partnerLane));

    uint offset = sampleIndex & (span - 1u);
    uint twiddleIndex = offset & (halfSpan - 1u);
    bool upperHalf = offset >= halfSpan;
    float2 evenValue = upperHalf ? partner : value;
    float2 oddValue = upperHalf ? value : partner;

    float direction = _FFTInverse != 0u ? 1.0 : -1.0;
    float angle = direction * TWO_PI * float(twiddleIndex) / float(span);
    float sine;
    float cosine;
    sincos(angle, sine, cosine);
    float2 twiddled = float2(
        oddValue.x * cosine - oddValue.y * sine,
        oddValue.x * sine + oddValue.y * cosine);
    return (upperHalf ? evenValue - twiddled : evenValue + twiddled)
        * k_FftUnitaryButterflyScale;
}

void ExecuteWaveFftAxis(uint lineIndex, uint localThreadIndex, bool horizontal)
{
    uint axisLength = horizontal ? uint(_FFTSize.x) : uint(_FFTSize.y);
    uint log2AxisLength = horizontal ? uint(_FFTSize.z) : uint(_FFTSize.w);
    uint batchCount = (axisLength + k_FftWaveGroupSize - 1u) / k_FftWaveGroupSize;

    for (uint batch = 0u; batch < batchCount; batch++)
    {
        uint sampleIndex = localThreadIndex + batch * k_FftWaveGroupSize;
        bool active = sampleIndex < axisLength;
        float3 realValue = 0.0;
        float3 imaginaryValue = 0.0;
        if (active)
        {
            uint2 coord = horizontal
                ? uint2(sampleIndex, lineIndex)
                : uint2(lineIndex, sampleIndex);
            realValue = _FFTRealInput[coord].xyz;
            imaginaryValue = _FFTImagInput[coord].xyz;

            [unroll]
            for (uint stage = 0u; stage < VIVID_FFT_WAVE_LOG2_SIZE; stage++)
            {
                float2 complexR = ExecuteWaveFftButterfly(
                    float2(realValue.r, imaginaryValue.r),
                    sampleIndex,
                    stage);
                float2 complexG = ExecuteWaveFftButterfly(
                    float2(realValue.g, imaginaryValue.g),
                    sampleIndex,
                    stage);
                float2 complexB = ExecuteWaveFftButterfly(
                    float2(realValue.b, imaginaryValue.b),
                    sampleIndex,
                    stage);
                realValue = float3(complexR.x, complexG.x, complexB.x);
                imaginaryValue = float3(complexR.y, complexG.y, complexB.y);
            }

            StoreWaveFftValue(sampleIndex, realValue, imaginaryValue);
        }
    }

    GroupMemoryBarrierWithGroupSync();

    for (uint stage = VIVID_FFT_WAVE_LOG2_SIZE; stage < log2AxisLength; stage++)
    {
        uint span = 1u << (stage + 1u);
        uint halfSpan = span >> 1u;
        uint butterflyCount = axisLength >> 1u;

        for (uint butterflyIndex = localThreadIndex;
             butterflyIndex < butterflyCount;
             butterflyIndex += k_FftWaveGroupSize)
        {
            uint blockIndex = butterflyIndex / halfSpan;
            uint twiddleIndex = butterflyIndex & (halfSpan - 1u);
            uint evenIndex = blockIndex * span + twiddleIndex;
            uint oddIndex = evenIndex + halfSpan;

            float3 evenReal;
            float3 evenImaginary;
            float3 oddReal;
            float3 oddImaginary;
            LoadWaveFftValue(
                evenIndex,
                evenReal,
                evenImaginary);
            LoadWaveFftValue(
                oddIndex,
                oddReal,
                oddImaginary);

            float3 lowerReal;
            float3 lowerImaginary;
            float3 upperReal;
            float3 upperImaginary;
            CalculateFftButterflyPair(
                evenReal,
                evenImaginary,
                oddReal,
                oddImaginary,
                twiddleIndex,
                span,
                lowerReal,
                lowerImaginary,
                upperReal,
                upperImaginary);
            StoreWaveFftValue(
                evenIndex,
                lowerReal,
                lowerImaginary);
            StoreWaveFftValue(
                oddIndex,
                upperReal,
                upperImaginary);
        }

        GroupMemoryBarrierWithGroupSync();
    }

    for (uint batch = 0u; batch < batchCount; batch++)
    {
        uint sampleIndex = localThreadIndex + batch * k_FftWaveGroupSize;
        if (sampleIndex >= axisLength)
            continue;

        float3 realValue;
        float3 imaginaryValue;
        LoadWaveFftValue(
            sampleIndex,
            realValue,
            imaginaryValue);
        uint2 coord = horizontal
            ? uint2(sampleIndex, lineIndex)
            : uint2(lineIndex, sampleIndex);
        _FFTRealOutput[coord] = float4(realValue, 0.0);
        _FFTImagOutput[coord] = float4(imaginaryValue, 0.0);
    }
}

#endif

[numthreads(256, 1, 1)]
void KFFTWaveHorizontal32(uint3 groupId : SV_GroupID, uint localThreadIndex : SV_GroupIndex)
{
#if VIVID_FFT_USE_WAVE_INTRINSICS
    ExecuteWaveFftAxis(groupId.x, localThreadIndex, true);
#endif
}

[numthreads(256, 1, 1)]
void KFFTWaveVertical32(uint3 groupId : SV_GroupID, uint localThreadIndex : SV_GroupIndex)
{
#if VIVID_FFT_USE_WAVE_INTRINSICS
    ExecuteWaveFftAxis(groupId.x, localThreadIndex, false);
#endif
}

[numthreads(256, 1, 1)]
void KFFTWaveHorizontal64(uint3 groupId : SV_GroupID, uint localThreadIndex : SV_GroupIndex)
{
#if VIVID_FFT_USE_WAVE_INTRINSICS
    ExecuteWaveFftAxis(groupId.x, localThreadIndex, true);
#endif
}

[numthreads(256, 1, 1)]
void KFFTWaveVertical64(uint3 groupId : SV_GroupID, uint localThreadIndex : SV_GroupIndex)
{
#if VIVID_FFT_USE_WAVE_INTRINSICS
    ExecuteWaveFftAxis(groupId.x, localThreadIndex, false);
#endif
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTMultiplyAndBitReverse(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    uint2 frequencySize = uint2(_FFTSize.xy);
    if (any(coord >= frequencySize))
        return;

    float3 sourceReal = _FFTRealInput[coord].xyz;
    float3 sourceImag = _FFTImagInput[coord].xyz;
    float3 kernelReal = _FFTKernelReal[coord].xyz;
    float3 kernelImag = _FFTKernelImag[coord].xyz;

    float3 productReal = sourceReal * kernelReal - sourceImag * kernelImag;
    float3 productImag = sourceReal * kernelImag + sourceImag * kernelReal;
    uint2 outputCoord = ReverseFftCoord(coord);
    _FFTRealOutput[outputCoord] = float4(productReal, 0.0);
    _FFTImagOutput[outputCoord] = float4(productImag, 0.0);
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTReduceEnergy(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 outputCoord = dispatchThreadId.xy;
    uint2 outputSize = uint2(_FFTOutputSize.xy);
    if (any(outputCoord >= outputSize))
        return;

    uint2 inputSize = uint2(_FFTInputSize.xy);
    uint2 inputCoord = outputCoord * 2u;
    float3 energy = 0.0;
    [unroll]
    for (uint y = 0u; y < 2u; y++)
    {
        [unroll]
        for (uint x = 0u; x < 2u; x++)
        {
            uint2 sampleCoord = inputCoord + uint2(x, y);
            if (all(sampleCoord < inputSize))
                energy += _FFTEnergyInput[sampleCoord].xyz;
        }
    }

    _FFTEnergyOutput[outputCoord] = float4(energy, 0.0);
}

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void KFFTResolve(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coord = dispatchThreadId.xy;
    uint2 imageSize = uint2(_FFTImageSize.xy);
    if (any(coord >= imageSize))
        return;

    float3 kernelEnergy = max(_FFTKernelEnergy[uint2(0u, 0u)].xyz, 1e-5);
    float3 bloom = max(_FFTRealInput[coord].xyz * _FFTResolveScale / kernelEnergy, 0.0);
    _FFTOutputTexture[coord] = float4(min(bloom, 65504.0), 1.0);
}
