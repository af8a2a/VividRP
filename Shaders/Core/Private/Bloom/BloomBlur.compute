#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch

#pragma kernel KMain          MAIN=KMain
#pragma kernel KDownsample    MAIN=KDownsample  DOWNSAMPLE
#pragma kernel KSpdDownsample
#pragma use_dxc
#pragma require Native16Bit

TEXTURE2D(_InputTexture);
SAMPLER(sampler_LinearClamp);

RW_TEXTURE2D(float4, _OutputTexture);

CBUFFER_START(cb0)
    float4 _TexelSize;      // xy: output size, zw: output texel size
    float4 _InputTexelSize; // xy: input  size, zw: input  texel size
CBUFFER_END

// 16x16 pixels with an 8x8 center. Each uint packs two halves to reduce LDS bank conflicts.
groupshared uint gs_cacheR[128];
groupshared uint gs_cacheG[128];
groupshared uint gs_cacheB[128];

float16_t3 BlurPixels(float16_t3 a, float16_t3 b, float16_t3 c, float16_t3 d, float16_t3 e, float16_t3 f, float16_t3 g, float16_t3 h, float16_t3 i)
{
    return float16_t(0.27343750) * (e    )
         + float16_t(0.21875000) * (d + f)
         + float16_t(0.10937500) * (c + g)
         + float16_t(0.03125000) * (b + h)
         + float16_t(0.00390625) * (a + i);
}

void Store2Pixels(uint index, float16_t3 pixel1, float16_t3 pixel2)
{
    gs_cacheR[index] = f32tof16(float(pixel1.r)) | f32tof16(float(pixel2.r)) << 16;
    gs_cacheG[index] = f32tof16(float(pixel1.g)) | f32tof16(float(pixel2.g)) << 16;
    gs_cacheB[index] = f32tof16(float(pixel1.b)) | f32tof16(float(pixel2.b)) << 16;
}

void Load2Pixels(uint index, out float16_t3 pixel1, out float16_t3 pixel2)
{
    uint rr = gs_cacheR[index];
    uint gg = gs_cacheG[index];
    uint bb = gs_cacheB[index];
    pixel1 = float16_t3(f16tof32(rr      ), f16tof32(gg      ), f16tof32(bb      ));
    pixel2 = float16_t3(f16tof32(rr >> 16), f16tof32(gg >> 16), f16tof32(bb >> 16));
}

void Store1Pixel(uint index, float16_t3 pixel)
{
    gs_cacheR[index] = f32tof16(float(pixel.r));
    gs_cacheG[index] = f32tof16(float(pixel.g));
    gs_cacheB[index] = f32tof16(float(pixel.b));
}

void Load1Pixel(uint index, out float16_t3 pixel)
{
    pixel = float16_t3(
        f16tof32(gs_cacheR[index]),
        f16tof32(gs_cacheG[index]),
        f16tof32(gs_cacheB[index]));
}

void BlurHorizontally(uint outIndex, uint leftMostIndex)
{
    float16_t3 s0, s1, s2, s3, s4, s5, s6, s7, s8, s9;
    Load2Pixels(leftMostIndex + 0, s0, s1);
    Load2Pixels(leftMostIndex + 1, s2, s3);
    Load2Pixels(leftMostIndex + 2, s4, s5);
    Load2Pixels(leftMostIndex + 3, s6, s7);
    Load2Pixels(leftMostIndex + 4, s8, s9);

    Store1Pixel(outIndex    , BlurPixels(s0, s1, s2, s3, s4, s5, s6, s7, s8));
    Store1Pixel(outIndex + 1, BlurPixels(s1, s2, s3, s4, s5, s6, s7, s8, s9));
}

void BlurVertically(uint2 pixelCoord, uint topMostIndex)
{
    float16_t3 s0, s1, s2, s3, s4, s5, s6, s7, s8;
    Load1Pixel(topMostIndex     , s0);
    Load1Pixel(topMostIndex +  8, s1);
    Load1Pixel(topMostIndex + 16, s2);
    Load1Pixel(topMostIndex + 24, s3);
    Load1Pixel(topMostIndex + 32, s4);
    Load1Pixel(topMostIndex + 40, s5);
    Load1Pixel(topMostIndex + 48, s6);
    Load1Pixel(topMostIndex + 56, s7);
    Load1Pixel(topMostIndex + 64, s8);

    float16_t3 blurred = BlurPixels(s0, s1, s2, s3, s4, s5, s6, s7, s8);

    blurred *= all(pixelCoord < uint2(_TexelSize.xy));
    _OutputTexture[pixelCoord] = float4(blurred, 1.0);
}

#define GROUP_SIZE 8

[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
void MAIN(uint2 groupId : SV_GroupID, uint2 groupThreadId : SV_GroupThreadID, uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 threadUL = (groupThreadId << 1) + (groupId << 3) - 4;

#if DOWNSAMPLE
    float2 offset = float2(threadUL);
    float16_t3 p00 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset                    + 0.5) * _TexelSize.zw, 0.0).xyz);
    float16_t3 p10 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset + float2(1.0, 0.0) + 0.5) * _TexelSize.zw, 0.0).xyz);
    float16_t3 p01 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset + float2(0.0, 1.0) + 0.5) * _TexelSize.zw, 0.0).xyz);
    float16_t3 p11 = float16_t3(SAMPLE_TEXTURE2D_LOD(_InputTexture, sampler_LinearClamp, (offset + float2(1.0, 1.0) + 0.5) * _TexelSize.zw, 0.0).xyz);
#else
    uint2 uthreadUL = uint2(max(0, threadUL));
    uint2 size = uint2(_InputTexelSize.xy) - 1u;
    float16_t3 p00 = float16_t3(_InputTexture[min(uthreadUL + uint2(0u, 0u), size)].xyz);
    float16_t3 p10 = float16_t3(_InputTexture[min(uthreadUL + uint2(1u, 0u), size)].xyz);
    float16_t3 p11 = float16_t3(_InputTexture[min(uthreadUL + uint2(1u, 1u), size)].xyz);
    float16_t3 p01 = float16_t3(_InputTexture[min(uthreadUL + uint2(0u, 1u), size)].xyz);
#endif

    uint destIdx = groupThreadId.x + (groupThreadId.y << 4u);
    Store2Pixels(destIdx     , p00, p10);
    Store2Pixels(destIdx + 8u, p01, p11);

    GroupMemoryBarrierWithGroupSync();

    uint row = groupThreadId.y << 4u;
    BlurHorizontally(row + (groupThreadId.x << 1u), row + groupThreadId.x + (groupThreadId.x & 4u));

    GroupMemoryBarrierWithGroupSync();

    BlurVertically(dispatchThreadId.xy, (groupThreadId.y << 3u) + groupThreadId.x);
}

#define A_GPU 1
#define A_HLSL 1
#define FFX_WAVE 1
#define FFX_HALF

#if defined(FFX_HALF)
#define A_HALF 1
#endif

#include "Packages/com.unity.render-pipelines.core/Runtime/PostProcessing/Shaders/ffx/ffx_a.hlsl"

#if !defined(UNITY_COMPILER_DXC)
    #error "BloomBlur.compute requires DXC (#pragma use_dxc) for the SPD wave path."
#endif

cbuffer spdConstants
{
    AU1 mips;
    AU1 numWorkGroups;
    AU2 workGroupOffset;
}

RWTexture2D<float4> _SpdMip0;
RWTexture2D<float4> _SpdMip1;
RWTexture2D<float4> _SpdMip2;
RWTexture2D<float4> _SpdMip3;
RWTexture2D<float4> _SpdMip4;
RWTexture2D<float4> _SpdMip5;
globallycoherent RWTexture2D<float4> _SpdMip6;
RWTexture2D<float4> _SpdMip7;
RWTexture2D<float4> _SpdMip8;
RWTexture2D<float4> _SpdMip9;
RWTexture2D<float4> _SpdMip10;
RWTexture2D<float4> _SpdMip11;
RWTexture2D<float4> _SpdMip12;

float4 _SpdSourceSize;
float4 _SpdMip6Size;

struct SpdGlobalAtomicBuffer
{
    uint counter;
};

globallycoherent RWStructuredBuffer<SpdGlobalAtomicBuffer> spdGlobalAtomic;

groupshared AU1 spdCounter;
groupshared AF1 spdIntermediateR[16][16];
groupshared AF1 spdIntermediateG[16][16];
groupshared AF1 spdIntermediateB[16][16];
groupshared AF1 spdIntermediateA[16][16];
groupshared AH2 spdIntermediateRG[16][16];
groupshared AH2 spdIntermediateBA[16][16];

uint2 ClampSpdCoord(ASU2 coord, float2 size)
{
    return min(uint2(coord), uint2(size) - 1u);
}

AF4 SpdLoadSourceImage(ASU2 tex)
{
    return _SpdMip0[ClampSpdCoord(tex, _SpdSourceSize.xy)];
}

AF4 SpdLoad(ASU2 tex)
{
    return _SpdMip6[ClampSpdCoord(tex, _SpdMip6Size.xy)];
}

void SpdStoreMip(ASU2 pix, AF4 outValue, AU1 mip)
{
    switch (mip)
    {
        case 0:
            _SpdMip1[pix] = outValue;
            break;
        case 1:
            _SpdMip2[pix] = outValue;
            break;
        case 2:
            _SpdMip3[pix] = outValue;
            break;
        case 3:
            _SpdMip4[pix] = outValue;
            break;
        case 4:
            _SpdMip5[pix] = outValue;
            break;
        case 5:
            _SpdMip6[pix] = outValue;
            break;
        case 6:
            _SpdMip7[pix] = outValue;
            break;
        case 7:
            _SpdMip8[pix] = outValue;
            break;
        case 8:
            _SpdMip9[pix] = outValue;
            break;
        case 9:
            _SpdMip10[pix] = outValue;
            break;
        case 10:
            _SpdMip11[pix] = outValue;
            break;
        case 11:
            _SpdMip12[pix] = outValue;
            break;
        default:
            break;
    }
}

void SpdStore(ASU2 pix, AF4 outValue, AU1 mip)
{
    SpdStoreMip(pix, outValue, mip);
}

void SpdIncreaseAtomicCounter(AU1 slice)
{
    InterlockedAdd(spdGlobalAtomic[0].counter, 1, spdCounter);
}

AU1 SpdGetAtomicCounter()
{
    return spdCounter;
}

void SpdResetAtomicCounter(AU1 slice)
{
    spdGlobalAtomic[0].counter = 0;
}

AF4 SpdLoadIntermediate(AU1 x, AU1 y)
{
    return AF4(
        spdIntermediateR[x][y],
        spdIntermediateG[x][y],
        spdIntermediateB[x][y],
        spdIntermediateA[x][y]);
}

void SpdStoreIntermediate(AU1 x, AU1 y, AF4 value)
{
    spdIntermediateR[x][y] = value.x;
    spdIntermediateG[x][y] = value.y;
    spdIntermediateB[x][y] = value.z;
    spdIntermediateA[x][y] = value.w;
}

AF4 SpdReduce4(AF4 v0, AF4 v1, AF4 v2, AF4 v3)
{
    return (v0 + v1 + v2 + v3) * 0.25;
}

AH4 SpdLoadSourceImageH(ASU2 tex)
{
    return AH4(_SpdMip0[ClampSpdCoord(tex, _SpdSourceSize.xy)]);
}

AH4 SpdLoadH(ASU2 tex)
{
    return AH4(_SpdMip6[ClampSpdCoord(tex, _SpdMip6Size.xy)]);
}

void SpdStoreH(ASU2 pix, AH4 outValue, AU1 mip)
{
    SpdStoreMip(pix, AF4(outValue), mip);
}

AH4 SpdLoadIntermediateH(AU1 x, AU1 y)
{
    return AH4(
        spdIntermediateRG[x][y].x,
        spdIntermediateRG[x][y].y,
        spdIntermediateBA[x][y].x,
        spdIntermediateBA[x][y].y);
}

void SpdStoreIntermediateH(AU1 x, AU1 y, AH4 value)
{
    spdIntermediateRG[x][y] = value.xy;
    spdIntermediateBA[x][y] = value.zw;
}

AH4 SpdReduce4H(AH4 v0, AH4 v1, AH4 v2, AH4 v3)
{
    return (v0 + v1 + v2 + v3) * AH1(0.25);
}

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/FidelityFX/ffx_spd.hlsl"

[numthreads(256, 1, 1)]
void KSpdDownsample(uint3 workGroupId : SV_GroupID, uint localThreadIndex : SV_GroupIndex)
{
    SpdDownsampleH(
        AU2(workGroupId.xy),
        AU1(localThreadIndex),
        AU1(mips),
        AU1(numWorkGroups),
        AU1(workGroupId.z),
        AU2(workGroupOffset));
}
