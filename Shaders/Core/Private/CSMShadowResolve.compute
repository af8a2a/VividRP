#pragma kernel CSMShadowResolve
#pragma kernel CSMShadowClearTiles
#pragma kernel CSMShadowClassifyTiles
#pragma kernel CSMShadowResolveTiles
#pragma kernel CSMShadowCopyFilterSource
#pragma kernel CSMShadowBilateralFilterH CSM_SHADOW_BILATERAL_FILTER_H
#pragma kernel CSMShadowBilateralFilterV CSM_SHADOW_BILATERAL_FILTER_V
#pragma kernel CSMShadowBendCompositeLow VIVID_BEND_ENABLED WAVE_SIZE=64 SAMPLE_COUNT=24 HARD_SHADOW_SAMPLES=2 FADE_OUT_SAMPLES=4 TRACK_HIT_UV=0
#pragma kernel CSMShadowBendCompositeMedium VIVID_BEND_ENABLED WAVE_SIZE=64 SAMPLE_COUNT=40 HARD_SHADOW_SAMPLES=4 FADE_OUT_SAMPLES=6 TRACK_HIT_UV=0
#pragma kernel CSMShadowBendCompositeHigh VIVID_BEND_ENABLED WAVE_SIZE=64 SAMPLE_COUNT=60 HARD_SHADOW_SAMPLES=4 FADE_OUT_SAMPLES=8 TRACK_HIT_UV=0
#pragma kernel CSMShadowBendCompositeVeryHigh VIVID_BEND_ENABLED WAVE_SIZE=64 SAMPLE_COUNT=80 HARD_SHADOW_SAMPLES=6 FADE_OUT_SAMPLES=10 TRACK_HIT_UV=0
#pragma use_dxc
#pragma require Native16Bit

// #pragma enable_d3d11_debug_symbols
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Core.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Input.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GBuffer.hlsl"

Texture2D<float>  _DepthTexture;
Texture2D<float4> _GBuffer1;
Texture2DArray<float> _CSMShadowAtlas;
RWTexture2D<float> _DirectionalShadowTexture;
Texture2D<float> _CSMShadowFilterSource;
RWTexture2D<float> _CSMShadowFilterTexture;
RWStructuredBuffer<uint> _CSMShadowTileList;
RWStructuredBuffer<uint> _CSMShadowDispatchIndirectArgs;
SamplerComparisonState sampler_CSMShadowAtlas;

float4x4 _CSMViewProjMatrices[4];
float4   _CSMCascadeSpheres[4];
int      _CSMCascadeCount;
float    _CSMMaxShadowDistance;
float    _CSMNormalBias;
float4x4 _CSMInvViewProjMatrix;
int      _CSMOutputWidth;
int      _CSMOutputHeight;
float3   _CSMLightDirectionWS;
int      _CSMCascadeResolution;
float4   _CSMCascadeWorldTexelSizes;
float4   _CSMCascadeBorders;
int      _CSMShadowQuality;
float    _CSMLightAngularDiameter;
int      _CSMFrameIndex;
int      _CSMPCSSBlockerSampleCount;
int      _CSMPCSSFilterSampleCount;
float    _CSMPCSSMaxPenumbraSize;
float    _CSMPCSSMaxSamplingDistance;
float    _CSMPCSSMinFilterSizeTexels;
float    _CSMPCSSMinFilterMaxAngularDiameter;
float    _CSMPCSSBlockerSearchAngularDiameter;
float    _CSMPCSSBlockerSamplingClumpExponent;
float4   _CSMBendLightCoordinate;
float4   _CSMBendWaveOffset;
float4   _CSMBendDepthTextureSize;
float    _CSMBendSurfaceThickness;
float    _CSMBendBilinearThreshold;
float    _CSMBendShadowContrast;
int      _CSMBendIgnoreEdgePixels;
int      _CSMBendUsePrecisionOffset;
int      _CSMBendBilinearSamplingOffsetMode;

static const int kCSMShadowQualityLow = 0;
static const int kCSMShadowQualityMedium = 1;
static const int kCSMShadowQualityHigh = 2;
static const int kCSMShadowQualityVeryHigh = 3;
static const int kCSMShadowQualityUnreal = 4;
static const int kPCSSMaxSampleCount = 64;
static const float kPCSSGoldenAngle = 2.39996323;
static const float kPCSSTwoPi = 6.28318531;
static const float kDegreesToRadians = 0.01745329251;
static const float kFixedUniformDepthBias = 1.0 / 65536.0;
bool IsSkyPixel(float deviceDepth)
{
    return deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
}

#if defined(VIVID_BEND_ENABLED)
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/Shadows/VividBendScreenSpaceShadow.hlsl"

DispatchParameters SetupCSMBendDispatchParameters()
{
    DispatchParameters parameters;
    parameters.SurfaceThickness = _CSMBendSurfaceThickness;
    parameters.BilinearThreshold = _CSMBendBilinearThreshold;
    parameters.ShadowContrast = _CSMBendShadowContrast;
    parameters.IgnoreEdgePixels = _CSMBendIgnoreEdgePixels != 0;
    parameters.UsePrecisionOffset = _CSMBendUsePrecisionOffset != 0;
    parameters.BilinearSamplingOffsetMode = _CSMBendBilinearSamplingOffsetMode != 0;
    parameters.DebugOutputEdgeMask = false;
    parameters.DebugOutputThreadIndex = false;
    parameters.DebugOutputWaveIndex = false;
    parameters.DepthBounds = float2(0.0, 1.0);
    parameters.UseEarlyOut = false;
    parameters.LightCoordinate = _CSMBendLightCoordinate;
    parameters.WaveOffset = (int2)_CSMBendWaveOffset.xy;
    parameters.FarDepthValue = UNITY_RAW_FAR_CLIP_VALUE;
    parameters.NearDepthValue = UNITY_NEAR_CLIP_VALUE;
    parameters.InvDepthTextureSize = _CSMBendDepthTextureSize.xy;
    return parameters;
}

bool IsCSMBendOutputPixelValid(int2 pixelCoord)
{
    return all(pixelCoord >= int2(0, 0))
        && pixelCoord.x < _CSMOutputWidth
        && pixelCoord.y < _CSMOutputHeight;
}

void CSMShadowBendCompositeCommon(uint3 groupID, uint3 groupThreadID)
{
    DispatchParameters parameters = SetupCSMBendDispatchParameters();

    float bendShadow;
    int2 pixelCoord;
    float2 hitUV;
    WriteScreenSpaceShadow(
        parameters,
        (int3)groupID,
        groupThreadID.x,
        bendShadow,
        pixelCoord,
        hitUV);

    if (!IsCSMBendOutputPixelValid(pixelCoord))
        return;

    uint2 outputCoord = (uint2)pixelCoord;
    float csmShadow = _DirectionalShadowTexture[outputCoord];
    _DirectionalShadowTexture[outputCoord] = saturate(csmShadow) * saturate(bendShadow);
}

[numthreads(64, 1, 1)]
void CSMShadowBendCompositeLow(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    CSMShadowBendCompositeCommon(groupID, groupThreadID);
}

[numthreads(64, 1, 1)]
void CSMShadowBendCompositeMedium(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    CSMShadowBendCompositeCommon(groupID, groupThreadID);
}

[numthreads(64, 1, 1)]
void CSMShadowBendCompositeHigh(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    CSMShadowBendCompositeCommon(groupID, groupThreadID);
}

[numthreads(64, 1, 1)]
void CSMShadowBendCompositeVeryHigh(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    CSMShadowBendCompositeCommon(groupID, groupThreadID);
}
#endif

float3 ReconstructWorldPosition(uint2 pixelCoord, float deviceDepth)
{
    float2 uv = (float2(pixelCoord) + 0.5) / float2(_CSMOutputWidth, _CSMOutputHeight);
    return ComputeWorldSpacePosition(uv, deviceDepth, _CSMInvViewProjMatrix);
}

int SelectCascade(float3 positionWS, out float distFromSphere)
{
    distFromSphere = 1.0;
    for (int i = 0; i < _CSMCascadeCount; i++)
    {
        float4 sphere = _CSMCascadeSpheres[i];
        float3 delta = positionWS - sphere.xyz;
        float distSq = dot(delta, delta);
        if (distSq < sphere.w) // sphere.w = radiusSq
        {
            distFromSphere = distSq / sphere.w;
            return i;
        }
    }
    return -1;
}

float3 TransformWorldToShadowCoord(float3 positionWS, int cascadeIndex)
{
    return mul(_CSMViewProjMatrices[cascadeIndex], float4(positionWS, 1.0)).xyz;
}

float GetCascadeWorldTexelSize(int cascadeIndex)
{
    return max(_CSMCascadeWorldTexelSizes[cascadeIndex], 0.0);
}

float GetCascadeDepthToWorldScale(int cascadeIndex)
{
    float3 lightDirectionWS = dot(_CSMLightDirectionWS, _CSMLightDirectionWS) > 0.0
        ? normalize(_CSMLightDirectionWS)
        : float3(0.0, -1.0, 0.0);
    float4x4 worldToShadow = _CSMViewProjMatrices[cascadeIndex];
    float shadowDepthPerWorldUnit = abs(mul(worldToShadow, float4(lightDirectionWS, 0.0)).z);
    return shadowDepthPerWorldUnit > 1e-5 ? rcp(shadowDepthPerWorldUnit) : 0.0;
}

float GetReceiverDistanceToLight(float receiverDepth, float depthToWorldScale)
{
#if UNITY_REVERSED_Z
    return max((1.0 - receiverDepth) * depthToWorldScale, 0.0);
#else
    return max(receiverDepth * depthToWorldScale, 0.0);
#endif
}

float GetShadowDepthOffsetDirection()
{
#if UNITY_REVERSED_Z
    return 1.0;
#else
    return -1.0;
#endif
}

float ApplyShadowComparisonDepthBias(float shadowDepth)
{
    return shadowDepth + kFixedUniformDepthBias;
}

bool IsShadowMapDepthCloser(float sampleDepth, float compareDepth)
{
#if UNITY_REVERSED_Z
    return sampleDepth > compareDepth;
#else
    return sampleDepth < compareDepth;
#endif
}

void GetCascadeShadowMapBounds(out float2 cascadeMinUV, out float2 cascadeMaxUV, out float2 texelSize)
{
    texelSize = 1.0 / max((float)_CSMCascadeResolution, 1.0);
    cascadeMinUV = texelSize * 0.5;
    cascadeMaxUV = 1.0 - cascadeMinUV;
}

float2 ClampShadowMapUV(float2 shadowUV)
{
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);
    return clamp(shadowUV, cascadeMinUV, cascadeMaxUV);
}

bool IsWithinCascadeShadowMapBounds(float2 shadowUV)
{
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);
    return all(shadowUV >= cascadeMinUV) && all(shadowUV <= cascadeMaxUV);
}

int2 ShadowUVToTexelCoord(float2 shadowUV)
{
    return int2(saturate(shadowUV) * (_CSMCascadeResolution - 1));
}

float SampleCSMShadowMap(float2 shadowUV, float depth, int cascadeIndex)
{
    return _CSMShadowAtlas.SampleCmpLevelZero(
        sampler_CSMShadowAtlas,
        float3(shadowUV, cascadeIndex),
        depth);
}

float SampleShadowPCFKernel(float2 shadowUV, float depth, int cascadeIndex, int kernelRadius)
{
    float shadow = 0.0;
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);
    int kernelWidth = kernelRadius * 2 + 1;

    [loop]
    for (int y = -kernelRadius; y <= kernelRadius; y++)
    {
        [loop]
        for (int x = -kernelRadius; x <= kernelRadius; x++)
        {
            float2 sampleUV = clamp(shadowUV + float2(x, y) * texelSize, cascadeMinUV, cascadeMaxUV);
            shadow += SampleCSMShadowMap(sampleUV, depth, cascadeIndex);
        }
    }

    return shadow / (kernelWidth * kernelWidth);
}

// Optimized tent-filter PCF: places bilinear taps between texels so hardware
// comparison filtering produces smooth gradients instead of hard 0/1 per tap.

float SampleShadowPCF3x3(float2 shadowUV, float depth, int cascadeIndex)
{
    float2 cascadeMinUV, cascadeMaxUV, texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);

    float2 texCoord = shadowUV / texelSize + 0.5;
    float2 texCoordFloor = floor(texCoord);
    float2 s = texCoord - texCoordFloor;
    float2 base = (texCoordFloor - 0.5) * texelSize;

    float uw0 = 3.0 - 2.0 * s.x;
    float uw1 = 1.0 + 2.0 * s.x;
    float vw0 = 3.0 - 2.0 * s.y;
    float vw1 = 1.0 + 2.0 * s.y;

    float u0 = (2.0 - s.x) / uw0 - 1.0;
    float u1 = s.x / uw1 + 1.0;
    float v0 = (2.0 - s.y) / vw0 - 1.0;
    float v1 = s.y / vw1 + 1.0;

    float shadow = 0.0;
    shadow += uw0 * vw0 * SampleCSMShadowMap(clamp(base + float2(u0, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw0 * SampleCSMShadowMap(clamp(base + float2(u1, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw0 * vw1 * SampleCSMShadowMap(clamp(base + float2(u0, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw1 * SampleCSMShadowMap(clamp(base + float2(u1, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);

    return shadow / 16.0;
}

float SampleShadowPCF5x5(float2 shadowUV, float depth, int cascadeIndex)
{
    float2 cascadeMinUV, cascadeMaxUV, texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);

    float2 texCoord = shadowUV / texelSize + 0.5;
    float2 texCoordFloor = floor(texCoord);
    float2 s = texCoord - texCoordFloor;
    float2 base = (texCoordFloor - 0.5) * texelSize;

    float uw0 = 4.0 - 3.0 * s.x;
    float uw1 = 7.0;
    float uw2 = 1.0 + 3.0 * s.x;
    float vw0 = 4.0 - 3.0 * s.y;
    float vw1 = 7.0;
    float vw2 = 1.0 + 3.0 * s.y;

    float u0 = (3.0 - 2.0 * s.x) / uw0 - 2.0;
    float u1 = (3.0 + s.x) / uw1;
    float u2 = s.x / uw2 + 2.0;
    float v0 = (3.0 - 2.0 * s.y) / vw0 - 2.0;
    float v1 = (3.0 + s.y) / vw1;
    float v2 = s.y / vw2 + 2.0;

    float shadow = 0.0;
    shadow += uw0 * vw0 * SampleCSMShadowMap(clamp(base + float2(u0, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw0 * SampleCSMShadowMap(clamp(base + float2(u1, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw2 * vw0 * SampleCSMShadowMap(clamp(base + float2(u2, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw0 * vw1 * SampleCSMShadowMap(clamp(base + float2(u0, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw1 * SampleCSMShadowMap(clamp(base + float2(u1, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw2 * vw1 * SampleCSMShadowMap(clamp(base + float2(u2, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw0 * vw2 * SampleCSMShadowMap(clamp(base + float2(u0, v2) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw2 * SampleCSMShadowMap(clamp(base + float2(u1, v2) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw2 * vw2 * SampleCSMShadowMap(clamp(base + float2(u2, v2) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);

    return shadow / 144.0;
}

float SampleShadowPCF7x7(float2 shadowUV, float depth, int cascadeIndex)
{
    float2 cascadeMinUV, cascadeMaxUV, texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);

    // 7x7 box filter using 4x4 bilinear taps placed between texels.
    // Each tap covers a 2x2 area, 4x4 taps cover the 8x8 neighborhood.
    float shadow = 0.0;

    [unroll]
    for (int j = 0; j < 4; j++)
    {
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            float2 offset = float2(i * 2.0 - 3.0, j * 2.0 - 3.0) * texelSize;
            float2 sampleUV = clamp(shadowUV + offset, cascadeMinUV, cascadeMaxUV);
            shadow += SampleCSMShadowMap(sampleUV, depth, cascadeIndex);
        }
    }

    return shadow / 16.0;
}


float GetCascadeBorder(int cascadeIndex)
{
    return cascadeIndex >= 0 && cascadeIndex < _CSMCascadeCount ? max(_CSMCascadeBorders[cascadeIndex], 0.0) : 0.0;
}

float ComputeCascadeBlendAlpha(float3 positionWS, int cascadeIndex, float relDistance)
{
    float border = GetCascadeBorder(cascadeIndex);
    if (border <= 0.0)
        return 0.0;

    return saturate((relDistance - (1.0 - border)) / border);
}

int GetPCSSBlockerSampleCount()
{
    return clamp(_CSMPCSSBlockerSampleCount, 1, kPCSSMaxSampleCount);
}

int GetPCSSFilterSampleCount()
{
    return clamp(_CSMPCSSFilterSampleCount, 1, kPCSSMaxSampleCount);
}

float GetPCSSBlockerClumpExponent()
{
    // Match HDRP's user-facing remap where 1..6 maps to an effective 0.5..3.0 range.
    return max(0.5 * _CSMPCSSBlockerSamplingClumpExponent, 0.5);
}

float2 SampleVogelDiskClumped(int sampleIndex, int sampleCount, float angleOffset, float clumpExponent, out float sampleDistNorm)
{
    float sampleCountInverse = rcp((float)sampleCount);
    sampleDistNorm = PositivePow((float)sampleIndex * sampleCountInverse, clumpExponent);
    float angle = sampleIndex * kPCSSGoldenAngle + angleOffset;
    return sampleDistNorm * float2(cos(angle), sin(angle));
}

float2 SampleVogelDiskUniform(int sampleIndex, int sampleCount, float angleOffset, out float sampleDistNorm)
{
    float sampleCountInverse = rcp((float)sampleCount);
    float sampleBias = 0.5 * sampleCountInverse;
    sampleDistNorm = sqrt((float)sampleIndex * sampleCountInverse + sampleBias);
    float angle = sampleIndex * kPCSSGoldenAngle + angleOffset;
    return sampleDistNorm * float2(cos(angle), sin(angle));
}

bool FindAverageBlockerDepth(
    out float averageBlockerDepth,
    float2 shadowUV,
    float receiverDepth,
    int cascadeIndex,
    float blockerSearchRadiusWorld,
    float worldTexelSize,
    float blockerRadial2DepthScale,
    float minFilterRadiusWorld,
    float minFilterRadial2DepthScale,
    float rotationAngle)
{
    averageBlockerDepth = UNITY_RAW_FAR_CLIP_VALUE;

    float blockerDepthSum = 0.0;
    float blockerCount = 0.0;
    float depthOffsetDirection = GetShadowDepthOffsetDirection();
    float blockerSearchRadiusTexels = blockerSearchRadiusWorld / max(worldTexelSize, 1e-6);
    float2 texelSize = 1.0 / max((float)_CSMCascadeResolution, 1.0);
    int blockerSampleCount = GetPCSSBlockerSampleCount();
    float blockerClumpExponent = GetPCSSBlockerClumpExponent();

    [loop]
    for (int sampleIndex = 0; sampleIndex < blockerSampleCount; sampleIndex++)
    {
        float sampleDistNorm;
        float2 diskSample = SampleVogelDiskClumped(
            sampleIndex,
            blockerSampleCount,
            rotationAngle,
            blockerClumpExponent,
            sampleDistNorm);
        float2 sampleUV = shadowUV + diskSample * (blockerSearchRadiusTexels * texelSize);
        if (!IsWithinCascadeShadowMapBounds(sampleUV))
            continue;

        float radialOffsetWorld = blockerSearchRadiusWorld * sampleDistNorm;
        float radial2DepthScale = radialOffsetWorld < minFilterRadiusWorld
            ? minFilterRadial2DepthScale
            : blockerRadial2DepthScale;
        float coordz = receiverDepth + depthOffsetDirection * (radialOffsetWorld * radial2DepthScale);
        float sampleDepth = _CSMShadowAtlas.Load(
            int4(ShadowUVToTexelCoord(sampleUV), cascadeIndex, 0));

        if (IsShadowMapDepthCloser(sampleDepth, coordz))
        {
            blockerDepthSum += sampleDepth;
            blockerCount += 1.0;
        }
    }

    if (blockerCount > 0.0)
    {
        averageBlockerDepth = blockerDepthSum / blockerCount;
        return true;
    }

    return false;
}

float SampleShadowPCSS(float2 shadowUV, float receiverDepth, int cascadeIndex, uint2 pixelCoord)
{
    float halfLightAngularDiameterTangent = tan(0.5 * max(_CSMLightAngularDiameter, 0.0) * kDegreesToRadians);
    if (halfLightAngularDiameterTangent <= 1e-5)
        return SampleShadowPCF7x7(shadowUV, receiverDepth, cascadeIndex);

    float worldTexelSize = GetCascadeWorldTexelSize(cascadeIndex);
    float depthToWorldScale = GetCascadeDepthToWorldScale(cascadeIndex);
    if (worldTexelSize <= 1e-6 || depthToWorldScale <= 1e-5)
        return SampleShadowPCF7x7(shadowUV, receiverDepth, cascadeIndex);

    float blockerSearchAngularDiameter = max(_CSMPCSSBlockerSearchAngularDiameter, _CSMLightAngularDiameter);
    float halfBlockerSearchAngularDiameterTangent = tan(0.5 * blockerSearchAngularDiameter * kDegreesToRadians);
    float minFilterAngularDiameter = max(blockerSearchAngularDiameter, _CSMPCSSMinFilterMaxAngularDiameter);
    float halfMinFilterAngularDiameterTangent = tan(0.5 * max(minFilterAngularDiameter, _CSMLightAngularDiameter) * kDegreesToRadians);
    float minFilterRadiusWorld = _CSMPCSSMinFilterSizeTexels * worldTexelSize;
    float maxPenumbraRadiusWorld = max(0.5 * _CSMPCSSMaxPenumbraSize, 0.0);
    float maxBlockerDistanceWorld = maxPenumbraRadiusWorld / max(halfLightAngularDiameterTangent, 1e-5);
    float blockerRadial2DepthScale = 1.0 / max(halfBlockerSearchAngularDiameterTangent * depthToWorldScale, 1e-5);
    float minFilterRadial2DepthScale = 1.0 / max(halfMinFilterAngularDiameterTangent * depthToWorldScale, 1e-5);
    float receiverDistanceWorld = min(GetReceiverDistanceToLight(receiverDepth, depthToWorldScale), maxBlockerDistanceWorld);
    float blockerSearchRadiusWorld = max(receiverDistanceWorld * halfLightAngularDiameterTangent, minFilterRadiusWorld);
    float noise = InterleavedGradientNoise(float2(pixelCoord) + 0.5, _CSMFrameIndex);
    float rotationAngle = noise * kPCSSTwoPi;
    float averageBlockerDepth;
    bool blockerFound = FindAverageBlockerDepth(
        averageBlockerDepth,
        shadowUV,
        receiverDepth,
        cascadeIndex,
        blockerSearchRadiusWorld,
        worldTexelSize,
        blockerRadial2DepthScale,
        minFilterRadiusWorld,
        minFilterRadial2DepthScale,
        rotationAngle);

    if (!blockerFound)
        return 1.0;

    float blockerDistanceWorld = min(abs(averageBlockerDepth - receiverDepth) * depthToWorldScale * 0.9, maxBlockerDistanceWorld);
    float filterRadiusWorld = min(blockerDistanceWorld * halfLightAngularDiameterTangent, maxPenumbraRadiusWorld);
    float samplingFilterRadiusWorld = max(filterRadiusWorld, minFilterRadiusWorld);
    float filterRadiusTexels = samplingFilterRadiusWorld / worldTexelSize;
    float maxPCSSOffsetShadow = min(_CSMPCSSMaxSamplingDistance, blockerDistanceWorld * 0.25) / depthToWorldScale;
    float2 texelSize = 1.0 / max((float)_CSMCascadeResolution, 1.0);
    float depthOffsetDirection = GetShadowDepthOffsetDirection();
    float shadow = 0.0;
    float validSampleCount = 0.0;
    int filterSampleCount = GetPCSSFilterSampleCount();

    [loop]
    for (int sampleIndex = 0; sampleIndex < filterSampleCount; sampleIndex++)
    {
        float sampleDistNorm;
        float2 diskSample = SampleVogelDiskUniform(sampleIndex, filterSampleCount, rotationAngle, sampleDistNorm);
        float2 sampleUV = shadowUV + diskSample * (filterRadiusTexels * texelSize);
        if (!IsWithinCascadeShadowMapBounds(sampleUV))
            continue;

        float zOffset = filterRadiusWorld * sampleDistNorm * minFilterRadial2DepthScale;
        float coordz = receiverDepth + depthOffsetDirection * min(zOffset, maxPCSSOffsetShadow);
        shadow += SampleCSMShadowMap(sampleUV, coordz, cascadeIndex);
        validSampleCount += 1.0;
    }

    return validSampleCount > 0.0 ? shadow / validSampleCount : 1.0;
}

float EvaluateShadow(float2 shadowUV, float receiverDepth, int cascadeIndex, uint2 pixelCoord)
{
    switch (_CSMShadowQuality)
    {
        case kCSMShadowQualityLow:
            return SampleShadowPCF3x3(shadowUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityMedium:
            return SampleShadowPCF5x5(shadowUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityHigh:
            return SampleShadowPCF7x7(shadowUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityVeryHigh:
            return SampleShadowPCSS(shadowUV, receiverDepth, cascadeIndex, pixelCoord);
        case kCSMShadowQualityUnreal:
            return SampleShadowPCF7x7(shadowUV, receiverDepth, cascadeIndex);
        default:
            return SampleShadowPCF5x5(shadowUV, receiverDepth, cascadeIndex);
    }
}

float3 ClampShadowCoordToShadowMap(float3 shadowCoord)
{
    shadowCoord.xy = saturate(shadowCoord.xy);
    return shadowCoord;
}

bool IsWithinCascadeBlendSamplingBounds(float3 shadowCoord)
{
    float halfTexel = 0.5 / max((float)_CSMCascadeResolution, 1.0);
    return all(shadowCoord.xy >= halfTexel) && all(shadowCoord.xy <= (1.0 - halfTexel));
}

bool TryGetBiasedShadowCoord(float3 positionWS, float3 normalWS, int cascadeIndex, out float3 shadowCoord)
{
    shadowCoord = 0.0;

    if (cascadeIndex < 0 || cascadeIndex >= _CSMCascadeCount)
        return false;

    float receiverNormalBias = _CSMNormalBias * GetCascadeWorldTexelSize(cascadeIndex);
    float3 biasedPositionWS = positionWS + normalWS * receiverNormalBias;
    shadowCoord = TransformWorldToShadowCoord(biasedPositionWS, cascadeIndex);
    return true;
}

float2 ComputeShadowUVJitter(uint2 pixelCoord, int cascadeIndex)
{
    float noise = InterleavedGradientNoise(float2(pixelCoord) + 0.5, _CSMFrameIndex);
    float angle = noise * kPCSSTwoPi;
    float texelSize = 1.0 / max((float)_CSMCascadeResolution, 1.0);
    return float2(cos(angle), sin(angle)) * (texelSize * 0.5);
}

bool TryEvaluateCascadeShadow(float3 positionWS, float3 normalWS, int cascadeIndex, uint2 pixelCoord, out float shadow)
{
    shadow = 1.0;

    float3 shadowCoord;
    if (!TryGetBiasedShadowCoord(positionWS, normalWS, cascadeIndex, shadowCoord))
        return false;

    shadowCoord = ClampShadowCoordToShadowMap(shadowCoord);
    shadowCoord.z = ApplyShadowComparisonDepthBias(shadowCoord.z);
    float2 shadowUV = shadowCoord.xy + ComputeShadowUVJitter(pixelCoord, cascadeIndex);
    shadowUV = ClampShadowMapUV(shadowUV);
    shadow = EvaluateShadow(shadowUV, shadowCoord.z, cascadeIndex, pixelCoord);
    return true;
}

bool TryEvaluateCascadeBlendShadow(float3 positionWS, float3 normalWS, int cascadeIndex, uint2 pixelCoord, out float shadow)
{
    shadow = 1.0;
    float3 shadowCoord;
    if (!TryGetBiasedShadowCoord(positionWS, normalWS, cascadeIndex, shadowCoord))
        return false;

    if (!IsWithinCascadeBlendSamplingBounds(shadowCoord))
        return false;

    shadowCoord = ClampShadowCoordToShadowMap(shadowCoord);
    shadowCoord.z = ApplyShadowComparisonDepthBias(shadowCoord.z);
    float2 shadowUV = shadowCoord.xy + ComputeShadowUVJitter(pixelCoord, cascadeIndex);
    shadowUV = ClampShadowMapUV(shadowUV);
    shadow = EvaluateShadow(shadowUV, shadowCoord.z, cascadeIndex, pixelCoord);
    return true;
}

float ApplyCSMShadowDistanceFade(float3 positionWS, float shadow)
{
    float distanceFade = 1.0;
    float3 cameraToPixel = positionWS - _WorldSpaceCameraPos;
    float pixelDistance = length(cameraToPixel);
    float fadeStart = _CSMMaxShadowDistance * 0.8;
    if (pixelDistance > fadeStart)
    {
        float fadeRange = max(_CSMMaxShadowDistance - fadeStart, 1.0e-5);
        distanceFade = 1.0 - saturate((pixelDistance - fadeStart) / fadeRange);
    }

    return lerp(1.0, shadow, distanceFade);
}

static const uint kCSMShadowTileSize = 16;
static const uint kCSMShadowTileSubGroupSize = 8;
static const uint kCSMShadowClassifyThreads = 64;
static const float kCSMShadowPenumbraSentinel = 0.5;
static const float kCSMShadowClassifyEpsilon = 1.0e-4;

uint EncodeCSMShadowTileIndex(uint2 tileCoord)
{
    return (tileCoord.y << 16) | (tileCoord.x & 0xffffu);
}

uint2 DecodeCSMShadowTileIndex(uint encodedTileIndex)
{
    return uint2(encodedTileIndex & 0xffffu, encodedTileIndex >> 16);
}

bool TryBuildCSMShadowInputs(
    uint2 pixelCoord,
    out float deviceDepth,
    out float3 positionWS,
    out float3 normalWS,
    out int cascadeIndex,
    out float relDistance)
{
    deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));
    positionWS = 0.0;
    normalWS = float3(0.0, 1.0, 0.0);
    cascadeIndex = -1;
    relDistance = 1.0;

    if (IsSkyPixel(deviceDepth))
        return false;

    positionWS = ReconstructWorldPosition(pixelCoord, deviceDepth);
    cascadeIndex = SelectCascade(positionWS, relDistance);
    if (cascadeIndex < 0)
        return false;

    float4 gbuffer1 = _GBuffer1.Load(int3(pixelCoord, 0));
    normalWS = DecodeVividNormalOct(gbuffer1.xy);
    return true;
}

float ResolveCSMShadowForPixel(uint2 pixelCoord)
{
    float deviceDepth;
    float3 positionWS;
    float3 normalWS;
    int cascadeIndex;
    float relDistance;
    if (!TryBuildCSMShadowInputs(pixelCoord, deviceDepth, positionWS, normalWS, cascadeIndex, relDistance))
        return 1.0;

    float shadowCurrent;
    if (!TryEvaluateCascadeShadow(positionWS, normalWS, cascadeIndex, pixelCoord, shadowCurrent))
        return 1.0;

    float shadow = shadowCurrent;
    float cascadeBlendAlpha = ComputeCascadeBlendAlpha(positionWS, cascadeIndex, relDistance);
    if (cascadeBlendAlpha > 0.0)
    {
        float shadowNext = 1.0;
        int nextCascadeIndex = cascadeIndex + 1;
        if (nextCascadeIndex < _CSMCascadeCount)
        {
            shadowNext = shadowCurrent;
            float nextCascadeShadow;
            if (TryEvaluateCascadeBlendShadow(positionWS, normalWS, nextCascadeIndex, pixelCoord, nextCascadeShadow))
                shadowNext = nextCascadeShadow;
        }

        shadow = lerp(shadowCurrent, shadowNext, cascadeBlendAlpha);
    }

    return ApplyCSMShadowDistanceFade(positionWS, shadow);
}

bool IsCSMShadowPenumbraClass(float prefilteredShadow)
{
    return prefilteredShadow > kCSMShadowClassifyEpsilon
        && prefilteredShadow < 1.0 - kCSMShadowClassifyEpsilon;
}

float QuantizeCSMShadowClass(float prefilteredShadow)
{
    return prefilteredShadow <= kCSMShadowClassifyEpsilon ? 0.0 : 1.0;
}

bool TryClassifyCascadeShadow(
    float3 positionWS,
    float3 normalWS,
    int cascadeIndex,
    uint2 pixelCoord,
    bool requireBlendSamplingBounds,
    out float prefilteredShadow)
{
    prefilteredShadow = 1.0;
    float3 shadowCoord;
    if (!TryGetBiasedShadowCoord(positionWS, normalWS, cascadeIndex, shadowCoord))
        return false;

    if (requireBlendSamplingBounds && !IsWithinCascadeBlendSamplingBounds(shadowCoord))
        return false;

    shadowCoord = ClampShadowCoordToShadowMap(shadowCoord);
    shadowCoord.z = ApplyShadowComparisonDepthBias(shadowCoord.z);
    float2 shadowUV = shadowCoord.xy + ComputeShadowUVJitter(pixelCoord, cascadeIndex);
    shadowUV = ClampShadowMapUV(shadowUV);

    prefilteredShadow = SampleShadowPCF3x3(shadowUV, shadowCoord.z, cascadeIndex);
    return true;
}

float ClassifyCSMShadowForPixel(uint2 pixelCoord, out bool needsResolve)
{
    needsResolve = false;

    float deviceDepth;
    float3 positionWS;
    float3 normalWS;
    int cascadeIndex;
    float relDistance;
    if (!TryBuildCSMShadowInputs(pixelCoord, deviceDepth, positionWS, normalWS, cascadeIndex, relDistance))
        return 1.0;

    float shadowCurrent;
    if (!TryClassifyCascadeShadow(positionWS, normalWS, cascadeIndex, pixelCoord, false, shadowCurrent))
        return 1.0;

    needsResolve = IsCSMShadowPenumbraClass(shadowCurrent);
    float shadow = QuantizeCSMShadowClass(shadowCurrent);
    float cascadeBlendAlpha = ComputeCascadeBlendAlpha(positionWS, cascadeIndex, relDistance);
    if (cascadeBlendAlpha > 0.0)
    {
        float shadowNext = shadow;
        int nextCascadeIndex = cascadeIndex + 1;
        if (nextCascadeIndex < _CSMCascadeCount)
        {
            float nextCascadeShadow;
            if (TryClassifyCascadeShadow(positionWS, normalWS, nextCascadeIndex, pixelCoord, true, nextCascadeShadow))
            {
                needsResolve = needsResolve || IsCSMShadowPenumbraClass(nextCascadeShadow);
                shadowNext = QuantizeCSMShadowClass(nextCascadeShadow);
            }
        }

        shadow = lerp(shadow, shadowNext, cascadeBlendAlpha);
    }

    return needsResolve
        ? kCSMShadowPenumbraSentinel
        : ApplyCSMShadowDistanceFade(positionWS, shadow);
}

groupshared uint g_CSMShadowTileNeedsResolve;

[numthreads(1, 1, 1)]
void CSMShadowClearTiles(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    _CSMShadowDispatchIndirectArgs[0] = 0u;
    _CSMShadowDispatchIndirectArgs[1] = 1u;
    _CSMShadowDispatchIndirectArgs[2] = 1u;
    _CSMShadowTileList[0] = 0u;
}

[numthreads(64, 1, 1)]
void CSMShadowClassifyTiles(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex,
    uint3 groupID : SV_GroupID)
{
    if (groupIndex == 0)
        g_CSMShadowTileNeedsResolve = 0u;

    GroupMemoryBarrierWithGroupSync();

    uint2 tileCoord = groupID.xy;
    uint2 tileOrigin = tileCoord * kCSMShadowTileSize;

    [unroll]
    for (uint i = 0; i < 4u; i++)
    {
        uint pixelIndex = i * kCSMShadowClassifyThreads + groupIndex;
        uint2 localCoord = uint2(pixelIndex & 15u, pixelIndex >> 4);
        uint2 pixelCoord = tileOrigin + localCoord;
        if (pixelCoord.x >= (uint)_CSMOutputWidth || pixelCoord.y >= (uint)_CSMOutputHeight)
            continue;

        bool needsResolve;
        float classifiedShadow = ClassifyCSMShadowForPixel(pixelCoord, needsResolve);
        _DirectionalShadowTexture[pixelCoord] = classifiedShadow;

        if (needsResolve)
            InterlockedOr(g_CSMShadowTileNeedsResolve, 1u);
    }

    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0 && g_CSMShadowTileNeedsResolve != 0u)
    {
        uint previousGroupCount;
        InterlockedAdd(_CSMShadowDispatchIndirectArgs[0], 4u, previousGroupCount);
        _CSMShadowTileList[previousGroupCount / 4u] = EncodeCSMShadowTileIndex(tileCoord);
    }
}

void InitializeCSMShadowDispatchThreadIdFromTileList(
    uint groupIndex,
    uint2 groupThreadId,
    out uint2 pixelCoord)
{
    uint encodedTileIndex = _CSMShadowTileList[groupIndex / 4u];
    uint2 tileCoord = DecodeCSMShadowTileIndex(encodedTileIndex);
    pixelCoord = tileCoord * kCSMShadowTileSize
        + uint2(groupIndex & 1u, (groupIndex >> 1) & 1u) * kCSMShadowTileSubGroupSize
        + groupThreadId;
}

[numthreads(8, 8, 1)]
void CSMShadowResolveTiles(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint2 groupThreadId : SV_GroupThreadID,
    uint3 groupID : SV_GroupID)
{
    uint2 pixelCoord;
    InitializeCSMShadowDispatchThreadIdFromTileList(groupID.x, groupThreadId, pixelCoord);
    if (pixelCoord.x >= (uint)_CSMOutputWidth || pixelCoord.y >= (uint)_CSMOutputHeight)
        return;

    float classifiedShadow = _DirectionalShadowTexture[pixelCoord];
    if (abs(classifiedShadow - kCSMShadowPenumbraSentinel) > kCSMShadowClassifyEpsilon)
        return;

    _DirectionalShadowTexture[pixelCoord] = ResolveCSMShadowForPixel(pixelCoord);
}

float ComputeCSMShadowBilateralWeight(float centerDepth, float3 centerNormal, uint2 sampleCoord)
{
    float sampleDepth = _DepthTexture.Load(int3(sampleCoord, 0));
    if (IsSkyPixel(sampleDepth))
        return 0.0;

    float3 sampleNormal = DecodeVividNormalOct(_GBuffer1.Load(int3(sampleCoord, 0)).xy);
    float centerLinearDepth = LinearEyeDepth(centerDepth, _ZBufferParams);
    float sampleLinearDepth = LinearEyeDepth(sampleDepth, _ZBufferParams);
    float depthWeight = exp(-abs(centerLinearDepth - sampleLinearDepth) * 4.0);
    float normalWeight = pow(saturate(dot(centerNormal, sampleNormal)), 32.0);
    return depthWeight * normalWeight;
}

float FilterCSMShadow(uint2 pixelCoord, int2 axis)
{
    static const float gaussianWeight[9] =
    {
        0.02763055, 0.06628224, 0.1238315, 0.1801738, 0.2041637,
        0.1801738, 0.1238315, 0.06628224, 0.02763055
    };

    float centerDepth = _DepthTexture.Load(int3(pixelCoord, 0));
    if (IsSkyPixel(centerDepth))
        return _CSMShadowFilterSource.Load(int3(pixelCoord, 0));

    float3 centerNormal = DecodeVividNormalOct(_GBuffer1.Load(int3(pixelCoord, 0)).xy);
    float colorSum = _CSMShadowFilterSource.Load(int3(pixelCoord, 0)) * gaussianWeight[4];
    float weightSum = gaussianWeight[4];

    [unroll]
    for (int i = -4; i <= 4; i++)
    {
        if (i == 0)
            continue;

        int2 sampleCoordInt = int2(pixelCoord) + axis * i;
        sampleCoordInt = clamp(sampleCoordInt, int2(0, 0), int2(_CSMOutputWidth - 1, _CSMOutputHeight - 1));
        uint2 sampleCoord = uint2(sampleCoordInt);
        float bilateralWeight = ComputeCSMShadowBilateralWeight(centerDepth, centerNormal, sampleCoord);
        float weight = gaussianWeight[i + 4] * bilateralWeight;
        colorSum += _CSMShadowFilterSource.Load(int3(sampleCoord, 0)) * weight;
        weightSum += weight;
    }

    return colorSum / max(weightSum, 1.0e-5);
}

[numthreads(8, 8, 1)]
void CSMShadowCopyFilterSource(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x >= (uint)_CSMOutputWidth || dispatchThreadID.y >= (uint)_CSMOutputHeight)
        return;

    uint2 pixelCoord = dispatchThreadID.xy;
    _CSMShadowFilterTexture[pixelCoord] = _CSMShadowFilterSource.Load(int3(pixelCoord, 0));
}

[numthreads(8, 8, 1)]
void CSMShadowBilateralFilterH(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint2 groupThreadId : SV_GroupThreadID,
    uint3 groupID : SV_GroupID)
{
    uint2 pixelCoord;
    InitializeCSMShadowDispatchThreadIdFromTileList(groupID.x, groupThreadId, pixelCoord);
    if (pixelCoord.x >= (uint)_CSMOutputWidth || pixelCoord.y >= (uint)_CSMOutputHeight)
        return;

    _CSMShadowFilterTexture[pixelCoord] = FilterCSMShadow(pixelCoord, int2(1, 0));
}

[numthreads(8, 8, 1)]
void CSMShadowBilateralFilterV(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint2 groupThreadId : SV_GroupThreadID,
    uint3 groupID : SV_GroupID)
{
    uint2 pixelCoord;
    InitializeCSMShadowDispatchThreadIdFromTileList(groupID.x, groupThreadId, pixelCoord);
    if (pixelCoord.x >= (uint)_CSMOutputWidth || pixelCoord.y >= (uint)_CSMOutputHeight)
        return;

    _CSMShadowFilterTexture[pixelCoord] = FilterCSMShadow(pixelCoord, int2(0, 1));
}

[numthreads(8, 8, 1)]
void CSMShadowResolve(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x >= (uint)_CSMOutputWidth || dispatchThreadID.y >= (uint)_CSMOutputHeight)
        return;

    uint2 pixelCoord = dispatchThreadID.xy;
    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

    // Sky pixels are fully lit
    if (IsSkyPixel(deviceDepth))
    {
        _DirectionalShadowTexture[pixelCoord] = 1.0;
        return;
    }

    float3 positionWS = ReconstructWorldPosition(pixelCoord, deviceDepth);

    // Cascade selection
    float relDistance;
    int cascadeIndex = SelectCascade(positionWS, relDistance);

    if (cascadeIndex < 0)
    {
        // Beyond all cascades — fully lit
        _DirectionalShadowTexture[pixelCoord] = 1.0;
        return;
    }

    // Normal bias
    float4 gbuffer1 = _GBuffer1.Load(int3(pixelCoord, 0));
    float3 normalWS = DecodeVividNormalOct(gbuffer1.xy);
    float shadowCurrent;
    if (!TryEvaluateCascadeShadow(positionWS, normalWS, cascadeIndex, pixelCoord, shadowCurrent))
    {
        _DirectionalShadowTexture[pixelCoord] = 1.0;
        return;
    }
    float shadow = shadowCurrent;
    float cascadeBlendAlpha = ComputeCascadeBlendAlpha(positionWS, cascadeIndex, relDistance);
    if (cascadeBlendAlpha > 0.0)
    {
        float shadowNext = 1.0;
        int nextCascadeIndex = cascadeIndex + 1;
        if (nextCascadeIndex < _CSMCascadeCount)
        {
            shadowNext = shadowCurrent;
            float nextCascadeShadow;
            if (TryEvaluateCascadeBlendShadow(positionWS, normalWS, nextCascadeIndex, pixelCoord, nextCascadeShadow))
                shadowNext = nextCascadeShadow;
        }

        shadow = lerp(shadowCurrent, shadowNext, cascadeBlendAlpha);
    }

    // Distance fade
    float distanceFade = 1.0;
    float3 cameraToPixel = positionWS - _WorldSpaceCameraPos;
    float pixelDistance = length(cameraToPixel);
    float fadeStart = _CSMMaxShadowDistance * 0.8;
    if (pixelDistance > fadeStart)
    {
        distanceFade = 1.0 - saturate((pixelDistance - fadeStart) / (_CSMMaxShadowDistance - fadeStart));
    }

    shadow = lerp(1.0, shadow, distanceFade);

    _DirectionalShadowTexture[pixelCoord] = shadow;
}
