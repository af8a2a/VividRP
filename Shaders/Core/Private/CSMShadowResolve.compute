#pragma kernel CSMShadowResolve
#pragma enable_d3d11_debug_symbols

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/Input.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/GBuffer.hlsl"

Texture2D<float>  _DepthTexture;
Texture2D<float4> _GBuffer1;
Texture2D<float>  _CSMShadowAtlas;
RWTexture2D<float> _DirectionalShadowTexture;
SamplerComparisonState sampler_CSMShadowAtlas;

float4x4 _CSMViewProjMatrices[4];
float4   _CSMCascadeSpheres[4];
float4   _CSMAtlasScaleOffsets[4];
int      _CSMCascadeCount;
float    _CSMMaxShadowDistance;
float    _CSMDepthBias;
float    _CSMNormalBias;
float4x4 _CSMInvViewProjMatrix;
int      _CSMOutputWidth;
int      _CSMOutputHeight;
float3   _CSMLightDirectionWS;
int      _CSMAtlasResolution;
int      _CSMCascadeResolution;
float4   _CSMCascadeWorldTexelSizes;
int      _CSMShadowQuality;
float    _CSMLightAngularDiameter;
int      _CSMFrameIndex;
int      _CSMPCSSBlockerSampleCount;
int      _CSMPCSSFilterSampleCount;
float    _CSMPCSSMaxPenumbraSize;
float    _CSMPCSSMaxSamplingDistance;
float    _CSMPCSSMinFilterSizeTexels;
float    _CSMPCSSMinFilterMaxAngularDiameter;
float    _CSMPCSSBlockerSearchAngularDiameter;
float    _CSMPCSSBlockerSamplingClumpExponent;

static const int kCSMShadowQualityLow = 0;
static const int kCSMShadowQualityMedium = 1;
static const int kCSMShadowQualityHigh = 2;
static const int kCSMShadowQualityVeryHigh = 3;
static const int kPCSSMaxSampleCount = 64;
static const float kPCSSGoldenAngle = 2.39996323;
static const float kPCSSTwoPi = 6.28318531;
static const float kDegreesToRadians = 0.01745329251;
static const float kCSMDefaultCascadeBorder = 0.2;

bool IsSkyPixel(float deviceDepth)
{
    return deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
}

float3 ReconstructWorldPosition(uint2 pixelCoord, float deviceDepth)
{
    float2 uv = (float2(pixelCoord) + 0.5) / float2(_CSMOutputWidth, _CSMOutputHeight);
    return ComputeWorldSpacePosition(uv, deviceDepth, _CSMInvViewProjMatrix);
}

int SelectCascade(float3 positionWS, out float distFromSphere)
{
    distFromSphere = 1.0;
    for (int i = 0; i < _CSMCascadeCount; i++)
    {
        float4 sphere = _CSMCascadeSpheres[i];
        float3 delta = positionWS - sphere.xyz;
        float distSq = dot(delta, delta);
        if (distSq < sphere.w) // sphere.w = radiusSq
        {
            distFromSphere = distSq / sphere.w;
            return i;
        }
    }
    return -1;
}

float3 TransformWorldToShadowCoord(float3 positionWS, int cascadeIndex)
{
    return mul(_CSMViewProjMatrices[cascadeIndex], float4(positionWS, 1.0)).xyz;
}

float2 RemapToAtlasUV(float2 shadowUV, int cascadeIndex)
{
    float4 scaleOffset = _CSMAtlasScaleOffsets[cascadeIndex];
    return shadowUV * scaleOffset.xy + scaleOffset.zw;
}

float GetCascadeWorldTexelSize(int cascadeIndex)
{
    return max(_CSMCascadeWorldTexelSizes[cascadeIndex], 0.0);
}

float GetCascadeDepthToWorldScale(int cascadeIndex)
{
    float3 lightDirectionWS = dot(_CSMLightDirectionWS, _CSMLightDirectionWS) > 0.0
        ? normalize(_CSMLightDirectionWS)
        : float3(0.0, -1.0, 0.0);
    float4x4 worldToShadow = _CSMViewProjMatrices[cascadeIndex];
    float shadowDepthPerWorldUnit = abs(mul(worldToShadow, float4(lightDirectionWS, 0.0)).z);
    return shadowDepthPerWorldUnit > 1e-5 ? rcp(shadowDepthPerWorldUnit) : 0.0;
}

float GetReceiverDistanceToLight(float receiverDepth, float depthToWorldScale)
{
#if UNITY_REVERSED_Z
    return max((1.0 - receiverDepth) * depthToWorldScale, 0.0);
#else
    return max(receiverDepth * depthToWorldScale, 0.0);
#endif
}

float GetShadowDepthOffsetDirection()
{
#if UNITY_REVERSED_Z
    return 1.0;
#else
    return -1.0;
#endif
}

bool IsShadowMapDepthCloser(float sampleDepth, float compareDepth)
{
#if UNITY_REVERSED_Z
    return sampleDepth > compareDepth;
#else
    return sampleDepth < compareDepth;
#endif
}

void GetCascadeAtlasBounds(int cascadeIndex, out float2 cascadeMinUV, out float2 cascadeMaxUV, out float2 texelSize)
{
    texelSize = 1.0 / float2(_CSMAtlasResolution, _CSMAtlasResolution);
    float4 scaleOffset = _CSMAtlasScaleOffsets[cascadeIndex];
    cascadeMinUV = scaleOffset.zw + texelSize * 0.5;
    cascadeMaxUV = scaleOffset.zw + scaleOffset.xy - texelSize * 0.5;
}

float2 ClampShadowAtlasUV(float2 atlasUV, int cascadeIndex)
{
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeAtlasBounds(cascadeIndex, cascadeMinUV, cascadeMaxUV, texelSize);
    return clamp(atlasUV, cascadeMinUV, cascadeMaxUV);
}

bool IsWithinCascadeAtlasBounds(float2 atlasUV, int cascadeIndex)
{
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeAtlasBounds(cascadeIndex, cascadeMinUV, cascadeMaxUV, texelSize);
    return all(atlasUV >= cascadeMinUV) && all(atlasUV <= cascadeMaxUV);
}

int2 AtlasUVToTexelCoord(float2 atlasUV)
{
    return int2(saturate(atlasUV) * (_CSMAtlasResolution - 1));
}

float SampleShadowPCFKernel(float2 atlasUV, float depth, int cascadeIndex, int kernelRadius)
{
    float shadow = 0.0;
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeAtlasBounds(cascadeIndex, cascadeMinUV, cascadeMaxUV, texelSize);
    int kernelWidth = kernelRadius * 2 + 1;

    [loop]
    for (int y = -kernelRadius; y <= kernelRadius; y++)
    {
        [loop]
        for (int x = -kernelRadius; x <= kernelRadius; x++)
        {
            float2 sampleUV = clamp(atlasUV + float2(x, y) * texelSize, cascadeMinUV, cascadeMaxUV);
            shadow += _CSMShadowAtlas.SampleCmpLevelZero(sampler_CSMShadowAtlas, sampleUV, depth);
        }
    }

    return shadow / (kernelWidth * kernelWidth);
}

float SampleShadowPCF3x3(float2 atlasUV, float depth, int cascadeIndex)
{
    return SampleShadowPCFKernel(atlasUV, depth, cascadeIndex, 1);
}

float SampleShadowPCF5x5(float2 atlasUV, float depth, int cascadeIndex)
{
    return SampleShadowPCFKernel(atlasUV, depth, cascadeIndex, 2);
}

float SampleShadowPCF7x7(float2 atlasUV, float depth, int cascadeIndex)
{
    return SampleShadowPCFKernel(atlasUV, depth, cascadeIndex, 3);
}

// float InterleavedGradientNoise(float2 pixelCoord, int frameIndex)
// {
//     const float3 magic = float3(0.06711056, 0.00583715, 52.9829189);
//     float2 frameMagicScale = float2(2.083, 4.867);
//     pixelCoord += frameIndex * frameMagicScale;
//     return frac(magic.z * frac(dot(pixelCoord, magic.xy)));
// }

float3 GetWorldSpaceViewDirCSM(float3 positionWS)
{
    float3 viewDir = _WorldSpaceCameraPos.xyz - positionWS;
    float viewDirLengthSq = dot(viewDir, viewDir);
    return viewDirLengthSq > 1e-8 ? viewDir * rsqrt(viewDirLengthSq) : float3(0.0, 0.0, 1.0);
}

float GetCascadeBorder(int cascadeIndex)
{
    return cascadeIndex >= 0 && cascadeIndex < _CSMCascadeCount ? kCSMDefaultCascadeBorder : 0.0;
}

float ComputeCascadeBlendAlpha(float3 positionWS, int cascadeIndex, float relDistance)
{
    float border = GetCascadeBorder(cascadeIndex);
    float alpha = border <= 0.0 ? 0.0 : saturate((relDistance - (1.0 - border)) / border);
    if (alpha <= 0.0)
        return 0.0;

    float4 sphere = _CSMCascadeSpheres[cascadeIndex];
    float3 wposDir = positionWS - sphere.xyz;
    float distSq = dot(wposDir, wposDir);
    if (distSq <= 1e-8)
        return alpha;

    wposDir *= rsqrt(distSq);
    float3 viewDir = GetWorldSpaceViewDirCSM(positionWS);
    float cascDot = dot(viewDir, wposDir);
    float lerpSharpness = 8.0 + 512.0 * smoothstep(1.0, 0.7, border);
    return lerp(alpha, 0.0, saturate(cascDot * lerpSharpness));
}

int GetPCSSBlockerSampleCount()
{
    return clamp(_CSMPCSSBlockerSampleCount, 1, kPCSSMaxSampleCount);
}

int GetPCSSFilterSampleCount()
{
    return clamp(_CSMPCSSFilterSampleCount, 1, kPCSSMaxSampleCount);
}

float GetPCSSBlockerClumpExponent()
{
    // Match HDRP's user-facing remap where 1..6 maps to an effective 0.5..3.0 range.
    return max(0.5 * _CSMPCSSBlockerSamplingClumpExponent, 0.5);
}

float2 SampleVogelDiskClumped(int sampleIndex, int sampleCount, float angleOffset, float clumpExponent, out float sampleDistNorm)
{
    float sampleCountInverse = rcp((float)sampleCount);
    sampleDistNorm = PositivePow((float)sampleIndex * sampleCountInverse, clumpExponent);
    float angle = sampleIndex * kPCSSGoldenAngle + angleOffset;
    return sampleDistNorm * float2(cos(angle), sin(angle));
}

float2 SampleVogelDiskUniform(int sampleIndex, int sampleCount, float angleOffset, out float sampleDistNorm)
{
    float sampleCountInverse = rcp((float)sampleCount);
    float sampleBias = 0.5 * sampleCountInverse;
    sampleDistNorm = sqrt((float)sampleIndex * sampleCountInverse + sampleBias);
    float angle = sampleIndex * kPCSSGoldenAngle + angleOffset;
    return sampleDistNorm * float2(cos(angle), sin(angle));
}

bool FindAverageBlockerDepth(
    out float averageBlockerDepth,
    float2 atlasUV,
    float receiverDepth,
    int cascadeIndex,
    float blockerSearchRadiusWorld,
    float worldTexelSize,
    float blockerRadial2DepthScale,
    float minFilterRadiusWorld,
    float minFilterRadial2DepthScale,
    float rotationAngle)
{
    averageBlockerDepth = UNITY_RAW_FAR_CLIP_VALUE;

    float blockerDepthSum = 0.0;
    float blockerCount = 0.0;
    float depthOffsetDirection = GetShadowDepthOffsetDirection();
    float blockerSearchRadiusTexels = blockerSearchRadiusWorld / max(worldTexelSize, 1e-6);
    float2 texelSize = 1.0 / float2(_CSMAtlasResolution, _CSMAtlasResolution);
    int blockerSampleCount = GetPCSSBlockerSampleCount();
    float blockerClumpExponent = GetPCSSBlockerClumpExponent();

    [loop]
    for (int sampleIndex = 0; sampleIndex < blockerSampleCount; sampleIndex++)
    {
        float sampleDistNorm;
        float2 diskSample = SampleVogelDiskClumped(
            sampleIndex,
            blockerSampleCount,
            rotationAngle,
            blockerClumpExponent,
            sampleDistNorm);
        float2 sampleUV = atlasUV + diskSample * (blockerSearchRadiusTexels * texelSize);
        if (!IsWithinCascadeAtlasBounds(sampleUV, cascadeIndex))
            continue;

        float radialOffsetWorld = blockerSearchRadiusWorld * sampleDistNorm;
        float radial2DepthScale = radialOffsetWorld < minFilterRadiusWorld
            ? minFilterRadial2DepthScale
            : blockerRadial2DepthScale;
        float coordz = receiverDepth + depthOffsetDirection * (radialOffsetWorld * radial2DepthScale);
        float sampleDepth = _CSMShadowAtlas.Load(int3(AtlasUVToTexelCoord(sampleUV), 0));

        if (IsShadowMapDepthCloser(sampleDepth, coordz))
        {
            blockerDepthSum += sampleDepth;
            blockerCount += 1.0;
        }
    }

    if (blockerCount > 0.0)
    {
        averageBlockerDepth = blockerDepthSum / blockerCount;
        return true;
    }

    return false;
}

float SampleShadowPCSS(float2 atlasUV, float receiverDepth, int cascadeIndex, uint2 pixelCoord)
{
    float halfLightAngularDiameterTangent = tan(0.5 * max(_CSMLightAngularDiameter, 0.0) * kDegreesToRadians);
    if (halfLightAngularDiameterTangent <= 1e-5)
        return SampleShadowPCF7x7(atlasUV, receiverDepth, cascadeIndex);

    float worldTexelSize = GetCascadeWorldTexelSize(cascadeIndex);
    float depthToWorldScale = GetCascadeDepthToWorldScale(cascadeIndex);
    if (worldTexelSize <= 1e-6 || depthToWorldScale <= 1e-5)
        return SampleShadowPCF7x7(atlasUV, receiverDepth, cascadeIndex);

    float blockerSearchAngularDiameter = max(_CSMPCSSBlockerSearchAngularDiameter, _CSMLightAngularDiameter);
    float halfBlockerSearchAngularDiameterTangent = tan(0.5 * blockerSearchAngularDiameter * kDegreesToRadians);
    float minFilterAngularDiameter = max(blockerSearchAngularDiameter, _CSMPCSSMinFilterMaxAngularDiameter);
    float halfMinFilterAngularDiameterTangent = tan(0.5 * max(minFilterAngularDiameter, _CSMLightAngularDiameter) * kDegreesToRadians);
    float minFilterRadiusWorld = _CSMPCSSMinFilterSizeTexels * worldTexelSize;
    float maxBlockerDistanceWorld = _CSMPCSSMaxPenumbraSize / max(2.0 * halfLightAngularDiameterTangent, 1e-5);
    float blockerRadial2DepthScale = 1.0 / max(halfBlockerSearchAngularDiameterTangent * depthToWorldScale, 1e-5);
    float minFilterRadial2DepthScale = 1.0 / max(halfMinFilterAngularDiameterTangent * depthToWorldScale, 1e-5);
    float receiverDistanceWorld = min(GetReceiverDistanceToLight(receiverDepth, depthToWorldScale), maxBlockerDistanceWorld);
    float blockerSearchRadiusWorld = max(receiverDistanceWorld * halfLightAngularDiameterTangent, minFilterRadiusWorld);
    float noise = InterleavedGradientNoise(float2(pixelCoord) + 0.5, _CSMFrameIndex);
    float rotationAngle = noise * kPCSSTwoPi;
    float averageBlockerDepth;
    bool blockerFound = FindAverageBlockerDepth(
        averageBlockerDepth,
        atlasUV,
        receiverDepth,
        cascadeIndex,
        blockerSearchRadiusWorld,
        worldTexelSize,
        blockerRadial2DepthScale,
        minFilterRadiusWorld,
        minFilterRadial2DepthScale,
        rotationAngle);

    if (!blockerFound)
        return 1.0;

    float blockerDistanceWorld = min(abs(averageBlockerDepth - receiverDepth) * depthToWorldScale * 0.9, maxBlockerDistanceWorld);
    float filterRadiusWorld = blockerDistanceWorld * halfLightAngularDiameterTangent;
    float samplingFilterRadiusWorld = max(filterRadiusWorld, minFilterRadiusWorld);
    float filterRadiusTexels = samplingFilterRadiusWorld / worldTexelSize;
    float maxPCSSOffsetShadow = min(_CSMPCSSMaxSamplingDistance, blockerDistanceWorld * 0.25) / depthToWorldScale;
    float2 texelSize = 1.0 / float2(_CSMAtlasResolution, _CSMAtlasResolution);
    float depthOffsetDirection = GetShadowDepthOffsetDirection();
    float shadow = 0.0;
    float validSampleCount = 0.0;
    int filterSampleCount = GetPCSSFilterSampleCount();

    [loop]
    for (int sampleIndex = 0; sampleIndex < filterSampleCount; sampleIndex++)
    {
        float sampleDistNorm;
        float2 diskSample = SampleVogelDiskUniform(sampleIndex, filterSampleCount, rotationAngle, sampleDistNorm);
        float2 sampleUV = atlasUV + diskSample * (filterRadiusTexels * texelSize);
        if (!IsWithinCascadeAtlasBounds(sampleUV, cascadeIndex))
            continue;

        float zOffset = filterRadiusWorld * sampleDistNorm * minFilterRadial2DepthScale;
        float coordz = receiverDepth + depthOffsetDirection * min(zOffset, maxPCSSOffsetShadow);
        shadow += _CSMShadowAtlas.SampleCmpLevelZero(sampler_CSMShadowAtlas, sampleUV, coordz);
        validSampleCount += 1.0;
    }

    return validSampleCount > 0.0 ? shadow / validSampleCount : 1.0;
}

float EvaluateShadow(float2 atlasUV, float receiverDepth, int cascadeIndex, uint2 pixelCoord)
{
    switch (_CSMShadowQuality)
    {
        case kCSMShadowQualityLow:
            return SampleShadowPCF3x3(atlasUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityMedium:
            return SampleShadowPCF5x5(atlasUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityHigh:
            return SampleShadowPCF7x7(atlasUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityVeryHigh:
            return SampleShadowPCSS(atlasUV, receiverDepth, cascadeIndex, pixelCoord);
        default:
            return SampleShadowPCF5x5(atlasUV, receiverDepth, cascadeIndex);
    }
}

bool IsWithinShadowMapBounds(float3 shadowCoord)
{
    return all(shadowCoord >= 0.0) && all(shadowCoord <= 1.0);
}

bool TryGetBiasedShadowCoord(float3 positionWS, float3 normalWS, int cascadeIndex, out float3 shadowCoord)
{
    shadowCoord = 0.0;

    if (cascadeIndex < 0 || cascadeIndex >= _CSMCascadeCount)
        return false;

    float receiverNormalBias = _CSMNormalBias * GetCascadeWorldTexelSize(cascadeIndex);
    float3 biasedPositionWS = positionWS + normalWS * receiverNormalBias;
    shadowCoord = TransformWorldToShadowCoord(biasedPositionWS, cascadeIndex);
    return IsWithinShadowMapBounds(shadowCoord);
}

bool TryEvaluateCascadeShadow(float3 positionWS, float3 normalWS, int cascadeIndex, uint2 pixelCoord, out float shadow)
{
    shadow = 1.0;

    float3 shadowCoord;
    if (!TryGetBiasedShadowCoord(positionWS, normalWS, cascadeIndex, shadowCoord))
        return false;

    float2 atlasUV = RemapToAtlasUV(shadowCoord.xy, cascadeIndex);
    shadow = EvaluateShadow(atlasUV, shadowCoord.z, cascadeIndex, pixelCoord);
    return true;
}

[numthreads(8, 8, 1)]
void CSMShadowResolve(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x >= (uint)_CSMOutputWidth || dispatchThreadID.y >= (uint)_CSMOutputHeight)
        return;

    uint2 pixelCoord = dispatchThreadID.xy;
    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

    // Sky pixels are fully lit
    if (IsSkyPixel(deviceDepth))
    {
        _DirectionalShadowTexture[pixelCoord] = 1.0;
        return;
    }

    float3 positionWS = ReconstructWorldPosition(pixelCoord, deviceDepth);

    // Cascade selection
    float relDistance;
    int cascadeIndex = SelectCascade(positionWS, relDistance);

    if (cascadeIndex < 0)
    {
        // Beyond all cascades — fully lit
        _DirectionalShadowTexture[pixelCoord] = 1.0;
        return;
    }

    // Normal bias
    float4 gbuffer1 = _GBuffer1.Load(int3(pixelCoord, 0));
    float3 normalWS = DecodeVividNormalOct(gbuffer1.xy);
    float shadowCurrent;
    if (!TryEvaluateCascadeShadow(positionWS, normalWS, cascadeIndex, pixelCoord, shadowCurrent))
    {
        _DirectionalShadowTexture[pixelCoord] = 1.0;
        return;
    }

    float shadow = shadowCurrent;
    float cascadeBlendAlpha = ComputeCascadeBlendAlpha(positionWS, cascadeIndex, relDistance);
    if (cascadeBlendAlpha > 0.0)
    {
        float shadowNext = 1.0;
        int nextCascadeIndex = cascadeIndex + 1;
        if (nextCascadeIndex < _CSMCascadeCount)
        {
            shadowNext = shadowCurrent;

            float nextCascadeShadow;
            if (TryEvaluateCascadeShadow(positionWS, normalWS, nextCascadeIndex, pixelCoord, nextCascadeShadow))
                shadowNext = nextCascadeShadow;
        }

        shadow = lerp(shadowCurrent, shadowNext, cascadeBlendAlpha);
    }

    // Distance fade
    float distanceFade = 1.0;
    float3 cameraToPixel = positionWS - _WorldSpaceCameraPos;
    float pixelDistance = length(cameraToPixel);
    float fadeStart = _CSMMaxShadowDistance * 0.8;
    if (pixelDistance > fadeStart)
    {
        distanceFade = 1.0 - saturate((pixelDistance - fadeStart) / (_CSMMaxShadowDistance - fadeStart));
    }

    shadow = lerp(1.0, shadow, distanceFade);

    _DirectionalShadowTexture[pixelCoord] = shadow;
}
