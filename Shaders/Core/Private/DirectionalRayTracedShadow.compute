#pragma kernel DirectionalRayTracedShadow
#pragma multi_compile _ SHADOW_CLASSIFY_ENABLED
#pragma use_dxc
#pragma require inlineraytracing
#pragma only_renderers d3d11 xboxseries ps5
#pragma enable_d3d11_debug_symbols

#include "UnityRayQuery.cginc"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/Input.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/GBuffer.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/RaytracingCommon.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/BlueNoise.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/ml.hlsl"
RaytracingAccelerationStructure _AccelerationStructure;
Texture2D<float> _DepthTexture;
Texture2D<float4> _GBuffer1;
RWTexture2D<float> _DirectionalShadowTexture;

#ifdef SHADOW_CLASSIFY_ENABLED
Texture2D<float> _ShadowClassifyMask;
#endif

float4x4 _InvViewProjectionMatrix;
float4 _LightDirectionWS;
float4 _SunBasisX;
float4 _SunBasisY;
float _RayLength;
float _TanSunAngularRadius;
int _FrameIndex;
int _OutputWidth;
int _OutputHeight;


bool IsSkyPixel(float deviceDepth)
{
    return deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
}


// Encode hit distance as penumbra radius for denoiser consumption.
// Returns HALF_MAX when no occluder is found (fully lit).
float PackPenumbra(float distanceToOccluder, float tanSunAngularRadius)
{
    float penumbraRadius = distanceToOccluder * tanSunAngularRadius * 0.5;
    return distanceToOccluder >= HALF_MAX ? HALF_MAX : min(penumbraRadius, 32768.0);
}

float PackFullyLitPenumbra(float tanSunAngularRadius)
{
    return PackPenumbra(HALF_MAX, tanSunAngularRadius);
}

[numthreads(8, 8, 1)]
void DirectionalRayTracedShadow(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x >= (uint)_OutputWidth || dispatchThreadID.y >= (uint)_OutputHeight)
        return;

    uint2 pixelCoord = dispatchThreadID.xy;
    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));
    if (IsSkyPixel(deviceDepth))
    {
        _DirectionalShadowTexture[pixelCoord] = PackFullyLitPenumbra(_TanSunAngularRadius);
        return;
    }

#ifdef SHADOW_CLASSIFY_ENABLED
    // Skip pixels classified as not needing ray tracing (backfacing, etc.).
    // The raw shadow encoding uses HALF_MAX for "fully lit / no occluder".
    if (_ShadowClassifyMask.Load(int3(pixelCoord, 0)) < 0.5)
    {
        _DirectionalShadowTexture[pixelCoord] = PackFullyLitPenumbra(_TanSunAngularRadius);
        return;
    }
#endif

    float2 uv = (float2(pixelCoord) + 0.5) / float2(_OutputWidth, _OutputHeight);
    float3 positionWS = ComputeWorldSpacePosition(uv, deviceDepth, _InvViewProjectionMatrix);

    float3 normalWS = DecodeVividNormalOct(_GBuffer1.Load(int3(pixelCoord, 0)).xy);
    float3 lightDirectionWS = SafeNormalize(_LightDirectionWS.xyz);

    // When tanSunAngularRadius > 0, sample within the sun disk cone for soft shadows
    float3 rayDirection;
    if (_TanSunAngularRadius > 0.0)
    {
        float2 rnd = float2(
            GetBNDSequenceSample(pixelCoord, (uint)_FrameIndex, 0),
            GetBNDSequenceSample(pixelCoord, (uint)_FrameIndex, 1));
        rnd = ImportanceSampling::Cosine::GetRay(rnd).xy;
        rnd *= _TanSunAngularRadius;
        rayDirection = normalize(_SunBasisX.xyz * rnd.x + _SunBasisY.xyz * rnd.y + lightDirectionWS);

    }
    else
    {
        rayDirection = lightDirectionWS;
    }

    RayDesc shadowRay;
    shadowRay.Origin = positionWS + normalWS * EvaluateRayTracingBias(positionWS);
    shadowRay.Direction = rayDirection;
    shadowRay.TMin = 0.0;
    shadowRay.TMax = _RayLength;

    UnityRayQuery<RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES|RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
    query.TraceRayInline(
        _AccelerationStructure,
        RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES|RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH,
        0xFF,
        shadowRay);

    query.Proceed();
    float shadowHitDist = HALF_MAX;
    if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
    {
        shadowHitDist = query.CommittedRayT();
    }

    _DirectionalShadowTexture[pixelCoord] = PackPenumbra(shadowHitDist, _TanSunAngularRadius);
}
