#pragma kernel ShadowTemporalAccumulation
#pragma use_dxc
#pragma only_renderers d3d11 xboxseries ps5

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/Input.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/GBuffer.hlsl"

Texture2D<float>  _RawShadowTexture;
Texture2D<float>  _HistoryShadowTexture;
Texture2D<float2> _MotionVectorTexture;
Texture2D<float>  _DepthTexture;
Texture2D<float4> _GBuffer1;

RWTexture2D<float> _DenoisedShadowTexture;

float4x4 _InvViewProjectionMatrix;
float4x4 _PrevInvViewProjectionMatrix;
int _HasValidHistory;
float _TemporalBlendMin;
float _TemporalBlendMax;
float _DepthRejectionThreshold;
float _NormalRejectionThreshold;

SamplerState sampler_LinearClamp;

bool IsSkyPixel(float deviceDepth)
{
    return deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
}

// Convert packed penumbra to [0,1] shadow visibility
float PenumbraToVisibility(float penumbra)
{
    return penumbra >= HALF_MAX ? 1.0 : saturate(1.0 - penumbra);
}

[numthreads(8, 8, 1)]
void ShadowTemporalAccumulation(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x >= (uint)_ScreenSize.x || dispatchThreadID.y >= (uint)_ScreenSize.y)
        return;

    uint2 pixelCoord = dispatchThreadID.xy;
    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

    // Sky pixels: fully lit
    if (IsSkyPixel(deviceDepth))
    {
        _DenoisedShadowTexture[pixelCoord] = 1.0;
        return;
    }

    float rawPenumbra = _RawShadowTexture.Load(int3(pixelCoord, 0));
    float currentVisibility = PenumbraToVisibility(rawPenumbra);

    // No valid history: output current frame directly
    if (!_HasValidHistory)
    {
        _DenoisedShadowTexture[pixelCoord] = currentVisibility;
        return;
    }

    // Reproject using motion vectors
    float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenSize.xy);
    float2 motionVector = _MotionVectorTexture.Load(int3(pixelCoord, 0));
    float2 prevUV = uv - motionVector;

    // Reject if reprojected UV is out of bounds
    bool validReproject = all(prevUV >= 0.0) && all(prevUV <= 1.0);

    float historyVisibility = currentVisibility;
    float blendFactor = _TemporalBlendMax;

    if (validReproject)
    {
        // History stores [0,1] visibility directly
        historyVisibility = _HistoryShadowTexture.SampleLevel(sampler_LinearClamp, prevUV, 0);

        // Depth-based disocclusion rejection
        float3 positionWS = ComputeWorldSpacePosition(uv, deviceDepth, UNITY_MATRIX_I_VP);
        float3 prevPositionWS = ComputeWorldSpacePosition(prevUV, deviceDepth, UNITY_MATRIX_I_VP);
        float depthDiff = length(positionWS - prevPositionWS);

        if (depthDiff < _DepthRejectionThreshold)
        {
            blendFactor = _TemporalBlendMin;
        }
    }

    float denoisedVisibility = lerp(historyVisibility, currentVisibility, blendFactor);
    _DenoisedShadowTexture[pixelCoord] = saturate(denoisedVisibility);
}
