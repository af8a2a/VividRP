#pragma kernel CS
#pragma kernel CSVSMCompacted VIVID_VSM_COMPACT_VIEWS

#pragma use_dxc

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GPUDriven/VividGPUDrivenCommon.hlsl"

#if defined(VIVID_VSM_COMPACT_VIEWS)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMViewCompaction.hlsl"
#endif

StructuredBuffer<VividGPUCullingContext> _CullingContexts;
StructuredBuffer<uint> _VisibleMeshletRenderRequestCounter;
RWStructuredBuffer<uint> _VisibleRendererListMeshletCounts;
RWStructuredBuffer<uint> _GPUMeshletCullingIndirectDispatchArgs;
RWByteAddressBuffer _VisibleMeshletIndirectDrawArgs;
uint _CullingContextCount;

void RunFixup(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
#if defined(VIVID_VSM_COMPACT_VIEWS)
    if (dispatchThreadID.x == 0u)
    {
        _GPUMeshletCullingIndirectDispatchArgs[1] = VividVSMActiveViewCount();
        _GPUMeshletCullingIndirectDispatchArgs[2] = 1u;
    }
    uint cullingContextIndex;
    if (!VividVSMResolveActiveView(dispatchThreadID.x, cullingContextIndex)) return;
#else
    const uint cullingContextCount = max(_CullingContextCount, 1u);
    const uint cullingContextIndex = dispatchThreadID.x;
    if (cullingContextIndex >= cullingContextCount)
    {
        return;
    }

    if (cullingContextIndex == 0u)
    {
        _GPUMeshletCullingIndirectDispatchArgs[1] = cullingContextCount;
        _GPUMeshletCullingIndirectDispatchArgs[2] = 1u;
    }

#endif

    const uint visibleMeshletRequestCount = _VisibleMeshletRenderRequestCounter[cullingContextIndex];
    const uint threadGroupCount = (visibleMeshletRequestCount + 31u) / 32u;
    InterlockedMax(_GPUMeshletCullingIndirectDispatchArgs[0], threadGroupCount);

    const VividGPUCullingContext cullingContext = _CullingContexts[cullingContextIndex];
    const uint rendererListBaseIndex = cullingContextIndex * VIVIDRENDERERLISTID_COUNT;
    uint startInstance = cullingContext.BaseStartInstance;

    [unroll]
    for (uint rendererListIndex = 0u; rendererListIndex < VIVIDRENDERERLISTID_COUNT; ++rendererListIndex)
    {
        const uint rendererListCountIndex = rendererListBaseIndex + rendererListIndex;
        const uint maxInstanceCount = _VisibleRendererListMeshletCounts[rendererListCountIndex];
        const uint drawArgsAddress = GetIndirectDrawArgsByteAddress(rendererListCountIndex);
        _VisibleMeshletIndirectDrawArgs.Store4(
            drawArgsAddress,
            uint4(
                VIVID_MAX_MESHLET_INDICES,
                0u,
                0u,
                startInstance
            )
        );
        _VisibleRendererListMeshletCounts[rendererListCountIndex] = 0u;

        startInstance += maxInstanceCount;
    }
}

[numthreads(1, 1, 1)]
void CS(uint3 id : SV_DispatchThreadID) { RunFixup(id); }
#if defined(VIVID_VSM_COMPACT_VIEWS)
[numthreads(1, 1, 1)]
void CSVSMCompacted(uint3 id : SV_DispatchThreadID) { RunFixup(id); }
#endif
