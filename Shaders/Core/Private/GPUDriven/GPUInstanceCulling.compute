#pragma kernel CS

#pragma kernel CSVSM VIVID_VSM_EARLY_CULL
#pragma kernel CSVSMCompacted VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS
#pragma kernel CSCompactVSMViews VIVID_VSM_EARLY_CULL VIVID_VSM_BUILD_COMPACT_VIEWS
#pragma kernel CSVSMHierarchy VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS VIVID_VSM_AFFINE_BOUNDS VIVID_VSM_LOD_HIERARCHY
#pragma use_dxc

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GPUDriven/VividGPUDrivenCommon.hlsl"
#if defined(VIVID_VSM_EARLY_CULL)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMPageCulling.hlsl"
#endif

#if defined(VIVID_VSM_COMPACT_VIEWS) || defined(VIVID_VSM_BUILD_COMPACT_VIEWS)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMViewCompaction.hlsl"
#endif

#define THREAD_GROUP_SIZE 32
#define MAX_LODNODES_PER_THREAD_GROUP 32u

StructuredBuffer<VividGPUCullingContext> _CullingContexts;
uint _CullingContextCount;
StructuredBuffer<uint> _VividPrimitiveDrawSetInstanceIndices;
uint _VividPrimitiveDrawSetInstanceCount;
uint _VividPrimitiveDrawSetEnabled;

RWStructuredBuffer<VividMeshletListBuildJob> _MeshletListBuildJobs;
RWStructuredBuffer<uint> _MeshletListBuildJobCounter;
RWStructuredBuffer<uint> _MeshletListBuildIndirectArgs;

#if defined(VIVID_VSM_LOD_HIERARCHY)
struct VSMLodHierarchyNode
{
    float4 Min;
    float4 Max;
    uint4 Range;
};
StructuredBuffer<VSMLodHierarchyNode> _VSMLodHierarchy;
StructuredBuffer<uint> _VSMLodRoots;
uint _VSMLodHierarchyCount;
uint _VSMLodRootCount;
uint _ForcedMeshLODNodeDepth;

void EmitVSMLodJob(uint instanceID, uint contextIndex, uint jobsOffset, uint offset, uint count)
{
    uint index;
    InterlockedAdd(_MeshletListBuildJobCounter[contextIndex], 1u, index);
    InterlockedMax(_MeshletListBuildIndirectArgs[0], index + 1u);
    VividMeshletListBuildJob job;
    job.InstanceID = instanceID; job.MeshLODNodeOffset = offset;
    job.MeshLODNodeCount = count; job.Padding0 = 0u;
    _MeshletListBuildJobs[jobsOffset + index] = job;
}

// Stackless preorder traversal. Every leaf is aligned to a 32-record job in
// this mesh, so surviving jobs cannot exceed the existing queue capacity.
void TraverseVSMLodHierarchy(uint instanceID, VividInstanceData instance, uint contextIndex,
    uint jobsOffset, float4x4 localToShadow)
{
    uint start = instance.TopMeshLODStartIndex;
    uint count = start < _VSMLodRootCount ? min(instance.TotalMeshLODCount, _VSMLodRootCount - start) : 0u;
    if (count == 0u) return;
    uint end = start + count;
    uint index = start < _VSMLodRootCount ? _VSMLodRoots[start] : 0xffffffffu;
    if (index >= _VSMLodHierarchyCount)
    {
        // Preserve the original guarded flat path for incomplete source data.
        for (uint offset = 0u; offset < count; offset += 32u)
            EmitVSMLodJob(instanceID, contextIndex, jobsOffset, offset, min(count - offset, 32u));
        return;
    }
    uint stop = _VSMLodHierarchy[index].Range.z;
    uint leafLevel = instance.MeshLODLevelCount - 1u;
    [loop] while (index < stop)
    {
        VSMLodHierarchyNode node = _VSMLodHierarchy[index];
        bool overlaps = node.Range.x < end && node.Range.x + node.Range.y > start;
        if (_ForcedMeshLODNodeDepth != VIVID_INVALID_FORCED_MESH_LOD_NODE_DEPTH)
            overlaps = overlaps && ((_ForcedMeshLODNodeDepth >= node.Min.w && _ForcedMeshLODNodeDepth <= node.Max.w)
                || (leafLevel < _ForcedMeshLODNodeDepth && leafLevel >= node.Min.w && leafLevel <= node.Max.w));
        if (overlaps)
            overlaps = VividVSMCasterLocalBoundsOverlaps(contextIndex,
                (node.Min.xyz + node.Max.xyz) * 0.5, (node.Max.xyz - node.Min.xyz) * 0.5, 0.0, false, localToShadow);
        if (!overlaps) { index = node.Range.z; continue; }
        if (node.Range.w == 0u) { index++; continue; }
        uint first = max(node.Range.x, start), last = min(node.Range.x + node.Range.y, end);
        EmitVSMLodJob(instanceID, contextIndex, jobsOffset, first - start, last - first);
        index = node.Range.z;
    }
}
#endif

void RunCulling(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint cullingContextCount = max(_CullingContextCount, 1u);
#if defined(VIVID_VSM_COMPACT_VIEWS)
    uint cullingContextIndex;
    if (!VividVSMResolveActiveView(dispatchThreadID.y, cullingContextIndex)) return;
#else
    const uint cullingContextIndex = dispatchThreadID.y;
#endif
    if (cullingContextIndex >= cullingContextCount)
    {
        return;
    }

#if !defined(VIVID_VSM_COMPACT_VIEWS)
    if (dispatchThreadID.x == 0u && cullingContextIndex == 0u)
    {
        _MeshletListBuildIndirectArgs[1] = cullingContextCount;
        _MeshletListBuildIndirectArgs[2] = 1u;
    }

#endif

    const uint dispatchInstanceIndex = dispatchThreadID.x;
    if (_VividPrimitiveDrawSetEnabled != 0u &&
        dispatchInstanceIndex >= _VividPrimitiveDrawSetInstanceCount)
    {
        return;
    }

    const uint instanceID = _VividPrimitiveDrawSetEnabled != 0u
        ? _VividPrimitiveDrawSetInstanceIndices[dispatchInstanceIndex]
        : dispatchInstanceIndex;
    if (instanceID >= _InstanceDataCount)
    {
        return;
    }

    const VividInstanceData instanceData = PullInstanceData(instanceID);
    const VividGPUCullingContext cullingContext = _CullingContexts[cullingContextIndex];

    if ((instanceData.Flags & VIVIDINSTANCEFLAGS_DISABLED) != 0u ||
        (instanceData.PassMask & (uint) cullingContext.PassMask) == 0u)
    {
        return;
    }

#if defined(VIVID_VSM_AFFINE_BOUNDS)
    float3 centerOS = (instanceData.AABBMin.xyz + instanceData.AABBMax.xyz) * 0.5;
    float3 extentOS = (instanceData.AABBMax.xyz - instanceData.AABBMin.xyz) * 0.5;
    if (!VividVSMFrustumVsLocalBounds(cullingContext.FrustumPlanes, centerOS, extentOS,
            0.0, false, instanceData.ObjectToWorldMatrix)) return;
    float4x4 localToShadow = mul(_VSMProjections[cullingContextIndex].worldToShadow, instanceData.ObjectToWorldMatrix);
    if (!VividVSMCasterLocalBoundsOverlaps(cullingContextIndex, centerOS, extentOS, 0.0, false, localToShadow)) return;
#else
    const float4 boundingSphereWS = ComputeInstanceBoundingSphereWS(instanceData);
    if (!FrustumVsSphere(cullingContext, boundingSphereWS) ||
        !LightSphereCulling(cullingContext, boundingSphereWS))
    {
        return;
    }

#if defined(VIVID_VSM_EARLY_CULL)
    // Reject before allocating LOD traversal jobs.
    if (!VividVSMCasterSphereOverlaps(cullingContextIndex, boundingSphereWS)) return;
#endif

#endif

    const uint totalMeshLODCount = instanceData.TotalMeshLODCount;
    if (totalMeshLODCount == 0u)
    {
        return;
    }

#if defined(VIVID_VSM_LOD_HIERARCHY)
    TraverseVSMLodHierarchy(instanceID, instanceData, cullingContextIndex, cullingContext.MeshletListBuildJobsOffset, localToShadow);
    return;
#endif

    const uint jobCount = (totalMeshLODCount + MAX_LODNODES_PER_THREAD_GROUP - 1u) / MAX_LODNODES_PER_THREAD_GROUP;

    uint jobWriteOffset;
    InterlockedAdd(_MeshletListBuildJobCounter[cullingContextIndex], jobCount, jobWriteOffset);
    InterlockedMax(_MeshletListBuildIndirectArgs[0], jobWriteOffset + jobCount);

    [loop]
    for (uint jobIndex = 0u; jobIndex < jobCount; ++jobIndex)
    {
        const uint offset = jobIndex * MAX_LODNODES_PER_THREAD_GROUP;
        const uint remainingNodeCount = totalMeshLODCount - offset;

        VividMeshletListBuildJob job;
        job.InstanceID = instanceID;
        job.MeshLODNodeOffset = offset;
        job.MeshLODNodeCount = min(remainingNodeCount, MAX_LODNODES_PER_THREAD_GROUP);
        job.Padding0 = 0u;
        _MeshletListBuildJobs[cullingContext.MeshletListBuildJobsOffset + jobWriteOffset + jobIndex] = job;
    }
}

#if defined(VIVID_VSM_EARLY_CULL)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSM(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RunCulling(dispatchThreadID);
}
#endif

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RunCulling(dispatchThreadID);
}

#if defined(VIVID_VSM_BUILD_COMPACT_VIEWS)
[numthreads(1, 1, 1)]
void CSCompactVSMViews(uint3 id : SV_DispatchThreadID)
{
    uint activeCount;
    VividVSMCompactViews(_CullingContextCount, (uint)_VSMCasterCullingParameters.w, activeCount);
    // This must also run for an empty view set, when the instance dispatch does not.
    _MeshletListBuildIndirectArgs[0] = 0u;
    _MeshletListBuildIndirectArgs[1] = activeCount;
    _MeshletListBuildIndirectArgs[2] = 1u;
}
#endif

#if defined(VIVID_VSM_COMPACT_VIEWS)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMCompacted(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RunCulling(dispatchThreadID);
}
#endif

#if defined(VIVID_VSM_LOD_HIERARCHY)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMHierarchy(uint3 id : SV_DispatchThreadID) { RunCulling(id); }
#endif
