#pragma kernel CS

#pragma kernel CSVSM VIVID_VSM_EARLY_CULL
#pragma kernel CSVSMCompacted VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS
#pragma kernel CSCompactVSMViews VIVID_VSM_EARLY_CULL VIVID_VSM_BUILD_COMPACT_VIEWS
#pragma kernel CSVSMHierarchy VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS VIVID_VSM_AFFINE_BOUNDS VIVID_VSM_LOD_HIERARCHY
#pragma kernel CSVSMHierarchyEnqueue VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS VIVID_VSM_AFFINE_BOUNDS VIVID_VSM_LOD_HIERARCHY VIVID_VSM_BATCH
#pragma kernel CSVSMHierarchyTraverse VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS VIVID_VSM_AFFINE_BOUNDS VIVID_VSM_LOD_HIERARCHY VIVID_VSM_BATCH
#pragma use_dxc
#pragma require wavebasic waveballot wavemath : VIVID_VSM_BATCH

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GPUDriven/VividGPUDrivenCommon.hlsl"
#if defined(VIVID_VSM_EARLY_CULL)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMPageCulling.hlsl"
#endif

#if defined(VIVID_VSM_COMPACT_VIEWS) || defined(VIVID_VSM_BUILD_COMPACT_VIEWS)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMViewCompaction.hlsl"
#endif

#define THREAD_GROUP_SIZE 32
#define MAX_LODNODES_PER_THREAD_GROUP 32u

StructuredBuffer<VividGPUCullingContext> _CullingContexts;
uint _CullingContextCount;
StructuredBuffer<uint> _VividPrimitiveDrawSetInstanceIndices;
uint _VividPrimitiveDrawSetInstanceCount;
uint _VividPrimitiveDrawSetEnabled;

RWStructuredBuffer<VividMeshletListBuildJob> _MeshletListBuildJobs;
RWStructuredBuffer<uint> _MeshletListBuildJobCounter;
RWStructuredBuffer<uint> _MeshletListBuildIndirectArgs;

#if defined(VIVID_VSM_LOD_HIERARCHY)
struct VSMLodHierarchyNode
{
    float4 Min;
    float4 Max;
    uint4 Range;
    float4 ErrorBounds; // min error/radius, max decoded parent error/radius
};
StructuredBuffer<VSMLodHierarchyNode> _VSMLodHierarchy;
StructuredBuffer<uint> _VSMLodRoots;
uint _VSMLodHierarchyCount;
uint _VSMLodRootCount;
uint _ForcedMeshLODNodeDepth;
float _MeshLODErrorThreshold;
StructuredBuffer<VividGPULODSelectionContext> _LODSelectionContexts;

bool VSMLodRangeMaySelect(VSMLodHierarchyNode node, VividInstanceData instance,
    float instanceScale, float texelScaleSq, float threshold)
{
    // TransformSphere (the unchanged leaf contract) subtracts transformed points.
    // Bound its cancellation/rounding error from the largest input magnitude in
    // this range; a simple error * radius^2 bound is unsafe at large translations.
    float3 maxLocalPoint = max(abs(node.Min.xyz), abs(node.Max.xyz)) + node.ErrorBounds.w;
    float3 worldMagnitude = mul(abs((float3x3)instance.ObjectToWorldMatrix), maxLocalPoint)
        + abs(float3(instance.ObjectToWorldMatrix._m03, instance.ObjectToWorldMatrix._m13,
            instance.ObjectToWorldMatrix._m23));
    if (!all(isfinite(worldMagnitude))) return true;
    float roundoff = max(1e-18f, 1e-5f * length(worldMagnitude));
    if (!isfinite(roundoff)) return true;

    float minRadius = max(0.0f, node.ErrorBounds.y * instanceScale - roundoff);
    float maxParentRadius = node.ErrorBounds.w * instanceScale + roundoff;
    // Keep the leaf multiplication order and leave ambiguous equality/underflow
    // cases to the leaf. An unbounded parent interval (including the no-parent
    // sentinel) disables parent rejection.
    float minError = node.ErrorBounds.x * minRadius * minRadius * texelScaleSq;
    float maxParentError = node.ErrorBounds.z * maxParentRadius * maxParentRadius * texelScaleSq;
    float tolerance = max(1e-30f, threshold * 1e-5f);
    bool ownErrorTooHigh = isfinite(minError) && minError > threshold + tolerance;
    bool allParentsTooLow = isfinite(maxParentError) && maxParentError < threshold - tolerance;
    return !(ownErrorTooHigh || allParentsTooLow);
}

void EmitVSMLodJob(uint instanceID, uint contextIndex, uint jobsOffset, uint offset, uint count)
{
    uint index;
#if defined(VIVID_VSM_BATCH)
    uint batchCount = WaveActiveCountBits(true), prefix = WavePrefixCountBits(true);
    uint baseIndex = 0u;
    if (WaveIsFirstLane())
    {
        InterlockedAdd(_MeshletListBuildJobCounter[contextIndex], batchCount, baseIndex);
        InterlockedMax(_MeshletListBuildIndirectArgs[0], baseIndex + batchCount);
    }
    index = WaveReadLaneFirst(baseIndex) + prefix;
#else
    InterlockedAdd(_MeshletListBuildJobCounter[contextIndex], 1u, index);
    InterlockedMax(_MeshletListBuildIndirectArgs[0], index + 1u);
#endif
    VividMeshletListBuildJob job;
    job.InstanceID = instanceID; job.MeshLODNodeOffset = offset;
    job.MeshLODNodeCount = count; job.Padding0 = 0u;
    _MeshletListBuildJobs[jobsOffset + index] = job;
}

struct VSMLodTraversalState
{
    uint start, end, leafLevel;
    float instanceScale, texelScaleSq, threshold;
    bool automaticErrorBounds;
};
VSMLodTraversalState VSMLodState(VividInstanceData instance, uint contextIndex, uint start, uint end)
{
    uint leafLevel = instance.MeshLODLevelCount - 1u;
    VividGPUCullingContext context = _CullingContexts[contextIndex];
    VividGPULODSelectionContext lodContext = _LODSelectionContexts[0];
    // Match MeshletListBuild's shadow-texel predicate and view scale exactly.
    float texelsPerWorldUnit = length(context.ViewProjectionMatrix[0].xyz) * lodContext.ScreenSizePixels.x * 0.5;
    float texelScaleSq = texelsPerWorldUnit * texelsPerWorldUnit;
    float threshold = _MeshLODErrorThreshold * instance.LODErrorScale;
    float3x3 columns = transpose((float3x3)instance.ObjectToWorldMatrix);
    float instanceScale = max(length(columns[0]), max(length(columns[1]), length(columns[2])));
    bool automaticErrorBounds = _ForcedMeshLODNodeDepth == VIVID_INVALID_FORCED_MESH_LOD_NODE_DEPTH
        && lodContext.CameraPosition.w == 0.0f && context.CameraIsPerspective == 0
        && ((uint)context.PassMask & VIVIDINSTANCEPASSMASK_SHADOWS) != 0u
        && isfinite(threshold) && threshold >= 0.0f
        && isfinite(texelScaleSq) && texelScaleSq > 0.0f
        && isfinite(instanceScale) && instanceScale > 0.0f;
    VSMLodTraversalState state;
    state.start = start; state.end = end; state.leafLevel = leafLevel;
    state.instanceScale = instanceScale; state.texelScaleSq = texelScaleSq;
    state.threshold = threshold; state.automaticErrorBounds = automaticErrorBounds;
    return state;
}
bool VSMLodMayVisit(VSMLodHierarchyNode node, VividInstanceData instance, uint contextIndex,
    float4x4 localToShadow, VSMLodTraversalState state)
{
    bool overlaps = node.Range.x < state.end && node.Range.x + node.Range.y > state.start;
    if (_ForcedMeshLODNodeDepth != VIVID_INVALID_FORCED_MESH_LOD_NODE_DEPTH)
        overlaps = overlaps && ((_ForcedMeshLODNodeDepth >= node.Min.w && _ForcedMeshLODNodeDepth <= node.Max.w)
            || (state.leafLevel < _ForcedMeshLODNodeDepth && state.leafLevel >= node.Min.w && state.leafLevel <= node.Max.w));
    if (overlaps && state.automaticErrorBounds)
        overlaps = VSMLodRangeMaySelect(node, instance, state.instanceScale, state.texelScaleSq, state.threshold);
    if (overlaps)
        overlaps = VividVSMCasterLocalBoundsOverlaps(contextIndex,
            (node.Min.xyz + node.Max.xyz) * 0.5, (node.Max.xyz - node.Min.xyz) * 0.5, 0.0, false, localToShadow);
    return overlaps;
}

// Stackless preorder traversal. Every leaf is aligned to a 32-record job in
// this mesh, so surviving jobs cannot exceed the existing queue capacity.
void TraverseVSMLodHierarchy(uint instanceID, VividInstanceData instance, uint contextIndex,
    uint jobsOffset, float4x4 localToShadow)
{
    uint start = instance.TopMeshLODStartIndex;
    uint count = start < _VSMLodRootCount ? min(instance.TotalMeshLODCount, _VSMLodRootCount - start) : 0u;
    if (count == 0u) return;
    uint end = start + count;
    uint index = start < _VSMLodRootCount ? _VSMLodRoots[start] : 0xffffffffu;
    if (index >= _VSMLodHierarchyCount)
    {
        // Preserve the original guarded flat path for incomplete source data.
        for (uint offset = 0u; offset < count; offset += 32u)
            EmitVSMLodJob(instanceID, contextIndex, jobsOffset, offset, min(count - offset, 32u));
        return;
    }
    uint stop = _VSMLodHierarchy[index].Range.z;
    VSMLodTraversalState state = VSMLodState(instance, contextIndex, start, end);
    [loop] while (index < stop)
    {
        VSMLodHierarchyNode node = _VSMLodHierarchy[index];
        bool overlaps = VSMLodMayVisit(node, instance, contextIndex, localToShadow, state);
        if (!overlaps) { index = node.Range.z; continue; }
        if (node.Range.w == 0u) { index++; continue; }
        uint first = max(node.Range.x, start), last = min(node.Range.x + node.Range.y, end);
        EmitVSMLodJob(instanceID, contextIndex, jobsOffset, first - start, last - first);
        index = node.Range.z;
    }
}
#if defined(VIVID_VSM_BATCH)
// One record per surviving long instance/view. The fourth args word is its count;
// the first three tile the work over X/Y so X never exceeds the dispatch limit.
RWStructuredBuffer<uint2> _VSMLodTraversalTasks;
RWStructuredBuffer<uint> _VSMLodTraversalArgs;
groupshared uint gVSMLodFrontier[32];
groupshared uint gVSMLodFrontierCount, gVSMLodNextCount;

void EnqueueVSMLodTraversal(uint instanceID, uint contextIndex)
{
    uint count = WaveActiveCountBits(true), prefix = WavePrefixCountBits(true), baseIndex = 0u;
    if (WaveIsFirstLane())
    {
        InterlockedAdd(_VSMLodTraversalArgs[3], count, baseIndex);
        uint end = baseIndex + count;
        InterlockedMax(_VSMLodTraversalArgs[0], min(end, 65535u));
        InterlockedMax(_VSMLodTraversalArgs[1], (end + 65534u) / 65535u);
    }
    _VSMLodTraversalTasks[WaveReadLaneFirst(baseIndex) + prefix] = uint2(instanceID, contextIndex);
}

void TraverseVSMLodGroup(uint lane, uint instanceID, uint contextIndex)
{
    VividInstanceData instance = PullInstanceData(instanceID);
    uint start = instance.TopMeshLODStartIndex;
    uint count = start < _VSMLodRootCount ? min(instance.TotalMeshLODCount, _VSMLodRootCount - start) : 0u;
    if (count == 0u) return; // Uniform for the entire group.
    uint end = start + count, root = _VSMLodRoots[start];
    uint jobsOffset = _CullingContexts[contextIndex].MeshletListBuildJobsOffset;
    if (root >= _VSMLodHierarchyCount)
    {
        // Disjoint 32-record chunks, including an incomplete final chunk.
        for (uint offset = lane * 32u; offset < count; offset += 1024u)
            EmitVSMLodJob(instanceID, contextIndex, jobsOffset, offset, min(32u, count - offset));
        return;
    }
    VSMLodTraversalState state = VSMLodState(instance, contextIndex, start, end);
    float4x4 localToShadow = mul(_VSMProjections[contextIndex].worldToShadow, instance.ObjectToWorldMatrix);
    if (lane == 0u) { gVSMLodFrontier[0] = root; gVSMLodFrontierCount = 1u; }
    GroupMemoryBarrierWithGroupSync();
    // Split only while at most 16 nodes are pending: two children per node always
    // fit in 32 slots. No unbounded stack, persistent queue or overflow fallback.
    [loop] while (gVSMLodFrontierCount != 0u && gVSMLodFrontierCount <= 16u)
    {
        bool branch = false;
        uint left = 0u, right = 0u;
        if (lane < gVSMLodFrontierCount)
        {
            uint index = gVSMLodFrontier[lane];
            VSMLodHierarchyNode node = _VSMLodHierarchy[index];
            if (VSMLodMayVisit(node, instance, contextIndex, localToShadow, state))
            {
                if (node.Range.w != 0u)
                {
                    uint first = max(node.Range.x, start), last = min(node.Range.x + node.Range.y, end);
                    EmitVSMLodJob(instanceID, contextIndex, jobsOffset, first - start, last - first);
                }
                else { branch = true; left = index + 1u; right = _VSMLodHierarchy[left].Range.z; }
            }
        }
        // All old frontier reads finish before any lane replaces its entries.
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u) gVSMLodNextCount = 0u;
        GroupMemoryBarrierWithGroupSync();
        uint children = branch ? 2u : 0u;
        uint prefix = WavePrefixSum(children), waveCount = WaveActiveSum(children), waveBase = 0u;
        if (WaveIsFirstLane() && waveCount != 0u) InterlockedAdd(gVSMLodNextCount, waveCount, waveBase);
        waveBase = WaveReadLaneFirst(waveBase);
        if (branch) { gVSMLodFrontier[waveBase + prefix] = left; gVSMLodFrontier[waveBase + prefix + 1u] = right; }
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u) gVSMLodFrontierCount = gVSMLodNextCount;
        GroupMemoryBarrierWithGroupSync();
    }
    // At most one disjoint subtree per lane. Wave compaction remains valid for
    // wave sizes below or above 32; no assumed hardware lane width or lane mask.
    uint index = lane < gVSMLodFrontierCount ? gVSMLodFrontier[lane] : 0u;
    uint stop = lane < gVSMLodFrontierCount ? _VSMLodHierarchy[index].Range.z : 0u;
    [loop] while (index < stop)
    {
        VSMLodHierarchyNode node = _VSMLodHierarchy[index];
        if (!VSMLodMayVisit(node, instance, contextIndex, localToShadow, state)) { index = node.Range.z; continue; }
        if (node.Range.w == 0u) { index++; continue; }
        uint first = max(node.Range.x, start), last = min(node.Range.x + node.Range.y, end);
        EmitVSMLodJob(instanceID, contextIndex, jobsOffset, first - start, last - first);
        index = node.Range.z;
    }
}
#endif

#endif

void RunCulling(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint cullingContextCount = max(_CullingContextCount, 1u);
#if defined(VIVID_VSM_COMPACT_VIEWS)
    uint cullingContextIndex;
    if (!VividVSMResolveActiveView(dispatchThreadID.y, cullingContextIndex)) return;
#else
    const uint cullingContextIndex = dispatchThreadID.y;
#endif
    if (cullingContextIndex >= cullingContextCount)
    {
        return;
    }

#if !defined(VIVID_VSM_COMPACT_VIEWS)
    if (dispatchThreadID.x == 0u && cullingContextIndex == 0u)
    {
        _MeshletListBuildIndirectArgs[1] = cullingContextCount;
        _MeshletListBuildIndirectArgs[2] = 1u;
    }

#endif

    const uint dispatchInstanceIndex = dispatchThreadID.x;
    if (_VividPrimitiveDrawSetEnabled != 0u &&
        dispatchInstanceIndex >= _VividPrimitiveDrawSetInstanceCount)
    {
        return;
    }

    const uint instanceID = _VividPrimitiveDrawSetEnabled != 0u
        ? _VividPrimitiveDrawSetInstanceIndices[dispatchInstanceIndex]
        : dispatchInstanceIndex;
    if (instanceID >= _InstanceDataCount)
    {
        return;
    }

    const VividInstanceData instanceData = PullInstanceData(instanceID);
    const VividGPUCullingContext cullingContext = _CullingContexts[cullingContextIndex];

    if ((instanceData.Flags & VIVIDINSTANCEFLAGS_DISABLED) != 0u ||
        (instanceData.PassMask & (uint) cullingContext.PassMask) == 0u)
    {
        return;
    }

#if defined(VIVID_VSM_AFFINE_BOUNDS)
    float3 centerOS = (instanceData.AABBMin.xyz + instanceData.AABBMax.xyz) * 0.5;
    float3 extentOS = (instanceData.AABBMax.xyz - instanceData.AABBMin.xyz) * 0.5;
    if (!VividVSMFrustumVsLocalBounds(cullingContext.FrustumPlanes, centerOS, extentOS,
            0.0, false, instanceData.ObjectToWorldMatrix)) return;
    float4x4 localToShadow = mul(_VSMProjections[cullingContextIndex].worldToShadow, instanceData.ObjectToWorldMatrix);
    if (!VividVSMCasterLocalBoundsOverlaps(cullingContextIndex, centerOS, extentOS, 0.0, false, localToShadow)) return;
#else
    const float4 boundingSphereWS = ComputeInstanceBoundingSphereWS(instanceData);
    if (!FrustumVsSphere(cullingContext, boundingSphereWS) ||
        !LightSphereCulling(cullingContext, boundingSphereWS))
    {
        return;
    }

#if defined(VIVID_VSM_EARLY_CULL)
    // Reject before allocating LOD traversal jobs.
    if (!VividVSMCasterSphereOverlaps(cullingContextIndex, boundingSphereWS)) return;
#endif

#endif

    const uint totalMeshLODCount = instanceData.TotalMeshLODCount;
    if (totalMeshLODCount == 0u)
    {
        return;
    }

#if defined(VIVID_VSM_BATCH)
    // Small ranges stay distributed across instance lanes; long ranges get a group.
    if (totalMeshLODCount > 128u)
    {
        EnqueueVSMLodTraversal(instanceID, cullingContextIndex);
        return;
    }
#endif
#if defined(VIVID_VSM_LOD_HIERARCHY)
    TraverseVSMLodHierarchy(instanceID, instanceData, cullingContextIndex, cullingContext.MeshletListBuildJobsOffset, localToShadow);
    return;
#endif

    const uint jobCount = (totalMeshLODCount + MAX_LODNODES_PER_THREAD_GROUP - 1u) / MAX_LODNODES_PER_THREAD_GROUP;

    uint jobWriteOffset;
    InterlockedAdd(_MeshletListBuildJobCounter[cullingContextIndex], jobCount, jobWriteOffset);
    InterlockedMax(_MeshletListBuildIndirectArgs[0], jobWriteOffset + jobCount);

    [loop]
    for (uint jobIndex = 0u; jobIndex < jobCount; ++jobIndex)
    {
        const uint offset = jobIndex * MAX_LODNODES_PER_THREAD_GROUP;
        const uint remainingNodeCount = totalMeshLODCount - offset;

        VividMeshletListBuildJob job;
        job.InstanceID = instanceID;
        job.MeshLODNodeOffset = offset;
        job.MeshLODNodeCount = min(remainingNodeCount, MAX_LODNODES_PER_THREAD_GROUP);
        job.Padding0 = 0u;
        _MeshletListBuildJobs[cullingContext.MeshletListBuildJobsOffset + jobWriteOffset + jobIndex] = job;
    }
}

#if defined(VIVID_VSM_EARLY_CULL)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSM(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RunCulling(dispatchThreadID);
}
#endif

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RunCulling(dispatchThreadID);
}

#if defined(VIVID_VSM_BUILD_COMPACT_VIEWS)
[numthreads(1, 1, 1)]
void CSCompactVSMViews(uint3 id : SV_DispatchThreadID)
{
    uint activeCount;
    VividVSMCompactViews(_CullingContextCount, (uint)_VSMCasterCullingParameters.w, activeCount);
    // This must also run for an empty view set, when the instance dispatch does not.
    _MeshletListBuildIndirectArgs[0] = 0u;
    _MeshletListBuildIndirectArgs[1] = activeCount;
    _MeshletListBuildIndirectArgs[2] = 1u;
}
#endif

#if defined(VIVID_VSM_COMPACT_VIEWS)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMCompacted(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RunCulling(dispatchThreadID);
}
#endif

#if defined(VIVID_VSM_LOD_HIERARCHY)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMHierarchy(uint3 id : SV_DispatchThreadID) { RunCulling(id); }
#endif

#if defined(VIVID_VSM_BATCH)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMHierarchyEnqueue(uint3 id : SV_DispatchThreadID) { RunCulling(id); }
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMHierarchyTraverse(uint3 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint task = group.x + group.y * 65535u;
    if (task >= _VSMLodTraversalArgs[3]) return;
    uint2 request = _VSMLodTraversalTasks[task];
    if (request.x >= _InstanceDataCount || request.y >= _CullingContextCount) return;
    TraverseVSMLodGroup(lane, request.x, request.y);
}
#endif
