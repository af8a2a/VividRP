#pragma kernel CS
#pragma kernel CSOcclusionTestAll
#pragma kernel CSFixupOccludedMeshletIndirectArgs
#pragma kernel CSPrepareOcclusionRetest
#pragma kernel CSOcclusionTestCulled
// Keep the old entry point during live script/shader reloads. Unity can import the
// compute shader before the matching managed assembly has finished reloading.
#pragma kernel CSOcclusionRetest
#pragma kernel CSCopyOccluderDepth
#pragma kernel CSDownsampleOccluderDepth

#pragma use_dxc
#pragma require Native16Bit

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GPUDriven/VividGPUDrivenCommon.hlsl"

#define FFX_WAVE 1
#define A_GPU 1
#define A_HLSL 1
#include "Packages/com.unity.render-pipelines.core/Runtime/PostProcessing/Shaders/ffx/ffx_a.hlsl"

#define THREAD_GROUP_SIZE 32

StructuredBuffer<VividGPUCullingContext> _CullingContexts;
uint _CullingContextCount;
StructuredBuffer<uint> _VisibleMeshletRenderRequestCounter;
StructuredBuffer<VividMeshletRenderRequestPacked> _CandidateMeshletRenderRequests;

RWStructuredBuffer<VividMeshletRenderRequestPacked> _VisibleMeshletRenderRequests;
RWStructuredBuffer<uint> _VisibleRendererListMeshletCounts;
RWByteAddressBuffer _VisibleMeshletIndirectDrawArgs;
RWStructuredBuffer<VividMeshletRenderRequestPacked> _OccludedMeshletRenderRequests;
RWStructuredBuffer<uint> _OccludedMeshletRenderRequestCounter;
RWStructuredBuffer<uint> _OccludedMeshletIndirectDispatchArgs;
RWStructuredBuffer<VividMeshletRenderRequestPacked> _RecoveredMeshletRenderRequests;
RWStructuredBuffer<uint> _RecoveredRendererListMeshletCounts;
RWByteAddressBuffer _RecoveredMeshletIndirectDrawArgs;

Texture2D<float> _InputDepth;
Texture2D<float> _OccluderDepthPyramid;
RWTexture2D<float> _OccluderDepthPyramidDestination;
RWTexture2D<float> rw_spd_mip0;
RWTexture2D<float> rw_spd_mip1;
RWTexture2D<float> rw_spd_mip2;
RWTexture2D<float> rw_spd_mip3;
RWTexture2D<float> rw_spd_mip4;
RWTexture2D<float> rw_spd_mip5;
globallycoherent RWTexture2D<float> rw_spd_mip6;
RWTexture2D<float> rw_spd_mip7;
RWTexture2D<float> rw_spd_mip8;
RWTexture2D<float> rw_spd_mip9;
RWTexture2D<float> rw_spd_mip10;
RWTexture2D<float> rw_spd_mip11;
RWTexture2D<float> rw_spd_mip12;

struct SpdGlobalAtomicBuffer
{
    uint counter[6];
};

globallycoherent RWStructuredBuffer<SpdGlobalAtomicBuffer> spdGlobalAtomic;

cbuffer spdConstants
{
    uint mips;
    uint numWorkGroups;
    uint2 workGroupOffset;
}

float4x4 _OccluderViewProjectionMatrix;
float4 _OccluderDepthPyramidSize;
float4 _OccluderDepthPyramidTextureSize;
uint _OccluderDepthPyramidMipCount;
float4 _OccluderSourceSize;
float4 _OccluderDestinationSize;
uint _OcclusionTestMode;
float _OcclusionDepthBias;
uint _OccludedMeshletCapacity;

bool IsFiniteFloat4(const float4 value)
{
    return all(value == value) && all(abs(value) < 3.402823466e+38f);
}

float FarthestDepth(const float lhs, const float rhs)
{
#if UNITY_REVERSED_Z
    return min(lhs, rhs);
#else
    return max(lhs, rhs);
#endif
}

float FarthestDepth4(const float4 depths)
{
    return FarthestDepth(
        FarthestDepth(depths.x, depths.y),
        FarthestDepth(depths.z, depths.w));
}

groupshared uint spdCounter;
groupshared float spdIntermediateR[16][16];
groupshared float spdIntermediateG[16][16];
groupshared float spdIntermediateB[16][16];
groupshared float spdIntermediateA[16][16];

float SpdReductionIdentity()
{
#if UNITY_REVERSED_Z
    return 1.0f;
#else
    return 0.0f;
#endif
}

float4 SpdLoadSourceImage(const int2 pixelCoord)
{
    const uint2 sourceSize = max(uint2(_OccluderDestinationSize.xy), 1u);
    if (any(uint2(pixelCoord) >= sourceSize))
        return SpdReductionIdentity().xxxx;

    return rw_spd_mip0[pixelCoord].xxxx;
}

float4 SpdLoad(const int2 pixelCoord)
{
    const uint2 sourceMipSize = max(uint2(_OccluderDestinationSize.xy) >> 6u, 1u);
    if (any(uint2(pixelCoord) >= sourceMipSize))
        return SpdReductionIdentity().xxxx;

    return rw_spd_mip6[pixelCoord].xxxx;
}

void SpdStore(const int2 pixelCoord, const float4 value, const uint mipLevel)
{
    switch (mipLevel)
    {
        case 0: rw_spd_mip1[pixelCoord] = value.x; break;
        case 1: rw_spd_mip2[pixelCoord] = value.x; break;
        case 2: rw_spd_mip3[pixelCoord] = value.x; break;
        case 3: rw_spd_mip4[pixelCoord] = value.x; break;
        case 4: rw_spd_mip5[pixelCoord] = value.x; break;
        case 5: rw_spd_mip6[pixelCoord] = value.x; break;
        case 6: rw_spd_mip7[pixelCoord] = value.x; break;
        case 7: rw_spd_mip8[pixelCoord] = value.x; break;
        case 8: rw_spd_mip9[pixelCoord] = value.x; break;
        case 9: rw_spd_mip10[pixelCoord] = value.x; break;
        case 10: rw_spd_mip11[pixelCoord] = value.x; break;
        case 11: rw_spd_mip12[pixelCoord] = value.x; break;
    }
}

void SpdIncreaseAtomicCounter(const uint slice)
{
    InterlockedAdd(spdGlobalAtomic[0].counter[slice], 1u, spdCounter);
}

uint SpdGetAtomicCounter()
{
    return spdCounter;
}

void SpdResetAtomicCounter(const uint slice)
{
    spdGlobalAtomic[0].counter[slice] = 0u;
}

float4 SpdLoadIntermediate(const uint x, const uint y)
{
    return float4(
        spdIntermediateR[x][y],
        spdIntermediateG[x][y],
        spdIntermediateB[x][y],
        spdIntermediateA[x][y]);
}

void SpdStoreIntermediate(const uint x, const uint y, const float4 value)
{
    spdIntermediateR[x][y] = value.x;
    spdIntermediateG[x][y] = value.y;
    spdIntermediateB[x][y] = value.z;
    spdIntermediateA[x][y] = value.w;
}

float4 SpdReduce4(const float4 v0, const float4 v1, const float4 v2, const float4 v3)
{
#if UNITY_REVERSED_Z
    return min(min(v0, v1), min(v2, v3));
#else
    return max(max(v0, v1), max(v2, v3));
#endif
}

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/FidelityFX/ffx_spd.hlsl"

bool IsVisibleAgainstOccluderDepth(const float occluderDepth, const float queryClosestDepth)
{
#if UNITY_REVERSED_Z
    return saturate(queryClosestDepth + _OcclusionDepthBias) > occluderDepth;
#else
    return saturate(queryClosestDepth - _OcclusionDepthBias) < occluderDepth;
#endif
}

bool TryBuildConservativeOcclusionQuery(
    const float4 boundingSphereWS,
    out uint2 minPixel,
    out uint2 maxPixel,
    out float queryClosestDepth)
{
    float2 minUv = float2(1.0f, 1.0f);
    float2 maxUv = float2(0.0f, 0.0f);
#if UNITY_REVERSED_Z
    queryClosestDepth = 0.0f;
#else
    queryClosestDepth = 1.0f;
#endif

    [unroll]
    for (uint cornerIndex = 0u; cornerIndex < 8u; ++cornerIndex)
    {
        const float3 cornerSign = float3(
            (cornerIndex & 1u) != 0u ? 1.0f : -1.0f,
            (cornerIndex & 2u) != 0u ? 1.0f : -1.0f,
            (cornerIndex & 4u) != 0u ? 1.0f : -1.0f);
        const float3 cornerWS = boundingSphereWS.xyz + cornerSign * boundingSphereWS.w;
        float4 cornerCS = mul(_OccluderViewProjectionMatrix, float4(cornerWS, 1.0f));
        if (!IsFiniteFloat4(cornerCS) || cornerCS.w <= 1e-5f)
        {
            minPixel = 0u;
            maxPixel = 0u;
            return false;
        }

#if UNITY_UV_STARTS_AT_TOP
        cornerCS.y = -cornerCS.y;
#endif
        const float3 cornerNdc = cornerCS.xyz / cornerCS.w;
        if (!IsFiniteFloat4(float4(cornerNdc, 0.0f)))
        {
            minPixel = 0u;
            maxPixel = 0u;
            return false;
        }

        const float2 cornerUv = cornerNdc.xy * 0.5f + 0.5f;
        minUv = min(minUv, cornerUv);
        maxUv = max(maxUv, cornerUv);
#if UNITY_REVERSED_Z
        queryClosestDepth = max(queryClosestDepth, cornerNdc.z);
#else
        queryClosestDepth = min(queryClosestDepth, cornerNdc.z);
#endif
    }

    const float2 pyramidSize = max(_OccluderDepthPyramidSize.xy, 1.0f);
    const float2 expandedMinPixel = minUv * pyramidSize - 2.0f;
    const float2 expandedMaxPixel = maxUv * pyramidSize + 2.0f;
    if (any(expandedMinPixel < 0.0f)
        || any(expandedMaxPixel >= pyramidSize)
        || any(expandedMaxPixel < expandedMinPixel))
    {
        minPixel = 0u;
        maxPixel = 0u;
        return false;
    }

    const float2 footprintSize = expandedMaxPixel - expandedMinPixel + 1.0f;
    if (max(footprintSize.x, footprintSize.y) > max(pyramidSize.x, pyramidSize.y) * 0.5f)
    {
        minPixel = 0u;
        maxPixel = 0u;
        return false;
    }

    minPixel = uint2(floor(expandedMinPixel));
    maxPixel = uint2(floor(expandedMaxPixel));
    return true;
}

bool IsMeshletVisibleAfterOcclusion(const float4 boundingSphereWS)
{
    if (_OcclusionTestMode == 0u
        || _OccluderDepthPyramidMipCount == 0u
        || any(_OccluderDepthPyramidSize.xy <= 0.0f))
    {
        return true;
    }

    uint2 minPixel;
    uint2 maxPixel;
    float queryClosestDepth;
    if (!TryBuildConservativeOcclusionQuery(
            boundingSphereWS,
            minPixel,
            maxPixel,
            queryClosestDepth))
    {
        return true;
    }

    uint mipLevel = 0u;
    [unroll]
    for (uint mipIndex = 0u; mipIndex < 16u; ++mipIndex)
    {
        mipLevel = mipIndex;
        const uint2 minCoord = minPixel >> mipIndex;
        const uint2 maxCoord = maxPixel >> mipIndex;
        if (all(maxCoord - minCoord <= 1u))
            break;
    }

    if (mipLevel >= _OccluderDepthPyramidMipCount)
        return true;

    const uint2 mipSize = max(uint2(1u, 1u), uint2(_OccluderDepthPyramidTextureSize.xy) >> mipLevel);
    const uint2 minCoord = minPixel >> mipLevel;
    const uint2 maxCoord = maxPixel >> mipLevel;
    // Hardware mip chains truncate odd dimensions. Queries reaching a truncated
    // tail must fail open instead of sampling the preceding texel block.
    if (any(maxCoord >= mipSize))
        return true;

    if (any(maxCoord - minCoord > 1u))
        return true;

    const float4 occluderDepths = float4(
        _OccluderDepthPyramid.Load(int3(minCoord, mipLevel)),
        _OccluderDepthPyramid.Load(int3(uint2(maxCoord.x, minCoord.y), mipLevel)),
        _OccluderDepthPyramid.Load(int3(uint2(minCoord.x, maxCoord.y), mipLevel)),
        _OccluderDepthPyramid.Load(int3(maxCoord, mipLevel)));
    const float occluderDepth = FarthestDepth4(occluderDepths);
    return IsVisibleAgainstOccluderDepth(occluderDepth, queryClosestDepth);
}

void AppendVisibleMeshlet(
    const VividMeshletRenderRequestPacked renderRequest,
    const uint rendererListIndex,
    const uint cullingContextIndex)
{
    const uint rendererListCountIndex =
        cullingContextIndex * VIVIDRENDERERLISTID_COUNT + rendererListIndex;
    const uint drawArgsAddress = GetIndirectDrawArgsByteAddress(rendererListCountIndex);

    uint localWriteOffset;
    _VisibleMeshletIndirectDrawArgs.InterlockedAdd(
        drawArgsAddress + VIVID_INDIRECT_DRAW_ARGS_INSTANCE_COUNT_OFFSET,
        1u,
        localWriteOffset);

    const uint startInstance = _VisibleMeshletIndirectDrawArgs.Load(
        drawArgsAddress + VIVID_INDIRECT_DRAW_ARGS_START_INSTANCE_OFFSET);
    const uint writeIndex = startInstance + localWriteOffset;
    _VisibleMeshletRenderRequests[writeIndex] = renderRequest;
    InterlockedAdd(_VisibleRendererListMeshletCounts[rendererListCountIndex], 1u);
}

bool TryResolveCulledMeshlet(
    const uint candidateIndex,
    const uint cullingContextIndex,
    out VividMeshletRenderRequestPacked renderRequest,
    out uint rendererListIndex,
    out float4 boundingSphereWS)
{
    if (candidateIndex >= _VisibleMeshletRenderRequestCounter[cullingContextIndex])
    {
        renderRequest.InstanceID_LOD = 0u;
        renderRequest.MeshletID = 0u;
        rendererListIndex = 0u;
        boundingSphereWS = 0.0f;
        return false;
    }

    const VividGPUCullingContext cullingContext = _CullingContexts[cullingContextIndex];
    renderRequest = _CandidateMeshletRenderRequests[cullingContext.MeshletRenderRequestsOffset + candidateIndex];

    if (renderRequest.MeshletID >= _MeshletCount)
    {
        rendererListIndex = 0u;
        boundingSphereWS = 0.0f;
        return false;
    }

    const VividInstanceData instanceData = PullInstanceData(renderRequest.InstanceID_LOD);
    const VividMaterialData materialData = PullMaterialData(instanceData.MaterialIndex);
    rendererListIndex = min(GetRendererListID(instanceData, materialData), VIVIDRENDERERLISTID_COUNT - 1u);
    const VividDecodedMeshlet meshlet = PullMeshletData(renderRequest.MeshletID);
    boundingSphereWS = TransformSphere(meshlet.BoundingSphere, instanceData.ObjectToWorldMatrix);

    if (!FrustumVsSphere(cullingContext, boundingSphereWS) ||
        !LightSphereCulling(cullingContext, boundingSphereWS))
    {
        return false;
    }

    if ((rendererListIndex & VIVIDRENDERERLISTID_CULL_OFF) == 0u &&
        !ConeCulling(cullingContext, instanceData, meshlet))
    {
        return false;
    }

    return true;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint cullingContextIndex = dispatchThreadID.y;
    if (cullingContextIndex >= max(_CullingContextCount, 1u))
    {
        return;
    }

    VividMeshletRenderRequestPacked renderRequest;
    uint rendererListIndex;
    float4 boundingSphereWS;
    if (!TryResolveCulledMeshlet(
            dispatchThreadID.x,
            cullingContextIndex,
            renderRequest,
            rendererListIndex,
            boundingSphereWS))
    {
        return;
    }

    AppendVisibleMeshlet(renderRequest, rendererListIndex, cullingContextIndex);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSOcclusionTestAll(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint cullingContextIndex = dispatchThreadID.y;
    if (cullingContextIndex >= max(_CullingContextCount, 1u))
    {
        return;
    }

    VividMeshletRenderRequestPacked renderRequest;
    uint rendererListIndex;
    float4 boundingSphereWS;
    if (!TryResolveCulledMeshlet(
            dispatchThreadID.x,
            cullingContextIndex,
            renderRequest,
            rendererListIndex,
            boundingSphereWS))
    {
        return;
    }

    if (!IsMeshletVisibleAfterOcclusion(boundingSphereWS))
    {
        uint occludedIndex;
        InterlockedAdd(_OccludedMeshletRenderRequestCounter[0], 1u, occludedIndex);
        if (occludedIndex < _OccludedMeshletCapacity)
        {
            _OccludedMeshletRenderRequests[occludedIndex] = renderRequest;
            return;
        }
    }

    AppendVisibleMeshlet(renderRequest, rendererListIndex, cullingContextIndex);
}

[numthreads(1, 1, 1)]
void CSFixupOccludedMeshletIndirectArgs(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x != 0u)
        return;

    const uint occludedCount = min(_OccludedMeshletRenderRequestCounter[0], _OccludedMeshletCapacity);
    _OccludedMeshletIndirectDispatchArgs[0] = (occludedCount + THREAD_GROUP_SIZE - 1u) / THREAD_GROUP_SIZE;
    _OccludedMeshletIndirectDispatchArgs[1] = 1u;
    _OccludedMeshletIndirectDispatchArgs[2] = 1u;
}

[numthreads(VIVIDRENDERERLISTID_COUNT, 1, 1)]
void CSPrepareOcclusionRetest(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint rendererListIndex = dispatchThreadID.x;
    if (rendererListIndex >= VIVIDRENDERERLISTID_COUNT)
        return;

    const uint drawArgsAddress = GetIndirectDrawArgsByteAddress(rendererListIndex);
    const uint firstPassStart = _VisibleMeshletIndirectDrawArgs.Load(
        drawArgsAddress + VIVID_INDIRECT_DRAW_ARGS_START_INSTANCE_OFFSET);
    _RecoveredMeshletIndirectDrawArgs.Store4(
        drawArgsAddress,
        uint4(
            VIVID_MAX_MESHLET_INDICES,
            0u,
            0u,
            firstPassStart));
    _RecoveredRendererListMeshletCounts[rendererListIndex] = 0u;
}

void ExecuteOcclusionTestCulled(const uint3 dispatchThreadID)
{
    const uint occludedIndex = dispatchThreadID.x;
    const uint occludedCount = min(_OccludedMeshletRenderRequestCounter[0], _OccludedMeshletCapacity);
    if (occludedIndex >= occludedCount)
        return;

    const VividMeshletRenderRequestPacked renderRequest = _OccludedMeshletRenderRequests[occludedIndex];
    if (renderRequest.MeshletID >= _MeshletCount)
        return;

    const VividInstanceData instanceData = PullInstanceData(renderRequest.InstanceID_LOD);
    const VividMaterialData materialData = PullMaterialData(instanceData.MaterialIndex);
    const uint rendererListIndex = min(GetRendererListID(instanceData, materialData), VIVIDRENDERERLISTID_COUNT - 1u);
    const VividDecodedMeshlet meshlet = PullMeshletData(renderRequest.MeshletID);
    const float4 boundingSphereWS = TransformSphere(meshlet.BoundingSphere, instanceData.ObjectToWorldMatrix);
    if (!IsMeshletVisibleAfterOcclusion(boundingSphereWS))
        return;

    const uint drawArgsAddress = GetIndirectDrawArgsByteAddress(rendererListIndex);
    uint localWriteOffset;
    _RecoveredMeshletIndirectDrawArgs.InterlockedAdd(
        drawArgsAddress + VIVID_INDIRECT_DRAW_ARGS_INSTANCE_COUNT_OFFSET,
        1u,
        localWriteOffset);
    const uint startInstance = _RecoveredMeshletIndirectDrawArgs.Load(
        drawArgsAddress + VIVID_INDIRECT_DRAW_ARGS_START_INSTANCE_OFFSET);
    _RecoveredMeshletRenderRequests[startInstance + localWriteOffset] = renderRequest;
    InterlockedAdd(_RecoveredRendererListMeshletCounts[rendererListIndex], 1u);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSOcclusionTestCulled(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    ExecuteOcclusionTestCulled(dispatchThreadID);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSOcclusionRetest(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    ExecuteOcclusionTestCulled(dispatchThreadID);
}

[numthreads(8, 8, 1)]
void CSCopyOccluderDepth(const uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint2 pixelCoord = dispatchThreadID.xy;
    const uint2 destinationSize = uint2(_OccluderDestinationSize.xy);
    if (any(pixelCoord >= destinationSize))
        return;

    const uint2 inputSize = uint2(_OccluderSourceSize.xy);
    if (all(pixelCoord < inputSize))
    {
        _OccluderDepthPyramidDestination[pixelCoord] = _InputDepth.Load(int3(pixelCoord, 0));
        return;
    }

#if UNITY_REVERSED_Z
    _OccluderDepthPyramidDestination[pixelCoord] = 0.0f;
#else
    _OccluderDepthPyramidDestination[pixelCoord] = 1.0f;
#endif
}

[numthreads(256, 1, 1)]
void CSDownsampleOccluderDepth(
    const uint3 workGroupID : SV_GroupID,
    const uint localThreadIndex : SV_GroupIndex)
{
    SpdDownsample(
        uint2(workGroupID.xy),
        localThreadIndex,
        mips,
        numWorkGroups,
        workGroupID.z,
        workGroupOffset);
}
