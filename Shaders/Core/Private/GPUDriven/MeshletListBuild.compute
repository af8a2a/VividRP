#pragma kernel CS

#pragma kernel CSVSM VIVID_VSM_EARLY_CULL
#pragma kernel CSVSMCompacted VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS
#pragma kernel CSVSMBounds VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS VIVID_VSM_AFFINE_BOUNDS
#pragma kernel CSVSMBoundsBatched VIVID_VSM_EARLY_CULL VIVID_VSM_COMPACT_VIEWS VIVID_VSM_AFFINE_BOUNDS VIVID_VSM_BATCH
#pragma use_dxc
#pragma require wavebasic waveballot wavemath : VIVID_VSM_BATCH

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GPUDriven/VividGPUDrivenCommon.hlsl"
#if defined(VIVID_VSM_EARLY_CULL)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMPageCulling.hlsl"
#endif

#if defined(VIVID_VSM_COMPACT_VIEWS) || defined(VIVID_VSM_BUILD_COMPACT_VIEWS)
#include "Packages/com.vivid.render-pipelines/Shaders/VirtualShadowMap/Private/VSMViewCompaction.hlsl"
#endif

#define THREAD_GROUP_SIZE 32

uint _ForcedMeshLODNodeDepth;
float _MeshLODErrorThreshold;
uint _CullingContextCount;

StructuredBuffer<VividGPUCullingContext> _CullingContexts;
StructuredBuffer<VividGPULODSelectionContext> _LODSelectionContexts;

StructuredBuffer<VividMeshletListBuildJob> _MeshletListBuildJobs;
StructuredBuffer<uint> _MeshletListBuildJobCounter;

RWStructuredBuffer<VividMeshletRenderRequestPacked> _CandidateMeshletRenderRequests;
RWStructuredBuffer<uint> _VisibleMeshletRenderRequestCounter;
RWStructuredBuffer<uint> _VisibleRendererListMeshletCounts;

void RunCulling(const uint3 groupThreadID : SV_GroupThreadID, const uint3 groupID : SV_GroupID)
{
#if defined(VIVID_VSM_COMPACT_VIEWS)
    uint cullingContextIndex;
    if (!VividVSMResolveActiveView(groupID.y, cullingContextIndex)) return;
#else
    const uint cullingContextIndex = groupID.y;
#endif
    if (cullingContextIndex >= max(_CullingContextCount, 1u) ||
        groupID.x >= _MeshletListBuildJobCounter[cullingContextIndex])
    {
        return;
    }

    const VividGPUCullingContext cullingContext = _CullingContexts[cullingContextIndex];
    const VividGPULODSelectionContext lodSelectionContext = _LODSelectionContexts[0];
    const VividMeshletListBuildJob job = _MeshletListBuildJobs[cullingContext.MeshletListBuildJobsOffset + groupID.x];
    const VividInstanceData instanceData = PullInstanceData(job.InstanceID);
    const VividMaterialData materialData = PullMaterialData(instanceData.MaterialIndex);

    const float3 aabbCenterOS = (instanceData.AABBMin.xyz + instanceData.AABBMax.xyz) * 0.5f;
    const float3 aabbCenterWS = TransformPosition(instanceData.ObjectToWorldMatrix, aabbCenterOS);
    const float distanceToViewSq = LengthSq(lodSelectionContext.CameraPosition.xyz - aabbCenterWS);
    const uint baseNodeIndex = instanceData.TopMeshLODStartIndex + job.MeshLODNodeOffset;

#if defined(VIVID_VSM_EARLY_CULL)
    [loop]
#endif
    for (uint nodeOffset = groupThreadID.x; nodeOffset < job.MeshLODNodeCount; nodeOffset += THREAD_GROUP_SIZE)
    {
        const uint nodeIndex = baseNodeIndex + nodeOffset;
        if (nodeIndex >= _MeshLODNodeCount)
        {
            continue;
        }

        const VividDecodedMeshLODNode meshLODNode = PullMeshLODNode(nodeIndex);
        // CameraPosition.w == 0 is the VSM clipmap LOD mode. Evaluate error in
        // shadow texels per level, independent of observer position/FOV/viewport.
        const bool shadowTexelLOD = lodSelectionContext.CameraPosition.w == 0.0
            && cullingContext.CameraIsPerspective == 0
            && (cullingContext.PassMask & VIVIDINSTANCEPASSMASK_SHADOWS) != 0u;
        const float texelsPerWorldUnit = length(cullingContext.ViewProjectionMatrix[0].xyz)
            * lodSelectionContext.ScreenSizePixels.x * 0.5;
        bool selected = shadowTexelLOD
            ? ShouldSelectShadowMeshLODNode(meshLODNode, instanceData, texelsPerWorldUnit,
                _ForcedMeshLODNodeDepth, _MeshLODErrorThreshold)
            : ShouldSelectMeshLODNode(
                lodSelectionContext,
                meshLODNode,
                instanceData,
                distanceToViewSq,
                _ForcedMeshLODNodeDepth,
                _MeshLODErrorThreshold
            );
        if (!selected)
        {
            continue;
        }

#if defined(VIVID_VSM_EARLY_CULL)
#if defined(VIVID_VSM_AFFINE_BOUNDS)
        if (!VividVSMCasterLocalBoundsOverlaps(cullingContextIndex, meshLODNode.Bounds.xyz,
            0.0, meshLODNode.Bounds.w, true,
            mul(_VSMProjections[cullingContextIndex].worldToShadow, instanceData.ObjectToWorldMatrix))) continue;
#else
        // Reject selected node bounds before expanding meshlets and reserving requests.
        if (!VividVSMCasterSphereOverlaps(cullingContextIndex,
                TransformSphere(meshLODNode.Bounds, instanceData.ObjectToWorldMatrix))) continue;
#endif
#endif

        const uint rendererListIndex = min(
            GetRendererListID(instanceData, materialData, (uint) cullingContext.PassMask),
            VIVIDRENDERERLISTID_COUNT - 1u);

#if defined(VIVID_VSM_BATCH)
        // Every lane in a job shares the instance/material/view, so this wave can
        // reserve both counters once for the complete variable-length expansion.
        uint batchCount = WaveActiveSum(meshLODNode.MeshletCount);
        uint prefix = WavePrefixSum(meshLODNode.MeshletCount), baseIndex = 0u;
        if (WaveIsFirstLane() && batchCount != 0u)
        {
            InterlockedAdd(_VisibleMeshletRenderRequestCounter[cullingContextIndex], batchCount, baseIndex);
            InterlockedAdd(_VisibleRendererListMeshletCounts[cullingContextIndex * VIVIDRENDERERLISTID_COUNT + rendererListIndex], batchCount);
        }
        uint firstRequest = WaveReadLaneFirst(baseIndex) + prefix;
        [loop] for (uint meshletIndex = 0u; meshletIndex < meshLODNode.MeshletCount; ++meshletIndex)
        {
            VividMeshletRenderRequestPacked request;
            request.InstanceID_LOD = job.InstanceID;
            request.MeshletID = meshLODNode.MeshletStartIndex + meshletIndex;
            _CandidateMeshletRenderRequests[cullingContext.MeshletRenderRequestsOffset + firstRequest + meshletIndex] = request;
        }
#else
        [loop]
        for (uint meshletIndex = 0u; meshletIndex < meshLODNode.MeshletCount; ++meshletIndex)
        {
            uint requestIndex;
            InterlockedAdd(_VisibleMeshletRenderRequestCounter[cullingContextIndex], 1u, requestIndex);

            VividMeshletRenderRequestPacked request;
            request.InstanceID_LOD = job.InstanceID;
            request.MeshletID = meshLODNode.MeshletStartIndex + meshletIndex;
            _CandidateMeshletRenderRequests[cullingContext.MeshletRenderRequestsOffset + requestIndex] = request;

            const uint rendererListCountIndex =
                cullingContextIndex * VIVIDRENDERERLISTID_COUNT + rendererListIndex;
            InterlockedAdd(_VisibleRendererListMeshletCounts[rendererListCountIndex], 1u);
        }
#endif
    }
}

#if defined(VIVID_VSM_EARLY_CULL)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSM(uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID)
{
    RunCulling(groupThreadID, groupID);
}
#endif

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS(uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID)
{
    RunCulling(groupThreadID, groupID);
}

#if defined(VIVID_VSM_COMPACT_VIEWS)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMCompacted(uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID)
{
    RunCulling(groupThreadID, groupID);
}
#endif

#if defined(VIVID_VSM_AFFINE_BOUNDS)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMBounds(uint3 lane : SV_GroupThreadID, uint3 group : SV_GroupID) { RunCulling(lane, group); }
#endif

#if defined(VIVID_VSM_BATCH)
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSVSMBoundsBatched(uint3 lane : SV_GroupThreadID, uint3 group : SV_GroupID) { RunCulling(lane, group); }
#endif
