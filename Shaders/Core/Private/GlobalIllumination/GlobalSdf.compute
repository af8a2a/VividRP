#pragma kernel ComposeGlobalSdf
#pragma kernel ComposeGlobalSdfSparse VIVID_SPARSE_MESH_DISTANCE_FIELDS
#pragma kernel ClearGlobalSdfPages
#pragma kernel CopyGlobalSdfPageBorders
#pragma kernel SeedGlobalSdfMip
#pragma kernel PropagateGlobalSdfMip
#pragma kernel ComposeGlobalSdfThinBricks
#pragma kernel TraceGlobalSdfDebug

#include "../../Public/GPUDriven/GlobalSdf.hlsl"
#if defined(VIVID_SPARSE_MESH_DISTANCE_FIELDS)
#include "../../Public/GPUDriven/SparseMeshDistanceField.hlsl"
#define ComposeGlobalSdf ComposeGlobalSdfSparse
#endif

RWTexture3D<float> _GlobalSdfWrite;
RWStructuredBuffer<uint> _GlobalSdfThinBrickWrites;
int3 _GlobalSdfRegionMin;
int3 _GlobalSdfRegionSize;
float _GlobalSdfVoxelSize;
uint _GlobalSdfWriteLevel;
uint _GlobalSdfFirstPage;

float GlobalSdfSampleField(VividMeshSdfField field, float3 positionInGrid)
{
    if (field.pageOffset == VividMeshSdfDense)
        return VividMeshSdfSample(field, positionInGrid);

    float voxelSize = field.originAndVoxelSize.w;
    float3 voxel = clamp(positionInGrid / voxelSize, 0.0, float3(field.dimensions - 1u));
    uint3 counts = VividMeshSdfBrickCount(field.dimensions);
    uint3 brick = min(uint3(voxel) / VividMeshSdfBrickCells, counts - 1u);
    uint page = VividMeshSdfPage(field.pageOffset, brick, counts);
    if (page != VividMeshSdfEmptyOutside)
    {
        if (page == VividMeshSdfEmptyInside)
            return -VividMeshSdfBandVoxels * voxelSize;
        uint3 start = brick * VividMeshSdfBrickCells;
        uint3 size = min(field.dimensions - start, VividMeshSdfBrickCells + 1u);
        return VividMeshSdfSampleBrick(field, size, page, voxel - start);
    }

    // EmptyOutside bricks omit samples beyond VividMeshSdfBandVoxels * voxelSize.
    // Returning that small constant fills open air with sub-voxel distances in coarse
    // clipmap levels (e.g. 0.20m < 0.25m expandSurfaceDistance in Level 2). Compute a
    // conservative lower bound from the 3x3x3 brick neighborhood instead.
    float brickSize = float(VividMeshSdfBrickCells);
    float3 bMin = float3(brick) * brickSize;
    float3 bMax = min(bMin + brickSize, float3(field.dimensions - 1u));
    float distSq = FLT_MAX;
    if (brick.x > 1u) { float d = voxel.x - (bMin.x - brickSize); distSq = min(distSq, d * d); }
    if (brick.x + 2u < counts.x) { float d = (bMax.x + brickSize) - voxel.x; distSq = min(distSq, d * d); }
    if (brick.y > 1u) { float d = voxel.y - (bMin.y - brickSize); distSq = min(distSq, d * d); }
    if (brick.y + 2u < counts.y) { float d = (bMax.y + brickSize) - voxel.y; distSq = min(distSq, d * d); }
    if (brick.z > 1u) { float d = voxel.z - (bMin.z - brickSize); distSq = min(distSq, d * d); }
    if (brick.z + 2u < counts.z) { float d = (bMax.z + brickSize) - voxel.z; distSq = min(distSq, d * d); }

    int3 lo = max(int3(brick) - 1, 0);
    int3 hi = min(int3(brick) + 1, int3(counts) - 1);
    for (int nz = lo.z; nz <= hi.z; nz++)
    for (int ny = lo.y; ny <= hi.y; ny++)
    for (int nx = lo.x; nx <= hi.x; nx++)
    {
        uint3 n = uint3(nx, ny, nz);
        if (all(n == brick))
            continue;
        if (VividMeshSdfPage(field.pageOffset, n, counts) == VividMeshSdfEmptyOutside)
            continue;
        float3 nMin = float3(n) * brickSize;
        float3 nMax = min(nMin + brickSize, float3(field.dimensions - 1u));
        float3 gap = max(0.0, max(nMin - voxel, voxel - nMax));
        distSq = min(distSq, dot(gap, gap));
    }

    if (distSq >= FLT_MAX * 0.5)
        return FLT_MAX;
    return sqrt(distSq + VividMeshSdfBandVoxels * VividMeshSdfBandVoxels) * voxelSize;
}

float GlobalSdfInstanceDistance(VividMeshSdfInstance instance, VividMeshSdfField field, float3 positionWS)
{
    float4 p = float4(positionWS, 1.0);
    float3 local = float3(dot(instance.worldToLocal0, p), dot(instance.worldToLocal1, p),
        dot(instance.worldToLocal2, p)) - field.originAndVoxelSize.xyz;
    float3 extent = float3(field.dimensions - 1u) * field.originAndVoxelSize.w;
    float3 clamped = clamp(local, 0.0, extent);
    float distance = GlobalSdfSampleField(field, clamped);
    if (distance >= FLT_MAX * 0.5)
        return FLT_MAX;
    float outsideSquared = dot(local - clamped, local - clamped);
    if (outsideSquared > 0.0)
    {
        // The baked grid encloses the surface. Outside it, extend from the positive boundary.
        float boundary = max(0.0, distance);
        distance = sqrt(outsideSquared + boundary * boundary);
    }
    return distance * instance.distanceScale;
}

[numthreads(4, 4, 4)]
void ComposeGlobalSdf(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_GlobalSdfRegionSize)))
        return;

    int3 cell = _GlobalSdfRegionMin + int3(id);
    uint3 physical = uint3(cell & (VividGlobalSdfResolution - 1));
    uint page = VividGlobalSdfPage(physical, _GlobalSdfWriteLevel);
    if (page == 0u)
        return;

    float3 position = float3(cell) * _GlobalSdfVoxelSize;
    float band = VividGlobalSdfBand * _GlobalSdfVoxelSize;
    float surface = band;
    uint nodeIndex = 0u;
    [loop]
    while (nodeIndex < _MeshSdfNodeCount)
    {
        VividMeshSdfNode node = _MeshSdfNodes[nodeIndex];
        float3 outside = max(0.0, max(node.boundsMin - position, position - node.boundsMax));
        float boxDistanceSquared = dot(outside, outside);
        float limit = max(surface, 0.0);
        if ((node.layerMask & _GlobalSdfLayerMask) == 0u || boxDistanceSquared > limit * limit)
        {
            nodeIndex = node.escapeIndex;
            continue;
        }
        nodeIndex++;
        if (node.leafCount == 0u)
            continue;

        float boxDistance = sqrt(boxDistanceSquared);
        [loop]
        for (uint i = 0u; i < node.leafCount; i++)
        {
            uint instanceIndex = _MeshSdfLeafInstances[node.firstLeaf + i];
            VividMeshSdfInstance instance = _MeshSdfInstances[instanceIndex];
            if ((instance.layerMask & _GlobalSdfLayerMask) == 0u)
                continue;
#if defined(VIVID_SPARSE_MESH_DISTANCE_FIELDS)
            uint objectOffset = instanceIndex * 4u;
            float4 localToVolume = _SparseSdfObjects[objectOffset];
            if (localToVolume.w >= 0.0)
            {
                float4 p = float4(position, 1.0);
                float3 localPosition = float3(dot(instance.worldToLocal0, p), dot(instance.worldToLocal1, p),
                    dot(instance.worldToLocal2, p));
                surface = min(surface, SparseDistanceToNearestSurfaceForObject(objectOffset, localToVolume, localPosition, surface));
                continue;
            }
#endif
            VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
            float distance = GlobalSdfInstanceDistance(instance, field, position);
            surface = min(surface, distance > 0.0 ? max(distance, boxDistance) : distance);
        }
    }

    _GlobalSdfWrite[VividGlobalSdfAtlasCell(page - 1u, physical)] =
        clamp(surface / _GlobalSdfVoxelSize, -VividGlobalSdfBand, VividGlobalSdfBand);
}

[numthreads(4, 4, 4)]
void ClearGlobalSdfPages(uint3 id : SV_DispatchThreadID)
{
    uint slot = _GlobalSdfFirstPage + (id.x >> VividGlobalSdfBrickShift);
    _GlobalSdfWrite[VividGlobalSdfAtlasCell(slot, id)] = VividGlobalSdfBand;
}

[numthreads(64, 1, 1)]
void CopyGlobalSdfPageBorders(uint3 groupId : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint group = groupId.x;
    uint page = _GlobalSdfPages[_GlobalSdfWriteLevel * VividGlobalSdfPagesPerLevel + group];
    if (page == 0u)
        return;

    uint3 brick = uint3(group % VividGlobalSdfBrickResolution,
        group / VividGlobalSdfBrickResolution % VividGlobalSdfBrickResolution, group / VividGlobalSdfPagesPerSlice);
    uint3 physical = brick * VividGlobalSdfBrickSize;
    uint3 dst = VividGlobalSdfAtlasCell(page - 1u, physical);
    const uint faceZ = VividGlobalSdfStoredBrickSize * VividGlobalSdfStoredBrickSize;
    const uint faceY = VividGlobalSdfStoredBrickSize * VividGlobalSdfBrickSize;
    const uint faceX = VividGlobalSdfBrickSize * VividGlobalSdfBrickSize;
    for (uint i = lane; i < faceZ + faceY + faceX; i += 64u)
    {
        uint3 texel;
        if (i < faceZ)
            texel = uint3(i % VividGlobalSdfStoredBrickSize, i / VividGlobalSdfStoredBrickSize, VividGlobalSdfBrickSize);
        else if (i < faceZ + faceY)
        {
            uint j = i - faceZ;
            texel = uint3(j % VividGlobalSdfStoredBrickSize, VividGlobalSdfBrickSize, j / VividGlobalSdfStoredBrickSize);
        }
        else
        {
            uint j = i - faceZ - faceY;
            texel = uint3(VividGlobalSdfBrickSize, j % VividGlobalSdfBrickSize, j / VividGlobalSdfBrickSize);
        }

        // The source is always an interior sample, including at a toroidal seam.
        uint3 sourceCell = (physical + texel) & (uint(VividGlobalSdfResolution) - 1u);
        uint sourcePage = VividGlobalSdfPage(sourceCell, _GlobalSdfWriteLevel);
        float distance = VividGlobalSdfBand;
        if (sourcePage != 0u)
            distance = _GlobalSdfWrite[VividGlobalSdfAtlasCell(sourcePage - 1u, sourceCell)];
        _GlobalSdfWrite[dst + texel] = distance;
    }
}

Texture3D<float> _GlobalSdfMipFineAtlas;
Texture3D<float> _GlobalSdfMipSource;
RWTexture3D<float> _GlobalSdfMipOutput;
uint _GlobalSdfMipReadOffset;
uint _GlobalSdfMipWriteOffset;

// GlobalDistanceFieldMip.usf uses the sorted axis minima for one Eikonal iteration.
// The step is expressed in decoded fine voxels so it equals the mip factor.
float PropagateGlobalSdfDistance(float center, float3 v)
{
    float minV = min(v.x, min(v.y, v.z));
    float maxV = max(v.x, max(v.y, v.z));
    float x = minV;
    float y = (v.x != minV && v.x != maxV) ? v.x : ((v.y != minV && v.y != maxV) ? v.y : v.z);
    float z = maxV;
    const float step = VividGlobalSdfMipFactor;
    center = min(center, x + step);
    float sum = x + y;
    float sumSquared = x * x + y * y;
    center = min(center, (1.0f / 2.0f) * (sum + sqrt(sum * sum - 2.0f * (sumSquared - step * step))));
    sum = x + y + z;
    sumSquared = x * x + y * y + z * z;
    center = min(center, (1.0f / 3.0f) * (sum + sqrt(sum * sum - 3.0f * (sumSquared - step * step))));
    return center;
}

float SeedGlobalSdfMipCell(int3 coord)
{
    coord = clamp(coord, 0, int(VividGlobalSdfMipResolution) - 1);
    float3 grid = (float3(coord) + 0.5f) * VividGlobalSdfMipFactor - 0.5f;
    float3 cell = grid + _GlobalSdfScroll[_GlobalSdfWriteLevel].xyz;
    float detailed = VividGlobalSdfSampleAtlas(_GlobalSdfMipFineAtlas, cell, _GlobalSdfWriteLevel);
    return detailed < VividGlobalSdfMipTransition ? max(detailed, -VividGlobalSdfMipTransition) : VividGlobalSdfMipBand;
}

[numthreads(4, 4, 4)]
void SeedGlobalSdfMip(uint3 id : SV_DispatchThreadID)
{
    int3 p = int3(id);
    float3 v;
    v.x = min(SeedGlobalSdfMipCell(p - int3(1, 0, 0)), SeedGlobalSdfMipCell(p + int3(1, 0, 0)));
    v.y = min(SeedGlobalSdfMipCell(p - int3(0, 1, 0)), SeedGlobalSdfMipCell(p + int3(0, 1, 0)));
    v.z = min(SeedGlobalSdfMipCell(p - int3(0, 0, 1)), SeedGlobalSdfMipCell(p + int3(0, 0, 1)));
    _GlobalSdfMipOutput[id + uint3(0, 0, _GlobalSdfMipWriteOffset)] =
        PropagateGlobalSdfDistance(SeedGlobalSdfMipCell(p), v);
}

float LoadGlobalSdfMipCell(int3 coord)
{
    coord = clamp(coord, 0, int(VividGlobalSdfMipResolution) - 1);
    coord.z += _GlobalSdfMipReadOffset;
    return _GlobalSdfMipSource.Load(int4(coord, 0));
}

[numthreads(4, 4, 4)]
void PropagateGlobalSdfMip(uint3 id : SV_DispatchThreadID)
{
    int3 p = int3(id);
    float3 v;
    v.x = min(LoadGlobalSdfMipCell(p - int3(1, 0, 0)), LoadGlobalSdfMipCell(p + int3(1, 0, 0)));
    v.y = min(LoadGlobalSdfMipCell(p - int3(0, 1, 0)), LoadGlobalSdfMipCell(p + int3(0, 1, 0)));
    v.z = min(LoadGlobalSdfMipCell(p - int3(0, 0, 1)), LoadGlobalSdfMipCell(p + int3(0, 0, 1)));
    _GlobalSdfMipOutput[id + uint3(0, 0, _GlobalSdfMipWriteOffset)] =
        PropagateGlobalSdfDistance(LoadGlobalSdfMipCell(p), v);
}

bool GlobalSdfBrickContainsThinShell(float3 center, float halfExtent)
{
    uint nodeIndex = 0u;
    [loop]
    while (nodeIndex < _MeshSdfNodeCount)
    {
        VividMeshSdfNode node = _MeshSdfNodes[nodeIndex];
        if ((node.layerMask & _GlobalSdfLayerMask) == 0u
            || any(center + halfExtent < node.boundsMin) || any(center - halfExtent > node.boundsMax))
        {
            nodeIndex = node.escapeIndex;
            continue;
        }
        nodeIndex++;
        [loop]
        for (uint i = 0u; i < node.leafCount; i++)
        {
            VividMeshSdfInstance instance = _MeshSdfInstances[_MeshSdfLeafInstances[node.firstLeaf + i]];
            if ((instance.layerMask & _GlobalSdfLayerMask) == 0u)
                continue;
            VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
            if (!VividMeshSdfIsSubvoxelShell(field, instance, _GlobalSdfVoxelSize))
                continue;

            // Transform the brick bounds conservatively into the baked grid's local space.
            float4 p = float4(center, 1.0);
            float3 localCenter = float3(dot(instance.worldToLocal0, p), dot(instance.worldToLocal1, p),
                dot(instance.worldToLocal2, p)) - field.originAndVoxelSize.xyz;
            float3 localHalf = halfExtent * float3(dot(abs(instance.worldToLocal0.xyz), 1.0),
                dot(abs(instance.worldToLocal1.xyz), 1.0), dot(abs(instance.worldToLocal2.xyz), 1.0));
            float3 gridExtent = float3(field.dimensions - 1u) * field.originAndVoxelSize.w;
            if (all(localCenter + localHalf >= 0.0) && all(localCenter - localHalf <= gridExtent))
                return true;
        }
    }
    return false;
}

[numthreads(4, 4, 4)]
void ComposeGlobalSdfThinBricks(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_GlobalSdfRegionSize)))
        return;

    int3 brick = _GlobalSdfRegionMin + int3(id);
    float size = VividGlobalSdfThinBrickSize * _GlobalSdfVoxelSize;
    float3 center = (float3(brick) + 0.5) * size;
    uint word, bit;
    VividGlobalSdfThinBrickBit(brick, _GlobalSdfWriteLevel, word, bit);
    if (GlobalSdfBrickContainsThinShell(center, size * 0.5 + 0.0001 * _GlobalSdfVoxelSize))
        InterlockedOr(_GlobalSdfThinBrickWrites[word], bit);
    else
        InterlockedAnd(_GlobalSdfThinBrickWrites[word], ~bit);
}

RWTexture2D<float4> _GlobalSdfDebugOutput;
float4x4 _GlobalSdfInverseViewProjection;
float4 _GlobalSdfScreenSize;
float _GlobalSdfFarClip;
float _GlobalSdfSliceHeight;
uint _GlobalSdfDebugMode;

[numthreads(8, 8, 1)]
void TraceGlobalSdfDebug(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(_GlobalSdfScreenSize.xy)))
        return;

    float2 ndc = (id.xy + 0.5) * (2.0 * _GlobalSdfScreenSize.zw) - 1.0;
    #if UNITY_UV_STARTS_AT_TOP
        ndc.y = -ndc.y;
    #endif
    float4 nearPoint = mul(_GlobalSdfInverseViewProjection, float4(ndc, UNITY_NEAR_CLIP_VALUE, 1.0));
    float4 farPoint = mul(_GlobalSdfInverseViewProjection, float4(ndc, UNITY_RAW_FAR_CLIP_VALUE, 1.0));
    float3 origin = nearPoint.xyz / nearPoint.w;
    float3 ray = farPoint.xyz - farPoint.w * origin;
    float rayLength = length(ray);
    float3 direction = ray / rayLength;
    float maxDistance = farPoint.w > 0.0 ? rayLength / farPoint.w : _GlobalSdfFarClip;

    float3 color = 0.0;
    if (_GlobalSdfDebugMode == 1u)
    {
        if (abs(direction.y) > 1e-6)
        {
            float t = (_GlobalSdfSliceHeight - origin.y) / direction.y;
            float distance;
            uint level;
            float3 position = origin + t * direction;
            if (t >= 0.0 && t <= maxDistance && VividGlobalSdfTrySample(position, distance, level))
            {
                float voxel = _GlobalSdfLevels[level].w;
                float units = distance / voxel;
                float3 tint = units < 0.0 ? float3(1.0, 0.36, 0.09) : float3(0.06, 0.5, 1.0);
                color = lerp(tint * (0.12 + 0.65 * exp(-0.4 * abs(units))), 1.0, saturate(1.0 - 3.0 * abs(units)));
                int3 brick = int3(floor(position / (VividGlobalSdfThinBrickSize * voxel)));
                if (VividGlobalSdfHasThinBrick(brick, level))
                    color = lerp(color, float3(0.72, 0.35, 0.92), 0.35);
            }
        }
    }
    else
    {
        VividGlobalSdfHit hit;
        if (VividTraceGlobalSdf(origin, direction, 0.0, maxDistance, hit))
        {
            float3 tint = hit.level == 0u ? float3(0.1, 0.85, 0.72)
                : hit.level == 1u ? float3(1.0, 0.55, 0.16) : float3(0.64, 0.36, 1.0);
            color = tint * (0.24 + 0.76 * abs(dot(hit.normalWS, direction)));
        }
    }
    _GlobalSdfDebugOutput[id.xy] = float4(color, 1.0);
}
