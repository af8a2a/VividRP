#pragma kernel ComputeConditional
#pragma kernel ComputeMarginal
#pragma kernel ComputeAtmosphereOpticalDepth
#pragma only_renderers d3d11 vulkan metal

#define REFERENCED_ENVIRONMENT_DISTRIBUTION_BUILD

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/GlobalIllumination/ReferencedPathtracing/ReferencedPathtracingCommon.hlsl"

#define REFERENCED_ENVIRONMENT_SCAN_WIDTH 128

void ReferencedEnvironmentParallelScan(
    uint threadIndex,
    uint elementCount,
    uint bufferOffset,
    out float sum)
{
    for (uint upsweepOffset = 1u;
        upsweepOffset <= elementCount / 2u;
        upsweepOffset *= 2u)
    {
        AllMemoryBarrierWithGroupSync();

        uint first =
            (2u * threadIndex + 1u) * upsweepOffset - 1u;
        uint second = first + upsweepOffset;
        if (second < elementCount)
        {
            _ReferencedEnvironmentImportanceDistribution[bufferOffset + second] +=
                _ReferencedEnvironmentImportanceDistribution[bufferOffset + first];
        }
    }

    AllMemoryBarrierWithGroupSync();
    sum = _ReferencedEnvironmentImportanceDistribution[
        bufferOffset + elementCount - 1u];

    AllMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
        _ReferencedEnvironmentImportanceDistribution[bufferOffset + elementCount - 1u] = 0.0;

    for (uint downsweepOffset = elementCount / 2u;
        downsweepOffset > 0u;
        downsweepOffset /= 2u)
    {
        AllMemoryBarrierWithGroupSync();

        uint first =
            (2u * threadIndex + 1u) * downsweepOffset - 1u;
        uint second = first + downsweepOffset;
        if (second < elementCount)
        {
            float value =
                _ReferencedEnvironmentImportanceDistribution[bufferOffset + first];
            _ReferencedEnvironmentImportanceDistribution[bufferOffset + first] =
                _ReferencedEnvironmentImportanceDistribution[bufferOffset + second];
            _ReferencedEnvironmentImportanceDistribution[bufferOffset + second] +=
                value;
        }
    }

    AllMemoryBarrierWithGroupSync();
}

[numthreads(REFERENCED_ENVIRONMENT_SCAN_WIDTH, 1, 1)]
void ComputeConditional(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint threadIndex = dispatchThreadId.x;
    uint rowIndex = dispatchThreadId.y;
    uint conditionalOffset =
        REFERENCED_ENVIRONMENT_CONDITIONAL_OFFSET
        + rowIndex * REFERENCED_ENVIRONMENT_CONDITIONAL_RESOLUTION;
    float v =
        (rowIndex + 0.5)
        / REFERENCED_ENVIRONMENT_MARGINAL_RESOLUTION;

    uint columnIndex = threadIndex;
    float u =
        (columnIndex + 0.5)
        / REFERENCED_ENVIRONMENT_CONDITIONAL_RESOLUTION;
    float3 directionWS =
        ReferencedPathtracingMapEquiarealUVToDirection(float2(u, v));
    float3 radiance = ReferencedPathtracingSampleEnvironment(directionWS);
    _ReferencedEnvironmentImportanceDistribution[
        conditionalOffset + columnIndex] =
        ReferencedPathtracingEnvironmentLuminance(radiance);

    float rowSum;
    ReferencedEnvironmentParallelScan(
        threadIndex,
        REFERENCED_ENVIRONMENT_CONDITIONAL_RESOLUTION,
        conditionalOffset,
        rowSum);

    bool hasRowEnergy =
        rowSum > REFERENCED_ENVIRONMENT_MIN_LUMINANCE
        && !isnan(rowSum)
        && !isinf(rowSum);
    float inverseRowSum = hasRowEnergy ? rcp(rowSum) : 0.0;
    _ReferencedEnvironmentImportanceDistribution[
        conditionalOffset + columnIndex] =
        hasRowEnergy
            ? _ReferencedEnvironmentImportanceDistribution[
                conditionalOffset + columnIndex] * inverseRowSum
            : (float)columnIndex
                / REFERENCED_ENVIRONMENT_CONDITIONAL_RESOLUTION;

    if (threadIndex == 0u)
    {
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ENVIRONMENT_MARGINAL_OFFSET + rowIndex] =
            hasRowEnergy
                ? rowSum / REFERENCED_ENVIRONMENT_CONDITIONAL_RESOLUTION
                : 0.0;
    }
}

[numthreads(REFERENCED_ENVIRONMENT_SCAN_WIDTH, 1, 1)]
void ComputeMarginal(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint threadIndex = dispatchThreadId.x;

    float marginalSum;
    ReferencedEnvironmentParallelScan(
        threadIndex,
        REFERENCED_ENVIRONMENT_MARGINAL_RESOLUTION,
        REFERENCED_ENVIRONMENT_MARGINAL_OFFSET,
        marginalSum);

    bool hasEnvironmentEnergy =
        marginalSum > REFERENCED_ENVIRONMENT_MIN_LUMINANCE
        && !isnan(marginalSum)
        && !isinf(marginalSum);
    float inverseMarginalSum = hasEnvironmentEnergy ? rcp(marginalSum) : 0.0;
    if (threadIndex < REFERENCED_ENVIRONMENT_MARGINAL_RESOLUTION)
    {
        uint rowIndex = threadIndex;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ENVIRONMENT_MARGINAL_OFFSET + rowIndex] =
            hasEnvironmentEnergy
                ? _ReferencedEnvironmentImportanceDistribution[
                    REFERENCED_ENVIRONMENT_MARGINAL_OFFSET + rowIndex]
                    * inverseMarginalSum
                : (float)rowIndex
                    / REFERENCED_ENVIRONMENT_MARGINAL_RESOLUTION;
    }

    if (threadIndex == 0u)
    {
        float averageLuminance =
            hasEnvironmentEnergy
                ? marginalSum / REFERENCED_ENVIRONMENT_MARGINAL_RESOLUTION
                : 0.0;
        float pdfNormalization =
            averageLuminance > REFERENCED_ENVIRONMENT_MIN_LUMINANCE
                ? rcp(averageLuminance)
                    * (0.25 / kReferencedPathtracingPi)
                : 0.0;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ENVIRONMENT_PDF_NORMALIZATION_OFFSET] =
            pdfNormalization;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ENVIRONMENT_AVERAGE_LUMINANCE_OFFSET] =
            averageLuminance;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ENVIRONMENT_VALID_OFFSET] =
            pdfNormalization > 0.0 ? 1.0 : 0.0;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ENVIRONMENT_VERSION_OFFSET] =
            REFERENCED_ENVIRONMENT_DISTRIBUTION_VERSION;
    }
}

[numthreads(8, 8, 1)]
void ComputeAtmosphereOpticalDepth(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coordinate = dispatchThreadId.xy;
    if (coordinate.x
            >= REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_ZENITH_RESOLUTION
        || coordinate.y
            >= REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_RADIAL_RESOLUTION)
    {
        return;
    }

    float2 uv =
        (coordinate + 0.5)
        / float2(
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_ZENITH_RESOLUTION,
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_RADIAL_RESOLUTION);
    float2 radialCosine =
        ReferencedPathtracingUnmapAtmosphereOpticalDepthLut(uv);
    float radialDistance = radialCosine.x;
    float cosineZenith = radialCosine.y;
    float sineZenith =
        sqrt(saturate(1.0 - cosineZenith * cosineZenith));
    float3 rayOriginPS = float3(0.0, radialDistance, 0.0);
    float3 rayDirectionPS =
        float3(sineZenith, cosineZenith, 0.0);
    float3 densityOpticalDepth =
        ReferencedPathtracingIntegrateAtmosphereDensityReference(
            rayOriginPS,
            rayDirectionPS,
            3.402823466e+38,
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_REFERENCE_SAMPLE_COUNT);

    uint address =
        ReferencedPathtracingGetAtmosphereOpticalDepthAddress(
            coordinate);
    _ReferencedEnvironmentImportanceDistribution[address] =
        densityOpticalDepth.x;
    _ReferencedEnvironmentImportanceDistribution[address + 1u] =
        densityOpticalDepth.y;
    _ReferencedEnvironmentImportanceDistribution[address + 2u] =
        densityOpticalDepth.z;

    if (all(coordinate == 0u))
    {
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_VALID_OFFSET] = 1.0;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_VERSION_OFFSET] =
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_VERSION;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_SAMPLE_COUNT_OFFSET] =
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_REFERENCE_SAMPLE_COUNT;
        _ReferencedEnvironmentImportanceDistribution[
            REFERENCED_ATMOSPHERE_OPTICAL_DEPTH_RESERVED_OFFSET] = 0.0;
    }
}
