uint ResolveSdfSkyMiss(float3 origin, float3 direction, bool incomplete, uint screenState)
{
    // A depth hit without readable history still blocks the sky on this ray.
    if (screenState != 0u)
        return RayMiss | RaySkyOccluded;
    if (incomplete)
        return RayMiss | RaySkyUnresolved;

    VividMeshSdfNode root = _MeshSdfNodes[0];
    float entry = _SdfDiffuseMaxDistance;
    float exit = FLT_MAX;
    if (!VividMeshSdfClipRay(origin, direction, root.boundsMin, root.boundsMax, entry, exit))
        return RaySkyVisible;

    float limit = min(exit, _SdfDiffuseSkyTraceDistance);
    if (entry <= limit)
    {
        VividMeshSdfHit unused;
        bool advancedReceiver;
        if (VividTraceMeshSdfSceneInternal(origin, direction, entry, limit, _SdfDiffuseLayerMask,
            0.0, true, (VividMeshSdfReceiver)0, unused, advancedReceiver, incomplete))
            return RayMiss | RaySkyOccluded;
    }
    return !incomplete && exit <= _SdfDiffuseSkyTraceDistance ? RaySkyVisible : (RayMiss | RaySkyUnresolved);
}

float ResolveSunShadowBias(VividMeshSdfField field, VividMeshSdfInstance instance, float3 normalWS)
{
    if (field.signMode != 2u)
        return _SdfDiffuseRayBias;

    // The hit is already on the outside of the baked shell. A shorter normal
    // offset keeps the sun ray near the real surface at contact and shadow edges.
    float localUnits = length(float3(dot(instance.worldToLocal0.xyz, normalWS),
        dot(instance.worldToLocal1.xyz, normalWS), dot(instance.worldToLocal2.xyz, normalWS)));
    float minBias = 0.25 * field.originAndVoxelSize.w / max(localUnits, 1e-6);
    return min(_SdfDiffuseRayBias, max(0.4 * _SdfDiffuseRayBias, minBias));
}

#if defined(VIVID_SDF_SUN_UPDATE) || defined(VIVID_SDF_RADIOSITY_UPDATE)
bool ProjectCardPoint(VividMeshSdfInstance instance, VividMeshSdfField field, float3 local, float3 normalLS,
    float3 normalWS, out float3 position, out float3 geometryNormal)
{
    if (field.signMode == 2u)
        local += normalLS * (0.5 * field.shellThickness);

    // Invert the linear part of the world-to-local transform without uploading a second transform.
    float3 r0 = instance.worldToLocal0.xyz;
    float3 r1 = instance.worldToLocal1.xyz;
    float3 r2 = instance.worldToLocal2.xyz;
    float3 c0 = cross(r1, r2);
    float3 c1 = cross(r2, r0);
    float3 c2 = cross(r0, r1);
    float3 delta = local - float3(instance.worldToLocal0.w, instance.worldToLocal1.w, instance.worldToLocal2.w);
    position = (c0 * delta.x + c1 * delta.y + c2 * delta.z) / dot(r0, c0);
    geometryNormal = 0.0;
    if (!all(isfinite(position)))
        return false;

    // The captured mesh and the SDF isosurface can disagree by a fraction of a voxel.
    float localUnits = length(float3(dot(r0, normalWS), dot(r1, normalWS), dot(r2, normalWS)));
    float reach = 1.75 * field.originAndVoxelSize.w / max(localUnits, 1e-6);
    float3 start = position + normalWS * reach;
    float distance;
    float3 gridPosition;
    if (!VividMeshSdfTraceInstance(field, instance, start, -normalWS, 0.0, 2.0 * reach, distance, gridPosition))
        return false;
    float3 gradient = VividMeshSdfGradient(field, gridPosition);
    geometryNormal = SafeNormalize(gradient.x * r0 + gradient.y * r1 + gradient.z * r2);
    position = start - normalWS * distance;
    return dot(geometryNormal, normalWS) >= 0.95;
}
#endif

#if defined(VIVID_SDF_SUN_UPDATE)
StructuredBuffer<uint> _SdfSunInstances;
RWTexture2D<float> _SdfSunVisibilityOutput;
uint _SdfSunFirstCard;

float EvaluateCardSunVisibility(uint card, uint2 pixel)
{
    uint face = card % 6u;
    uint instanceIndex = _SdfSunInstances[card / 6u];
    VividMeshSdfInstance instance = _MeshSdfInstances[instanceIndex];
    if ((instance.layerMask & _SdfDiffuseLightLayerMask) == 0u)
        return -1.0;

    DiffuseSurface surface = _SdfDiffuseSurfaces[instanceIndex];
    uint slice = (uint)surface.cardMinAndFirst.w - 1u + face;
    float4 packedNormal = _SdfSurfaceNormalCoverage.Load(int4(pixel, slice, 0));
    if (packedNormal.a == 0.0)
        return -1.0;

    float3 normalLS = SafeNormalize(packedNormal.xyz * 2.0 - 1.0);
    float3 r0 = instance.worldToLocal0.xyz;
    float3 r1 = instance.worldToLocal1.xyz;
    float3 r2 = instance.worldToLocal2.xyz;
    float3 normalWS = SafeNormalize(normalLS.x * r0 + normalLS.y * r1 + normalLS.z * r2);
    float3 sun = _SdfDiffuseLightPositionRange.xyz;
    if (dot(normalWS, sun) <= 0.0)
        return -1.0;

    float depth = _SdfSurfaceAlbedoDepth.Load(int4(pixel, slice, 0)).a;
    float2 uv = (float2(pixel) + 0.5) / _SdfSunLayout.xy;
    uint axis = face >> 1u;
    float3 relative = axis == 0u ? float3(depth, uv) :
        axis == 1u ? float3(uv.x, depth, uv.y) : float3(uv, depth);
    VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
    float3 local = surface.cardMinAndFirst.xyz + relative * surface.cardExtent.xyz;
    float3 position, geometryNormal;
    if (!ProjectCardPoint(instance, field, local, normalLS, normalWS, position, geometryNormal)
        || dot(geometryNormal, sun) <= 0.0)
        return -1.0;

    float bias = ResolveSunShadowBias(field, instance, geometryNormal);
    float3 origin = position + geometryNormal * bias;
    return VividOccludeMeshSdfScene(origin, sun, -_SdfDiffuseLightPositionRange.w, _SdfDiffuseLightLayerMask) ? 0.0 : 1.0;
}

[numthreads(8, 8, 1)]
void UpdateSdfSurfaceSunVisibility(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(_SdfSunLayout.xy)))
        return;
    uint card = _SdfSunFirstCard + id.z;
    _SdfSunVisibilityOutput[VividSdfSunAtlasPixel(card, id.xy)] = EvaluateCardSunVisibility(card, id.xy);
}
#endif

#if defined(VIVID_SDF_CACHED_SUN)
Texture2D<float> _SdfSunVisibility;
RWTexture2D<float4> _SdfSunCacheHits;
uint _SdfSunReadyCards;

float LoadCachedSunVisibility(DiffuseSurface surface, uint3 cardTexel, float surfaceError,
    VividMeshSdfHit hit, float3 lightingNormal)
{
    uint card = ((uint)surface.cardExtent.w - 1u) * 6u + cardTexel.z;
    uint2 pixel = cardTexel.xy;
    if (cardTexel.z >= VividSdfBaseCardCount || card >= _SdfSunReadyCards || any(pixel == 0u) || any(pixel + 1u >= uint2(_SdfSunLayout.xy))
        || dot(hit.normalWS, lightingNormal) < 0.95
        || dot(hit.normalWS, _SdfDiffuseLightPositionRange.xyz) <= 0.0)
        return -1.0;
    VividMeshSdfField field = _MeshSdfFields[_MeshSdfInstances[hit.instanceIndex].fieldIndex];
    if (surfaceError > 0.5 * (field.originAndVoxelSize.w + field.shellThickness))
        return -1.0;

    int2 uv = int2(VividSdfSunAtlasPixel(card, pixel));
    float visibility = _SdfSunVisibility.Load(int3(uv, 0));
    // Keep the exact hit shadow test at shadow transitions and card gaps.
    if (visibility < 0.0
        || _SdfSunVisibility.Load(int3(uv + int2(-1, 0), 0)) != visibility
        || _SdfSunVisibility.Load(int3(uv + int2(1, 0), 0)) != visibility
        || _SdfSunVisibility.Load(int3(uv + int2(0, -1), 0)) != visibility
        || _SdfSunVisibility.Load(int3(uv + int2(0, 1), 0)) != visibility)
        return -1.0;
    return visibility;
}
#endif

bool LoadReceiver(uint2 pixel, out float3 position, out float3 normal)
{
    float depth = _SdfDiffuseDepth.Load(int3(pixel, 0));
    float4 rt1 = _SdfDiffuseGBuffer1.Load(int3(pixel, 0));
    uint surfaceClass = VividGetDeferredExportClass(
        VividDecodeDeferredExportHeader(_SdfDiffuseGBuffer0.Load(int3(pixel, 0)).a));
    position = 0.0;
    normal = 0.0;
    if (depth == UNITY_RAW_FAR_CLIP_VALUE || !VividIsSurfaceSummaryGBufferABIValid(rt1.a)
        || (surfaceClass != VIVID_DEFERRED_EXPORT_CLASS_FAST_SLAB
            && surfaceClass != VIVID_DEFERRED_EXPORT_CLASS_DUAL_SLAB
            && surfaceClass != VIVID_DEFERRED_EXPORT_CLASS_OPENPBR_OPAQUE))
        return false;

    float2 uv = (float2(pixel) + 0.5) * _SdfDiffuseScreenSize.zw;
    position = ComputeWorldSpacePosition(uv, depth, _SdfDiffuseInverseVP);
    normal = VividDecodeSurfaceSummaryNormal(rt1.xy);
    return true;
}

float PackProbeNormal(float3 normal)
{
    uint2 oct = uint2(round(saturate(VividEncodeSurfaceSummaryNormal(normal)) * 255.0));
    return float(oct.x + 256u * oct.y);
}

float3 UnpackProbeNormal(float packed)
{
    uint oct = (uint)packed;
    return VividDecodeSurfaceSummaryNormal(float2(oct & 255u, oct >> 8u) / 255.0);
}

uint HashProbe(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

uint2 ProbeReceiverPixel(uint2 tile, uint2 screenSize)
{
    return min(tile * ProbeSpacing + ProbeSpacing / 2u, screenSize - 1u);
}

uint2 ProbeGridSize(uint2 screenSize)
{
    uint spacing = _SdfRestirDense != 0u ? RestirPixelSpacing : ProbeSpacing;
    return (screenSize + spacing - 1u) / spacing;
}

uint ProbeRayCount()
{
    return _SdfRestirDense != 0u ? 1u : RaysPerProbe;
}

bool LoadAdaptiveProbePixel(uint2 tile, out uint2 pixel)
{
    uint encoded = (uint)_SdfAdaptivePlacement.Load(int3(tile, 0));
    uint offset = encoded - 1u;
    pixel = tile * ProbeSpacing + uint2(offset % ProbeSpacing, offset / ProbeSpacing);
    return encoded != 0u;
}

bool LoadProbeReceiverPixel(uint2 atlas, uint2 screenSize, out uint2 pixel)
{
    if (_SdfRestirDense != 0u)
    {
        uint2 jitter = uint2(_SdfDiffuseFrame & 1u, (_SdfDiffuseFrame >> 1u) & 1u);
        pixel = min(atlas * RestirPixelSpacing + jitter, screenSize - 1u);
        return true;
    }
    uint gridHeight = ProbeGridSize(screenSize).y;
    if (atlas.y < gridHeight)
    {
        pixel = ProbeReceiverPixel(atlas, screenSize);
        return true;
    }
    return LoadAdaptiveProbePixel(atlas - uint2(0, gridHeight), pixel);
}

bool LoadProbeReceiver(uint2 atlas, uint2 screenSize, out float3 position, out float3 normal)
{
    uint2 pixel;
    if (LoadProbeReceiverPixel(atlas, screenSize, pixel))
        return LoadReceiver(pixel, position, normal);
    position = normal = 0.0;
    return false;
}

#if defined(VIVID_SDF_RECEIVER)
Texture2D<uint2> _SdfReceiverVisibility;
StructuredBuffer<uint2> _SdfReceiverEntities;
uint _SdfReceiverCount;

bool LoadReceiverTangent(int2 pixel, int2 axis, uint2 visibility, float3 position, out float3 tangent)
{
    tangent = 0.0;
    [unroll]
    for (int side = -1; side <= 1; side += 2)
    {
        int2 neighbor = pixel + side * axis;
        if (any(neighbor < 0) || any(neighbor >= int2(_SdfDiffuseScreenSize.xy))
            || any(_SdfReceiverVisibility.Load(int3(neighbor, 0)) != visibility))
            continue;
        float depth = _SdfDiffuseDepth.Load(int3(neighbor, 0));
        if (depth == UNITY_RAW_FAR_CLIP_VALUE)
            continue;
        float2 uv = (float2(neighbor) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 neighborPosition = ComputeWorldSpacePosition(uv, depth, _SdfDiffuseInverseVP);
        tangent = neighborPosition - position;
        return true;
    }
    return false;
}

bool LoadContinuousReceiverTangent(int2 pixel, int2 axis, uint instance, float3 position, float3 normal,
    out float3 tangent)
{
    tangent = 0.0;
    float3 before, after, beforeNormal, afterNormal;
    int2 a = pixel - axis;
    int2 b = pixel + axis;
    if (any(a < 0) || any(b >= int2(_SdfDiffuseScreenSize.xy)))
        return false;
    if (_SdfReceiverVisibility.Load(int3(a, 0)).x != instance
        || _SdfReceiverVisibility.Load(int3(b, 0)).x != instance
        || !LoadReceiver(uint2(a), before, beforeNormal)
        || !LoadReceiver(uint2(b), after, afterNormal))
        return false;
    if (min(dot(beforeNormal, normal), dot(afterNormal, normal)) < 0.98)
        return false;

    float3 left = position - before;
    float3 right = after - position;
    float leftLength = length(left);
    float rightLength = length(right);
    // A shared instance can contain folds or disconnected surfaces. Require depth continuity on both sides.
    if (min(leftLength, rightLength) <= 1e-6 || max(leftLength, rightLength) > 1.35 * min(leftLength, rightLength)
        || dot(left, right) < 0.999 * leftLength * rightLength)
        return false;
    tangent = after - before;
    return true;
}

VividMeshSdfReceiver LoadSdfReceiver(uint2 pixel, float3 position, float3 shadingNormal)
{
    VividMeshSdfReceiver receiver = (VividMeshSdfReceiver)0;
    uint2 visibility = _SdfReceiverVisibility.Load(int3(pixel, 0));
    uint index = visibility.x - VIVID_VISIBILITY_BUFFER_INSTANCE_ID_BIAS;
    if (index >= _SdfReceiverCount)
        return receiver;

    float3 dx, dy;
    bool exactX = LoadReceiverTangent(int2(pixel), int2(1, 0), visibility, position, dx);
    bool exactY = LoadReceiverTangent(int2(pixel), int2(0, 1), visibility, position, dy);
    bool reconstructed = !exactX || !exactY;
    if (reconstructed)
    {
        // Reconstruct from a continuous patch on both axes when a triangle-local derivative is missing.
        if (!LoadContinuousReceiverTangent(int2(pixel), int2(1, 0), visibility.x, position, shadingNormal, dx))
            return receiver;
        if (!LoadContinuousReceiverTangent(int2(pixel), int2(0, 1), visibility.x, position, shadingNormal, dy))
            return receiver;
    }
    float3 normal = SafeNormalize(cross(dx, dy));
    if (dot(normal, normal) < 0.5)
        return receiver;
    float3 towardsCamera = unity_OrthoParams.w != 0.0 ? -_SdfProbeCameraForward.xyz : _WorldSpaceCameraPos - position;
    receiver.normalWS = dot(normal, towardsCamera) < 0.0 ? -normal : normal;
    if (reconstructed && dot(receiver.normalWS, shadingNormal) < 0.94)
        return (VividMeshSdfReceiver)0;
    receiver.entityId = _SdfReceiverEntities[index];
    receiver.positionWS = position;
    return receiver;
}
#endif

float ProbeGeometryWeight(float3 delta, float3 normal, float3 otherNormal, float eyeDepth)
{
    float plane = max(abs(dot(delta, normal)), abs(dot(delta, otherNormal)));
    float planeWeight = saturate(1.0 - plane / clamp(0.006 * eyeDepth, 0.035, 0.10));
    float normalWeight = saturate((dot(normal, otherNormal) - 0.88) / 0.12);
    float depthWeight = saturate(1.0 - abs(dot(delta, _SdfProbeCameraForward.xyz)) / max(0.20, 0.16 * eyeDepth));
    return planeWeight * normalWeight * depthWeight;
}

[numthreads(8, 8, 1)]
void PlaceSdfAdaptiveProbes(uint3 id : SV_DispatchThreadID)
{
    uint2 screenSize = uint2(_SdfDiffuseScreenSize.xy);
    uint2 grid = ProbeGridSize(screenSize);
    if (any(id.xy >= grid))
        return;

    uint encoded = 0u;
    float worstCoverage = 0.22;
    [loop]
    for (uint sampleIndex = 0u; sampleIndex < 4u; ++sampleIndex)
    {
        uint2 offset = uint2(sampleIndex & 1u, sampleIndex >> 1u) * 8u + 4u;
        uint2 pixel = id.xy * ProbeSpacing + offset;
        float3 position, normal;
        if (any(pixel >= screenSize) || !LoadReceiver(pixel, position, normal))
            continue;

        float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
        int2 low = int2(id.xy) + int2(sampleIndex & 1u, sampleIndex >> 1u) - 1;
        float coverage = 0.0;
        [unroll]
        for (uint neighbor = 0u; neighbor < 4u; ++neighbor)
        {
            uint2 tile = uint2(clamp(low + int2(neighbor & 1u, neighbor >> 1u), 0, int2(grid) - 1));
            float3 otherPosition, otherNormal;
            if (LoadReceiver(ProbeReceiverPixel(tile, screenSize), otherPosition, otherNormal))
                coverage = max(coverage, ProbeGeometryWeight(otherPosition - position, normal, otherNormal, eyeDepth));
        }
        coverage = floor(coverage * 8.0) / 8.0;
        if (coverage < worstCoverage)
        {
            worstCoverage = coverage;
            encoded = 1u + offset.x + offset.y * ProbeSpacing;
        }
    }
    _SdfAdaptivePlacementOutput[id.xy] = float(encoded);
}

uint ProbeSeed(uint2 tile)
{
    return HashProbe(tile.x + tile.y * 65537u + _SdfDiffuseFrame * 0x9e3779b9u);
}

float3 CosineRayDirection(uint ray, uint rayCount, uint seed, float3x3 basis)
{
    float u = (float(ray) + float(seed >> 16u) / 65536.0) / float(rayCount);
    float phi = TWO_PI * frac(float(seed & 65535u) / 65536.0 + float(ray) * 0.61803398875);
    float s, c;
    sincos(phi, s, c);
    return mul(float3(sqrt(u) * c, sqrt(u) * s, sqrt(1.0 - u)), basis);
}

float3 ProbeRayDirection(uint ray, uint seed, float3x3 basis)
{
    return CosineRayDirection(ray, ProbeRayCount(), seed, basis);
}

float2 ScreenUv(float4 clip)
{
    float2 uv = clip.xy / clip.w * 0.5 + 0.5;
    #if UNITY_UV_STARTS_AT_TOP
        uv.y = 1.0 - uv.y;
    #endif
    return uv;
}

bool ReadScreenRadiance(uint2 pixel, float3 position, float3 normal, float thickness, out float3 radiance)
{
    radiance = 0.0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z > previousClip.w || previousClip.z <= 0.0)
        return false;

    float4 packedMotion = float4(_SdfScreenMotion.Load(int3(pixel, 0)), 0.0, 0.0);
    if (PixelSetAsNoMotionVectors(packedMotion))
        return false;
    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousUv = (float2(pixel) + 0.5) * _SdfDiffuseScreenSize.zw - motion + _SdfScreenJitterDelta;
    if (any(previousUv < 0.0) || any(previousUv >= 1.0))
        return false;

    uint2 previousPixel = uint2(previousUv * _SdfDiffuseScreenSize.xy);
    float2 geometry = _SdfScreenPreviousGeometry.Load(int3(previousPixel, 0));
    if (geometry.y < 0.0)
        return false;
    uint oct = (uint)geometry.y;
    float3 previousNormal = VividDecodeSurfaceSummaryNormal(float2(oct & 1023u, oct >> 10u) / 1023.0);
    if (dot(normal, previousNormal) < 0.92)
        return false;

    float2 sampleUv = (float2(previousPixel) + 0.5) * _SdfDiffuseScreenSize.zw;
    float3 previousPosition = ComputeWorldSpacePosition(sampleUv, geometry.x, _SdfScreenPreviousInverseVP);
    float3 expectedDepthPosition = ComputeWorldSpacePosition(sampleUv, previousClip.z / previousClip.w,
        _SdfScreenPreviousInverseVP);
    if (distance(previousPosition, expectedDepthPosition) > thickness)
        return false;

    radiance = _SdfScreenPreviousRadiance.Load(int3(previousPixel, 0)).rgb;
    return all(isfinite(radiance));
}

struct ScreenRayHit
{
    float3 position;
    float3 normal;
    float distance;
    float thickness;
    uint2 pixel;
};

bool LoadScreenHitGeometry(uint2 pixel, float depth, out float3 position, out float3 normal)
{
    float4 packedNormal = _SdfDiffuseGBuffer1.Load(int3(pixel, 0));
    normal = VividDecodeSurfaceSummaryNormal(packedNormal.xy);
    float2 uv = (float2(pixel) + 0.5) * _SdfDiffuseScreenSize.zw;
    position = ComputeWorldSpacePosition(uv, depth, _SdfDiffuseInverseVP);
    return depth != UNITY_RAW_FAR_CLIP_VALUE && VividIsSurfaceSummaryGBufferABIValid(packedNormal.a);
}

// Traverse a reversed-Z closest-depth pyramid in projected pixel space.
bool TraceScreenGeometry(float3 origin, float3 direction, float maxDistance, out ScreenRayHit hit)
{
    hit = (ScreenRayHit)0;
    float4 start = mul(_SdfDiffuseVP, float4(origin, 1.0));
    float4 end = mul(_SdfDiffuseVP, float4(origin + direction * maxDistance, 1.0));
    if (start.w <= 0.0 || start.z > start.w || start.z <= 0.0)
        return false;
    if (end.z > end.w)
        end = lerp(start, end, 0.999 * (start.w - start.z) / (start.w - start.z + end.z - end.w));
    if (end.w <= 0.0)
        return false;

    float2 screenSize = _SdfDiffuseScreenSize.xy;
    float2 startPixel = ScreenUv(start) * screenSize;
    float2 delta = ScreenUv(end) * screenSize - startPixel;
    float major = max(abs(delta.x), abs(delta.y));
    if (major < 1.0)
        return false;

    float epsilon = 0.002 / major;
    float startDepth = start.z / start.w;
    float endDepth = end.z / end.w;
    float t = epsilon;
    uint width, height, mips;
    _SdfScreenHzb.GetDimensions(0, width, height, mips);
    int maxMip = min(4, int(mips) - 1);
    int mip = maxMip;
    [loop]
    for (uint iteration = 0u; iteration < 48u && t < 1.0; iteration++)
    {
        float2 pixel = startPixel + delta * t;
        if (any(pixel < 0.0) || any(pixel >= screenSize))
            break;
        uint cellSize = 1u << mip;
        uint2 cell = uint2(pixel) >> mip;
        if (mip > 0 && any(cell >= (uint2(width, height) >> mip)))
        {
            // A floor-sized mip can omit the odd edge texel.
            mip--;
            continue;
        }

        float2 boundary = (float2(cell) + step(0.0, delta)) * cellSize;
        float2 exitT = float2(abs(delta.x) > 1e-6 ? (boundary.x - startPixel.x) / delta.x : 2.0,
            abs(delta.y) > 1e-6 ? (boundary.y - startPixel.y) / delta.y : 2.0);
        float nextT = min(1.0, max(t, min(exitT.x, exitT.y)));
        float closest = mip == 0 ? _SdfDiffuseDepth.Load(int3(cell, 0)) : _SdfScreenHzb.Load(int3(cell, mip));
        if (closest == UNITY_RAW_FAR_CLIP_VALUE
            || min(lerp(startDepth, endDepth, t), lerp(startDepth, endDepth, nextT)) > closest)
        {
            t = nextT + epsilon;
            mip = min(mip + 1, maxMip);
            continue;
        }
        if (mip > 0)
        {
            mip--;
            continue;
        }

        if (!LoadScreenHitGeometry(cell, closest, hit.position, hit.normal))
            return false;
        float2 uv = (float2(cell) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 footprint = ComputeWorldSpacePosition(uv + _SdfDiffuseScreenSize.zw, closest, _SdfDiffuseInverseVP);
        hit.thickness = clamp(1.25 * distance(footprint, hit.position), 0.02, 0.15);
        float travel = dot(hit.position - origin, direction);
        if (travel <= _SdfDiffuseRayBias || travel > maxDistance
            || dot(hit.normal, direction) >= -0.05
            || distance(hit.position, origin + direction * travel) > hit.thickness)
            return false;

        hit.pixel = cell;
        hit.distance = travel;
        return true;
    }
    return false;
}

// A positive finite bit pattern carries an exact linear pixel index in the dense RGBA32F scratch.
static const uint ScreenHitPixelBase = 0x3f800000u;

[numthreads(8, 8, 1)]
void TraceDiffuseScreenRays(uint3 id : SV_DispatchThreadID)
{
    uint2 tile = id.xy;
    uint2 screenSize = uint2(_SdfDiffuseScreenSize.xy);
    if (any(tile >= ProbeGridSize(screenSize) * uint2(1u, 1u + _SdfDiffuseAdaptiveProbes)))
        return;

    float3 position, normal;
    bool receiver = LoadProbeReceiver(tile, screenSize, position, normal);
    float3x3 basis = GetLocalFrame(receiver ? normal : float3(0.0, 1.0, 0.0));
    float3 origin = position + normal * _SdfDiffuseRayBias;
    uint seed = ProbeSeed(tile);
    uint rayCount = ProbeRayCount();
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        float3 radiance = 0.0;
        float encodedHit = 0.0;
        ScreenRayHit hit;
        if (receiver && TraceScreenGeometry(origin, ProbeRayDirection(ray, seed, basis), _SdfDiffuseMaxDistance, hit))
        {
            encodedHit = -hit.distance;
            bool compatible = true;
            if (_SdfRestirDense != 0u)
            {
                float3 rayToHit = hit.position - origin;
                float3 directionToHit = SafeNormalize(rayToHit);
                compatible = length(rayToHit) <= _SdfDiffuseMaxDistance
                    && dot(normal, directionToHit) > 0.02 && dot(hit.normal, directionToHit) < -0.05;
            }
            if (compatible && ReadScreenRadiance(hit.pixel, hit.position, hit.normal, hit.thickness, radiance))
                encodedHit = _SdfRestirDense != 0u
                    ? asfloat(ScreenHitPixelBase + hit.pixel.y * screenSize.x + hit.pixel.x) : hit.distance;
        }
        // A negative distance retains the geometric hit of a rejected screen candidate.
        _SdfScreenRaysOutput[uint2(tile.x * rayCount + ray, tile.y)] = float4(encodedHit > 0.0 ? radiance : 0.0, encodedHit);
    }
}

float3 TraceHitLighting(float3 position, float3 normal, VividMeshSdfHit hit, DiffuseSurface surface,
    float cachedVisibility)
{
    float3 radiance = max(surface.emission.rgb, 0.0);
    float range = _SdfDiffuseLightPositionRange.w;
    VividMeshSdfInstance instance = _MeshSdfInstances[hit.instanceIndex];
    if (range == 0.0 || (instance.layerMask & _SdfDiffuseLightLayerMask) == 0u)
        return radiance;

    bool directional = range < 0.0;
    float3 direction = _SdfDiffuseLightPositionRange.xyz;
    float attenuation = 1.0;
    if (!directional)
    {
        float3 toLight = direction - position;
        float distanceSquared = dot(toLight, toLight);
        if (distanceSquared <= 1e-6 || distanceSquared >= range * range)
            return radiance;
        direction = toLight * rsqrt(distanceSquared);
        float relativeDistance = distanceSquared / (range * range);
        float window = saturate(1.0 - relativeDistance * relativeDistance);
        attenuation = window * window / max(distanceSquared, 0.01);
    }
    float nDotL = dot(normal, direction);
    if (nDotL <= 0.0)
        return radiance;
    if (dot(hit.normalWS, direction) <= 0.0)
        return radiance;

    float shadow = 1.0;
    float strength = _SdfDiffuseLightColorShadow.w;
    if (cachedVisibility >= 0.0)
        shadow -= strength * (1.0 - cachedVisibility);
    else if (strength > 0.0)
    {
        float bias = _SdfDiffuseRayBias;
        if (directional && hit.signMode == 2u)
            bias = ResolveSunShadowBias(_MeshSdfFields[instance.fieldIndex], instance, hit.normalWS);
        float3 origin = position + hit.normalWS * bias;
        float3 shadowDirection = direction;
        float shadowDistance = -range;
        if (!directional)
        {
            float3 shadowRay = _SdfDiffuseLightPositionRange.xyz - origin;
            shadowDistance = length(shadowRay);
            shadowDirection = shadowRay / max(shadowDistance, 1e-6);
        }
        if (shadowDistance > _SdfDiffuseRayBias
            && VividOccludeMeshSdfScene(origin, shadowDirection, shadowDistance, _SdfDiffuseLightLayerMask))
            shadow -= strength;
    }

    return radiance + saturate(surface.albedoAndValid.rgb) * max(_SdfDiffuseLightColorShadow.rgb, 0.0)
        * (INV_PI * nDotL * attenuation * shadow);
}

#if defined(VIVID_SDF_SURFACE_CACHE)
// Keep the atlas dimensions in sync with SdfDiffuseGatherPass.
static const uint RadiosityCardSize = 8u;
static const uint RadiosityColumns = 16u;
static const uint RadiosityRays = 16u;
StructuredBuffer<uint> _SdfRadiosityWork;
Texture2D<float4> _SdfRadiosityInput;
uint _SdfRadiosityLayout; // Number of published cards, or zero until a sweep is complete.

uint2 RadiosityAtlasPixel(uint card, uint2 pixel)
{
    return uint2(card % RadiosityColumns, card / RadiosityColumns) * RadiosityCardSize + pixel;
}

uint2 RadiosityCardPixel(uint2 pixel, uint2 size)
{
    return min((2u * pixel + 1u) * size / (2u * RadiosityCardSize), size - 1u);
}

float3 LoadCardIndirect(DiffuseSurface surface, VividMeshSdfHit hit, uint3 cardTexel)
{
    [branch]
    if (_SdfRadiosityLayout == 0u)
        return 0.0;
    uint first = _SdfRadiosityWork[(uint)surface.cardExtent.w];
    if (first >= _SdfRadiosityLayout || cardTexel.z >= _SdfRadiosityLayout - first)
        return 0.0;

    uint card = first + cardTexel.z;
    uint slice, axis;
    float3 boundsMin, extent;
    VividGetSdfCardProjection(surface, cardTexel.z, slice, axis, boundsMin, extent);
    uint2 size;
    uint slices;
    _SdfSurfaceAlbedoDepth.GetDimensions(size.x, size.y, slices);
    float depth = _SdfSurfaceAlbedoDepth.Load(int4(cardTexel.xy, slice, 0)).a;
    float3 normal = SafeNormalize(_SdfSurfaceNormalCoverage.Load(int4(cardTexel.xy, slice, 0)).xyz * 2.0 - 1.0);
    VividMeshSdfField field = _MeshSdfFields[_MeshSdfInstances[hit.instanceIndex].fieldIndex];
    float depthTolerance = max(1.5 * field.originAndVoxelSize.w, extent[axis] / 512.0);
    float2 p = (float2(cardTexel.xy) + 0.5) * (RadiosityCardSize / float2(size)) - 0.5;
    int2 lower = int2(floor(p));
    float2 fraction = frac(p);
    float3 sum = 0.0;
    float total = 0.0;
    [unroll]
    for (uint tap = 0u; tap < 4u; tap++)
    {
        uint2 offset = uint2(tap & 1u, tap >> 1u);
        uint2 cell = uint2(clamp(lower + int2(offset), 0, int(RadiosityCardSize) - 1));
        float4 sample = _SdfRadiosityInput.Load(int3(RadiosityAtlasPixel(card, cell), 0));
        if (sample.a == 0.0 || abs(sample.a - 1.0 - depth) * extent[axis] > depthTolerance)
            continue;
        uint2 representative = RadiosityCardPixel(cell, size);
        float3 sampleNormal = SafeNormalize(_SdfSurfaceNormalCoverage.Load(int4(representative, slice, 0)).xyz * 2.0 - 1.0);
        if (dot(normal, sampleNormal) < 0.9)
            continue;
        float2 w = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = w.x * w.y;
        sum += sample.rgb * weight;
        total += weight;
    }

    // Cached irradiance divided by pi. Apply the hit material only once, and keep
    // the feedback contractive even for ideal white cards.
    return min(saturate(surface.albedoAndValid.rgb), 0.95) * (sum / max(total, 1e-5));
}
#endif

#if defined(VIVID_SDF_RADIOSITY_UPDATE)
RWTexture2D<float4> _SdfRadiosityOutput;
uint _SdfRadiosityFirstCard;

float3 TraceCardRadiance(float3 origin, float3 direction, VividMeshSdfReceiver receiver)
{
    VividMeshSdfHit hit;
    bool advancedReceiver, incomplete;
    bool traced = VividTraceMeshSdfSceneInternal(origin, direction, 0.0, _SdfDiffuseMaxDistance,
        _SdfDiffuseLayerMask, 0.0, false, receiver, hit, advancedReceiver, incomplete);
    if (incomplete)
        return 0.0;
    if (!traced)
        return HasSkyTexture() && ResolveSdfSkyMiss(origin, direction, false, 0u) == RaySkyVisible
            ? clamp(SampleSkyTexture(direction, 0.0), 0.0, 65000.0) : 0.0;

    DiffuseSurface surface = _SdfDiffuseSurfaces[hit.instanceIndex];
    if (surface.albedoAndValid.a == 0.0 || dot(hit.normalWS, direction) >= 0.0)
        return 0.0;
    float3 position = origin + direction * hit.distance;
    float3 normal;
    uint3 texel;
    float error;
    if (!VividTrySampleSdfSurface(hit, position, surface, normal, texel, error))
        return 0.0;
    return TraceHitLighting(position, normal, hit, surface, -1.0) + LoadCardIndirect(surface, hit, texel);
}

float4 GatherCardIndirect(uint card, uint2 cell)
{
    uint work = _SdfRadiosityWork[0] + 2u * card;
    uint instanceIndex = _SdfRadiosityWork[work];
    uint slot = _SdfRadiosityWork[work + 1u];
    VividMeshSdfInstance instance = _MeshSdfInstances[instanceIndex];
    if ((instance.layerMask & _SdfDiffuseLayerMask) == 0u)
        return 0.0;

    uint slice, axis;
    float3 boundsMin, extent;
    VividGetSdfCardProjection(_SdfDiffuseSurfaces[instanceIndex], slot, slice, axis, boundsMin, extent);
    uint2 size;
    uint slices;
    _SdfSurfaceAlbedoDepth.GetDimensions(size.x, size.y, slices);
    uint2 pixel = RadiosityCardPixel(cell, size);
    float4 packedNormal = _SdfSurfaceNormalCoverage.Load(int4(pixel, slice, 0));
    if (packedNormal.a == 0.0)
        return 0.0;
    float3 normalLS = SafeNormalize(packedNormal.xyz * 2.0 - 1.0);
    float3 normalWS = SafeNormalize(normalLS.x * instance.worldToLocal0.xyz
        + normalLS.y * instance.worldToLocal1.xyz + normalLS.z * instance.worldToLocal2.xyz);
    float depth = _SdfSurfaceAlbedoDepth.Load(int4(pixel, slice, 0)).a;
    float2 uv = (float2(pixel) + 0.5) / float2(size);
    float3 relative = axis == 0u ? float3(depth, uv) : axis == 1u ? float3(uv.x, depth, uv.y) : float3(uv, depth);
    float3 local = boundsMin + extent * relative;
    VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
    VividMeshSdfReceiver receiver;
    receiver.entityId = instance.entityId;
    if (!ProjectCardPoint(instance, field, local, normalLS, normalWS, receiver.positionWS, receiver.normalWS))
        return 0.0;

    float3 origin = receiver.positionWS + receiver.normalWS * ResolveSunShadowBias(field, instance, receiver.normalWS);
    float3x3 basis = GetLocalFrame(normalWS);
    uint seed = HashProbe(card * (RadiosityCardSize * RadiosityCardSize) + cell.y * RadiosityCardSize + cell.x);
    float3 sum = 0.0;
    [loop]
    for (uint ray = 0u; ray < RadiosityRays; ray++)
    {
        float3 direction = CosineRayDirection(ray, RadiosityRays, seed, basis);
        if (dot(receiver.normalWS, direction) > 0.0)
            sum += TraceCardRadiance(origin, direction, receiver);
    }
    // Keep zero for uncovered cells and preserve covered black as a valid sample.
    return float4(clamp(sum / RadiosityRays, 0.0, 65000.0), 1.0 + depth);
}

[numthreads(8, 8, 1)]
void UpdateSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    _SdfRadiosityOutput[RadiosityAtlasPixel(card, id.xy)] = GatherCardIndirect(card, id.xy);
}
#endif

uint2 ProbePlaneStride()
{
    return uint2((uint(_SdfDiffuseScreenSize.x) + ProbeSpacing - 1u) / ProbeSpacing, 0u);
}

float3x3 ProbeSampleMoments(float3 radiance, float3 direction, float3 normal)
{
    // Differentiate the cosine response in the tangent plane. Limit inverse-PDF
    // weights near the horizon, where eight rays cannot estimate the slope reliably.
    float cosine = dot(direction, normal);
    float3 tangent = (direction - cosine * normal) * (ProbeMomentScale / max(cosine, 0.25));
    return float3x3(tangent.x * radiance, tangent.y * radiance, tangent.z * radiance);
}

void StoreProbe(uint2 tile, float4 lighting, float3x3 moments)
{
    _SdfDiffuseProbes[tile] = lighting;
    if (_SdfDiffuseDirectionalProbes != 0u)
    {
        uint2 stride = ProbePlaneStride();
        _SdfDiffuseProbes[tile + stride] = float4(clamp(moments[0], -65000.0, 65000.0), 0.0);
        _SdfDiffuseProbes[tile + 2u * stride] = float4(clamp(moments[1], -65000.0, 65000.0), 0.0);
        _SdfDiffuseProbes[tile + 3u * stride] = float4(clamp(moments[2], -65000.0, 65000.0), 0.0);
    }
}

float4 AccumulateProbe(float4 current, float3 position, float3 normal, inout float3x3 moments)
{
    if (_SdfDiffuseHasHistory == 0u || current.a == 0.0)
        return current;

    float4 clip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (clip.w <= 0.0)
        return current;
    float2 uv = ScreenUv(clip);
    if (any(uv < 0.0) || any(uv >= 1.0))
        return current;

    uint2 previousTile = uint2(uv * _SdfDiffuseScreenSize.xy) / ProbeSpacing;
    float4 geometry = _SdfDiffusePreviousGeometry.Load(int3(previousTile, 0));
    if (_SdfDiffuseAdaptiveProbes != 0u || _SdfDiffuseSpatialFilter != 0u)
    {
        float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
        float radius = max(0.08, 0.035 * eyeDepth);
        float weight = geometry.w < 0.0 ? 0.0 : ProbeGeometryWeight(geometry.xyz - position, normal,
            UnpackProbeNormal(geometry.w), eyeDepth) * saturate(1.0 - distance(geometry.xyz, position) / radius);
        if (_SdfDiffuseAdaptiveProbes != 0u)
        {
            uint2 adaptive = previousTile + uint2(0u, ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy)).y);
            float4 other = _SdfDiffusePreviousGeometry.Load(int3(adaptive, 0));
            float otherWeight = other.w < 0.0 ? 0.0 : ProbeGeometryWeight(other.xyz - position, normal,
                UnpackProbeNormal(other.w), eyeDepth) * saturate(1.0 - distance(other.xyz, position) / radius);
            if (otherWeight > weight)
            {
                previousTile = adaptive;
                weight = otherWeight;
            }
        }
        if (weight < 0.16)
            return current;
    }
    else if (geometry.w < 0.0 || distance(geometry.xyz, position) > max(0.1, 0.04 * clip.w)
        || dot(UnpackProbeNormal(geometry.w), normal) < 0.9)
        return current;

    float4 history = _SdfDiffusePreviousProbes.Load(int3(previousTile, 0));
    if (history.a > 0.0)
    {
        float weight = 0.85 * history.a;
        current.rgb = lerp(current.rgb, history.rgb, weight);
        if (_SdfDiffuseDirectionalProbes != 0u)
        {
            uint2 stride = ProbePlaneStride();
            moments[0] = lerp(moments[0], _SdfDiffusePreviousProbes.Load(int3(previousTile + stride, 0)).rgb, weight);
            moments[1] = lerp(moments[1], _SdfDiffusePreviousProbes.Load(int3(previousTile + 2u * stride, 0)).rgb, weight);
            moments[2] = lerp(moments[2], _SdfDiffusePreviousProbes.Load(int3(previousTile + 3u * stride, 0)).rgb, weight);
        }
    }
    return current;
}

void StoreTraceSample(uint2 tile, uint ray, uint state, float distance, float3 radiance, float3 direction = 0.0)
{
    uint2 address = uint2(tile.x * ProbeRayCount() + ray, tile.y);
    if (_SdfDiffuseHitFilterEnabled != 0u)
    {
        uint packed = 0u;
        uint hitState = state & 7u;
        if (hitState == RayScreenHit || hitState == RaySdfHit)
        {
            // Numeric float32 stores this 24-bit integer exactly. Zero marks an invalid hit.
            uint2 oct = uint2(round(saturate(VividEncodeSurfaceSummaryNormal(direction)) * 63.0));
            uint depth = max(1u, uint(round(saturate(distance / _SdfDiffuseMaxDistance) * 4095.0)));
            packed = (depth << 12u) | (oct.y << 6u) | oct.x;
        }
        _SdfDiffuseHitSamples[address] = float(packed);
    }
    if (_SdfDiffuseRecordRayDiagnostics != 0u)
    {
        // RGB is unexposed radiance. Decode W as floor(W) and frac(W) * 2 * maxDistance.
        float encoded = float(state) + 0.5 * saturate(distance / _SdfDiffuseMaxDistance);
        _SdfDiffuseRayDiagnostics[address] = float4(radiance, encoded);
    }
}

void StoreFirstHitDiagnostic(uint2 tile, uint ray, float3 origin, float3 direction, VividMeshSdfHit hit,
    uint rejection, bool advancedReceiver = false)
{
    uint2 pixel = uint2(tile.x * ProbeRayCount() + ray, tile.y * 3u);
    float4 entity = 0.0;
    float4 firstHit = 0.0;
    #if !defined(VIVID_SDF_SCREEN_ONLY)
        if (hit.instanceIndex != 0xffffffffu)
        {
            VividMeshSdfInstance instance = _MeshSdfInstances[hit.instanceIndex];
            VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
            float4 p = float4(origin, 1.0);
            float3 grid = float3(dot(instance.worldToLocal0, p), dot(instance.worldToLocal1, p),
                dot(instance.worldToLocal2, p)) - field.originAndVoxelSize.xyz;
            float3 extent = float3(field.dimensions - 1u) * field.originAndVoxelSize.w;
            float signedVoxels = any(grid < 0.0) || any(grid > extent) ? FLT_MAX
                : VividMeshSdfSample(field, grid) / field.originAndVoxelSize.w;
            // Keep every 16-bit word of the entity ID exact in the float readback.
            entity = float4(hit.entityId.x & 65535u, hit.entityId.x >> 16u,
                hit.entityId.y & 65535u, hit.entityId.y >> 16u);
            firstHit = float4(PackProbeNormal(hit.normalWS), hit.signMode, rejection, signedVoxels);
        }
    #endif
    _SdfDiffuseFirstHitDiagnostics[pixel] = entity;
    _SdfDiffuseFirstHitDiagnostics[pixel + uint2(0u, 1u)] = firstHit;
    _SdfDiffuseFirstHitDiagnostics[pixel + uint2(0u, 2u)] = float4(direction, advancedReceiver ? 1.0 : 0.0);
}

#include "SdfDiffuseReSTIR.hlsl"

[numthreads(8, 8, 1)]
void DenoiseSdfRestir(uint3 id : SV_DispatchThreadID)
{
    FilterRestirLighting(id);
}

void TraceProbe(uint3 id)
{
    uint2 screenSize = uint2(_SdfDiffuseScreenSize.xy);
    uint2 tile = id.xy;
    uint rayCount = ProbeRayCount();
    if (any(tile >= ProbeGridSize(screenSize) * uint2(1u, 1u + _SdfDiffuseAdaptiveProbes)))
        return;

    float3 position, normal;
    uint2 receiverPixel;
    if (!LoadProbeReceiverPixel(tile, screenSize, receiverPixel) || !LoadReceiver(receiverPixel, position, normal))
    {
        if (_SdfRestirEnabled != 0u)
            StoreInitialRestir(tile, (RestirReservoir)0);
        StoreProbe(tile, 0.0, (float3x3)0.0);
        _SdfDiffuseGeometry[tile] = float4(0.0, 0.0, 0.0, -1.0);
        _SdfDiffuseHitLighting[tile] = 0.0;
        _SdfDiffuseTraceSources[tile] = 0.0;
        if (_SdfDiffuseRecordRayDiagnostics != 0u)
        {
            [unroll]
            for (uint ray = 0u; ray < rayCount; ++ray)
            {
                StoreTraceSample(tile, ray, 0u, 0.0, 0.0);
                if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                {
                    VividMeshSdfHit miss = (VividMeshSdfHit)0;
                    miss.instanceIndex = 0xffffffffu;
                    StoreFirstHitDiagnostic(tile, ray, 0.0, 0.0, miss, 0u);
                }
            }
        }
        #if defined(VIVID_SDF_CACHED_SUN)
            _SdfSunCacheHits[tile] = 0.0;
        #endif
        return;
    }

    float3x3 basis = GetLocalFrame(normal);
    float3 origin = position + normal * _SdfDiffuseRayBias;
    #if defined(VIVID_SDF_RECEIVER)
        VividMeshSdfReceiver receiver = LoadSdfReceiver(receiverPixel, position, normal);
    #endif
    uint seed = ProbeSeed(tile);
    float3 sum = 0.0;
    float3x3 moments = (float3x3)0.0;
    uint valid = 0u;
    uint screenHits = 0u;
    uint skyHits = 0u;
    uint unknown = 0u;
    uint cachedSunHits = 0u;
    RestirReservoir reservoir = (RestirReservoir)0;
    float reservoirWeightSum = 0.0;
    #if defined(VIVID_SDF_SCREEN_ONLY)
        const bool useSky = false;
    #else
        bool useSky = HasSkyTexture();
    #endif
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        uint screenState = 0u;
        if (_SdfDiffuseUseScreenRays != 0u)
        {
            float4 screenHit = _SdfScreenRays.Load(int3(tile.x * rayCount + ray, tile.y, 0));
            if (screenHit.a > 0.0)
            {
                float3 direction = ProbeRayDirection(ray, seed, basis);
                float distance = screenHit.a;
                bool accepted = true;
                if (_SdfRestirDense != 0u)
                {
                    uint address = asuint(screenHit.a) - ScreenHitPixelBase;
                    uint2 pixel = uint2(address % screenSize.x, address / screenSize.x);
                    RestirSample sample;
                    accepted = LoadScreenHitGeometry(pixel, _SdfDiffuseDepth.Load(int3(pixel, 0)), sample.position, sample.normal);
                    if (accepted)
                    {
                        distance = dot(sample.position - origin, direction);
                        sample.radiance = screenHit.rgb;
                        sample.fromScreen = true;
                        RestirUpdate(reservoir, reservoirWeightSum, sample, RestirLuminance(sample.radiance), 0u,
                            RestirRandom(seed ^ (0xca5a826bu * (ray + 1u))));
                    }
                }
                if (accepted)
                {
                    StoreTraceSample(tile, ray, RayScreenHit, distance, screenHit.rgb, direction);
                    if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                    {
                        VividMeshSdfHit miss = (VividMeshSdfHit)0;
                        miss.instanceIndex = 0xffffffffu;
                        StoreFirstHitDiagnostic(tile, ray, origin, direction, miss, 0u);
                    }
                    sum += screenHit.rgb;
                    if (_SdfDiffuseDirectionalProbes != 0u)
                        moments += ProbeSampleMoments(screenHit.rgb, direction, normal);
                    screenHits++;
                    valid++;
                    continue;
                }
            }
            screenState = screenHit.a != 0.0 ? RayScreenHistoryRejected : 0u;
        }
        #if !defined(VIVID_SDF_SCREEN_ONLY)
        float3 direction = ProbeRayDirection(ray, seed, basis);
        VividMeshSdfHit hit;
        bool advancedReceiver = false;
        bool incomplete;
        #if defined(VIVID_SDF_RECEIVER)
            bool traced = VividTraceMeshSdfSceneInternal(origin, direction, 0.0, _SdfDiffuseMaxDistance,
                _SdfDiffuseLayerMask, 0.0, false, receiver, hit, advancedReceiver, incomplete);
        #else
            bool traced = VividTraceMeshSdfSceneInternal(origin, direction, 0.0, _SdfDiffuseMaxDistance,
                _SdfDiffuseLayerMask, 0.0, false, (VividMeshSdfReceiver)0, hit, advancedReceiver, incomplete);
        #endif
        if (!traced)
        {
            uint missState = RayMiss;
            [branch]
            if (useSky)
                missState = ResolveSdfSkyMiss(origin, direction, incomplete, screenState);
            float3 sky = 0.0;
            if (missState == RaySkyVisible)
            {
                sky = clamp(SampleSkyTexture(direction, 0.0), 0.0, 65000.0);
                sum += sky;
                if (_SdfDiffuseDirectionalProbes != 0u)
                    moments += ProbeSampleMoments(sky, direction, normal);
                skyHits++;
                valid++;
            }
            StoreTraceSample(tile, ray, screenState | missState, 0.0, sky, direction);
            if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, 0u, advancedReceiver);
            continue;
        }

        DiffuseSurface surface = _SdfDiffuseSurfaces[hit.instanceIndex];
        bool backface = dot(hit.normalWS, direction) >= 0.0;
        if (surface.albedoAndValid.a == 0.0 || backface)
        {
            StoreTraceSample(tile, ray, screenState | (backface ? RayBackface : RayMissingSurface), hit.distance, 0.0);
            if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, backface ? 0u : 6u, advancedReceiver);
            unknown++;
            continue;
        }
        float3 hitPosition = origin + hit.distance * direction;
        float3 lightingNormal = hit.normalWS;
        #if defined(VIVID_SDF_SURFACE_CACHE)
            uint3 cardTexel;
            float surfaceError;
            uint rejection;
            if (!VividTrySampleSdfSurface(hit, hitPosition, surface, lightingNormal, cardTexel, surfaceError,
                _SdfDiffuseRecordFirstHitDiagnostics != 0u, rejection))
            {
                StoreTraceSample(tile, ray, screenState | RayMissingSurface, hit.distance, 0.0);
                if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                    StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, rejection, advancedReceiver);
                unknown++;
                continue;
            }
        #endif
        if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
            StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, 0u, advancedReceiver);
        valid++;
        if (_SdfDiffuseOffscreenOnly != 0u)
        {
            float4 hitClip = mul(_SdfDiffuseVP, float4(hitPosition, 1.0));
            if (hitClip.w > 0.0 && all(abs(hitClip.xy) <= hitClip.w))
            {
                StoreTraceSample(tile, ray, screenState | RayOffscreenOnlyRejected, hit.distance, 0.0);
                continue;
            }
        }
        float cachedVisibility = -1.0;
        #if defined(VIVID_SDF_CACHED_SUN)
            cachedVisibility = LoadCachedSunVisibility(surface, cardTexel, surfaceError, hit, lightingNormal);
            cachedSunHits += cachedVisibility >= 0.0 ? 1u : 0u;
        #endif
        float3 radiance = TraceHitLighting(hitPosition, lightingNormal, hit, surface, cachedVisibility);
        #if defined(VIVID_SDF_SURFACE_CACHE)
            radiance += LoadCardIndirect(surface, hit, cardTexel);
        #endif
        if (_SdfRestirEnabled != 0u)
        {
            RestirSample sample;
            sample.position = hitPosition;
            sample.normal = hit.normalWS;
            sample.radiance = radiance;
            sample.fromScreen = false;
            // Target and the original proposal both contain the receiver cosine.
            RestirUpdate(reservoir, reservoirWeightSum, sample, RestirLuminance(radiance), 0u,
                RestirRandom(seed ^ (0xca5a826bu * (ray + 1u))));
        }
        StoreTraceSample(tile, ray, screenState | RaySdfHit, hit.distance, radiance, direction);
        sum += radiance;
        if (_SdfDiffuseDirectionalProbes != 0u)
            moments += ProbeSampleMoments(radiance, direction, normal);
        #else
            StoreTraceSample(tile, ray, screenState | RayMiss, 0.0, 0.0);
            if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
            {
                VividMeshSdfHit miss = (VividMeshSdfHit)0;
                miss.instanceIndex = 0xffffffffu;
                StoreFirstHitDiagnostic(tile, ray, origin, ProbeRayDirection(ray, seed, basis), miss, 0u);
            }
        #endif
    }

    // Cosine sampling estimates irradiance divided by pi, before the receiver's albedo.
    // Sky-aware output is the mean of the resolved rays. Coverage blends in the unresolved fraction once.
    #if defined(VIVID_SDF_SURFACE_CACHE) || defined(VIVID_SDF_SCREEN_ONLY)
        // Keep the baked fallback where cards cover few of the gather rays.
        float confidence = float(valid) / float(rayCount);
    #else
        float confidence = valid > 0u ? 1.0 - float(unknown) / float(rayCount) : 0.0;
    #endif
    float normalization = useSky ? float(max(1u, valid)) : float(rayCount);
    if (useSky)
        confidence = float(valid) / float(rayCount);
    float4 current = float4(min(sum / normalization, 65000.0), confidence);
    moments /= normalization;
    if (_SdfRestirEnabled != 0u)
    {
        // Misses and shaded black hits are known zero contributions. Rejected geometry
        // and missing cards have no evaluated contribution and are handled by coverage.
        reservoir.count = rayCount - unknown;
        // Use the same packed receiver normal as the resampling passes.
        float3 storedNormal = UnpackProbeNormal(PackProbeNormal(normal));
        RestirFinalize(reservoir, reservoirWeightSum, position + storedNormal * _SdfDiffuseRayBias, storedNormal);
        StoreInitialRestir(tile, reservoir);
    }
    else if (_SdfDiffuseHitFilterEnabled == 0u)
        current = AccumulateProbe(current, position, normal, moments);
    StoreProbe(tile, current, moments);
    _SdfDiffuseGeometry[tile] = float4(position, PackProbeNormal(normal));
    _SdfDiffuseHitLighting[tile] = float4(min(sum / max(1u, valid), 65000.0), float(valid) / rayCount);
    // Sky occupies the residual of the three source fractions.
    _SdfDiffuseTraceSources[tile] = float4(float3(screenHits, valid - screenHits - skyHits, rayCount - valid) / rayCount, 1.0);
    #if defined(VIVID_SDF_CACHED_SUN)
        _SdfSunCacheHits[tile] = float4(float(cachedSunHits) / rayCount, 0.0, 0.0, 1.0);
    #endif
}

#if defined(VIVID_SDF_SCREEN_ONLY)
[numthreads(8, 8, 1)]
void GatherScreenDiffuseProbes(uint3 id : SV_DispatchThreadID)
{
    TraceProbe(id);
}
#elif defined(VIVID_SDF_CACHED_SUN)
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceSdfReceiverCachedSunProbes(uint3 id : SV_DispatchThreadID)
#else
void TraceSdfDiffuseCachedSunProbes(uint3 id : SV_DispatchThreadID)
#endif
{
    TraceProbe(id);
}
#elif defined(VIVID_SDF_SURFACE_CACHE)
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceSdfReceiverCachedProbes(uint3 id : SV_DispatchThreadID)
#else
void TraceSdfDiffuseCachedProbes(uint3 id : SV_DispatchThreadID)
#endif
{
    TraceProbe(id);
}
#else
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceSdfReceiverProbes(uint3 id : SV_DispatchThreadID)
#else
void TraceSdfDiffuseProbes(uint3 id : SV_DispatchThreadID)
#endif
{
    TraceProbe(id);
}
#endif

float FilterNeighborWeight(uint2 tile, float4 center, float3 normal, float eyeDepth)
{
    float4 geometry = _SdfDiffuseGeometry[tile];
    if (geometry.w < 0.0)
        return 0.0;
    float weight = ProbeGeometryWeight(geometry.xyz - center.xyz, normal, UnpackProbeNormal(geometry.w), eyeDepth);
    return weight * _SdfDiffuseProbeInput.Load(int3(tile, 0)).a;
}

static const int2 ProbeFilterOffsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

float SelectFilterNeighbor(int2 neighbor, uint2 grid, float4 center, float3 normal, float eyeDepth, out uint2 selected)
{
    selected = uint2(neighbor);
    if (any(neighbor < 0) || any(neighbor >= int2(grid)))
        return 0.0;
    float weight = FilterNeighborWeight(selected, center, normal, eyeDepth);
    if (_SdfDiffuseAdaptiveProbes != 0u)
    {
        uint2 adaptive = selected + uint2(0, grid.y);
        float alternateWeight = FilterNeighborWeight(adaptive, center, normal, eyeDepth);
        if (alternateWeight > weight)
        {
            weight = alternateWeight;
            selected = adaptive;
        }
    }
    return weight * 0.65;
}

void FilterProbeLighting(uint2 tile, uint2 grid, float4 center, float4 geometry, float3 normal,
    float4 compatibility, uint planes, out float3 lighting[4])
{
    uint2 stride = uint2(grid.x, 0u);
    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        lighting[plane] = _SdfDiffuseProbeInput.Load(int3(tile + plane * stride, 0)).rgb;

    float total = 1.0;
    if (geometry.w >= 0.0 && center.a > 0.0)
    {
        float eyeDepth = dot(float4(geometry.xyz, 1.0), _SdfProbeCameraForward);
        int2 uniformTile = int2(tile.x, tile.y % grid.y);
        [loop]
        for (uint i = 0u; i < 4u; ++i)
        {
            uint2 selected;
            float weight = SelectFilterNeighbor(uniformTile + ProbeFilterOffsets[i], grid, geometry, normal, eyeDepth, selected);
            weight *= compatibility[i];
            if (weight <= 0.0)
                continue;
            total += weight;
            [loop]
            for (uint plane = 0u; plane < planes; ++plane)
                lighting[plane] += _SdfDiffuseProbeInput.Load(int3(selected + plane * stride, 0)).rgb * weight;
        }
    }

    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        lighting[plane] /= total;
}

[numthreads(8, 8, 1)]
void FilterSdfDiffuseProbes(uint3 id : SV_DispatchThreadID)
{
    uint2 grid = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy));
    if (any(id.xy >= grid * uint2(1u, 1u + _SdfDiffuseAdaptiveProbes)))
        return;

    float4 center = _SdfDiffuseProbeInput.Load(int3(id.xy, 0));
    float4 geometry = _SdfDiffuseGeometry[id.xy];
    float3 normal = geometry.w >= 0.0 ? UnpackProbeNormal(geometry.w) : 0.0;
    uint planes = _SdfDiffuseDirectionalProbes != 0u ? 4u : 1u;
    float3 lighting[4];
    FilterProbeLighting(id.xy, grid, center, geometry, normal, 1.0, planes, lighting);
    uint2 stride = uint2(grid.x, 0u);
    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        _SdfDiffuseFilteredProbes[id.xy + plane * stride] = float4(lighting[plane], plane == 0u ? center.a : 0.0);
}

float3 DecodeHitDirection(uint packed)
{
    return VividDecodeSurfaceSummaryNormal(float2(packed & 63u, (packed >> 6u) & 63u) / 63.0);
}

float HitDistanceRejection(uint2 tile, float3 origin, float3 direction, float distance)
{
    float bestAlignment = 0.92;
    float3 bestHit = 0.0;
    [loop]
    for (uint ray = 0u; ray < RaysPerProbe; ++ray)
    {
        uint packed = uint(_SdfDiffuseHitSamplesInput.Load(int3(tile.x * RaysPerProbe + ray, tile.y, 0)));
        if (packed == 0u)
            continue;
        float3 neighborDirection = DecodeHitDirection(packed);
        float alignment = dot(direction, neighborDirection);
        if (alignment > bestAlignment)
        {
            bestAlignment = alignment;
            bestHit = neighborDirection * (float(packed >> 12u) * (_SdfDiffuseMaxDistance / 4095.0));
        }
    }
    if (bestAlignment <= 0.92)
        return 0.0;

    float4 geometry = _SdfDiffuseGeometry[tile];
    float3 offset = geometry.xyz + UnpackProbeNormal(geometry.w) * _SdfDiffuseRayBias - origin;
    float3 hit = offset + bestHit;
    float tolerance = max(0.12, 0.15 * distance) + 0.25 * length(offset);
    float separation = abs(dot(hit, direction) - distance);
    return smoothstep(0.92, 0.99, bestAlignment) * smoothstep(tolerance, 2.0 * tolerance, separation);
}

groupshared float4 ProbeHitRejection[8][RaysPerProbe];

[numthreads(8, 8, 1)]
void FilterSdfDirectionalHits(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID)
{
    uint2 tile = uint2(group.x * 8u + lane.y, group.y);
    uint2 grid = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy));
    bool inBounds = tile.x < grid.x;
    float4 center = 0.0;
    float4 geometry = 0.0;
    float3 normal = 0.0;
    float4 rejection = 0.0;
    if (inBounds)
    {
        center = _SdfDiffuseProbeInput.Load(int3(tile, 0));
        geometry = _SdfDiffuseGeometry[tile];
        if (center.a > 0.0 && geometry.w >= 0.0)
        {
            normal = UnpackProbeNormal(geometry.w);
            uint packed = uint(_SdfDiffuseHitSamplesInput.Load(int3(tile.x * RaysPerProbe + lane.x, tile.y, 0)));
            if (packed != 0u)
            {
                float3 direction = DecodeHitDirection(packed);
                float distance = float(packed >> 12u) * (_SdfDiffuseMaxDistance / 4095.0);
                float3 origin = geometry.xyz + normal * _SdfDiffuseRayBias;
                float eyeDepth = dot(float4(geometry.xyz, 1.0), _SdfProbeCameraForward);
                int2 uniformTile = int2(tile.x, tile.y % grid.y);
                [unroll]
                for (uint i = 0u; i < 4u; ++i)
                {
                    uint2 selected;
                    float weight = SelectFilterNeighbor(uniformTile + ProbeFilterOffsets[i], grid, geometry, normal, eyeDepth, selected);
                    if (weight > 0.0)
                        rejection[i] = HitDistanceRejection(selected, origin, direction, distance);
                }
            }
        }
    }

    ProbeHitRejection[lane.y][lane.x] = rejection;
    GroupMemoryBarrierWithGroupSync();
    if (!inBounds || lane.x != 0u)
        return;

    [unroll]
    for (uint ray = 1u; ray < RaysPerProbe; ++ray)
        rejection += ProbeHitRejection[lane.y][ray];

    // Only aligned rays provide evidence of a discontinuity. Keep the original
    // spatial weight where sparse samples cannot establish a correspondence.
    float4 compatibility = 1.0 - 0.75 * saturate(0.5 * rejection);
    uint planes = _SdfDiffuseDirectionalProbes != 0u ? 4u : 1u;
    float3 lighting[4];
    FilterProbeLighting(tile, grid, center, geometry, normal, compatibility, planes, lighting);
    float3x3 moments = (float3x3)0.0;
    if (planes > 1u)
        moments = float3x3(lighting[1], lighting[2], lighting[3]);
    center.rgb = lighting[0];
    center = AccumulateProbe(center, geometry.xyz, normal, moments);
    StoreProbe(tile, center, moments);
}

void AddProbeToResolve(uint2 tile, float weight, float3 position, float3 normal, float eyeDepth,
    inout float4 result, inout float totalWeight)
{
    float4 geometry = _SdfDiffuseGeometry[tile];
    if (geometry.w < 0.0)
        return;
    float3 probeNormal = UnpackProbeNormal(geometry.w);
    float agreement = dot(probeNormal, normal);
    if (_SdfDiffuseAdaptiveProbes != 0u || _SdfDiffuseSpatialFilter != 0u)
        weight *= ProbeGeometryWeight(geometry.xyz - position, normal, probeNormal, eyeDepth);
    else if (abs(dot(geometry.xyz - position, normal)) > 0.1 || agreement < 0.85)
        return;
    if (weight <= 0.0)
        return;

    float4 probe = _SdfDiffuseProbeInput.Load(int3(tile, 0));
    if (_SdfDiffuseDirectionalProbes != 0u && probe.a > 0.0)
    {
        uint2 stride = ProbePlaneStride();
        float3 tangent = (normal - probeNormal * agreement) / ProbeMomentScale;
        probe.rgb = clamp(probe.rgb + tangent.x * _SdfDiffuseProbeInput.Load(int3(tile + stride, 0)).rgb
            + tangent.y * _SdfDiffuseProbeInput.Load(int3(tile + 2u * stride, 0)).rgb
            + tangent.z * _SdfDiffuseProbeInput.Load(int3(tile + 3u * stride, 0)).rgb, 0.0, 65000.0);
    }
    result += float4(probe.rgb * probe.a, probe.a) * weight;
    totalWeight += weight;
}

[numthreads(8, 8, 1)]
void ResolveSdfDiffuseGI(uint3 id : SV_DispatchThreadID)
{
    if (_SdfRestirDense != 0u)
    {
        IntegrateRestirLighting(id);
        return;
    }
    uint2 screenSize = uint2(_SdfDiffuseScreenSize.xy);
    if (any(id.xy >= screenSize))
        return;

    float3 position, normal;
    float4 result = 0.0;
    if (LoadReceiver(id.xy, position, normal))
    {
        float2 grid = (float2(id.xy) + 0.5) / ProbeSpacing - 0.5;
        int2 low = int2(floor(grid));
        float2 fraction = frac(grid);
        uint2 probeGrid = ProbeGridSize(screenSize);
        int2 last = int2(probeGrid) - 1;
        float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
        float totalWeight = 0.0;
        [unroll]
        for (uint i = 0u; i < 4u; i++)
        {
            int2 offset = int2(i & 1u, i >> 1u);
            uint2 tile = uint2(clamp(low + offset, 0, last));
            float2 weights = lerp(1.0 - fraction, fraction, float2(offset));
            AddProbeToResolve(tile, weights.x * weights.y, position, normal, eyeDepth, result, totalWeight);
            if (_SdfDiffuseAdaptiveProbes != 0u && all(int2(tile) == low + offset))
            {
                uint2 pixel;
                if (LoadAdaptiveProbePixel(tile, pixel))
                {
                    float2 adaptiveWeights = saturate(1.0 - abs(float2(pixel) - float2(id.xy)) / ProbeSpacing);
                    AddProbeToResolve(tile + uint2(0, probeGrid.y), adaptiveWeights.x * adaptiveWeights.y,
                        position, normal, eyeDepth, result, totalWeight);
                }
            }
        }
        result.rgb /= max(result.a, 1e-5);
        result.a /= max(totalWeight, 1e-5);
        if (_SdfDiffuseRealtimeOnly != 0u)
            result.a = 1.0;
    }
    _SdfDiffuseOutput[id.xy] = result;
}

bool ReadPixelHistory(uint2 pixel, float3 position, float3 normal, out float4 history, out float foregroundWeight)
{
    history = 0.0;
    foregroundWeight = 0.0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z > previousClip.w || previousClip.z <= 0.0)
        return false;

    float4 packedMotion = float4(_SdfScreenMotion.Load(int3(pixel, 0)), 0.0, 0.0);
    if (PixelSetAsNoMotionVectors(packedMotion))
        return false;
    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    int2 low = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    int2 screenSize = int2(_SdfDiffuseScreenSize.xy);
    float expectedDepth = previousClip.z / previousClip.w;
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float thickness = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float totalWeight = 0.0;
    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 offset = int2(i & 1u, i >> 1u);
        int2 tap = low + offset;
        float2 weights = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = weights.x * weights.y;
        if (weight <= 0.0 || any(tap < 0) || any(tap >= screenSize))
            continue;

        uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
        float depth = f16tof32(packed & 65535u);
        float3 previousNormal = UnpackProbeNormal(float(packed >> 16u));
        bool normalMatches = dot(normal, previousNormal) >= 0.92;
        #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
            // Reversed Z. Even a mismatched normal may belong to a foreground occluder.
            bool nearer = depth > expectedDepth;
            if (depth <= 0.0 || (!normalMatches && !nearer))
                continue;
        #else
            if (depth <= 0.0 || !normalMatches)
                continue;
        #endif

        float2 uv = (float2(tap) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 previousPosition = ComputeWorldSpacePosition(uv, depth, _SdfScreenPreviousInverseVP);
        float3 expectedPosition = ComputeWorldSpacePosition(uv, expectedDepth, _SdfScreenPreviousInverseVP);
        float depthError = distance(previousPosition, expectedPosition);
        float planeError = abs(dot(previousPosition - position, normal));
        #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
            if (nearer && depthError > thickness && planeError > thickness)
                foregroundWeight += weight;
        #endif
        if (!normalMatches || depthError > thickness || planeError > thickness)
            continue;

        float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
        if (sample.a > 0.0)
        {
            history += sample * weight;
            totalWeight += weight;
        }
    }
    history /= max(totalWeight, 1e-5);
    return totalWeight >= 0.35;
}

float3 ClampPixelHistory(uint2 pixel, float3 position, float3 normal, float3 current, float3 history)
{
    float3 low = current;
    float3 high = current;
    int2 screenSize = int2(_SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    const int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 tap = int2(pixel) + offsets[i];
        if (any(tap < 0) || any(tap >= screenSize))
            continue;
        float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        float3 otherPosition, otherNormal;
        if (lighting.a <= 0.0 || !LoadReceiver(uint2(tap), otherPosition, otherNormal)
            || ProbeGeometryWeight(otherPosition - position, normal, otherNormal, eyeDepth) < 0.15)
            continue;
        low = min(low, lighting.rgb);
        high = max(high, lighting.rgb);
    }
    float3 margin = max(0.25 * (high - low), 0.15 * high);
    return clamp(history, max(0.0, low - margin), high + margin);
}

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
void TemporalSdfRestirDiffuseGI(uint3 id : SV_DispatchThreadID)
#else
void TemporalSdfDiffuseGI(uint3 id : SV_DispatchThreadID)
#endif
{
    if (any(id.xy >= uint2(_SdfDiffuseScreenSize.xy)))
        return;

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    float3 position, normal;
    bool receiver = LoadReceiver(id.xy, position, normal);
    float age = 0.0;
    uint packed = 0u;
    if (receiver)
    {
        #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
            // Occluder depth must survive even when this frame has no valid GI there.
            packed = f32tof16(_SdfDiffuseDepth.Load(int3(id.xy, 0))) | (uint(PackProbeNormal(normal)) << 16u);
        #endif
        if (result.a > 0.0)
        {
            #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                packed = f32tof16(_SdfDiffuseDepth.Load(int3(id.xy, 0))) | (uint(PackProbeNormal(normal)) << 16u);
            #endif
            age = 1.0;
            float4 history;
            float foregroundWeight;
            if (_SdfDiffuseHasHistory != 0u && ReadPixelHistory(id.xy, position, normal, history, foregroundWeight))
            {
                float3 bounded = ClampPixelHistory(id.xy, position, normal, result.rgb, history.rgb);
                float confidence = 1.0;
                #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    // A partly occluded footprint can renormalize a few bright taps.
                    // Retain normal accumulation when current same-surface lighting supports those taps.
                    float brightness = RestirLuminance(history.rgb);
                    float excess = brightness - RestirLuminance(bounded);
                    if (foregroundWeight > 0.0 && excess > max(0.05, 0.1 * brightness))
                        confidence = foregroundWeight >= 0.125 ? 0.0 : 1.0 - 2.0 * foregroundWeight;
                #endif
                age = lerp(1.0, min(history.a + 1.0, 8.0), confidence);
                float3 rectified = lerp(history.rgb, bounded, lerp(1.0, 0.20, confidence));
                result.rgb = lerp(rectified, result.rgb, rcp(age));
            }
        }
    }

    _SdfDiffusePixelLightingOutput[id.xy] = float4(result.rgb, age);
    _SdfDiffusePixelGeometryOutput[id.xy] = packed;
    if (receiver && _SdfDiffuseRealtimeOnly != 0u)
        result.a = 1.0;
    if (_SdfRestirDense == 0u)
        _SdfDiffuseOutput[id.xy] = result;
}
