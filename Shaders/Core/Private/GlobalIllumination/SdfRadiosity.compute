#pragma kernel UpdateSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE VIVID_SDF_RECEIVER
#pragma kernel AccumulateSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE VIVID_SDF_RECEIVER VIVID_SDF_RADIOSITY_ACCUMULATION
#pragma kernel PublishSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel PublishSdfSurfaceRadiosityCards VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel ClearSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel RescaleSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel PrepareRadiosityFeedbackProbesCS VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_FEEDBACK
#pragma kernel TraceRadiosityFeedbackRaysCS VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_FEEDBACK
#pragma kernel ResolveRadiosityFeedbackRaysCS VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_FEEDBACK VIVID_SDF_RADIOSITY_FEEDBACK_RESOLVE
#pragma kernel IntegrateRadiosityFeedbackCS VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_FEEDBACK
#pragma kernel ClearRadiosityFeedbackCS VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_FEEDBACK
#pragma kernel ClearSdfSkyRadianceBound VIVID_SDF_SCREEN_ONLY
#pragma kernel MeasureSdfSkyRadianceBound VIVID_SDF_SCREEN_ONLY

#include "SdfScreenProbeCommon.hlsl"
#include "SdfScreenProbeReceiver.hlsl"
#include "SdfSurfaceCacheLighting.hlsl"
#if defined(VIVID_SDF_RADIOSITY_FEEDBACK_RESOLVE)
#include "SdfRadianceCacheCommon.hlsl"
#endif

RWStructuredBuffer<uint> _SdfSkyRadianceBound;
uint _SdfSkyRadianceBoundSize;
groupshared uint SkyRadianceBound[64];

[numthreads(1, 1, 1)]
void ClearSdfSkyRadianceBound(uint3 id : SV_DispatchThreadID)
{
    _SdfSkyRadianceBound[0] = 0u;
}

[numthreads(8, 8, 1)]
void MeasureSdfSkyRadianceBound(uint3 id : SV_DispatchThreadID, uint lane : SV_GroupIndex)
{
    float peak = 0.0;
    if (all(id.xy < _SdfSkyRadianceBoundSize))
    {
        float2 uv = (float2(id.xy) + 0.5) / float(_SdfSkyRadianceBoundSize);
        float3 direction = CubemapTexelToDirection(uv * 2.0 - 1.0, id.z);
        float3 value = SAMPLE_TEXTURECUBE_LOD(_SkyTexture, sampler_PointClamp, direction, 0.0).rgb;
        // Non-finite content cannot establish an unsaturated transport bound.
        peak = all(isfinite(value)) ? max(0.0, max(value.x, max(value.y, value.z))) : 3.402823466e+38;
    }
    SkyRadianceBound[lane] = asuint(peak);
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 32u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
            SkyRadianceBound[lane] = max(SkyRadianceBound[lane], SkyRadianceBound[lane + stride]);
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0u)
        InterlockedMax(_SdfSkyRadianceBound[0], SkyRadianceBound[0]);
}

#if defined(VIVID_SDF_RADIOSITY_UPDATE) || defined(VIVID_SDF_RADIOSITY_FEEDBACK)
RWTexture2D<float4> _SdfRadiosityOutput;
uint _SdfRadiosityFirstCard;
uint _SdfRadiositySeed;
uint _SdfRadiosityCardCount;
#endif

#if defined(VIVID_SDF_RADIOSITY_UPDATE)
uint _SdfRadiositySamples;
uint _SdfRadiosityBatch;
uint _SdfRadiosityBounce;
float _SdfRadiosityPublishBlend;
float4 _SdfRadiosityHistoryScale;

float4 GatherCardIndirect(uint card, uint2 cell)
{
    uint work = _SdfRadiosityWork[0] + 2u * card;
    uint instanceIndex = _SdfRadiosityWork[work];
    uint slot = _SdfRadiosityWork[work + 1u];
    VividMeshSdfInstance instance = _MeshSdfInstances[instanceIndex];
    if ((instance.layerMask & _SdfDiffuseLayerMask) == 0u)
        return 0.0;

    uint slice, axis;
    float3 boundsMin, extent;
    VividGetSdfCardProjection(_SdfDiffuseSurfaces[instanceIndex], slot, slice, axis, boundsMin, extent);
    uint2 size;
    uint slices;
    _SdfSurfaceAlbedoDepth.GetDimensions(size.x, size.y, slices);
    uint2 pixel = RadiosityCardPixel(cell, size);
    float4 packedNormal = _SdfSurfaceNormalCoverage.Load(int4(pixel, slice, 0));
    if (packedNormal.a == 0.0)
        return 0.0;
    float3 normalLS = SafeNormalize(packedNormal.xyz * 2.0 - 1.0);
    float3 normalWS = SafeNormalize(normalLS.x * instance.worldToLocal0.xyz
        + normalLS.y * instance.worldToLocal1.xyz + normalLS.z * instance.worldToLocal2.xyz);
    float depth = _SdfSurfaceAlbedoDepth.Load(int4(pixel, slice, 0)).a;
    float2 uv = (float2(pixel) + 0.5) / float2(size);
    float3 relative = axis == 0u ? float3(depth, uv) : axis == 1u ? float3(uv.x, depth, uv.y) : float3(uv, depth);
    float3 local = boundsMin + extent * relative;
    VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
    VividMeshSdfReceiver receiver;
    receiver.entityId = instance.entityId;
    if (!ProjectCardPoint(instance, field, local, normalLS, normalWS, receiver.positionWS, receiver.normalWS))
        return 0.0;

    float3 origin = receiver.positionWS + receiver.normalWS * ResolveSunShadowBias(field, instance, receiver.normalWS);
    float3x3 basis = GetLocalFrame(normalWS);
    uint seed = HashProbe((card * (RadiosityCardSize * RadiosityCardSize) + cell.y * RadiosityCardSize + cell.x)
        ^ _SdfRadiositySeed);
    #if defined(VIVID_SDF_RADIOSITY_ACCUMULATION)
        // Batch zero reproduces the fixed sequence. Subsequent batches are independent
        // per bounce; advancing samples must not silently introduce another bounce.
        if (_SdfRadiosityBatch > 0u)
            seed = HashProbe(seed ^ HashProbe(_SdfRadiosityBatch + 0x9e3779b9u * (_SdfRadiosityBounce + 1u)));
    #endif
    uint rayCount = clamp(_SdfRadiositySamples, RadiosityRays, 4096u);
    float3 sum = 0.0;
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        float3 direction = CosineRayDirection(ray, rayCount, seed, basis);
        if (dot(receiver.normalWS, direction) > 0.0)
            sum += TraceLegacyCardRadiance(origin, direction, receiver);
    }
    // p(w) = cos(theta) / PI, so mean incoming radiance estimates E / PI.
    // The receiving card's albedo is applied only when this cache is read at a hit.
    // Keep zero for uncovered cells and preserve covered black as a valid sample.
    return float4(clamp(sum / rayCount, 0.0, 65000.0), 1.0 + depth);
}

[numthreads(8, 8, 1)]
void UpdateSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    _SdfRadiosityOutput[RadiosityAtlasPixel(card, id.xy)] = GatherCardIndirect(card, id.xy);
}

[numthreads(8, 8, 1)]
void AccumulateSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    uint2 pixel = RadiosityAtlasPixel(card, id.xy);
    float4 sample = GatherCardIndirect(card, id.xy);
    // Only this invocation owns this texel. Different orders use different atlases.
    // On invalidation batch=0 overwrites all owned cells without reading old energy.
    if (_SdfRadiosityBatch > 0u && sample.a > 0.0)
    {
        float4 old = _SdfRadiosityOutput[pixel];
        if (old.a > 0.0)
            sample.rgb = lerp(old.rgb, sample.rgb, rcp(float(_SdfRadiosityBatch + 1u)));
    }
    _SdfRadiosityOutput[pixel] = SdfRoundToNearestHalf(sample);
}

[numthreads(8, 8, 1)]
void PublishSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    _SdfRadiosityOutput[id.xy] = _SdfRadiosityInput.Load(int3(id.xy, 0));
}

[numthreads(8, 8, 1)]
void PublishSdfSurfaceRadiosityCards(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    if (card >= _SdfRadiosityCardCount)
        return;
    uint2 pixel = RadiosityAtlasPixel(card, id.xy);
    float4 sample = _SdfRadiosityInput.Load(int3(pixel, 0));
    if (_SdfRadiosityPublishBlend < 1.0 && sample.a > 0.0)
    {
        float4 old = _SdfRadiosityOutput[pixel];
        if (old.a > 0.0)
            sample.rgb = lerp(old.rgb, sample.rgb, _SdfRadiosityPublishBlend);
        sample = SdfRoundToNearestHalf(sample);
    }
    // Uncovered cells replace old coverage immediately, including moving silhouettes.
    _SdfRadiosityOutput[pixel] = sample;
}

[numthreads(8, 8, 1)]
void ClearSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    _SdfRadiosityOutput[id.xy] = 0.0;
}

[numthreads(8, 8, 1)]
void RescaleSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    if (id.z >= _SdfRadiosityCardCount)
        return;
    uint2 pixel = RadiosityAtlasPixel(id.z, id.xy);
    float4 old = _SdfRadiosityOutput[pixel];
    if (old.a > 0.0)
        old.rgb = clamp(old.rgb * _SdfRadiosityHistoryScale.rgb, 0.0, 65000.0);
    else
        old = 0.0;
    _SdfRadiosityOutput[pixel] = SdfRoundToNearestHalf(old);
}
#endif

#if defined(VIVID_SDF_RADIOSITY_FEEDBACK)
struct RadiosityFeedbackProbe
{
    float4 positionAndDepth;
    float4 normal;
};

struct RadiosityFeedbackRay
{
    float3 direction;
    float distance;
    float3 normal;
    uint level;
};

static const uint RadiosityProbesPerCard = RadiosityCardSize * RadiosityCardSize;
static const float RadiositySurfaceBias = 0.10f; // 10 cm in LumenRadiosityDistanceFieldTracingCS.
RWStructuredBuffer<RadiosityFeedbackProbe> _SdfRadiosityFeedbackProbesWrite;
StructuredBuffer<RadiosityFeedbackProbe> _SdfRadiosityFeedbackProbes;
RWStructuredBuffer<RadiosityFeedbackRay> _SdfRadiosityFeedbackRaysWrite;
StructuredBuffer<RadiosityFeedbackRay> _SdfRadiosityFeedbackRays;
RWStructuredBuffer<float3> _SdfRadiosityFeedbackRadianceWrite;
StructuredBuffer<float3> _SdfRadiosityFeedbackRadiance;
RWTexture2D<float> _SdfRadiosityFeedbackCount;
uint _SdfRadiosityFeedbackDispatchWidth;
groupshared float3 RadiosityIntegrated[RadiosityProbesPerCard];

[numthreads(8, 8, 1)]
void PrepareRadiosityFeedbackProbesCS(uint3 id : SV_DispatchThreadID, uint probe : SV_GroupIndex)
{
    uint card = _SdfFinalLightingOrder[_SdfRadiosityFirstCard + id.z];
    uint work = _SdfRadiosityWork[0] + 2u * card;
    uint instanceIndex = _SdfRadiosityWork[work];
    uint slot = _SdfRadiosityWork[work + 1u];
    uint slice, axis;
    float3 lower, extent;
    VividGetSdfCardProjection(_SdfDiffuseSurfaces[instanceIndex], slot, slice, axis, lower, extent);
    uint2 size;
    uint slices;
    _SdfSurfaceAlbedoDepth.GetDimensions(size.x, size.y, slices);
    uint2 pixel = RadiosityCardPixel(id.xy, size);
    float4 packedNormal = _SdfSurfaceNormalCoverage.Load(int4(pixel, slice, 0));
    VividMeshSdfInstance instance = _MeshSdfInstances[instanceIndex];
    RadiosityFeedbackProbe data = (RadiosityFeedbackProbe)0;
    if (packedNormal.a > 0.0f && (instance.layerMask & _SdfDiffuseLayerMask) != 0u)
    {
        float depth = _SdfSurfaceAlbedoDepth.Load(int4(pixel, slice, 0)).a;
        float2 uv = (float2(pixel) + 0.5f) / float2(size);
        float3 relative = axis == 0u ? float3(depth, uv) : axis == 1u ? float3(uv.x, depth, uv.y) : float3(uv, depth);
        float3 r0 = instance.worldToLocal0.xyz, r1 = instance.worldToLocal1.xyz, r2 = instance.worldToLocal2.xyz;
        float3 delta = lower + relative * extent
            - float3(instance.worldToLocal0.w, instance.worldToLocal1.w, instance.worldToLocal2.w);
        float3 c0 = cross(r1, r2);
        float3 position = (c0 * delta.x + cross(r2, r0) * delta.y + cross(r0, r1) * delta.z) / dot(r0, c0);
        float3 normalLS = packedNormal.xyz * 2.0f - 1.0f;
        if (all(isfinite(position)))
        {
            data.positionAndDepth = float4(position, 1.0f + depth);
            data.normal = float4(SafeNormalize(normalLS.x * r0 + normalLS.y * r1 + normalLS.z * r2), 0.0f);
        }
    }
    _SdfRadiosityFeedbackProbesWrite[id.z * RadiosityProbesPerCard + probe] = data;
}

uint RadiosityRayAddress(uint2 group, uint lane)
{
    return (group.x + group.y * _SdfRadiosityFeedbackDispatchWidth) * 64u + lane;
}

float3 RadiosityRayOrigin(RadiosityFeedbackProbe probe, float3 direction)
{
    return (probe.positionAndDepth.xyz + probe.normal.xyz * RadiositySurfaceBias) + direction * RadiositySurfaceBias;
}

[numthreads(64, 1, 1)]
void TraceRadiosityFeedbackRaysCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint address = RadiosityRayAddress(group, lane);
    uint probeIndex = address / RadiosityRays;
    if (probeIndex >= _SdfRadiosityCardCount * RadiosityProbesPerCard)
        return;

    RadiosityFeedbackProbe probe = _SdfRadiosityFeedbackProbes[probeIndex];
    RadiosityFeedbackRay ray = (RadiosityFeedbackRay)0;
    ray.distance = FLT_MAX;
    if (probe.positionAndDepth.w > 0.0f)
    {
        uint card = _SdfFinalLightingOrder[_SdfRadiosityFirstCard + probeIndex / RadiosityProbesPerCard];
        uint seed = HashProbe(card * RadiosityProbesPerCard + probeIndex % RadiosityProbesPerCard
            ^ _SdfRadiositySeed ^ (_SdfDiffuseFrame * 0x9e3779b9u));
        ray.direction = CosineRayDirection(address % RadiosityRays, RadiosityRays, seed, GetLocalFrame(probe.normal.xyz));
        VividGlobalSdfHit hit;
        if (VividTraceGlobalSdf(RadiosityRayOrigin(probe, ray.direction), ray.direction,
            RadiositySurfaceBias, _SdfDiffuseMaxDistance, hit, true, false))
        {
            ray.distance = hit.distance + 0.5f * hit.expandSurfaceAmount;
            ray.normal = hit.normalWS;
            ray.level = hit.level;
        }
    }
    _SdfRadiosityFeedbackRaysWrite[address] = ray;
}

#if defined(VIVID_SDF_RADIOSITY_FEEDBACK_RESOLVE)
[numthreads(64, 1, 1)]
void ResolveRadiosityFeedbackRaysCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint address = RadiosityRayAddress(group, lane);
    uint probeIndex = address / RadiosityRays;
    if (probeIndex >= _SdfRadiosityCardCount * RadiosityProbesPerCard)
        return;

    RadiosityFeedbackProbe probe = _SdfRadiosityFeedbackProbes[probeIndex];
    float3 radiance = 0.0f;
    if (probe.positionAndDepth.w > 0.0f)
    {
        RadiosityFeedbackRay ray = _SdfRadiosityFeedbackRays[address];
        if (ray.distance < FLT_MAX)
        {
            float3 position = RadiosityRayOrigin(probe, ray.direction) + ray.direction * ray.distance;
            GridCardLighting lighting = EvaluateGlobalDistanceFieldHit(position, ray.normal, ray.direction, ray.level);
            radiance = lighting.sum;
        }
        else if (HasSkyTexture()
            && ResolveSdfSkyMiss(RadiosityRayOrigin(probe, ray.direction), ray.direction,
                0.0f, false, 0u, (VividMeshSdfReceiver)0) == RaySkyVisible)
        {
            radiance = SampleSkyTexture(ray.direction, 0.0f);
        }
    }
    _SdfRadiosityFeedbackRadianceWrite[address] = clamp(radiance, 0.0f, 65000.0f);
}
#endif

float RadiosityFeedbackPlaneWeight(float3 WorldPosition, float3 WorldNormal, float3 ProbeWorldPosition)
{
    float4 TexelPlane = float4(WorldNormal, dot(ProbeWorldPosition, WorldNormal));
    float PlaneDistance = abs(dot(float4(WorldPosition, -1), TexelPlane));
    float RelativeDistance = max(PlaneDistance / (length(ProbeWorldPosition - WorldPosition) + .01f), .1f);
    float DepthWeight = exp2(-100.0f * (RelativeDistance * RelativeDistance));
    return DepthWeight > .01f ? 1 : 0;
}

[numthreads(8, 8, 1)]
void IntegrateRadiosityFeedbackCS(uint3 id : SV_DispatchThreadID, uint lane : SV_GroupIndex)
{
    uint probeStart = id.z * RadiosityProbesPerCard;
    uint probeIndex = probeStart + lane;
    float3 sum = 0.0f;
    [unroll] for (uint ray = 0u; ray < RadiosityRays; ++ray)
        sum += _SdfRadiosityFeedbackRadiance[probeIndex * RadiosityRays + ray];
    RadiosityIntegrated[lane] = sum / float(RadiosityRays);
    GroupMemoryBarrierWithGroupSync();

    uint card = _SdfFinalLightingOrder[_SdfRadiosityFirstCard + id.z];
    uint2 pixel = RadiosityAtlasPixel(card, id.xy);
    RadiosityFeedbackProbe probe = _SdfRadiosityFeedbackProbes[probeIndex];
    float4 result = 0.0f;
    float newFrames = 0.0f;
    if (probe.positionAndDepth.w > 0.0f)
    {
        float weightSum = 2.0f;
        float3 filtered = RadiosityIntegrated[lane] * weightSum;
        const int2 offsets[4] = { int2(0, 1), int2(1, 0), int2(0, -1), int2(-1, 0) };
        [unroll] for (uint tap = 0u; tap < 4u; ++tap)
        {
            int2 cell = int2(id.xy) + offsets[tap];
            if (any(cell < 0) || any(cell >= int(RadiosityCardSize))) continue;
            uint neighbor = uint(cell.x) + RadiosityCardSize * uint(cell.y);
            RadiosityFeedbackProbe other = _SdfRadiosityFeedbackProbes[probeStart + neighbor];
            if (other.positionAndDepth.w <= 0.0f || dot(probe.normal.xyz, other.normal.xyz) < 0.9f) continue;
            float w = RadiosityFeedbackPlaneWeight(probe.positionAndDepth.xyz, probe.normal.xyz, other.positionAndDepth.xyz);
            filtered += w * RadiosityIntegrated[neighbor];
            weightSum += w;
        }

        float4 old = _SdfRadiosityOutput[pixel];
        float frames = abs(old.a - probe.positionAndDepth.w) <= 0.002f ? _SdfRadiosityFeedbackCount[pixel] : 0.0f;
        newFrames = min(frames + 1.0f, 4.0f);
        float alpha = 1.0f / (1.0f + frames);
        result = SdfRoundToNearestHalf(float4(lerp(old.rgb, filtered / weightSum, alpha), probe.positionAndDepth.w));
    }
    _SdfRadiosityOutput[pixel] = result;
    _SdfRadiosityFeedbackCount[pixel] = newFrames;
}

[numthreads(8, 8, 1)]
void ClearRadiosityFeedbackCS(uint3 id : SV_DispatchThreadID)
{
    _SdfRadiosityOutput[id.xy] = 0.0f;
    _SdfRadiosityFeedbackCount[id.xy] = 0.0f;
}
#endif
