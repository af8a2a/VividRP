#pragma kernel UpdateSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE VIVID_SDF_RECEIVER
#pragma kernel AccumulateSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE VIVID_SDF_RECEIVER VIVID_SDF_RADIOSITY_ACCUMULATION
#pragma kernel PublishSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel PublishSdfSurfaceRadiosityCards VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel ClearSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel RescaleSdfSurfaceRadiosity VIVID_SDF_SURFACE_CACHE VIVID_SDF_RADIOSITY_UPDATE
#pragma kernel ClearSdfSkyRadianceBound VIVID_SDF_SCREEN_ONLY
#pragma kernel MeasureSdfSkyRadianceBound VIVID_SDF_SCREEN_ONLY

#include "SdfScreenProbeCommon.hlsl"
#include "SdfScreenProbeReceiver.hlsl"
#include "SdfSurfaceCacheLighting.hlsl"

RWStructuredBuffer<uint> _SdfSkyRadianceBound;
uint _SdfSkyRadianceBoundSize;
groupshared uint SkyRadianceBound[64];

[numthreads(1, 1, 1)]
void ClearSdfSkyRadianceBound(uint3 id : SV_DispatchThreadID)
{
    _SdfSkyRadianceBound[0] = 0u;
}

[numthreads(8, 8, 1)]
void MeasureSdfSkyRadianceBound(uint3 id : SV_DispatchThreadID, uint lane : SV_GroupIndex)
{
    float peak = 0.0;
    if (all(id.xy < _SdfSkyRadianceBoundSize))
    {
        float2 uv = (float2(id.xy) + 0.5) / float(_SdfSkyRadianceBoundSize);
        float3 direction = CubemapTexelToDirection(uv * 2.0 - 1.0, id.z);
        float3 value = SAMPLE_TEXTURECUBE_LOD(_SkyTexture, sampler_PointClamp, direction, 0.0).rgb;
        // Non-finite content cannot establish an unsaturated transport bound.
        peak = all(isfinite(value)) ? max(0.0, max(value.x, max(value.y, value.z))) : 3.402823466e+38;
    }
    SkyRadianceBound[lane] = asuint(peak);
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 32u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
            SkyRadianceBound[lane] = max(SkyRadianceBound[lane], SkyRadianceBound[lane + stride]);
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0u)
        InterlockedMax(_SdfSkyRadianceBound[0], SkyRadianceBound[0]);
}

#if defined(VIVID_SDF_RADIOSITY_UPDATE)
RWTexture2D<float4> _SdfRadiosityOutput;
uint _SdfRadiosityFirstCard;
uint _SdfRadiositySamples;
uint _SdfRadiositySeed;
uint _SdfRadiosityBatch;
uint _SdfRadiosityBounce;
uint _SdfRadiosityCardCount;
float _SdfRadiosityPublishBlend;
float4 _SdfRadiosityHistoryScale;

float4 GatherCardIndirect(uint card, uint2 cell)
{
    uint work = _SdfRadiosityWork[0] + 2u * card;
    uint instanceIndex = _SdfRadiosityWork[work];
    uint slot = _SdfRadiosityWork[work + 1u];
    VividMeshSdfInstance instance = _MeshSdfInstances[instanceIndex];
    if ((instance.layerMask & _SdfDiffuseLayerMask) == 0u)
        return 0.0;

    uint slice, axis;
    float3 boundsMin, extent;
    VividGetSdfCardProjection(_SdfDiffuseSurfaces[instanceIndex], slot, slice, axis, boundsMin, extent);
    uint2 size;
    uint slices;
    _SdfSurfaceAlbedoDepth.GetDimensions(size.x, size.y, slices);
    uint2 pixel = RadiosityCardPixel(cell, size);
    float4 packedNormal = _SdfSurfaceNormalCoverage.Load(int4(pixel, slice, 0));
    if (packedNormal.a == 0.0)
        return 0.0;
    float3 normalLS = SafeNormalize(packedNormal.xyz * 2.0 - 1.0);
    float3 normalWS = SafeNormalize(normalLS.x * instance.worldToLocal0.xyz
        + normalLS.y * instance.worldToLocal1.xyz + normalLS.z * instance.worldToLocal2.xyz);
    float depth = _SdfSurfaceAlbedoDepth.Load(int4(pixel, slice, 0)).a;
    float2 uv = (float2(pixel) + 0.5) / float2(size);
    float3 relative = axis == 0u ? float3(depth, uv) : axis == 1u ? float3(uv.x, depth, uv.y) : float3(uv, depth);
    float3 local = boundsMin + extent * relative;
    VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
    VividMeshSdfReceiver receiver;
    receiver.entityId = instance.entityId;
    if (!ProjectCardPoint(instance, field, local, normalLS, normalWS, receiver.positionWS, receiver.normalWS))
        return 0.0;

    float3 origin = receiver.positionWS + receiver.normalWS * ResolveSunShadowBias(field, instance, receiver.normalWS);
    float3x3 basis = GetLocalFrame(normalWS);
    uint seed = HashProbe((card * (RadiosityCardSize * RadiosityCardSize) + cell.y * RadiosityCardSize + cell.x)
        ^ _SdfRadiositySeed);
    #if defined(VIVID_SDF_RADIOSITY_ACCUMULATION)
        // Batch zero reproduces the fixed sequence. Subsequent batches are independent
        // per bounce; advancing samples must not silently introduce another bounce.
        if (_SdfRadiosityBatch > 0u)
            seed = HashProbe(seed ^ HashProbe(_SdfRadiosityBatch + 0x9e3779b9u * (_SdfRadiosityBounce + 1u)));
    #endif
    uint rayCount = clamp(_SdfRadiositySamples, RadiosityRays, 4096u);
    float3 sum = 0.0;
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        float3 direction = CosineRayDirection(ray, rayCount, seed, basis);
        if (dot(receiver.normalWS, direction) > 0.0)
            sum += TraceCardRadiance(origin, direction, receiver);
    }
    // p(w) = cos(theta) / PI, so mean incoming radiance estimates E / PI.
    // The receiving card's albedo is applied only when this cache is read at a hit.
    // Keep zero for uncovered cells and preserve covered black as a valid sample.
    return float4(clamp(sum / rayCount, 0.0, 65000.0), 1.0 + depth);
}

[numthreads(8, 8, 1)]
void UpdateSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    _SdfRadiosityOutput[RadiosityAtlasPixel(card, id.xy)] = GatherCardIndirect(card, id.xy);
}

[numthreads(8, 8, 1)]
void AccumulateSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    uint2 pixel = RadiosityAtlasPixel(card, id.xy);
    float4 sample = GatherCardIndirect(card, id.xy);
    // Only this invocation owns this texel. Different orders use different atlases.
    // On invalidation batch=0 overwrites all owned cells without reading old energy.
    if (_SdfRadiosityBatch > 0u && sample.a > 0.0)
    {
        float4 old = _SdfRadiosityOutput[pixel];
        if (old.a > 0.0)
            sample.rgb = lerp(old.rgb, sample.rgb, rcp(float(_SdfRadiosityBatch + 1u)));
    }
    _SdfRadiosityOutput[pixel] = SdfRoundToNearestHalf(sample);
}

[numthreads(8, 8, 1)]
void PublishSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    _SdfRadiosityOutput[id.xy] = _SdfRadiosityInput.Load(int3(id.xy, 0));
}

[numthreads(8, 8, 1)]
void PublishSdfSurfaceRadiosityCards(uint3 id : SV_DispatchThreadID)
{
    uint card = _SdfRadiosityFirstCard + id.z;
    if (card >= _SdfRadiosityCardCount)
        return;
    uint2 pixel = RadiosityAtlasPixel(card, id.xy);
    float4 sample = _SdfRadiosityInput.Load(int3(pixel, 0));
    if (_SdfRadiosityPublishBlend < 1.0 && sample.a > 0.0)
    {
        float4 old = _SdfRadiosityOutput[pixel];
        if (old.a > 0.0)
            sample.rgb = lerp(old.rgb, sample.rgb, _SdfRadiosityPublishBlend);
        sample = SdfRoundToNearestHalf(sample);
    }
    // Uncovered cells replace old coverage immediately, including moving silhouettes.
    _SdfRadiosityOutput[pixel] = sample;
}

[numthreads(8, 8, 1)]
void ClearSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    _SdfRadiosityOutput[id.xy] = 0.0;
}

[numthreads(8, 8, 1)]
void RescaleSdfSurfaceRadiosity(uint3 id : SV_DispatchThreadID)
{
    if (id.z >= _SdfRadiosityCardCount)
        return;
    uint2 pixel = RadiosityAtlasPixel(id.z, id.xy);
    float4 old = _SdfRadiosityOutput[pixel];
    if (old.a > 0.0)
        old.rgb = clamp(old.rgb * _SdfRadiosityHistoryScale.rgb, 0.0, 65000.0);
    else
        old = 0.0;
    _SdfRadiosityOutput[pixel] = SdfRoundToNearestHalf(old);
}
#endif
