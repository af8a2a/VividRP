#pragma kernel FilterSdfDiffuseProbes
#pragma kernel FilterSdfDirectionalHits

#pragma kernel ScreenProbeCompositeTracesWithScatterCS
#pragma kernel ScreenProbeTemporallyAccumulateTraceRadianceCS
#pragma kernel ScreenProbeFilterGatherTracesCS
#pragma kernel ScreenProbeConvertToIrradianceCS

#include "SdfScreenProbeCommon.hlsl"
#include "SdfScreenProbeHistory.hlsl"
#include "SdfDiffuseDirectionalCache.hlsl"

#include "SdfScreenProbeIrradiance.hlsl"

float FilterNeighborWeight(uint2 tile, float4 center, float3 normal, float eyeDepth)
{
    float4 geometry = _SdfDiffuseGeometry[tile];
    if (geometry.w < 0.0)
        return 0.0;
    float weight = ProbeGeometryWeight(geometry.xyz - center.xyz, normal, UnpackProbeNormal(geometry.w), eyeDepth);
    return weight * _SdfDiffuseProbeInput.Load(int3(tile, 0)).a;
}

static const int2 ProbeFilterOffsets[24] =
{
    int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1),
    int2(-1, -1), int2(1, -1), int2(-1, 1), int2(1, 1),
    int2(-2, 0), int2(2, 0), int2(0, -2), int2(0, 2),
    int2(-2, -1), int2(-2, 1), int2(2, -1), int2(2, 1),
    int2(-1, -2), int2(1, -2), int2(-1, 2), int2(1, 2),
    int2(-2, -2), int2(2, -2), int2(-2, 2), int2(2, 2)
};

uint ProbeSpatialTapCount(float confidence)
{
    if (_SdfProbeSpatialKernel == 0u)
        return 4u;
    return _SdfProbeSpatialKernel == 2u && confidence < 0.625 ? 24u : 8u;
}

float ProbeSpatialFalloff(int2 offset)
{
    return exp2(-0.55 * float(dot(offset, offset) - 1));
}

float SelectFilterNeighbor(int2 neighbor, uint2 grid, float4 center, float3 normal, float eyeDepth, out uint2 selected)
{
    selected = uint2(neighbor);
    if (any(neighbor < 0) || any(neighbor >= int2(grid)))
        return 0.0;
    float weight = FilterNeighborWeight(selected, center, normal, eyeDepth);
    if (_SdfDiffuseAdaptiveProbes != 0u)
    {
        uint2 adaptive = selected + uint2(0, grid.y);
        float alternateWeight = FilterNeighborWeight(adaptive, center, normal, eyeDepth);
        if (alternateWeight > weight)
        {
            weight = alternateWeight;
            selected = adaptive;
        }
    }
    return weight * 0.65;
}

void FilterProbeLighting(uint2 tile, uint2 grid, float4 center, float4 geometry, float3 normal,
    float4 compatibility, uint planes, out float3 lighting[4])
{
    uint2 stride = uint2(grid.x, 0u);
    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        lighting[plane] = _SdfDiffuseProbeInput.Load(int3(tile + plane * stride, 0)).rgb;

    float total = _SdfProbeSpatialKernel == 0u ? 1.0 : max(0.25, center.a);
    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        lighting[plane] *= total;
    if (geometry.w >= 0.0 && center.a > 0.0)
    {
        float eyeDepth = dot(float4(geometry.xyz, 1.0), _SdfProbeCameraForward);
        int2 uniformTile = int2(tile.x, tile.y % grid.y);
        [loop]
        for (uint i = 0u; i < ProbeSpatialTapCount(center.a); ++i)
        {
            uint2 selected;
            int2 offset = ProbeFilterOffsets[i];
            float weight = SelectFilterNeighbor(uniformTile + offset, grid, geometry, normal, eyeDepth, selected);
            weight *= i < 4u ? compatibility[min(i, 3u)] : ProbeSpatialFalloff(offset);
            if (weight <= 0.0)
                continue;
            total += weight;
            [loop]
            for (uint plane = 0u; plane < planes; ++plane)
                lighting[plane] += _SdfDiffuseProbeInput.Load(int3(selected + plane * stride, 0)).rgb * weight;
        }
    }

    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        lighting[plane] /= total;
}

[numthreads(8, 8, 1)]
void FilterSdfDiffuseProbes(uint3 id : SV_DispatchThreadID)
{
    uint2 grid = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy));
    if (any(id.xy >= grid * uint2(1u, 1u + _SdfDiffuseAdaptiveProbes)))
        return;

    float4 center = _SdfDiffuseProbeInput.Load(int3(id.xy, 0));
    float4 geometry = _SdfDiffuseGeometry[id.xy];
    float3 normal = geometry.w >= 0.0 ? UnpackProbeNormal(geometry.w) : 0.0;
    uint planes = _SdfDiffuseDirectionalProbes != 0u ? 4u : 1u;
    float3 lighting[4];
    FilterProbeLighting(id.xy, grid, center, geometry, normal, 1.0, planes, lighting);
    uint2 stride = uint2(grid.x, 0u);
    [loop]
    for (uint plane = 0u; plane < planes; ++plane)
        _SdfDiffuseFilteredProbes[id.xy + plane * stride] = float4(lighting[plane], plane == 0u ? center.a : 0.0);
}

float3 DecodeHitDirection(uint packed)
{
    return VividDecodeSurfaceSummaryNormal(float2(packed & 63u, (packed >> 6u) & 63u) / 63.0);
}

float HitDistanceRejection(uint2 tile, float3 origin, float3 direction, float distance)
{
    float bestAlignment = 0.92;
    float3 bestHit = 0.0;
    [loop]
    for (uint ray = 0u; ray < RaysPerProbe; ++ray)
    {
        uint packed = uint(_SdfDiffuseHitSamplesInput.Load(int3(tile.x * RaysPerProbe + ray, tile.y, 0)));
        if (packed == 0u)
            continue;
        float3 neighborDirection = DecodeHitDirection(packed);
        float alignment = dot(direction, neighborDirection);
        if (alignment > bestAlignment)
        {
            bestAlignment = alignment;
            bestHit = neighborDirection * (float(packed >> 12u) * (_SdfDiffuseMaxDistance / 4095.0));
        }
    }
    if (bestAlignment <= 0.92)
        return 0.0;

    float4 geometry = _SdfDiffuseGeometry[tile];
    float3 offset = geometry.xyz + UnpackProbeNormal(geometry.w) * _SdfDiffuseRayBias - origin;
    float3 hit = offset + bestHit;
    float tolerance = max(0.12, 0.15 * distance) + 0.25 * length(offset);
    float separation = abs(dot(hit, direction) - distance);
    return smoothstep(0.92, 0.99, bestAlignment) * smoothstep(tolerance, 2.0 * tolerance, separation);
}

groupshared float4 ProbeHitRejection[8][RaysPerProbe];

[numthreads(8, 8, 1)]
void FilterSdfDirectionalHits(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID)
{
    uint2 tile = uint2(group.x * 8u + lane.y, group.y);
    uint2 grid = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy));
    bool inBounds = tile.x < grid.x;
    float4 center = 0.0;
    float4 geometry = 0.0;
    float3 normal = 0.0;
    float4 rejection = 0.0;
    if (inBounds)
    {
        center = _SdfDiffuseProbeInput.Load(int3(tile, 0));
        geometry = _SdfDiffuseGeometry[tile];
        if (center.a > 0.0 && geometry.w >= 0.0)
        {
            normal = UnpackProbeNormal(geometry.w);
            uint packed = uint(_SdfDiffuseHitSamplesInput.Load(int3(tile.x * RaysPerProbe + lane.x, tile.y, 0)));
            if (packed != 0u)
            {
                float3 direction = DecodeHitDirection(packed);
                float distance = float(packed >> 12u) * (_SdfDiffuseMaxDistance / 4095.0);
                float3 origin = geometry.xyz + normal * _SdfDiffuseRayBias;
                float eyeDepth = dot(float4(geometry.xyz, 1.0), _SdfProbeCameraForward);
                int2 uniformTile = int2(tile.x, tile.y % grid.y);
                [unroll]
                for (uint i = 0u; i < 4u; ++i)
                {
                    uint2 selected;
                    float weight = SelectFilterNeighbor(uniformTile + ProbeFilterOffsets[i], grid, geometry, normal, eyeDepth, selected);
                    if (weight > 0.0)
                        rejection[i] = HitDistanceRejection(selected, origin, direction, distance);
                }
            }
        }
    }

    ProbeHitRejection[lane.y][lane.x] = rejection;
    GroupMemoryBarrierWithGroupSync();
    if (!inBounds || lane.x != 0u)
        return;

    [unroll]
    for (uint ray = 1u; ray < RaysPerProbe; ++ray)
        rejection += ProbeHitRejection[lane.y][ray];

    // Only aligned rays provide evidence of a discontinuity. Keep the original
    // spatial weight where sparse samples cannot establish a correspondence.
    float4 compatibility = 1.0 - 0.75 * saturate(0.5 * rejection);
    uint planes = _SdfDiffuseDirectionalProbes != 0u ? 4u : 1u;
    float3 lighting[4];
    FilterProbeLighting(tile, grid, center, geometry, normal, compatibility, planes, lighting);
    float3x3 moments = (float3x3)0.0;
    if (planes > 1u)
        moments = float3x3(lighting[1], lighting[2], lighting[3]);
    center.rgb = lighting[0];
    center = AccumulateProbe(center, geometry.xyz, normal, moments);
    StoreProbe(tile, center, moments);
}

Texture2D<float4> _SdfDirectionalPrevious;
Texture2D<float4> _SdfDirectionalRays;
Texture2D<float4> _SdfDirectionalComposite;
Texture2D<float4> _SdfDirectionalTemporal;
Texture2D<float4> _SdfDirectionalFiltered;
RWTexture2D<float4> _SdfDirectionalCompositeOutput;
RWTexture2D<float4> _SdfDirectionalTemporalOutput;
RWTexture2D<float4> _SdfDirectionalFilteredOutput;
uint _SdfDirectionalHasHistory;

groupshared float4 SharedTraceRadiance[RaysPerProbe];
groupshared float4 SharedTraceMetadata[RaysPerProbe];

[numthreads(16, 1, 1)]
void ScreenProbeCompositeTracesWithScatterCS(uint3 group : SV_GroupID, uint bin : SV_GroupIndex)
{
    uint2 tile = group.xy;
    uint2 offset = DirectionalMetadataOffset(DirectionalGrid());
    float4 geometry = _SdfDiffuseGeometry[tile];
    if (bin < RaysPerProbe)
    {
        float4 sample = 0.0;
        float4 metadata = 0.0;
        if (geometry.w >= 0.0)
        {
            uint2 address = DirectionalAddress(tile, bin);
            sample = _SdfDirectionalRays.Load(int3(address, 0));
            metadata = _SdfDirectionalRays.Load(int3(address + offset, 0));
            float3 direction = VividDecodeSurfaceSummaryNormal(metadata.zw);
            metadata.x = DirectionalGatherBin(direction, GetLocalFrame(UnpackProbeNormal(geometry.w)));
        }
        SharedTraceRadiance[bin] = sample;
        SharedTraceMetadata[bin] = metadata;
    }
    GroupMemoryBarrierWithGroupSync();

    // The tracing stage has already selected one winner per ray. Scatter its
    // cosine mass to the gather chart and reduce in ray order at each bin.
    float3 radiance = 0.0;
    float drawWeight = 0.0;
    float coveredWeight = 0.0;
    float4 hit = 0.0;
    [unroll]
    for (uint ray = 0u; ray < RaysPerProbe; ++ray)
    {
        float4 metadata = SharedTraceMetadata[ray];
        if (uint(metadata.x) != bin)
            continue;
        drawWeight += metadata.y;
        float4 sample = SharedTraceRadiance[ray];
        if (sample.a == 0.0)
            continue;
        radiance += sample.rgb * metadata.y;
        coveredWeight += metadata.y;
        if (hit.x == 0.0 || (sample.a > 0.0 && (hit.x < 0.0 || sample.a < hit.x)))
            hit = float4(sample.a, 0.0, metadata.zw);
    }
    hit.y = drawWeight;
    uint2 output = DirectionalGatherAddress(tile, bin);
    _SdfDirectionalCompositeOutput[output] = float4(radiance / max(coveredWeight, 1e-5), coveredWeight);
    _SdfDirectionalCompositeOutput[output + offset] = hit;
}

float ProbeTraceHitWeight(float4 center, float4 other, float3 delta)
{
    if (other.x == 0.0 || (center.x < 0.0) != (other.x < 0.0))
        return 0.0;

    float3 direction = VividDecodeSurfaceSummaryNormal(center.zw);
    float3 otherDirection = VividDecodeSurfaceSummaryNormal(other.zw);
    if (center.x < 0.0)
        return smoothstep(0.88, 0.98, dot(direction, otherDirection));

    // Clamp the distance used to judge angle so a distant neighbor cannot
    // blur away a nearby contact. Compare the full endpoints separately.
    float3 endpoint = delta + other.x * otherDirection;
    float endpointDistance = length(endpoint);
    float tolerance = clamp(0.30 * min(center.x, endpointDistance), 0.06, 0.5);
    float distanceWeight = saturate(1.0 - abs(center.x - endpointDistance) / tolerance);
    float3 contact = delta + min(center.x, other.x) * otherDirection;
    float angle = dot(direction, contact) / max(length(contact), 1e-5);
    return distanceWeight * smoothstep(0.84, 0.98, angle);
}

float ProbeTraceGeometryWeight(float4 geometry, float3 position, float3 normal, float eyeDepth)
{
    if (geometry.w < 0.0)
        return 0.0;
    float3 delta = geometry.xyz - position;
    float depth = dot(delta, _SdfProbeCameraForward.xyz) / max(eyeDepth, 0.1);
    return ProbeGeometryWeight(delta, normal, UnpackProbeNormal(geometry.w), eyeDepth)
        * exp2(-80.0 * depth * depth);
}

[numthreads(16, 1, 1)]
void ScreenProbeTemporallyAccumulateTraceRadianceCS(uint3 group : SV_GroupID, uint bin : SV_GroupIndex)
{
    uint2 tile = group.xy;
    uint2 address = DirectionalGatherAddress(tile, bin);
    float4 current = _SdfDirectionalComposite.Load(int3(address, 0));
    float4 geometry = _SdfDiffuseGeometry[tile];
    uint2 grid = DirectionalGrid();
    uint2 offset = DirectionalMetadataOffset(grid);
    float4 hit = _SdfDirectionalComposite.Load(int3(address + offset, 0));
    current.a /= max(hit.y, 1e-5);
    // Temporal metadata stores sample age and up to eight undrawn frames in Y.
    // Composite metadata continues to store the current draw mass for spatial filtering.
    float4 temporalHit = float4(hit.x, current.a > 0.0 ? 1.0 : 0.0, hit.zw);
    // A ray that explicitly failed to resolve cannot borrow coverage from history.
    if (_SdfDirectionalHasHistory != 0u && geometry.w >= 0.0 && (current.a > 0.0 || hit.y == 0.0))
    {
        float4 clip = mul(_SdfDiffusePreviousVP, float4(geometry.xyz, 1.0));
        float2 uv = ScreenUv(clip);
        if (clip.w > 0.0 && all(uv >= 0.0) && all(uv < 1.0))
        {
            float3 normal = UnpackProbeNormal(geometry.w);
            float3 direction = DirectionalGatherDirection(bin, GetLocalFrame(normal));
            float eyeDepth = max(0.1, dot(float4(geometry.xyz, 1.0), _SdfProbeCameraForward));
            float2 probe = uv * _SdfDiffuseScreenSize.xy / ProbeSpacing - 0.5;
            int2 lower = int2(floor(probe));
            float2 fraction = frac(probe);
            float3 history = 0.0;
            float total = 0.0;
            float geometryTotal = 0.0;
            float ageSum = 0.0;
            float bestWeight = 0.0;
            float4 historyHit = 0.0;
            [loop]
            for (uint tap = 0u; tap < 4u; ++tap)
            {
                int2 corner = int2(tap & 1u, tap >> 1u);
                int2 candidate = lower + corner;
                if (any(candidate < 0) || any(candidate >= int2(grid)))
                    continue;
                uint2 oldTile = uint2(candidate);
                float4 oldGeometry = _SdfDiffusePreviousGeometry.Load(int3(oldTile, 0));
                float weight = ProbeTraceGeometryWeight(oldGeometry, geometry.xyz, normal, eyeDepth);
                if (_SdfDiffuseAdaptiveProbes != 0u)
                {
                    uint2 adaptive = oldTile + uint2(0u, grid.y);
                    float4 alternate = _SdfDiffusePreviousGeometry.Load(int3(adaptive, 0));
                    float alternateWeight = ProbeTraceGeometryWeight(alternate, geometry.xyz, normal, eyeDepth);
                    if (alternateWeight > weight)
                    {
                        oldTile = adaptive;
                        oldGeometry = alternate;
                        weight = alternateWeight;
                    }
                }
                float3 delta = oldGeometry.xyz - geometry.xyz;
                if (weight <= 0.0 || length(delta) > clamp(0.035 * eyeDepth, 0.12, 0.40))
                    continue;

                uint oldBin = DirectionalGatherBin(direction, GetLocalFrame(UnpackProbeNormal(oldGeometry.w)));
                uint2 oldAddress = DirectionalGatherAddress(oldTile, oldBin);
                float4 oldLighting = _SdfDirectionalPrevious.Load(int3(oldAddress, 0));
                float4 oldHit = _SdfDirectionalPrevious.Load(int3(oldAddress + offset, 0));
                float oldAge = floor(oldHit.y);
                float oldStale = round(frac(oldHit.y) * 32.0);
                if (oldLighting.a <= 0.0 || oldAge < 1.0 || oldStale >= 8.0)
                    continue;
                if (current.a > 0.0)
                    weight *= ProbeTraceHitWeight(hit, oldHit, delta);
                else if (oldHit.x > 0.0)
                {
                    float3 endpoint = delta + oldHit.x * VividDecodeSurfaceSummaryNormal(oldHit.zw);
                    weight *= smoothstep(0.88, 0.98, dot(direction, SafeNormalize(endpoint)));
                }
                float2 bilinear = lerp(1.0 - fraction, fraction, float2(corner));
                weight *= bilinear.x * bilinear.y;
                geometryTotal += weight;
                weight *= oldLighting.a;
                history += oldLighting.rgb * weight;
                total += weight;
                ageSum += oldAge * weight;
                if (weight > bestWeight)
                {
                    bestWeight = weight;
                    historyHit = oldHit;
                }
            }
            if (total > 1e-5)
            {
                history /= total;
                float historyCoverage = saturate(total / max(geometryTotal, 1e-5));
                float age = min(ageSum / total, 7.0);
                if (current.a > 0.0)
                {
                    float blend = (age / (age + 1.0)) * saturate(geometryTotal);
                    float coverage = lerp(current.a, historyCoverage, blend);
                    current.rgb = lerp(current.rgb * current.a, history * historyCoverage, blend) / max(coverage, 1e-5);
                    current.a = coverage;
                    temporalHit.y = clamp(round(1.0 + age * saturate(geometryTotal)), 1.0, 8.0);
                }
                else
                {
                    // An undrawn direction can retain a validated estimate. An explicitly
                    // unresolved current ray was excluded above and cannot inherit coverage.
                    current = float4(history, historyCoverage * saturate(geometryTotal));
                    float stale = round(frac(historyHit.y) * 32.0) + 1.0;
                    temporalHit = float4(historyHit.x, floor(historyHit.y) + stale / 32.0, historyHit.zw);
                }
            }
        }
    }
    _SdfDirectionalTemporalOutput[address] = current;
    _SdfDirectionalTemporalOutput[address + offset] = temporalHit;
}

[numthreads(16, 1, 1)]
void ScreenProbeFilterGatherTracesCS(uint3 group : SV_GroupID, uint bin : SV_GroupIndex)
{
    uint2 tile = group.xy;
    uint2 address = DirectionalGatherAddress(tile, bin);
    float4 lighting = _SdfDirectionalTemporal.Load(int3(address, 0));
    if (_SdfDiffuseSpatialFilter != 0u)
    {
        uint2 grid = DirectionalGrid();
        uint2 offset = DirectionalMetadataOffset(grid);
        float4 hit = _SdfDirectionalTemporal.Load(int3(address + offset, 0));
        float drawMass = _SdfDirectionalComposite.Load(int3(address + offset, 0)).y;
        float4 geometry = _SdfDiffuseGeometry[tile];
        // A traced miss stays unresolved. Only directions without a draw can borrow shape.
        bool fill = _SdfProbeSpatialKernel != 0u && drawMass == 0.0 && lighting.a == 0.0;
        if (geometry.w >= 0.0 && ((hit.x != 0.0 && lighting.a > 0.0) || fill))
        {
            float3 normal = UnpackProbeNormal(geometry.w);
            float3 direction = DirectionalGatherDirection(bin, GetLocalFrame(normal));
            float eyeDepth = max(0.1, dot(float4(geometry.xyz, 1.0), _SdfProbeCameraForward));
            float total = fill ? 0.0 : _SdfProbeSpatialKernel == 0u ? 1.0 : max(0.25, lighting.a);
            float3 sum = lighting.rgb * total;
            uint donors = 0u;
            float4 referenceHit = hit;
            float3 referencePosition = geometry.xyz;
            [loop]
            for (uint tap = 0u; tap < ProbeSpatialTapCount(min(lighting.a, drawMass / (1.0 + drawMass))); ++tap)
            {
                int2 tapOffset = ProbeFilterOffsets[tap];
                int2 candidate = int2(tile.x, tile.y % grid.y) + tapOffset;
                if (any(candidate < 0) || any(candidate >= int2(grid)))
                    continue;
                uint2 neighbor = uint2(candidate);
                float4 other = _SdfDiffuseGeometry[neighbor];
                float weight = ProbeTraceGeometryWeight(other, geometry.xyz, normal, eyeDepth);
                if (_SdfDiffuseAdaptiveProbes != 0u)
                {
                    uint2 adaptive = neighbor + uint2(0u, grid.y);
                    float4 alternate = _SdfDiffuseGeometry[adaptive];
                    float alternateWeight = ProbeTraceGeometryWeight(alternate, geometry.xyz, normal, eyeDepth);
                    if (alternateWeight > weight)
                    {
                        neighbor = adaptive;
                        other = alternate;
                        weight = alternateWeight;
                    }
                }
                if (weight <= 0.0)
                    continue;
                uint otherBin = DirectionalGatherBin(direction, GetLocalFrame(UnpackProbeNormal(other.w)));
                uint2 otherAddress = DirectionalGatherAddress(neighbor, otherBin);
                float4 otherLighting = _SdfDirectionalTemporal.Load(int3(otherAddress, 0));
                float4 otherHit = _SdfDirectionalTemporal.Load(int3(otherAddress + offset, 0));
                if (fill)
                {
                    float3 delta = other.xyz - geometry.xyz;
                    float3 endpoint = delta + otherHit.x * VividDecodeSurfaceSummaryNormal(otherHit.zw);
                    // Without a center endpoint, accept only mutually consistent distant surface hits.
                    if (otherLighting.a <= 0.0 || otherHit.x <= max(0.5, 2.0 * length(delta))
                        || dot(direction, SafeNormalize(endpoint)) < 0.92)
                        continue;
                    if (donors == 0u)
                    {
                        referenceHit = otherHit;
                        referencePosition = other.xyz;
                    }
                }
                weight *= otherLighting.a * ProbeSpatialFalloff(tapOffset)
                    * ProbeTraceHitWeight(referenceHit, otherHit, other.xyz - referencePosition);
                if (weight <= 0.0)
                    continue;
                donors++;
                sum += otherLighting.rgb * weight;
                total += weight;
            }
            if (!fill)
                lighting.rgb = sum / total;
            else if (donors >= 2u && total > 1e-4)
                // Negative alpha carries limited shape support. It is excluded from sampling guidance.
                lighting = float4(sum / total, -0.125 * saturate(total));
        }
    }
    _SdfDirectionalFilteredOutput[address] = lighting;
}

float4 AccumulateDirectionalProbeAnchor(float4 current, float3 position, float3 normal)
{
    if (_SdfDiffuseHasHistory == 0u)
        return current;
    float4 clip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (clip.w <= 0.0)
        return current;
    float2 uv = ScreenUv(clip);
    if (any(uv < 0.0) || any(uv >= 1.0))
        return current;

    uint2 grid = DirectionalGrid();
    float2 probe = uv * _SdfDiffuseScreenSize.xy / ProbeSpacing - 0.5;
    int2 lower = int2(floor(probe));
    float2 fraction = frac(probe);
    float eyeDepth = max(0.1, dot(float4(position, 1.0), _SdfProbeCameraForward));
    float radius = clamp(0.04 * eyeDepth, 0.12, 0.40);
    float4 history = 0.0;
    float total = 0.0;
    [unroll]
    for (uint tap = 0u; tap < 4u; ++tap)
    {
        int2 corner = int2(tap & 1u, tap >> 1u);
        int2 candidate = lower + corner;
        if (any(candidate < 0) || any(candidate >= int2(grid)))
            continue;
        uint2 tile = uint2(candidate);
        float weight = ProbeReprojectionWeight(_SdfDiffusePreviousGeometry.Load(int3(tile, 0)),
            position, normal, eyeDepth, radius);
        if (_SdfDiffuseAdaptiveProbes != 0u)
        {
            uint2 adaptive = tile + uint2(0u, grid.y);
            float alternate = ProbeReprojectionWeight(_SdfDiffusePreviousGeometry.Load(int3(adaptive, 0)),
                position, normal, eyeDepth, radius);
            if (alternate > weight)
            {
                tile = adaptive;
                weight = alternate;
            }
        }
        float4 sample = _SdfDiffusePreviousProbes.Load(int3(tile, 0));
        if (sample.a <= 0.0)
            continue;
        float2 bilinear = lerp(1.0 - fraction, fraction, float2(corner));
        weight *= bilinear.x * bilinear.y;
        history += float4(sample.rgb * sample.a, sample.a) * weight;
        total += weight;
    }
    if (total > 1e-5)
    {
        float4 covered = float4(current.rgb * current.a, current.a);
        covered = lerp(covered, history / total, 0.85 * saturate(total));
        current = float4(covered.rgb / max(covered.a, 1e-5), covered.a);
    }
    return current;
}

[numthreads(8, 8, 1)]
void ScreenProbeConvertToIrradianceCS(uint3 id : SV_DispatchThreadID)
{
    uint2 grid = DirectionalGrid();
    if (any(id.xy >= grid * uint2(1u, 1u + _SdfDiffuseAdaptiveProbes)))
        return;

    float4 geometry = _SdfDiffuseGeometry[id.xy];
    SdfProbeIrradiance sh = (SdfProbeIrradiance)0;
    float covered = 0.0;
    float4 anchorLighting = 0.0;
    if (geometry.w >= 0.0)
    {
        float3 normal = UnpackProbeNormal(geometry.w);
        float3x3 basis = GetLocalFrame(normal);
        float3 anchor = 0.0;
        float3 borrowedAnchor = 0.0;
        [loop]
        for (uint bin = 0u; bin < DirectionalGatherBinCount; ++bin)
        {
            uint2 address = DirectionalGatherAddress(id.xy, bin);
            float4 traced = _SdfDirectionalComposite.Load(int3(address, 0));
            anchorLighting += float4(traced.rgb * traced.a, traced.a);
            float4 filtered = _SdfDirectionalFiltered.Load(int3(address, 0));
            // The cosine chart has equal-mass cells. Integrate each reconstructed
            // direction once, including validated temporal samples in undrawn cells.
            const float cellMass = float(RaysPerProbe) / float(DirectionalGatherBinCount);
            float weight = cellMass * max(filtered.a, 0.0);
            if (filtered.a < 0.0)
            {
                float3 sample = filtered.rgb * (-filtered.a * cellMass);
                float3 direction = DirectionalGatherDirection(bin, basis);
                ProjectSdfProbeIrradiance(sh, sample / max(dot(normal, direction), 0.25), direction);
                borrowedAnchor += sample;
                continue;
            }
            if (weight <= 0.0)
                continue;
            float3 sample = filtered.rgb * weight;
            float3 direction = DirectionalGatherDirection(bin, basis);
            ProjectSdfProbeIrradiance(sh, sample / max(dot(normal, direction), 0.25), direction);
            anchor += sample;
            covered += weight;
        }
        anchorLighting.rgb /= max(anchorLighting.a, 1e-5);
        anchorLighting.a = saturate(anchorLighting.a / RaysPerProbe);
        anchorLighting = AccumulateDirectionalProbeAnchor(anchorLighting, geometry.xyz, normal);
        if (any(borrowedAnchor > 0.0))
        {
            // Redistribute directional shape without creating energy or trace coverage.
            float3 scale = anchor / max(anchor + borrowedAnchor, 1e-5);
            sh.r0 *= scale.r;
            sh.r1 *= scale.r;
            sh.g0 *= scale.g;
            sh.g1 *= scale.g;
            sh.b0 *= scale.b;
            sh.b1 *= scale.b;
            sh.c *= scale;
        }
        // SH truncation and a sparse cosine chart can shift the anchor energy.
        // Preserve the traced irradiance at the probe normal exactly.
        float3 correction = anchorLighting.rgb * covered - EvaluateSdfProbeIrradiance(sh, normal);
        sh.r0.w += correction.r;
        sh.g0.w += correction.g;
        sh.b0.w += correction.b;
    }
    _SdfDiffuseProbes[id.xy] = anchorLighting;

    float invCovered = rcp(max(covered, 1e-5));
    uint2 stride = uint2(grid.x, 0u);
    _SdfDiffuseFilteredProbes[id.xy] = clamp(sh.r0 * invCovered, -65000.0, 65000.0);
    _SdfDiffuseFilteredProbes[id.xy + stride] = clamp(sh.g0 * invCovered, -65000.0, 65000.0);
    _SdfDiffuseFilteredProbes[id.xy + 2u * stride] = clamp(sh.b0 * invCovered, -65000.0, 65000.0);
    _SdfDiffuseFilteredProbes[id.xy + 3u * stride] = clamp(sh.r1 * invCovered, -65000.0, 65000.0);
    _SdfDiffuseFilteredProbes[id.xy + 4u * stride] = clamp(sh.g1 * invCovered, -65000.0, 65000.0);
    _SdfDiffuseFilteredProbes[id.xy + 5u * stride] = clamp(sh.b1 * invCovered, -65000.0, 65000.0);
    _SdfDiffuseFilteredProbes[id.xy + 6u * stride] = float4(clamp(sh.c * invCovered, -65000.0, 65000.0),
        covered > 0.0 ? anchorLighting.a : 0.0);
}
