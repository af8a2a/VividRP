float _SdfProbeMaxRayIntensity;

RWTexture2D<float4> _SdfDirectionalPlaneIdentityOutput;

[numthreads(16, 1, 1)]
void InspectDirectionalPlaneIdentityCS(uint3 id : SV_DispatchThreadID)
{
    static const uint indices[10] = { 0u, 1u, 2047u, 8191u, 8192u, 65535u, 4194304u,
        0x3ffffffu, 0x4000000u, 0xffffffffu };
    if (id.x < 10u)
        _SdfDirectionalPlaneIdentityOutput[id.xy] = PackDirectionalHitPlane(float3(0.0, 1.0, 0.0), indices[id.x]);
}

[numthreads(16, 1, 1)]
void InspectDirectionalHistoryAgeCS(uint3 id : SV_DispatchThreadID)
{
    static const float masses[10] = { 0.0, 1.0, 1.03125, 1.25, 2.5, 3.5, 4.125, 5.75, 7.96875, 8.0 };
    if (id.x < 10u)
    {
        float stale = float(id.x % 9u);
        _SdfDirectionalPlaneIdentityOutput[id.xy] = float4(PackDirectionalHistoryAge(masses[id.x], stale), masses[id.x], stale, 0.0);
    }
}

