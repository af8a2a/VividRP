#pragma kernel TemporalSdfDiffuseGI
#pragma kernel ScreenProbeTemporalReprojectionCS VIVID_SDF_SCREEN_PROBE_TEMPORAL
#pragma kernel ScreenProbeTemporalReprojectionWithMomentsCS VIVID_SDF_SCREEN_PROBE_TEMPORAL VIVID_SDF_SCREEN_PROBE_MOMENTS
#pragma kernel ScreenProbeTemporalReprojectionWithAOCS VIVID_SDF_SCREEN_PROBE_TEMPORAL VIVID_SDF_SCREEN_PROBE_AO
#pragma kernel ScreenProbeTemporalReprojectionWithMomentsAndAOCS VIVID_SDF_SCREEN_PROBE_TEMPORAL VIVID_SDF_SCREEN_PROBE_MOMENTS VIVID_SDF_SCREEN_PROBE_AO
#pragma kernel TemporalSdfRestirDiffuseGI VIVID_SDF_RESTIR_PIXEL_HISTORY
#pragma kernel TemporalSdfRestirVariance VIVID_SDF_RESTIR_PIXEL_HISTORY VIVID_SDF_RESTIR_VARIANCE_HISTORY
#pragma kernel InspectSdfHistoryQuantizationCS
#pragma kernel InspectSdfCoveredHistoryEnergyCS VIVID_SDF_SCREEN_PROBE_TEMPORAL
#pragma kernel InspectScreenProbeTemporalHistoryCS VIVID_SDF_SCREEN_PROBE_TEMPORAL

#include "SdfScreenProbeCommon.hlsl"
#include "SdfDiffuseReSTIR.hlsl"

#if defined(VIVID_SDF_SCREEN_PROBE_AO)
#include "SdfShortRangeAOReconstruction.hlsl"

Texture2D<float> _SdfBentScalarNoise;
Texture2D<uint> _SdfLumenBentNormal;
Texture2D<uint> _SdfBentPrevious;
RWTexture2D<uint> _SdfBentOutput;
uint _SdfBentHistoryValid;

// LumenScreenProbeGatherTemporal.usf, SHORT_RANGE_AO_MODE == 2.
half4 UnpackSharedShortRangeAO(uint Packed)
{
    half3 BentNormal;
    BentNormal.z = half(Packed >> 21) / 2047.0;
    BentNormal.x = half((Packed >> 10) & 2047) / 2047.0;
    BentNormal.y = half(Packed & 1023) / 1023.0;
    BentNormal = BentNormal * 2.0 - 1.0;
    half Len = sqrt(dot(BentNormal, BentNormal));
    return half4(BentNormal / max(Len, half(0.0001)), Len);
}

uint PackSharedShortRangeAO(half4 BentNormalAndAO)
{
    half3 BentNormal = normalize(BentNormalAndAO.xyz) * BentNormalAndAO.w;
    return PackScreenBentNormal(BentNormal);
}

// StochasticLightingTileClassification.usf, 2x2 triangle/depth/normal footprint.
int2 ReconstructShortRangeAO(uint2 Pixel, float3 Position, float3 Normal, out bool bValidReconstruction)
{
    int2 ScreenCoord = int2(BentScreenPixel(Pixel));
    int2 DownsampledCoord00 = int2(floor((float2(ScreenCoord) + 0.5f) / 2.0f - 0.5f));
    int2 Last = (int2(_SdfDiffuseScreenSize.xy) - 1) / 2;
    float4 UpsampleWeights = 0;
    float4 CornerDepths = 0;
    float3 CornerPositions[4];
    float3 CornerNormals[4];
    float SceneDepth = dot(float4(Position, 1.0), _SdfProbeCameraForward);
    [unroll]
    for (uint Index = 0u; Index < 4u; ++Index)
    {
        int2 Cell = DownsampledCoord00 + int2(Index & 1u, Index >> 1u);
        int2 SampleScreenOffset = Cell * 2 + GetDownsampleJitter2x2(Cell) - ScreenCoord;
        uint2 ReceiverPixel = BentDownsampledReceiver(Cell);
        if (LoadReceiver(ReceiverPixel, CornerPositions[Index], CornerNormals[Index]))
            CornerDepths[Index] = dot(float4(CornerPositions[Index], 1.0), _SdfProbeCameraForward);
        if (all(Cell >= 0) && all(Cell <= Last))
            UpsampleWeights[Index] = (2.0f - abs(SampleScreenOffset.x)) * (2.0f - abs(SampleScreenOffset.y));
    }

    // UE Position01 uses its own depth for XY and the 00 depth for the view Z component.
    CornerPositions[2] += _SdfProbeCameraForward.xyz * (CornerDepths.x - CornerDepths.z);
    float4 ScenePlane = float4(Normal, dot(Position, Normal));
    [unroll]
    for (uint Corner = 0u; Corner < 4u; ++Corner)
    {
        float PlaneDistance = abs(dot(float4(CornerPositions[Corner], -1), ScenePlane));
        float RelativeDepthDifference = PlaneDistance / SceneDepth;
        float DepthWeight = CornerDepths[Corner] > 0.0f
            ? exp2(-5000.0f * (RelativeDepthDifference * RelativeDepthDifference)) : 0.0f;
        float NormalWeight = 1.0f - saturate(VividBentNormalAcosFast(saturate(dot(CornerNormals[Corner], Normal))));
        UpsampleWeights[Corner] *= DepthWeight;
        UpsampleWeights[Corner] *= NormalWeight * NormalWeight;
    }

    uint3 WrappedCoordinate = uint3(ScreenCoord, _SdfDiffuseFrame) & uint3(127u, 127u, 63u);
    uint3 TextureCoordinate = uint3(WrappedCoordinate.x, 8191u - (WrappedCoordinate.z * 128u + WrappedCoordinate.y), 0);
    float RandomScalar = _SdfBentScalarNoise.Load(TextureCoordinate);
    float4 PreSum;
    PreSum.x = UpsampleWeights.x;
    PreSum.y = PreSum.x + UpsampleWeights.y;
    PreSum.z = PreSum.y + UpsampleWeights.z;
    PreSum.w = PreSum.z + UpsampleWeights.w;
    PreSum /= max(PreSum.w, 0.00001f);
    int2 StochasticBilinearOffset = RandomScalar <= PreSum.x ? int2(0, 0)
        : RandomScalar <= PreSum.y ? int2(1, 0) : RandomScalar <= PreSum.z ? int2(0, 1) : int2(1, 1);
    bValidReconstruction = dot(UpsampleWeights, 1.0f) >= 0.01f;
    return clamp((ScreenCoord - 1) / 2 + StochasticBilinearOffset, 0, Last);
}

half4 ClampShortRangeAOHistory(uint2 Pixel, int2 SampleCoord, half4 CenterShortRangeAO, half4 HistoryShortRangeAO)
{
    // The reference tile has a one-cell border around its 4x4 downsampled interior.
    int2 TileMin = int2(BentScreenPixel(Pixel) / 8u) * 4 - 1;
    int2 SharedCoord = SampleCoord - TileMin;
    int2 Last = (int2(_SdfDiffuseScreenSize.xy) - 1) / 2;
    half4 AOSum = CenterShortRangeAO;
    half4 AOSqSum = CenterShortRangeAO * CenterShortRangeAO;
    half WeightSum = 1.0;
    [unroll]
    for (int Y = -1; Y <= 1; ++Y)
    {
        [unroll]
        for (int X = -1; X <= 1; ++X)
        {
            int2 NeighborSharedCoord = SharedCoord + int2(X, Y);
            if ((X != 0 || Y != 0) && all(NeighborSharedCoord >= 0) && all(NeighborSharedCoord < 6))
            {
                int2 LoadCoord = clamp(TileMin + NeighborSharedCoord, 0, Last);
                half4 NeighborAO = UnpackSharedShortRangeAO(_SdfLumenBentNormal.Load(int3(LoadCoord, 0)));
                AOSum += NeighborAO;
                AOSqSum += NeighborAO * NeighborAO;
                WeightSum += 1.0;
            }
        }
    }
    half4 M1 = AOSum / WeightSum;
    half4 M2 = AOSqSum / WeightSum;
    half4 Variance = max(M2 - M1 * M1, half(0.0));
    half4 StdDev = sqrt(Variance);
    return clamp(HistoryShortRangeAO, M1 - StdDev, M1 + StdDev);
}
#endif

float _SdfPixelHistoryMaxAge;

#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
Texture2D<float4> _SdfScreenProbePreviousMoments;
RWTexture2D<float4> _SdfScreenProbeMomentsOutput;
uint _SdfScreenProbeMomentsHistoryValid;

float ScreenProbeLogLuminance(float3 value)
{
    return log2(1.0 + RestirLuminance(value));
}
#endif

#if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
Texture2D<float> _SdfRestirPreviousVariance;
RWTexture2D<float> _SdfRestirVarianceHistoryOutput;
#endif

#if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
static const uint ScreenProbeNoHistory = 0u;
static const uint ScreenProbeHistoryAccepted = 1u;
static const uint ScreenProbeHistoryCoverageLimited = 2u;

float PackScreenProbePixelHistory(float age, float coverage, uint historyStatus)
{
    if (age == 0.0)
        return 0.0;

    // A normal, finite FP16 encoding preserves the payload through the history RT.
    // Bits after the exponent offset are coverage (8), age (5), and status (2).
    uint coverageBits = max(1u, uint(round(saturate(coverage) * 255.0)));
    uint ageBits = uint(round(clamp(age, 1.0, 32.0))) - 1u;
    return f16tof32(0x0400u + (historyStatus << 13u) + (ageBits << 8u) + coverageBits);
}

float2 UnpackScreenProbePixelHistory(float packed)
{
    uint bits = f32tof16(packed) - 0x0400u;
    return float2(1.0 + ((bits >> 8u) & 31u), (bits & 255u) * (1.0 / 255.0));
}

float3 DecodeScreenProbeCoveredHistory(float3 rgb, float coverage)
{
    // Editor control for the old conditional-RGB / quantized-coverage feedback.
    return (_SdfGatherHistoryDiagnostics & 2097152u) != 0u ? rgb * coverage : rgb;
}

float3 EncodeScreenProbeCoveredHistory(float3 rgb, float coverage)
{
    float3 value = (_SdfGatherHistoryDiagnostics & 2097152u) != 0u ? rgb : rgb * coverage;
    return RoundSdfHistory(float4(value, 0.0)).rgb;
}
#endif

float3 SdfHistoryYCoCg(float3 rgb)
{
    return float3(dot(rgb, float3(0.25, 0.5, 0.25)), 0.5 * (rgb.r - rgb.b),
        0.5 * rgb.g - 0.25 * (rgb.r + rgb.b));
}

float3 SdfHistoryRgb(float3 color)
{
    return float3(color.x + color.y - color.z, color.x + color.z, color.x - color.y - color.z);
}

float SdfPixelHistoryFastUpdate(float foreground, float objectMotionPixels)
{
    return max(saturate(4.0 * foreground), 0.85 * smoothstep(0.75, 4.0, objectMotionPixels));
}

float3 RectifyPixelHistory(uint2 pixel, float3 position, float3 normal, float4 current,
    float3 history, inout float fastUpdate)
{
    if ((_SdfGatherHistoryDiagnostics & 1u) != 0u)
        return history;
#if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
    // Sparse probe samples can move the whole neighborhood together on static geometry.
    if (fastUpdate <= 0.0 || (_SdfGatherHistoryDiagnostics & 1048576u) != 0u)
        return history;
#endif
    int2 size = int2(_SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float4 material = _SdfDiffuseGBuffer0.Load(int3(pixel, 0));
    float3 center = SdfHistoryYCoCg(current.rgb);
    float3 sum = center;
    float3 sumSquared = center * center;
    float total = 1.0;
    const int2 offsets[8] = { int2(-1, -1), int2(0, -1), int2(1, -1), int2(-1, 0),
        int2(1, 0), int2(-1, 1), int2(0, 1), int2(1, 1) };
    [loop]
    for (uint i = 0u; i < 8u; ++i)
    {
        int2 tap = int2(pixel) + offsets[i];
        if (any(tap < 0) || any(tap >= size))
            continue;
        float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        float coverage = min(abs(current.a), abs(lighting.a)) / max(abs(current.a), abs(lighting.a));
        if (coverage < 0.25 || (lighting.a < 0.0) != (current.a < 0.0))
            continue;
        float4 tapMaterial = _SdfDiffuseGBuffer0.Load(int3(tap, 0));
        float3 albedoDelta = tapMaterial.rgb - material.rgb;
        float3 tapPosition, tapNormal;
        if (tapMaterial.a != material.a || !LoadReceiver(uint2(tap), tapPosition, tapNormal))
            continue;
        float geometryWeight = ProbeGeometryWeight(tapPosition - position, normal, tapNormal, eyeDepth);
        if (geometryWeight < 0.15)
            continue;

        float weight = geometryWeight * coverage * exp2(-16.0 * dot(albedoDelta, albedoDelta));
        float3 color = SdfHistoryYCoCg(lighting.rgb);
        sum += weight * color;
        sumSquared += weight * color * color;
        total += weight;
    }

    float3 mean = sum / total;
    float3 variance = max(0.0, sumSquared / total - mean * mean);
    bool probeScaleVariance = (_SdfGatherHistoryDiagnostics & 64u) != 0u;
    #if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
        probeScaleVariance = (_SdfGatherHistoryDiagnostics & 512u) == 0u;
    #endif
    if (probeScaleVariance)
    {
        // A 3x3 pixel neighborhood underestimates noise shared by a 16px probe tile.
        // Expand only the variance bound; retain the fine mean and validate geometry/materials.
        float3 coarseVariance = 0.0;
        float coarseWeight = 0.0;
        [loop]
        for (uint i = 0u; i < 8u; ++i)
        {
            int2 tap = int2(pixel) + offsets[i] * int(ProbeSpacing / 2u);
            if (any(tap < 0) || any(tap >= size))
                continue;
            float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
            float agreement = min(abs(current.a), abs(lighting.a)) / max(abs(current.a), abs(lighting.a));
            float4 tapMaterial = _SdfDiffuseGBuffer0.Load(int3(tap, 0));
            float3 tapPosition, tapNormal;
            if (agreement < 0.25 || tapMaterial.a != material.a || (lighting.a < 0.0) != (current.a < 0.0)
                || !LoadReceiver(uint2(tap), tapPosition, tapNormal))
                continue;
            float geometryWeight = ProbeGeometryWeight(tapPosition - position, normal, tapNormal, eyeDepth);
            float3 albedoDelta = tapMaterial.rgb - material.rgb;
            float weight = geometryWeight * agreement * exp2(-16.0 * dot(albedoDelta, albedoDelta));
            if (geometryWeight < 0.15)
                continue;
            float3 delta = SdfHistoryYCoCg(lighting.rgb) - mean;
            coarseVariance += weight * delta * delta;
            coarseWeight += weight;
        }
        variance = max(variance, coarseVariance / max(coarseWeight, 1e-5));
    }
    float3 deviation = sqrt(variance);
    float3 sigmaScale = lerp(float3(2.5, 2.0, 2.0), float3(1.25, 1.25, 1.25), fastUpdate);
    float3 extent = max(deviation * sigmaScale, 0.01 + 0.04 * max(center.x, mean.x));
    float3 historyColor = SdfHistoryYCoCg(history);
    float3 delta = historyColor - mean;
    float3 normalized = abs(delta) / extent;
    float3 bounded = max(0.0, SdfHistoryRgb(mean + delta / max(1.0, Max3(normalized.x, normalized.y, normalized.z))));
#if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
    return bounded;
#else
    // A sparse sample can change color abruptly across the entire 3x3 neighborhood.
    // Shorten stable history only for a large, spatially coherent luminance change.
    float lumaScale = max(0.05, max(historyColor.x, mean.x));
    float lumaResidual = max(0.0, abs(delta.x) - extent.x) / lumaScale;
    float coherentChange = smoothstep(0.45, 0.8, lumaResidual)
        * (1.0 - smoothstep(0.05, 0.2, deviation.x / lumaScale));
    if ((_SdfGatherHistoryDiagnostics & 524288u) == 0u)
        fastUpdate = max(fastUpdate, 0.25 * coherentChange);
    // Weak rectification on stable pixels lets the long window absorb sparse trace noise.
    return (_SdfGatherHistoryDiagnostics & 1048576u) != 0u
        ? history : lerp(history, bounded, lerp(0.10, 1.0, fastUpdate));
#endif
}

#if !defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
bool ReadPixelHistory(uint2 pixel, float3 position, float3 normal, bool openPbr,
    out float4 history, out float historyCoverage, out float foregroundWeight, out float historyVariance,
    out float objectMotionPixels)
{
    history = 0.0;
    historyCoverage = 0.0;
    foregroundWeight = 0.0;
    historyVariance = 0.0;
    objectMotionPixels = 0.0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z > previousClip.w || previousClip.z <= 0.0)
        return false;

    float4 packedMotion = _SdfScreenMotion.Load(int3(pixel, 0));
    if (PixelSetAsNoMotionVectors(packedMotion) || !all(isfinite(packedMotion.xy)))
        return false;
    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float2 previousUv = (previousPixel + 0.5) * _SdfDiffuseScreenSize.zw;
    if (any(previousUv < 0.0) || any(previousUv >= 1.0))
        return false;
    objectMotionPixels = length((previousUv - ScreenUv(previousClip)) * _SdfDiffuseScreenSize.xy);
    int2 low = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    int2 screenSize = int2(_SdfDiffuseScreenSize.xy);
    float expectedDepth = VividPreviousDeviceZ(packedMotion, _SdfDiffuseDepth.Load(int3(pixel, 0)), previousClip.z / previousClip.w);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float3 expectedReceiver = ComputeWorldSpacePosition(previousUv, expectedDepth, _SdfScreenPreviousInverseVP);
    float thickness = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float totalWeight = 0.0;
    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 offset = int2(i & 1u, i >> 1u);
        int2 tap = low + offset;
        float2 weights = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = weights.x * weights.y;
        if (weight <= 0.0 || any(tap < 0) || any(tap >= screenSize))
            continue;

        uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
        float depth = f16tof32(packed & 65535u);
        float3 previousNormal = UnpackProbeNormal(float(packed >> 16u));
        bool normalMatches = dot(normal, previousNormal) >= 0.92;
        // Reversed Z. Even a mismatched normal may belong to a foreground occluder.
        bool nearer = depth > expectedDepth;
        if (depth <= 0.0 || (!normalMatches && !nearer))
            continue;

        float2 uv = (float2(tap) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 previousPosition = ComputeWorldSpacePosition(uv, depth, _SdfScreenPreviousInverseVP);
        float3 expectedPosition = ComputeWorldSpacePosition(uv, expectedDepth, _SdfScreenPreviousInverseVP);
        float depthError = distance(previousPosition, expectedPosition);
        float planeError = abs(dot(previousPosition - expectedReceiver, normal));
        if (nearer && depthError > thickness && planeError > thickness)
            foregroundWeight += weight;
        if (!normalMatches || depthError > thickness || planeError > thickness)
            continue;

        float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
        sample.rgb *= _SdfHistoryLightScale.rgb;
        #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        if (abs(sample.a) > 0.0 && (sample.a < 0.0) == openPbr)
        {
            totalWeight += weight;
            #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                float2 ageAndCoverage = UnpackRestirPixelHistory(sample.a);
                float covered = weight * ageAndCoverage.y;
                history += covered * float4(sample.rgb, ageAndCoverage.x);
                historyCoverage += covered;
                historyVariance += covered * _SdfRestirPreviousVariance.Load(int3(tap, 0));
            #else
                sample.a = abs(sample.a);
                history += sample * weight;
            #endif
        }
        #else
        if (sample.a > 0.0)
        {
            float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
            float coveredWeight = weight * ageAndCoverage.y;
            history += float4(sample.rgb, ageAndCoverage.x) * coveredWeight;
            historyCoverage += coveredWeight;
            totalWeight += weight;
        }
        #endif
    }
    #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY) && !defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        history /= max(totalWeight, 1e-5);
    #else
        history /= max(historyCoverage, 1e-5);
        historyVariance /= max(historyCoverage, 1e-5);
        historyCoverage /= max(totalWeight, 1e-5);
    #endif
    return totalWeight >= 0.35 && foregroundWeight < 0.25;
}

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
void TemporalSdfRestirVariance(uint3 id : SV_DispatchThreadID)
#elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
void TemporalSdfRestirDiffuseGI(uint3 id : SV_DispatchThreadID)
#else
void TemporalSdfDiffuseGI(uint3 id : SV_DispatchThreadID)
#endif
{
    if (any(id.xy >= uint2(_SdfDiffuseScreenSize.xy)))
        return;

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    bool openPbr = result.a < 0.0;
    float3 position, normal;
    bool receiver = LoadReceiver(id.xy, position, normal);
    float age = 0.0;
    uint packed = f32tof16(_SdfDiffuseDepth.Load(int3(id.xy, 0)))
        | (receiver ? uint(PackProbeNormal(normal)) << 16u : 0u);
    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        float variance = 0.0;
    #endif
    #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        uint historyStatus = ScreenProbeNoHistory;
    #endif
    if (receiver)
    {
        if (abs(result.a) > 0.0)
        {
            age = 1.0;
            #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                variance = _SdfRestirVariance.Load(int3(id.xy, 0));
            #endif
            float4 history;
            float historyCoverage;
            float foregroundWeight;
            float historyVariance;
            float objectMotionPixels;
            if (_SdfDiffuseHasHistory != 0u
                && ReadPixelHistory(id.xy, position, normal, openPbr, history, historyCoverage, foregroundWeight, historyVariance,
                    objectMotionPixels))
            {
                float confidence = 1.0;
                float fastUpdate = SdfPixelHistoryFastUpdate(foregroundWeight, objectMotionPixels);
                #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY) || defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                    float coverageAgreement = min(abs(result.a), historyCoverage) / max(abs(result.a), historyCoverage);
                    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                        fastUpdate = max(fastUpdate, 1.0 - smoothstep(0.25, 0.65, coverageAgreement));
                    #else
                        confidence = coverageAgreement;
                    #endif
                #endif
                float3 rectified = RectifyPixelHistory(id.xy, position, normal, result, history.rgb, fastUpdate);
                confidence *= 1.0 - fastUpdate;
                age += min(history.a, _SdfPixelHistoryMaxAge - 1.0) * confidence;
                #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    historyStatus = confidence < 0.8 ? ScreenProbeHistoryCoverageLimited : ScreenProbeHistoryAccepted;
                #endif
                float currentWeight = rcp(age);
                #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                    // A shared bright path can give the current reservoirs low spatial variance.
                    // Also measure the change from the accepted temporal estimate in log luminance.
                    if (confidence > 0.0)
                    {
                        float coverage = abs(result.a);
                        float currentLuminance = RestirLuminance(result.rgb) * coverage;
                        float previousLuminance = RestirLuminance(history.rgb) * historyCoverage;
                        float change = log2(1.0 + currentLuminance) - log2(1.0 + previousLuminance);
                        float observedVariance = max(variance, min(change * change, 4.0));
                        float historyWeight = (1.0 - currentWeight) * confidence;
                        variance = lerp(observedVariance, historyVariance, historyWeight);
                        // Deferred lighting consumes covered radiance. Accumulate both factors together.
                        float3 covered = lerp(rectified * historyCoverage, result.rgb * coverage, currentWeight);
                        result.a = lerp(historyCoverage, coverage, currentWeight);
                        result.rgb = covered / max(result.a, 1e-5);
                    }
                #elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    result.rgb = lerp(rectified, result.rgb, currentWeight);
                #else
                    // Accumulate numerator and coverage together so an unstable
                    // coverage estimate cannot bypass temporal filtering.
                    float3 covered = lerp(rectified * historyCoverage, result.rgb * result.a, currentWeight);
                    result.a = lerp(historyCoverage, result.a, currentWeight);
                    result.rgb = covered / result.a;
                #endif
            }
        }
    }

    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        float historyAlpha = PackRestirPixelHistory(age, abs(result.a), openPbr);
    #elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        float historyAlpha = openPbr ? -age : age;
    #else
        float historyAlpha = PackScreenProbePixelHistory(age, result.a, historyStatus);
    #endif
    _SdfDiffusePixelLightingOutput[id.xy] = float4(result.rgb, historyAlpha);
    _SdfDiffusePixelGeometryOutput[id.xy] = packed;
    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        _SdfRestirVarianceHistoryOutput[id.xy] = variance;
    #endif
    if (_SdfRestirDense == 0u)
        _SdfDiffuseOutput[id.xy] = result;
}
#else
Texture2D<float> _SdfPreviousFastUpdate;
RWTexture2D<float> _SdfFastUpdateOutput;

// LumenScreenProbeGatherTemporal.usf, scalar loads from Vivid's geometry-valid taps.
float PackFastUpdateModeAmountAndNumFramesAccumulated(float FastUpdateModeAmount, float NumFramesAccumulated)
{
    float EncodedFastUpdateModeAmount = ceil(FastUpdateModeAmount * 15.0f);
    float LocalMaxFramesAccumulated = min(_SdfPixelHistoryMaxAge, 15.0f);
    float EncodedNumFramesAccumulated = round(saturate(NumFramesAccumulated / LocalMaxFramesAccumulated) * 15.0f);
    return (EncodedFastUpdateModeAmount * 16.0f + EncodedNumFramesAccumulated) / 255.0f;
}

void UnpackFastUpdateModeAmountAndNumFramesAccumulated(float Packed,
    out float OutFastUpdateModeAmount, out float OutNumFramesAccumulated)
{
    Packed = round(Packed * 255.0f);
    float EncodedFastUpdateModeAmount = floor(Packed / 16.0f);
    float EncodedNumFramesAccumulated = Packed - EncodedFastUpdateModeAmount * 16.0f;
    OutFastUpdateModeAmount = EncodedFastUpdateModeAmount / 15.0f;
    OutNumFramesAccumulated = EncodedNumFramesAccumulated == 15.0f ? _SdfPixelHistoryMaxAge
        : EncodedNumFramesAccumulated / 15.0f * min(_SdfPixelHistoryMaxAge, 15.0f);
}

struct ScreenProbeTemporalHistory
{
    float3 coveredLighting;
    float coverage;
    float age;
    float footprint;
    float foreground;
    float objectMotionPixels;
    float fastUpdate;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    half4 shortRangeAO;
#endif
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    float logMean, logVariance, momentAge, momentCoverage;
#endif
};

bool ReadScreenProbeTemporalHistory(uint2 pixel, float3 position, float3 normal, out ScreenProbeTemporalHistory history)
{
    history = (ScreenProbeTemporalHistory)0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z <= 0.0 || previousClip.z > previousClip.w)
        return false;

    float4 packedMotion = _SdfScreenMotion.Load(int3(pixel, 0));
    if (PixelSetAsNoMotionVectors(packedMotion) || !all(isfinite(packedMotion.xy)))
        return false;

    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float2 previousUv = (previousPixel + 0.5) * _SdfDiffuseScreenSize.zw;
    if (any(previousUv < 0.0) || any(previousUv >= 1.0))
        return false;

    int2 lower = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    int2 size = int2(_SdfDiffuseScreenSize.xy);
    float expectedDepth = VividPreviousDeviceZ(packedMotion, _SdfDiffuseDepth.Load(int3(pixel, 0)), previousClip.z / previousClip.w);
    float3 expectedReceiver = ComputeWorldSpacePosition(previousUv, expectedDepth, _SdfScreenPreviousInverseVP);
    history.objectMotionPixels = length((previousUv - ScreenUv(previousClip)) * _SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float depthTolerance = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float planeTolerance = clamp(0.006 * eyeDepth, 0.02, 0.10);
    float geometryWeight = 0.0;
    float coveredWeight = 0.0;

    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 offset = int2(i & 1u, i >> 1u);
        int2 tap = lower + offset;
        float2 bilinear = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = bilinear.x * bilinear.y;
        if (weight <= 0.0 || any(tap < 0) || any(tap >= size))
            continue;

        uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
        float depth = f16tof32(packed & 65535u);
        if (depth <= 0.0)
            continue;

        float2 tapUv = (float2(tap) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 samplePosition = ComputeWorldSpacePosition(tapUv, depth, _SdfScreenPreviousInverseVP);
        float3 expectedTap = ComputeWorldSpacePosition(tapUv, expectedDepth, _SdfScreenPreviousInverseVP);
        bool depthMismatch = distance(samplePosition, expectedTap) > depthTolerance;
        bool planeMismatch = abs(dot(samplePosition - expectedReceiver, normal)) > planeTolerance;
        if (depth > expectedDepth && depthMismatch && planeMismatch)
            history.foreground += weight;
        if (depthMismatch || planeMismatch || dot(normal, UnpackProbeNormal(float(packed >> 16u))) < 0.92)
            continue;

        geometryWeight += weight;
        float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
        float3 unscaledRgb = sample.rgb;
#endif
        sample.rgb *= _SdfHistoryLightScale.rgb;
        if (sample.a <= 0.0)
            continue;

        float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
        float covered = weight * ageAndCoverage.y;
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
        if (_SdfScreenProbeMomentsHistoryValid != 0u)
        {
            float4 moments = _SdfScreenProbePreviousMoments.Load(int3(tap, 0));
            if (moments.w > 0.0 && moments.z >= 1.0)
            {
                float3 oldLighting = DecodeScreenProbeCoveredHistory(unscaledRgb, ageAndCoverage.y) / max(ageAndCoverage.y, 1e-5);
                float3 newLighting = DecodeScreenProbeCoveredHistory(sample.rgb, ageAndCoverage.y) / max(ageAndCoverage.y, 1e-5);
                float oldY = RestirLuminance(oldLighting), newY = RestirLuminance(newLighting);
                float mean = moments.x + log2((1.0 + newY) / (1.0 + oldY));
                // A covered black history still needs a unit Jacobian under unchanged lighting.
                float radianceScale = oldY > 1e-5 ? newY / oldY : RestirLuminance(_SdfHistoryLightScale.rgb);
                float jacobian = radianceScale * (1.0 + oldY) / (1.0 + newY);
                float variance = max(0.0, moments.y) * jacobian * jacobian;
                float combinedWeight = history.momentCoverage + covered;
                float fraction = covered / max(combinedWeight, 1e-5);
                float delta = mean - history.logMean;
                history.logMean += fraction * delta;
                history.logVariance += covered * variance + history.momentCoverage * fraction * delta * delta;
                history.momentAge += covered * moments.z;
                history.momentCoverage += covered;
            }
        }
#endif
        history.coveredLighting += weight * DecodeScreenProbeCoveredHistory(sample.rgb, ageAndCoverage.y);
        float fastUpdate, numFramesAccumulated;
        UnpackFastUpdateModeAmountAndNumFramesAccumulated(_SdfPreviousFastUpdate.Load(int3(tap, 0)),
            fastUpdate, numFramesAccumulated);
        history.age += weight * (numFramesAccumulated + 1.0f);
        history.fastUpdate += weight * fastUpdate;
        history.footprint += weight;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
        if (_SdfBentHistoryValid != 0u)
            history.shortRangeAO += half(weight) * UnpackSharedShortRangeAO(_SdfBentPrevious.Load(int3(tap, 0)));
#endif
        coveredWeight += covered;
    }
    if (history.footprint < 0.35 || history.foreground >= 0.25)
        return false;

    history.coveredLighting /= geometryWeight;
    history.coverage = coveredWeight / geometryWeight;
    history.age = min(history.age / history.footprint, _SdfPixelHistoryMaxAge);
    history.fastUpdate /= history.footprint;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    history.shortRangeAO /= half(history.footprint);
#endif
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    float momentWeight = history.momentCoverage;
    history.logVariance = max(0.0, history.logVariance / max(momentWeight, 1e-5));
    history.momentAge /= max(momentWeight, 1e-5);
    history.momentCoverage = momentWeight / max(coveredWeight, 1e-5);
#endif
    return true;
}

Texture2D<float> _SdfResolvedMoving;

float ScreenProbePriorFrameCount(float storedAge, float confidence, float fastUpdate)
{
    return min(storedAge * confidence, (1.0 - fastUpdate) * _SdfPixelHistoryMaxAge);
}

float ScreenProbeCurrentSampleWeight(bool bLightingIsValid, float NewNumFramesAccumulated)
{
    float Alpha = 1.0f / (1.0f + NewNumFramesAccumulated);
    if (!bLightingIsValid && NewNumFramesAccumulated >= 1.0f)
        Alpha = 1.0f / (1.0f + 4.0f * NewNumFramesAccumulated);
    return Alpha;
}

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS) && defined(VIVID_SDF_SCREEN_PROBE_AO)
void ScreenProbeTemporalReprojectionWithMomentsAndAOCS(uint3 id : SV_DispatchThreadID)
#elif defined(VIVID_SDF_SCREEN_PROBE_AO)
void ScreenProbeTemporalReprojectionWithAOCS(uint3 id : SV_DispatchThreadID)
#elif defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
void ScreenProbeTemporalReprojectionWithMomentsCS(uint3 id : SV_DispatchThreadID)
#else
void ScreenProbeTemporalReprojectionCS(uint3 id : SV_DispatchThreadID)
#endif
{
    if (any(id.xy >= uint2(_SdfDiffuseScreenSize.xy)))
        return;

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    float depth = _SdfDiffuseDepth.Load(int3(id.xy, 0));
    float3 position, normal;
    bool receiver = LoadReceiver(id.xy, position, normal);
    // Depth from an unresolved or unlit foreground still occludes history.
    uint geometry = f32tof16(depth) | (receiver ? uint(PackProbeNormal(normal)) << 16u : 0u);
    bool hasLighting = receiver && result.a > 0.0;
    bool fullSphere = _SdfScreenProbeFullSphere != 0u;
    float moving = receiver ? _SdfResolvedMoving.Load(int3(id.xy, 0)) : 0.0;
    float age = hasLighting ? 1.0 : 0.0;
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    float currentLog = ScreenProbeLogLuminance(result.rgb);
    float3 moments = float3(currentLog, 0.0, age);
#endif
    uint historyStatus = ScreenProbeNoHistory;
    ScreenProbeTemporalHistory history;
    float currentFastUpdate = 0.0;
    float numFramesAccumulated = 0.0;
    bool bValidReconstruction = true;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    half4 OutShortRangeAO = half4(0.0, 1.0, 0.0, 1.0);
    int2 SampleCoord = 0;
    if (receiver)
    {
        SampleCoord = ReconstructShortRangeAO(id.xy, position, normal, bValidReconstruction);
        OutShortRangeAO = UnpackSharedShortRangeAO(_SdfLumenBentNormal.Load(int3(SampleCoord, 0)));
    }
#endif
    bool bLightingIsValid = hasLighting && (!fullSphere || moving > 0.0) && bValidReconstruction;
    bool readHistory = receiver && (fullSphere || hasLighting);
    if (readHistory && _SdfDiffuseHasHistory != 0u && ReadScreenProbeTemporalHistory(id.xy, position, normal, history))
    {
        float coverageAgreement = min(result.a, history.coverage) / max(result.a, history.coverage);
        // Coverage can disagree when the current integration failed. The history
        // reader has already validated the reprojected receiver and its lighting.
        if ((fullSphere && !bLightingIsValid) || (hasLighting && coverageAgreement >= 0.35))
        {
            float3 historyLighting = history.coveredLighting / history.coverage;
            currentFastUpdate = saturate(moving * 10.0f);
            currentFastUpdate = saturate(min((currentFastUpdate - .2f) / .8f, .9f));
            // Only this frame's lighting motion is carried into the next frame.
            float fastUpdate = max(currentFastUpdate, min(history.fastUpdate, 0.9));
            float3 rectified = historyLighting;
            if (!fullSphere)
            {
                fastUpdate = max(fastUpdate, SdfPixelHistoryFastUpdate(history.foreground, history.objectMotionPixels));
                rectified = RectifyPixelHistory(id.xy, position, normal, result, historyLighting, fastUpdate);
            }
            // Trace coverage is a stochastic lighting estimate. It must not
            // select the current sample's averaging weight on stable geometry.
            float ageConfidence = (_SdfGatherHistoryDiagnostics & 4194304u) != 0u
                ? coverageAgreement : saturate(history.footprint);
            if ((_SdfGatherHistoryDiagnostics & 8u) != 0u)
                ageConfidence = 1.0;
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
            if (history.momentCoverage >= 0.35)
            {
                float momentPriorFrames = ScreenProbePriorFrameCount(history.momentAge,
                    ageConfidence * saturate(history.momentCoverage), fastUpdate);
                float weight = ScreenProbeCurrentSampleWeight(bLightingIsValid, momentPriorFrames);
                float mean = history.logMean + ScreenProbeLogLuminance(rectified) - ScreenProbeLogLuminance(historyLighting);
                float delta = currentLog - mean;
                // Central variance avoids cancellation in half-precision history.
                // Keep observation variance conservative: sparse probes are correlated.
                moments = float3(lerp(mean, currentLog, weight),
                    (1.0 - weight) * (history.logVariance + weight * delta * delta), min(1.0 + momentPriorFrames, _SdfPixelHistoryMaxAge));
            }
#endif
            // The UE desktop default uses validity-weighted age, with no
            // fast-update neighborhood clamp. Geometry/coverage rejection above still applies.
            numFramesAccumulated = ScreenProbePriorFrameCount(history.age, fullSphere ? 1.0 : ageConfidence, fastUpdate);
            age = min(1.0 + numFramesAccumulated, _SdfPixelHistoryMaxAge);
            historyStatus = fastUpdate > 0.2 || coverageAgreement < 0.8
                ? ScreenProbeHistoryCoverageLimited : ScreenProbeHistoryAccepted;

            float currentWeight = ScreenProbeCurrentSampleWeight(bLightingIsValid, numFramesAccumulated);
            float3 covered = lerp(rectified * history.coverage, result.rgb * result.a, currentWeight);
            result.a = lerp(history.coverage, result.a, currentWeight);
            result.rgb = min(covered / max(result.a, 1e-5), 65000.0);
        }
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
        if (_SdfBentHistoryValid != 0u)
        {
            float FastUpdateModeAmount = saturate(_SdfResolvedMoving.Load(int3(id.xy, 0)) * 10.0f);
            FastUpdateModeAmount = saturate(min((FastUpdateModeAmount - .2f) / .8f, .9f));
            FastUpdateModeAmount = max(FastUpdateModeAmount, min(history.fastUpdate, .9f));
            float NewNumFramesAccumulated = min(history.age, (1.0f - FastUpdateModeAmount) * _SdfPixelHistoryMaxAge);
            half4 HistoryShortRangeAO = ClampShortRangeAOHistory(id.xy, SampleCoord, OutShortRangeAO, history.shortRangeAO);
            float Alpha = ScreenProbeCurrentSampleWeight(bLightingIsValid, NewNumFramesAccumulated);
            OutShortRangeAO = lerp(HistoryShortRangeAO, OutShortRangeAO, half(Alpha));
        }
#endif
    }

#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    _SdfBentOutput[id.xy] = PackSharedShortRangeAO(OutShortRangeAO);
#endif
    _SdfDiffusePixelGeometryOutput[id.xy] = geometry;
    _SdfFastUpdateOutput[id.xy] = PackFastUpdateModeAmountAndNumFramesAccumulated(currentFastUpdate, numFramesAccumulated);
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    _SdfScreenProbeMomentsOutput[id.xy] = SdfRoundToNearestHalf(float4(moments, age > 0.0 ? result.a : 0.0));
#endif
    float historyAlpha = PackScreenProbePixelHistory(age, result.a, historyStatus);
    float3 historyRgb = EncodeScreenProbeCoveredHistory(result.rgb, result.a);
    result = RoundSdfHistory(result);
    _SdfDiffusePixelLightingOutput[id.xy] = float4(historyRgb, historyAlpha);
    _SdfDiffuseOutput[id.xy] = result;
}

// Explicit Editor diagnostic dispatch only. Reuse the production history reader
// so a nearest-depth approximation cannot be mistaken for its four-tap decision.
float4 _SdfPixelHistoryInspectRegion; // offset.xy, pixel stride, unused
float4 _SdfPixelHistoryInspectSize;   // sampled width, sampled height, unused
RWStructuredBuffer<float4> _SdfPixelHistoryInspection;

[numthreads(8, 8, 1)]
void InspectScreenProbeTemporalHistoryCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(_SdfPixelHistoryInspectSize.xy)))
        return;
    uint2 pixel = uint2(_SdfPixelHistoryInspectRegion.xy) + id.xy * uint(_SdfPixelHistoryInspectRegion.z);
    uint address = (id.y * uint(_SdfPixelHistoryInspectSize.x) + id.x) * 6u;
    float3 position, normal;
    bool receiver = LoadReceiver(pixel, position, normal);
    ScreenProbeTemporalHistory history = (ScreenProbeTemporalHistory)0;
    bool valid = receiver && ReadScreenProbeTemporalHistory(pixel, position, normal, history);
    float4 clip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    float4 encodedMotion = _SdfScreenMotion.Load(int3(pixel, 0));
    float2 motion = VividDecodeMotionUV(encodedMotion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    _SdfPixelHistoryInspection[address] = float4(valid ? 1.0 : 0.0, history.footprint,
        history.foreground, history.objectMotionPixels);
    _SdfPixelHistoryInspection[address + 1u] = float4(history.coveredLighting, history.coverage);
    _SdfPixelHistoryInspection[address + 2u] = float4(history.age, receiver ? 1.0 : 0.0,
        clamp(0.008 * eyeDepth, 0.025, 0.12), clamp(0.006 * eyeDepth, 0.02, 0.10));
    _SdfPixelHistoryInspection[address + 3u] = float4(position, eyeDepth);
    _SdfPixelHistoryInspection[address + 4u] = float4(normal, _SdfDiffuseDepth.Load(int3(pixel, 0)));
    _SdfPixelHistoryInspection[address + 5u] = float4(previousPixel,
        VividPreviousDeviceZ(encodedMotion, _SdfDiffuseDepth.Load(int3(pixel, 0)), clip.w != 0.0 ? clip.z / clip.w : 0.0),
        PixelSetAsNoMotionVectors(encodedMotion) ? 1.0 : 0.0);
}
#endif

#if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
RWStructuredBuffer<float4> _SdfCoveredHistoryValidation;

[numthreads(8, 1, 1)]
void InspectSdfCoveredHistoryEnergyCS(uint3 id : SV_DispatchThreadID)
{
    const float coverages[8] = {0.051, 0.101, 0.331, 0.6877, 0.953, 0.1, 0.5, 0.75};
    float currentCoverage = coverages[id.x];
    float3 expected = id.x == 7u ? 0.0 : float3(1.0, 2.0, 0.5);
    float coverage = currentCoverage;
    float3 stored = EncodeScreenProbeCoveredHistory(expected / coverage, coverage);
    float packed = PackScreenProbePixelHistory(32.0, coverage, ScreenProbeHistoryAccepted);
    float3 energy = expected;
    [loop]
    for (uint frame = 0u; frame < 4096u; ++frame)
    {
        float previousCoverage = UnpackScreenProbePixelHistory(packed).y;
        energy = lerp(DecodeScreenProbeCoveredHistory(stored, previousCoverage), expected, 1.0 / 32.0);
        coverage = lerp(previousCoverage, currentCoverage, 1.0 / 32.0);
        stored = EncodeScreenProbeCoveredHistory(energy / coverage, coverage);
        packed = PackScreenProbePixelHistory(32.0, coverage, ScreenProbeHistoryAccepted);
    }
    _SdfCoveredHistoryValidation[id.x] = float4(energy, UnpackScreenProbePixelHistory(packed).y);
}
#endif

RWTexture2D<float4> _SdfHistoryQuantizationFloat;
RWTexture2D<float4> _SdfHistoryQuantizationHalf;

[numthreads(64, 1, 1)]
void InspectSdfHistoryQuantizationCS(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x & 63u;
    uint category = id.x >> 6u;
    float value = category == 0u ? 1.0 + (float(index) + 0.25) / 2048.0
        : category == 1u ? 1.0 + (float(index) + 0.5) / 1024.0
        : category == 2u ? (float(index) + 0.25) * exp2(-25.0) : 65000.0 + 1.25 * float(index);
    float4 rounded = SdfRoundToNearestHalf(float4(value, -value, 0.0, 0.0));
    float4 sample = float4(value, rounded.x, -value, rounded.y);
    _SdfHistoryQuantizationFloat[id.xy] = sample;
    _SdfHistoryQuantizationHalf[id.xy] = sample;
}
