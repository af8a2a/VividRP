#if defined(VIVID_SDF_SCREEN_PROBE_AO)
#include "SdfShortRangeAOReconstruction.hlsl"

Texture2D<float> _SdfBentScalarNoise;
Texture2D<uint> _SdfLumenBentNormal;
Texture2D<uint> _SdfBentPrevious;
RWTexture2D<uint> _SdfBentOutput;
uint _SdfBentHistoryValid;

// LumenScreenProbeGatherTemporal.usf, SHORT_RANGE_AO_MODE == 2.
half4 UnpackSharedShortRangeAO(uint Packed)
{
    half3 BentNormal;
    BentNormal.z = half(Packed >> 21) / 2047.0;
    BentNormal.x = half((Packed >> 10) & 2047) / 2047.0;
    BentNormal.y = half(Packed & 1023) / 1023.0;
    BentNormal = BentNormal * 2.0 - 1.0;
    half Len = sqrt(dot(BentNormal, BentNormal));
    return half4(BentNormal / max(Len, half(0.0001)), Len);
}

uint PackSharedShortRangeAO(half4 BentNormalAndAO)
{
    half3 BentNormal = normalize(BentNormalAndAO.xyz) * BentNormalAndAO.w;
    return PackScreenBentNormal(BentNormal);
}

groupshared uint SharedBentPackedAO[64];
groupshared float4 SharedBentPosAndDepth[36];
groupshared float3 SharedBentNormal[36];

void PreloadShortRangeAOTile(uint3 group, uint lane, int2 screenSize, out int2 reconBase, out int2 aoBase)
{
    int2 lastHalf = (screenSize - 1) / 2;
    int2 groupMinScreen = int2(
        int(group.x * 8u),
        _SdfBentFlipY != 0u ? (screenSize.y - 1 - int(group.y * 8u + 7u)) : int(group.y * 8u));
    reconBase = int2(floor((float2(groupMinScreen) - 1.0f) * 0.5f));
    aoBase = reconBase - 1;

    int2 aoCell = clamp(aoBase + int2(int(lane & 7u), int(lane >> 3u)), 0, lastHalf);
    SharedBentPackedAO[lane] = _SdfLumenBentNormal.Load(int3(aoCell, 0));

    if (lane < 36u)
    {
        int2 reconCell = reconBase + int2(int(lane % 6u), int(lane / 6u));
        float3 pos = 0.0f;
        float3 nrm = 0.0f;
        float depth = 0.0f;
        if (all(reconCell >= 0) && all(reconCell <= lastHalf))
        {
            uint2 receiverPixel = BentDownsampledReceiver(reconCell);
            if (LoadReceiver(receiverPixel, pos, nrm))
                depth = dot(float4(pos, 1.0f), _SdfProbeCameraForward);
        }
        SharedBentPosAndDepth[lane] = float4(pos, depth);
        SharedBentNormal[lane] = nrm;
    }
}

// StochasticLightingTileClassification.usf, 2x2 triangle/depth/normal footprint backed by groupshared LDS.
int2 ReconstructShortRangeAO(uint2 Pixel, float3 Position, float3 Normal, int2 reconBase, int2 aoBase,
    out bool bValidReconstruction, out half4 OutFilteredAO, out half4 OutStochasticAO)
{
    int2 ScreenCoord = int2(BentScreenPixel(Pixel));
    int2 DownsampledCoord00 = int2(floor((float2(ScreenCoord) + 0.5f) / 2.0f - 0.5f));
    int2 Last = (int2(_SdfDiffuseScreenSize.xy) - 1) / 2;
    float4 UpsampleWeights = 0;
    float SceneDepth = dot(float4(Position, 1.0), _SdfProbeCameraForward);
    float4 ScenePlane = float4(Normal, dot(Position, Normal));
    float Depth00 = 0.0f;
    [unroll]
    for (uint Index = 0u; Index < 4u; ++Index)
    {
        int2 Cell = DownsampledCoord00 + int2(Index & 1u, Index >> 1u);
        int2 rel = Cell - reconBase;
        uint reconIdx = uint(rel.y * 6 + rel.x);
        float4 posDepth = SharedBentPosAndDepth[reconIdx];
        float3 cornerPos = posDepth.xyz;
        float cornerDepth = posDepth.w;
        if (Index == 0u)
            Depth00 = cornerDepth;
        // UE Position01 uses its own depth for XY and the 00 depth for the view Z component.
        if (Index == 2u)
            cornerPos += _SdfProbeCameraForward.xyz * (Depth00 - cornerDepth);
        float weight = 0.0f;
        if (all(Cell >= 0) && all(Cell <= Last) && cornerDepth > 0.0f)
        {
            int2 SampleScreenOffset = Cell * 2 + GetDownsampleJitter2x2(Cell) - ScreenCoord;
            float spatialW = (2.0f - abs(SampleScreenOffset.x)) * (2.0f - abs(SampleScreenOffset.y));
            float PlaneDistance = abs(dot(float4(cornerPos, -1.0f), ScenePlane));
            float RelativeDepthDifference = PlaneDistance / SceneDepth;
            float DepthWeight = exp2(-5000.0f * (RelativeDepthDifference * RelativeDepthDifference));
            float NormalWeight = 1.0f - saturate(VividBentNormalAcosFast(saturate(dot(SharedBentNormal[reconIdx], Normal))));
            weight = spatialW * DepthWeight * NormalWeight * NormalWeight;
        }
        UpsampleWeights[Index] = weight;
    }

    float WeightSum = dot(UpsampleWeights, 1.0f);
    bValidReconstruction = WeightSum >= 0.01f;
    if (bValidReconstruction)
    {
        half4 FilteredSum = 0;
        [unroll]
        for (uint Corner = 0u; Corner < 4u; ++Corner)
        {
            if (UpsampleWeights[Corner] > 1e-4f)
            {
                int2 aoRel = DownsampledCoord00 + int2(Corner & 1u, Corner >> 1u) - aoBase;
                uint aoIdx = uint(aoRel.y * 8 + aoRel.x);
                FilteredSum += half(UpsampleWeights[Corner]) * UnpackSharedShortRangeAO(SharedBentPackedAO[aoIdx]);
            }
        }
        OutFilteredAO = FilteredSum / half(WeightSum);
        half Len = sqrt(dot(OutFilteredAO.xyz, OutFilteredAO.xyz));
        OutFilteredAO.xyz = Len > half(1e-4) ? OutFilteredAO.xyz / Len : half3(Normal);
    }
    else
    {
        // Avoid borrowing an unrelated dark corner cell when all 4 half-res taps fail geometry checks.
        OutFilteredAO = half4(half3(Normal), half(1.0));
    }

    uint3 WrappedCoordinate = uint3(ScreenCoord, _SdfDiffuseFrame) & uint3(127u, 127u, 63u);
    uint3 TextureCoordinate = uint3(WrappedCoordinate.x, 8191u - (WrappedCoordinate.z * 128u + WrappedCoordinate.y), 0);
    float RandomScalar = _SdfBentScalarNoise.Load(TextureCoordinate);
    float4 PreSum;
    PreSum.x = UpsampleWeights.x;
    PreSum.y = PreSum.x + UpsampleWeights.y;
    PreSum.z = PreSum.y + UpsampleWeights.z;
    PreSum.w = PreSum.z + UpsampleWeights.w;
    PreSum /= max(PreSum.w, 0.00001f);
    int2 StochasticBilinearOffset = RandomScalar <= PreSum.x ? int2(0, 0)
        : RandomScalar <= PreSum.y ? int2(1, 0) : RandomScalar <= PreSum.z ? int2(0, 1) : int2(1, 1);
    int2 sampleCoord = clamp((ScreenCoord - 1) / 2 + StochasticBilinearOffset, 0, Last);
    int2 sampleRel = clamp(sampleCoord - aoBase, 0, 7);
    OutStochasticAO = UnpackSharedShortRangeAO(SharedBentPackedAO[uint(sampleRel.y * 8 + sampleRel.x)]);
    return sampleCoord;
}

half4 ClampShortRangeAOHistory(uint2 Pixel, int2 SampleCoord, int2 aoBase, half4 CenterShortRangeAO, half4 HistoryShortRangeAO, half SigmaScale)
{
    // The reference tile has a one-cell border around its 4x4 downsampled interior.
    int2 TileMin = int2(BentScreenPixel(Pixel) / 8u) * 4 - 1;
    int2 SharedCoord = SampleCoord - TileMin;
    half4 AOSum = CenterShortRangeAO;
    half4 AOSqSum = CenterShortRangeAO * CenterShortRangeAO;
    half WeightSum = 1.0;
    [unroll]
    for (int Y = -1; Y <= 1; ++Y)
    {
        [unroll]
        for (int X = -1; X <= 1; ++X)
        {
            int2 NeighborSharedCoord = SharedCoord + int2(X, Y);
            if ((X != 0 || Y != 0) && all(NeighborSharedCoord >= 0) && all(NeighborSharedCoord < 6))
            {
                int2 rel = clamp(TileMin + NeighborSharedCoord - aoBase, 0, 7);
                half4 NeighborAO = UnpackSharedShortRangeAO(SharedBentPackedAO[uint(rel.y * 8 + rel.x)]);
                AOSum += NeighborAO;
                AOSqSum += NeighborAO * NeighborAO;
                WeightSum += 1.0;
            }
        }
    }
    half4 M1 = AOSum / WeightSum;
    half4 M2 = AOSqSum / WeightSum;
    half4 Variance = max(M2 - M1 * M1, half(0.0));
    half4 StdDev = sqrt(Variance) * SigmaScale;
    return clamp(HistoryShortRangeAO, M1 - StdDev, M1 + StdDev);
}
#endif

float _SdfPixelHistoryMaxAge;

#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
Texture2D<float4> _SdfScreenProbePreviousMoments;
RWTexture2D<float4> _SdfScreenProbeMomentsOutput;
uint _SdfScreenProbeMomentsHistoryValid;

float ScreenProbeLogLuminance(float3 value)
{
    return log2(1.0 + RestirLuminance(value));
}
#endif

#if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
Texture2D<float> _SdfRestirPreviousVariance;
RWTexture2D<float> _SdfRestirVarianceHistoryOutput;
#endif

#if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
static const uint ScreenProbeNoHistory = 0u;
static const uint ScreenProbeHistoryAccepted = 1u;
static const uint ScreenProbeHistoryCoverageLimited = 2u;

float PackScreenProbePixelHistory(float age, float coverage, uint historyStatus)
{
    if (age == 0.0)
        return 0.0;

    // A normal, finite FP16 encoding preserves the payload through the history RT.
    // Bits after the exponent offset are coverage (8), age (5), and status (2).
    uint coverageBits = max(1u, uint(round(saturate(coverage) * 255.0)));
    uint ageBits = uint(round(clamp(age, 1.0, 32.0))) - 1u;
    return f16tof32(0x0400u + (historyStatus << 13u) + (ageBits << 8u) + coverageBits);
}

float2 UnpackScreenProbePixelHistory(float packed)
{
    uint bits = f32tof16(packed) - 0x0400u;
    return float2(1.0 + ((bits >> 8u) & 31u), (bits & 255u) * (1.0 / 255.0));
}

float3 DecodeScreenProbeCoveredHistory(float3 rgb, float coverage)
{
    // Editor control for the old conditional-RGB / quantized-coverage feedback.
    return (_SdfGatherHistoryDiagnostics & 2097152u) != 0u ? rgb * coverage : rgb;
}

float3 EncodeScreenProbeCoveredHistory(float3 rgb, float coverage)
{
    float3 value = (_SdfGatherHistoryDiagnostics & 2097152u) != 0u ? rgb : rgb * coverage;
    return RoundSdfHistory(float4(value, 0.0)).rgb;
}
#endif

float3 SdfHistoryYCoCg(float3 rgb)
{
    return float3(dot(rgb, float3(0.25, 0.5, 0.25)), 0.5 * (rgb.r - rgb.b),
        0.5 * rgb.g - 0.25 * (rgb.r + rgb.b));
}

float3 SdfHistoryRgb(float3 color)
{
    return float3(color.x + color.y - color.z, color.x + color.z, color.x - color.y - color.z);
}

float SdfPixelHistoryFastUpdate(float foreground, float objectMotionPixels)
{
    return max(saturate(4.0 * foreground), 0.85 * smoothstep(0.75, 4.0, objectMotionPixels));
}

float3 RectifyPixelHistory(uint2 pixel, float3 position, float3 normal, float4 current,
    float3 history, inout float fastUpdate)
{
    if ((_SdfGatherHistoryDiagnostics & 1u) != 0u)
        return history;
#if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
    // Sparse probe samples can move the whole neighborhood together on static geometry.
    if (fastUpdate <= 0.0 || (_SdfGatherHistoryDiagnostics & 1048576u) != 0u)
        return history;
#endif
    int2 size = int2(_SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float4 material = _SdfDiffuseGBuffer0.Load(int3(pixel, 0));
    float3 center = SdfHistoryYCoCg(current.rgb);
    float3 sum = center;
    float3 sumSquared = center * center;
    float total = 1.0;
    const int2 offsets[8] = { int2(-1, -1), int2(0, -1), int2(1, -1), int2(-1, 0),
        int2(1, 0), int2(-1, 1), int2(0, 1), int2(1, 1) };
    [loop]
    for (uint i = 0u; i < 8u; ++i)
    {
        int2 tap = int2(pixel) + offsets[i];
        if (any(tap < 0) || any(tap >= size))
            continue;
        float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        float coverage = min(abs(current.a), abs(lighting.a)) / max(abs(current.a), abs(lighting.a));
        if (coverage < 0.25 || (lighting.a < 0.0) != (current.a < 0.0))
            continue;
        float4 tapMaterial = _SdfDiffuseGBuffer0.Load(int3(tap, 0));
        float3 albedoDelta = tapMaterial.rgb - material.rgb;
        float3 tapPosition, tapNormal;
        if (tapMaterial.a != material.a || !LoadReceiver(uint2(tap), tapPosition, tapNormal))
            continue;
        float geometryWeight = ProbeGeometryWeight(tapPosition - position, normal, tapNormal, eyeDepth);
        if (geometryWeight < 0.15)
            continue;

        float weight = geometryWeight * coverage * exp2(-16.0 * dot(albedoDelta, albedoDelta));
        float3 color = SdfHistoryYCoCg(lighting.rgb);
        sum += weight * color;
        sumSquared += weight * color * color;
        total += weight;
    }

    float3 mean = sum / total;
    float3 variance = max(0.0, sumSquared / total - mean * mean);
    bool probeScaleVariance = (_SdfGatherHistoryDiagnostics & 64u) != 0u;
    #if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
        probeScaleVariance = (_SdfGatherHistoryDiagnostics & 512u) == 0u;
    #endif
    if (probeScaleVariance)
    {
        // A 3x3 pixel neighborhood underestimates noise shared by a 16px probe tile.
        // Expand only the variance bound; retain the fine mean and validate geometry/materials.
        float3 coarseVariance = 0.0;
        float coarseWeight = 0.0;
        [loop]
        for (uint i = 0u; i < 8u; ++i)
        {
            int2 tap = int2(pixel) + offsets[i] * int(ProbeSpacing / 2u);
            if (any(tap < 0) || any(tap >= size))
                continue;
            float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
            float agreement = min(abs(current.a), abs(lighting.a)) / max(abs(current.a), abs(lighting.a));
            float4 tapMaterial = _SdfDiffuseGBuffer0.Load(int3(tap, 0));
            float3 tapPosition, tapNormal;
            if (agreement < 0.25 || tapMaterial.a != material.a || (lighting.a < 0.0) != (current.a < 0.0)
                || !LoadReceiver(uint2(tap), tapPosition, tapNormal))
                continue;
            float geometryWeight = ProbeGeometryWeight(tapPosition - position, normal, tapNormal, eyeDepth);
            float3 albedoDelta = tapMaterial.rgb - material.rgb;
            float weight = geometryWeight * agreement * exp2(-16.0 * dot(albedoDelta, albedoDelta));
            if (geometryWeight < 0.15)
                continue;
            float3 delta = SdfHistoryYCoCg(lighting.rgb) - mean;
            coarseVariance += weight * delta * delta;
            coarseWeight += weight;
        }
        variance = max(variance, coarseVariance / max(coarseWeight, 1e-5));
    }
    float3 deviation = sqrt(variance);
    float3 sigmaScale = lerp(float3(2.5, 2.0, 2.0), float3(1.25, 1.25, 1.25), fastUpdate);
    float3 extent = max(deviation * sigmaScale, 0.01 + 0.04 * max(center.x, mean.x));
    float3 historyColor = SdfHistoryYCoCg(history);
    float3 delta = historyColor - mean;
    float3 normalized = abs(delta) / extent;
    float3 bounded = max(0.0, SdfHistoryRgb(mean + delta / max(1.0, Max3(normalized.x, normalized.y, normalized.z))));
#if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
    return bounded;
#else
    // A sparse sample can change color abruptly across the entire 3x3 neighborhood.
    // Shorten stable history only for a large, spatially coherent luminance change.
    float lumaScale = max(0.05, max(historyColor.x, mean.x));
    float lumaResidual = max(0.0, abs(delta.x) - extent.x) / lumaScale;
    float coherentChange = smoothstep(0.45, 0.8, lumaResidual)
        * (1.0 - smoothstep(0.05, 0.2, deviation.x / lumaScale));
    if ((_SdfGatherHistoryDiagnostics & 524288u) == 0u)
        fastUpdate = max(fastUpdate, 0.25 * coherentChange);
    // Weak rectification on stable pixels lets the long window absorb sparse trace noise.
    return (_SdfGatherHistoryDiagnostics & 1048576u) != 0u
        ? history : lerp(history, bounded, lerp(0.10, 1.0, fastUpdate));
#endif
}

#if !defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
bool ReadPixelHistory(uint2 pixel, float3 position, float3 normal, bool openPbr,
    out float4 history, out float historyCoverage, out float foregroundWeight, out float historyVariance,
    out float objectMotionPixels)
{
    history = 0.0;
    historyCoverage = 0.0;
    foregroundWeight = 0.0;
    historyVariance = 0.0;
    objectMotionPixels = 0.0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z > previousClip.w || previousClip.z <= 0.0)
        return false;

    float4 packedMotion = _SdfScreenMotion.Load(int3(pixel, 0));
    if (PixelSetAsNoMotionVectors(packedMotion) || !all(isfinite(packedMotion.xy)))
        return false;
    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float2 previousUv = (previousPixel + 0.5) * _SdfDiffuseScreenSize.zw;
    if (any(previousUv < 0.0) || any(previousUv >= 1.0))
        return false;
    objectMotionPixels = length((previousUv - ScreenUv(previousClip)) * _SdfDiffuseScreenSize.xy);
    int2 low = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    int2 screenSize = int2(_SdfDiffuseScreenSize.xy);
    float expectedDepth = VividPreviousDeviceZ(packedMotion, _SdfDiffuseDepth.Load(int3(pixel, 0)), previousClip.z / previousClip.w);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float3 expectedReceiver = ComputeWorldSpacePosition(previousUv, expectedDepth, _SdfScreenPreviousInverseVP);
    float thickness = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float totalWeight = 0.0;
    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 offset = int2(i & 1u, i >> 1u);
        int2 tap = low + offset;
        float2 weights = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = weights.x * weights.y;
        if (weight <= 0.0 || any(tap < 0) || any(tap >= screenSize))
            continue;

        uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
        float depth = f16tof32(packed & 65535u);
        float3 previousNormal = UnpackProbeNormal(float(packed >> 16u));
        bool normalMatches = dot(normal, previousNormal) >= 0.92;
        // Reversed Z. Even a mismatched normal may belong to a foreground occluder.
        bool nearer = depth > expectedDepth;
        if (depth <= 0.0 || (!normalMatches && !nearer))
            continue;

        float2 uv = (float2(tap) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 previousPosition = ComputeWorldSpacePosition(uv, depth, _SdfScreenPreviousInverseVP);
        float3 expectedPosition = ComputeWorldSpacePosition(uv, expectedDepth, _SdfScreenPreviousInverseVP);
        float depthError = distance(previousPosition, expectedPosition);
        float planeError = abs(dot(previousPosition - expectedReceiver, normal));
        if (nearer && depthError > thickness && planeError > thickness)
            foregroundWeight += weight;
        if (!normalMatches || depthError > thickness || planeError > thickness)
            continue;

        float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
        sample.rgb *= _SdfHistoryLightScale.rgb;
        #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        if (abs(sample.a) > 0.0 && (sample.a < 0.0) == openPbr)
        {
            totalWeight += weight;
            #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                float2 ageAndCoverage = UnpackRestirPixelHistory(sample.a);
                float covered = weight * ageAndCoverage.y;
                history += covered * float4(sample.rgb, ageAndCoverage.x);
                historyCoverage += covered;
                historyVariance += covered * _SdfRestirPreviousVariance.Load(int3(tap, 0));
            #else
                sample.a = abs(sample.a);
                history += sample * weight;
            #endif
        }
        #else
        if (sample.a > 0.0)
        {
            float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
            float coveredWeight = weight * ageAndCoverage.y;
            history += float4(sample.rgb, ageAndCoverage.x) * coveredWeight;
            historyCoverage += coveredWeight;
            totalWeight += weight;
        }
        #endif
    }
    #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY) && !defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        history /= max(totalWeight, 1e-5);
    #else
        history /= max(historyCoverage, 1e-5);
        historyVariance /= max(historyCoverage, 1e-5);
        historyCoverage /= max(totalWeight, 1e-5);
    #endif
    return totalWeight >= 0.35 && foregroundWeight < 0.25;
}

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
void TemporalSdfRestirVariance(uint3 id : SV_DispatchThreadID)
#elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
void TemporalSdfRestirDiffuseGI(uint3 id : SV_DispatchThreadID)
#else
void TemporalSdfDiffuseGI(uint3 id : SV_DispatchThreadID)
#endif
{
    if (any(id.xy >= uint2(_SdfDiffuseScreenSize.xy)))
        return;

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    bool openPbr = result.a < 0.0;
    float3 position, normal;
    bool receiver = LoadReceiver(id.xy, position, normal);
    float age = 0.0;
    uint packed = f32tof16(_SdfDiffuseDepth.Load(int3(id.xy, 0)))
        | (receiver ? uint(PackProbeNormal(normal)) << 16u : 0u);
    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        float variance = 0.0;
    #endif
    #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        uint historyStatus = ScreenProbeNoHistory;
    #endif
    if (receiver)
    {
        if (abs(result.a) > 0.0)
        {
            age = 1.0;
            #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                variance = _SdfRestirVariance.Load(int3(id.xy, 0));
            #endif
            float4 history;
            float historyCoverage;
            float foregroundWeight;
            float historyVariance;
            float objectMotionPixels;
            if (_SdfDiffuseHasHistory != 0u
                && ReadPixelHistory(id.xy, position, normal, openPbr, history, historyCoverage, foregroundWeight, historyVariance,
                    objectMotionPixels))
            {
                float confidence = 1.0;
                float fastUpdate = SdfPixelHistoryFastUpdate(foregroundWeight, objectMotionPixels);
                #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY) || defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                    float coverageAgreement = min(abs(result.a), historyCoverage) / max(abs(result.a), historyCoverage);
                    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                        fastUpdate = max(fastUpdate, 1.0 - smoothstep(0.25, 0.65, coverageAgreement));
                    #else
                        confidence = coverageAgreement;
                    #endif
                #endif
                float3 rectified = RectifyPixelHistory(id.xy, position, normal, result, history.rgb, fastUpdate);
                confidence *= 1.0 - fastUpdate;
                age += min(history.a, _SdfPixelHistoryMaxAge - 1.0) * confidence;
                #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    historyStatus = confidence < 0.8 ? ScreenProbeHistoryCoverageLimited : ScreenProbeHistoryAccepted;
                #endif
                float currentWeight = rcp(age);
                #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                    // A shared bright path can give the current reservoirs low spatial variance.
                    // Also measure the change from the accepted temporal estimate in log luminance.
                    if (confidence > 0.0)
                    {
                        float coverage = abs(result.a);
                        float currentLuminance = RestirLuminance(result.rgb) * coverage;
                        float previousLuminance = RestirLuminance(history.rgb) * historyCoverage;
                        float change = log2(1.0 + currentLuminance) - log2(1.0 + previousLuminance);
                        float observedVariance = max(variance, min(change * change, 4.0));
                        float historyWeight = (1.0 - currentWeight) * confidence;
                        variance = lerp(observedVariance, historyVariance, historyWeight);
                        // Deferred lighting consumes covered radiance. Accumulate both factors together.
                        float3 covered = lerp(rectified * historyCoverage, result.rgb * coverage, currentWeight);
                        result.a = lerp(historyCoverage, coverage, currentWeight);
                        result.rgb = covered / max(result.a, 1e-5);
                    }
                #elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    result.rgb = lerp(rectified, result.rgb, currentWeight);
                #else
                    // Accumulate numerator and coverage together so an unstable
                    // coverage estimate cannot bypass temporal filtering.
                    float3 covered = lerp(rectified * historyCoverage, result.rgb * result.a, currentWeight);
                    result.a = lerp(historyCoverage, result.a, currentWeight);
                    result.rgb = covered / result.a;
                #endif
            }
        }
    }

    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        float historyAlpha = PackRestirPixelHistory(age, abs(result.a), openPbr);
    #elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        float historyAlpha = openPbr ? -age : age;
    #else
        float historyAlpha = PackScreenProbePixelHistory(age, result.a, historyStatus);
    #endif
    _SdfDiffusePixelLightingOutput[id.xy] = float4(result.rgb, historyAlpha);
    _SdfDiffusePixelGeometryOutput[id.xy] = packed;
    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        _SdfRestirVarianceHistoryOutput[id.xy] = variance;
    #endif
    if (_SdfRestirDense == 0u)
        _SdfDiffuseOutput[id.xy] = result;
}
#else
#include "../../Public/AutoExposure.hlsl"

Texture2D<float> _SdfPreviousFastUpdate;
RWTexture2D<float> _SdfFastUpdateOutput;
Texture2D<float> _SdfDiffusePreviousPixelDepth;
RWTexture2D<float> _SdfDiffusePixelDepthOutput;
uint _SdfPreviousPixelDepthValid;
Texture2D<float> _SdfPreviousPreExposure;
RWTexture2D<float> _SdfCurrentPreExposureOutput;
uint _SdfPreExposureHistoryEnabled;
uint _SdfPreviousPreExposureValid;
Texture2D<float4> _SdfCurrentRoughSpecular;
Texture2D<float4> _SdfPreviousRoughSpecular;
RWTexture2D<float4> _SdfRoughSpecularHistoryOutput;
uint _SdfRoughSpecularEnabled;
uint _SdfPreviousRoughSpecularValid;
uint _SdfDisocclusionSpatialFilter;
Texture2D<float> _SdfTemporalScalarNoise;
uint _SdfTemporalScalarNoiseEnabled;
float4 _SdfProbePreviousCameraForward;
float4 _SdfProbeCameraPosition;
float4 _SdfProbePreviousCameraPosition;
float4 _SdfHistorySubPixelGridSizeAndInvSize;
float4 _SdfHistoryGatherUvMinMax;
uint _SdfHistoryCoordShiftX;
uint _SdfHistoryCoordShiftY;
float4 _SdfHistoryTemporalParams; // x: DistanceThreshold, y: NormalCosThreshold, z: InvFractionMoving, w: MaxFastUpdateAmount
uint _SdfFastUpdateNeighborhoodClamp;
uint _SdfTemporalReprojectionFlags; // bit 0: PLANE_DISOCCLUSION_WEIGHTS, bit 1: HISTORY_REJECT_BASED_ON_NORMAL, bit 2: COHERENT_RADIANCE_FAST_UPDATE, bit 3: CAMERA_STATIC

static const int2 kScreenProbeOffsets3x3[8] =
{
    int2(-1, -1),
    int2( 0, -1),
    int2( 1, -1),
    int2(-1,  0),
    int2( 1,  0),
    int2(-1,  1),
    int2( 0,  1),
    int2( 1,  1),
};

// StochasticLightingCommon.ush::EncodeHistoryScreenCoord / DecodeHistoryScreenCoord
uint EncodeHistoryScreenCoord(float2 HistoryScreenCoord, float2 SubPixelGridSize)
{
    float2 EncodeCoord = clamp(HistoryScreenCoord * SubPixelGridSize + 0.5f, 0.0f, 65535.0f);
    return (uint(EncodeCoord.y) << 16u) | uint(EncodeCoord.x);
}

float4 DecodeHistoryScreenCoord(uint Encoded, uint2 HistoryScreenCoordShift, float2 InvSubPixelGridSize)
{
    uint2 EncodeCoord = uint2(Encoded & 0xFFFFu, Encoded >> 16u);
    uint2 HistoryScreenCoord = EncodeCoord >> HistoryScreenCoordShift;
    uint2 SubPixelCoord = EncodeCoord - (HistoryScreenCoord << HistoryScreenCoordShift);
    float2 BilinearWeights = float2(SubPixelCoord) * InvSubPixelGridSize;
    return float4(HistoryScreenCoord, BilinearWeights);
}

float LoadScreenProbeTemporalScalarNoise(uint2 pixel)
{
    if (_SdfTemporalScalarNoiseEnabled == 0u)
        return 0.5f;
    uint3 WrappedCoordinate = uint3(pixel, _SdfDiffuseFrame) & uint3(127u, 127u, 63u);
    uint3 TextureCoordinate = uint3(WrappedCoordinate.x, 8191u - (WrappedCoordinate.z * 128u + WrappedCoordinate.y), 0u);
    return _SdfTemporalScalarNoise.Load(TextureCoordinate);
}

float3 TonemapSdfHistory(float3 rgb)
{
    float3 clamped = max(rgb, 0.0f);
    float luma = dot(clamped, float3(0.2126f, 0.7152f, 0.0722f));
    return clamped * rcp(1.0f + luma);
}

float3 InverseTonemapSdfHistory(float3 rgb)
{
    float3 clamped = max(rgb, 0.0f);
    float luma = dot(clamped, float3(0.2126f, 0.7152f, 0.0722f));
    return clamped * rcp(max(1.0f - luma, 1e-4f));
}

// LumenScreenProbeGatherTemporal.usf::ClampHistory
float3 ClampScreenProbeHistory(
    uint2 ScreenCoord,
    uint2 MinScreenCoord,
    uint2 MaxScreenCoord,
    float3 NewLighting,
    float3 HistoryLighting,
    float PreExposure)
{
    float3 NeighborMin = NewLighting;
    float3 NeighborMax = NewLighting;

    [unroll]
    for (uint NeighborId = 0u; NeighborId < 8u; ++NeighborId)
    {
        const int2 SampleOffset = kScreenProbeOffsets3x3[NeighborId];
        const int2 NeighborScreenCoord = clamp(int2(ScreenCoord) + SampleOffset, int2(MinScreenCoord), int2(MaxScreenCoord));
        const float4 Lighting = _SdfDiffuseCurrentResolved.Load(int3(NeighborScreenCoord, 0));
        if (Lighting.w > 0.0f)
        {
            const float3 NeighborLighting = Lighting.xyz * PreExposure;
            NeighborMin = min(NeighborMin, NeighborLighting);
            NeighborMax = max(NeighborMax, NeighborLighting);
        }
    }

    HistoryLighting = clamp(HistoryLighting, NeighborMin, NeighborMax);
    return HistoryLighting;
}

// Detects spatially coherent radiance divergence across both pixel and probe scales during dynamic lighting
// while rejecting 16px probe Monte Carlo blotches so light rotation does not lock noise into history.
float3 ApplyCoherentRadianceFastUpdate(
    uint2 ScreenCoord,
    uint2 MaxScreenCoord,
    float3 Position,
    float3 Normal,
    float3 CurrentPreExposed,
    float3 HistoryPreExposed,
    float PreExposure,
    out float CoherentBoost)
{
    float3 centerYCoCg = SdfHistoryYCoCg(TonemapSdfHistory(CurrentPreExposed));
    float3 sum = centerYCoCg;
    float3 sumSq = centerYCoCg * centerYCoCg;
    float3 neighborMin = centerYCoCg;
    float3 neighborMax = centerYCoCg;
    float count = 1.0f;

    [unroll]
    for (uint i = 0u; i < 8u; ++i)
    {
        int2 tap = clamp(int2(ScreenCoord) + kScreenProbeOffsets3x3[i], int2(0, 0), int2(MaxScreenCoord));
        float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        if (lighting.w > 0.0f)
        {
            float3 sampleYCoCg = SdfHistoryYCoCg(TonemapSdfHistory(lighting.xyz * PreExposure));
            sum += sampleYCoCg;
            sumSq += sampleYCoCg * sampleYCoCg;
            neighborMin = min(neighborMin, sampleYCoCg);
            neighborMax = max(neighborMax, sampleYCoCg);
            count += 1.0f;
        }
    }

    float invCount = rcp(count);
    float3 mean = sum * invCount;
    float3 fineVar = max(sumSq * invCount - mean * mean, 0.0f);

    // Measure probe-scale variance (stride ProbeSpacing/2) on coplanar neighbors so 16px probe blotches
    // are recognized as spatial noise rather than mistaken for a coherent lighting change.
    float eyeDepth = max(dot(float4(Position, 1.0f), _SdfProbeCameraForward), 1e-4f);
    float3 coarseVarSum = 0.0f;
    float coarseWeightSum = 0.0f;
    int probeHalfStep = int(ProbeSpacing / 2u);
    [unroll]
    for (uint j = 0u; j < 8u; ++j)
    {
        int2 tap = int2(ScreenCoord) + kScreenProbeOffsets3x3[j] * probeHalfStep;
        if (any(tap < 0) || any(tap > int2(MaxScreenCoord)))
            continue;
        float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        if (lighting.w <= 0.0f)
            continue;
        float3 tapPosition, tapNormal;
        if (!LoadReceiver(uint2(tap), tapPosition, tapNormal))
            continue;
        if (dot(Normal, tapNormal) < 0.85f)
            continue;
        float relativePlane = abs(dot(tapPosition - Position, Normal)) / eyeDepth;
        if (relativePlane > 0.025f)
            continue;
        float3 sampleYCoCg = SdfHistoryYCoCg(TonemapSdfHistory(lighting.xyz * PreExposure));
        float3 diff = sampleYCoCg - mean;
        coarseVarSum += diff * diff;
        coarseWeightSum += 1.0f;
    }
    float3 coarseVar = coarseWeightSum > 0.0f ? (coarseVarSum / coarseWeightSum) : 0.0f;
    float3 stddev = sqrt(max(fineVar, coarseVar));
    float3 historyYCoCg = SdfHistoryYCoCg(TonemapSdfHistory(HistoryPreExposed));

    float3 extent = max(stddev * 2.0f, float3(0.035f, 0.025f, 0.025f) + 0.06f * mean.x);
    float3 excess = max(0.0f, abs(historyYCoCg - mean) - extent);
    float lumaScale = max(0.05f, max(mean.x, historyYCoCg.x));
    float relExcess = Max3(excess.x, excess.y, excess.z) / lumaScale;
    float neighborhoodNoise = stddev.x / max(mean.x, 0.05f);
    float coherence = 1.0f - smoothstep(0.12f, 0.32f, neighborhoodNoise);
    float coherentShift = smoothstep(0.30f, 0.55f, relExcess) * coherence;
    float gentleDrift = smoothstep(0.08f, 0.28f, abs(historyYCoCg.x - mean.x) / lumaScale) * coherence;
    // Accelerate temporal convergence smoothly without hard-clamping history to a noisy single-frame
    // 3x3 box, which otherwise draws iso-contour lava-lamp blotches across probe footprints during light rotation.
    CoherentBoost = max(coherentShift * 0.85f, gentleDrift * 0.50f);
    return HistoryPreExposed;
}

groupshared uint2 SharedRoughSpecYCoCg[100];

uint2 PackRoughSpecYCoCg(float3 ycocg, bool valid)
{
    return uint2(
        f32tof16(ycocg.x) | (f32tof16(ycocg.y) << 16u),
        f32tof16(ycocg.z) | (valid ? (1u << 16u) : 0u));
}

bool UnpackRoughSpecYCoCg(uint2 packed, out float3 ycocg)
{
    ycocg = float3(
        f16tof32(packed.x & 0xffffu),
        f16tof32(packed.x >> 16u),
        f16tof32(packed.y & 0xffffu));
    return (packed.y >> 16u) != 0u;
}

void PreloadRoughSpecularTile(uint3 group, uint lane, int2 maxScreenCoord, float preExposure)
{
    int2 tileBase = int2(group.xy * 8u) - 1;
    [unroll]
    for (uint passIdx = 0u; passIdx < 2u; ++passIdx)
    {
        uint idx = lane + passIdx * 64u;
        if (idx < 100u)
        {
            int2 tap = clamp(tileBase + int2(int(idx % 10u), int(idx / 10u)), int2(0, 0), maxScreenCoord);
            float validAlpha = _SdfDiffuseCurrentResolved.Load(int3(tap, 0)).w;
            bool valid = validAlpha > 0.0f;
            float3 ycocg = 0.0f;
            if (valid)
            {
                float3 tapSpec = _SdfCurrentRoughSpecular.Load(int3(tap, 0)).rgb * preExposure;
                ycocg = SdfHistoryYCoCg(TonemapSdfHistory(tapSpec));
            }
            SharedRoughSpecYCoCg[idx] = PackRoughSpecYCoCg(ycocg, valid);
        }
    }
}

// Tonemapped YCoCg 3x3 variance clamp for view-dependent Rough Specular history (LumenReflectionDenoiserTemporal style).
// Reads all 8 neighbors from groupshared LDS to cut per-pixel texture fetches by ~10x.
float3 ClampRoughSpecularHistory(
    uint2 LocalCoord,
    float3 CurrentPreExposed,
    float3 HistoryPreExposed,
    float SigmaScale,
    float ParallaxAmount,
    float CoherentClampGate)
{
    float3 centerYCoCg = SdfHistoryYCoCg(TonemapSdfHistory(CurrentPreExposed));
    float3 sum = centerYCoCg;
    float3 sumSq = centerYCoCg * centerYCoCg;
    float3 neighborMin = centerYCoCg;
    float3 neighborMax = centerYCoCg;
    float count = 1.0f;

    int2 sharedCenter = int2(LocalCoord) + 1;
    [unroll]
    for (uint i = 0u; i < 8u; ++i)
    {
        int2 sharedTap = sharedCenter + kScreenProbeOffsets3x3[i];
        float3 sampleYCoCg;
        if (UnpackRoughSpecYCoCg(SharedRoughSpecYCoCg[uint(sharedTap.y * 10 + sharedTap.x)], sampleYCoCg))
        {
            sum += sampleYCoCg;
            sumSq += sampleYCoCg * sampleYCoCg;
            neighborMin = min(neighborMin, sampleYCoCg);
            neighborMax = max(neighborMax, sampleYCoCg);
            count += 1.0f;
        }
    }

    float invCount = rcp(count);
    float3 mean = sum * invCount;
    float3 stddev = sqrt(max(sumSq * invCount - mean * mean, 0.0f));
    float3 historyYCoCg = SdfHistoryYCoCg(TonemapSdfHistory(HistoryPreExposed));

    float coherentShift = 0.0f;
    if (CoherentClampGate > 0.0f)
    {
        float3 softExtent = max(stddev * (SigmaScale + 0.5f), float3(0.04f, 0.025f, 0.025f) + 0.06f * mean.x);
        float3 excess = max(0.0f, abs(historyYCoCg - mean) - softExtent);
        float relExcess = Max3(excess.x, excess.y, excess.z) / max(0.05f, max(mean.x, historyYCoCg.x));
        float neighborhoodNoise = stddev.x / max(mean.x, 0.05f);
        float coherence = 1.0f - smoothstep(0.20f, 0.50f, neighborhoodNoise);
        coherentShift = smoothstep(0.15f, 0.50f, relExcess) * coherence * CoherentClampGate;
    }
    float clampStrength = max(ParallaxAmount, coherentShift);
    if (clampStrength <= 0.0f)
        return HistoryPreExposed;

    float3 clampMin = max(mean - SigmaScale * stddev, neighborMin);
    float3 clampMax = min(mean + SigmaScale * stddev, neighborMax);
    float3 clampedYCoCg = clamp(historyYCoCg, clampMin, clampMax);
    float3 clampedRgb = InverseTonemapSdfHistory(max(SdfHistoryRgb(clampedYCoCg), 0.0f));
    return lerp(HistoryPreExposed, clampedRgb, clampStrength);
}

// Dense 5x5 geometry-aware bilateral filter executed for freshly disoccluded / low-age pixels
// (numFramesAccumulated < 4) or uncovered silhouette pixels to suppress single-frame stochastic
// probe jitter, seams, and black holes without bleeding across depth or normal discontinuities.
float4 FilterDisoccludedScreenProbeLighting(uint2 pixel, float3 position, float3 normal, float4 current,
    bool filterRoughSpec, inout float4 currentRoughSpec)
{
    int2 size = int2(_SdfDiffuseScreenSize.xy);
    float eyeDepth = max(dot(float4(position, 1.0f), _SdfProbeCameraForward), 1e-4f);
    float3 viewDir = _SdfProbeCameraPosition.w > 0.5f
        ? SafeNormalize(_SdfProbeCameraPosition.xyz - position)
        : -_SdfProbeCameraForward.xyz;
    float grazingScale = clamp(saturate(dot(viewDir, normal)), 0.15f, 1.0f);
    float depthFalloff = 2500.0f * grazingScale * grazingScale;
    float planeFalloff = 6000.0f * grazingScale * grazingScale;

    float centerWeight = current.a > 0.0f ? 1.0f : 0.0f;
    float3 coveredSum = current.rgb * current.a * centerWeight;
    float coverageSum = current.a * centerWeight;
    float4 specSum = filterRoughSpec ? currentRoughSpec * centerWeight : 0.0f;
    float weightSum = centerWeight;

    // Dense 5x5 (24-neighbor) footprint with balanced even/odd parity weights (5.2 == 5.2)
    // so coplanar checkerboard stochastic noise averages cleanly without spatial holes.
    const int2 offsets[24] =
    {
        int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1),
        int2(-1, -1), int2(1, -1), int2(-1, 1), int2(1, 1),
        int2(-2, 0), int2(2, 0), int2(0, -2), int2(0, 2),
        int2(-2, -1), int2(-2, 1), int2(2, -1), int2(2, 1),
        int2(-1, -2), int2(1, -2), int2(-1, 2), int2(1, 2),
        int2(-2, -2), int2(2, -2), int2(-2, 2), int2(2, 2)
    };
    const float spatialWeights[24] =
    {
        0.75f, 0.75f, 0.75f, 0.75f,
        0.50f, 0.50f, 0.50f, 0.50f,
        0.35f, 0.35f, 0.35f, 0.35f,
        0.275f, 0.275f, 0.275f, 0.275f,
        0.275f, 0.275f, 0.275f, 0.275f,
        0.20f, 0.20f, 0.20f, 0.20f
    };

    [loop]
    for (uint i = 0u; i < 24u; ++i)
    {
        int2 tap = int2(pixel) + offsets[i];
        if (any(tap < 0) || any(tap >= size))
            continue;
        float4 tapLighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        if (tapLighting.a <= 0.0f)
            continue;
        float3 tapPosition, tapNormal;
        if (!LoadReceiver(uint2(tap), tapPosition, tapNormal))
            continue;

        float tapEyeDepth = max(dot(float4(tapPosition, 1.0f), _SdfProbeCameraForward), 1e-4f);
        float relativeDepth = abs(tapEyeDepth - eyeDepth) / eyeDepth;
        float depthWeight = exp2(-depthFalloff * relativeDepth * relativeDepth);
        float relativePlane = abs(dot(tapPosition - position, normal)) / eyeDepth;
        float planeWeight = exp2(-planeFalloff * relativePlane * relativePlane);
        float normalWeight = saturate((dot(normal, tapNormal) - 0.55f) / 0.35f);
        float weight = spatialWeights[i] * depthWeight * planeWeight * normalWeight;
        if (weight <= 1e-4f)
            continue;

        coveredSum += tapLighting.rgb * tapLighting.a * weight;
        coverageSum += tapLighting.a * weight;
        if (filterRoughSpec)
            specSum += _SdfCurrentRoughSpecular.Load(int3(tap, 0)) * weight;
        weightSum += weight;
    }

    if (weightSum <= 1e-5f)
        return current;

    float invWeightSum = rcp(weightSum);
    float filteredCoverage = coverageSum * invWeightSum;
    float3 filteredRgb = coveredSum / max(coverageSum, 1e-5f);
    if (filterRoughSpec)
        currentRoughSpec = specSum * invWeightSum;
    return float4(filteredRgb, filteredCoverage);
}

// LumenScreenProbeGatherTemporal.usf, scalar loads from Vivid's geometry-valid taps.
float PackFastUpdateModeAmountAndNumFramesAccumulated(float FastUpdateModeAmount, float NumFramesAccumulated)
{
    float EncodedFastUpdateModeAmount = ceil(FastUpdateModeAmount * 15.0f);
    float LocalMaxFramesAccumulated = min(_SdfPixelHistoryMaxAge, 15.0f);
    float EncodedNumFramesAccumulated = round(saturate(NumFramesAccumulated / LocalMaxFramesAccumulated) * 15.0f);
    return (EncodedFastUpdateModeAmount * 16.0f + EncodedNumFramesAccumulated) / 255.0f;
}

void UnpackFastUpdateModeAmountAndNumFramesAccumulated(float Packed,
    out float OutFastUpdateModeAmount, out float OutNumFramesAccumulated)
{
    Packed = round(Packed * 255.0f);
    float EncodedFastUpdateModeAmount = floor(Packed / 16.0f);
    float EncodedNumFramesAccumulated = Packed - EncodedFastUpdateModeAmount * 16.0f;
    OutFastUpdateModeAmount = EncodedFastUpdateModeAmount / 15.0f;
    OutNumFramesAccumulated = EncodedNumFramesAccumulated == 15.0f ? _SdfPixelHistoryMaxAge
        : EncodedNumFramesAccumulated / 15.0f * min(_SdfPixelHistoryMaxAge, 15.0f);
}

struct ScreenProbeTemporalHistory
{
    float3 coveredLighting;
    float coverage;
    float age;
    float footprint;
    float foreground;
    float objectMotionPixels;
    float fastUpdate;
    float3 roughSpecular;
    float skyVisibility;
    bool staticSubpixelOnly;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    half4 shortRangeAO;
#endif
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    float logMean, logVariance, momentAge, momentCoverage;
#endif
};

bool ReadScreenProbeTemporalHistory(uint2 pixel, float3 position, float3 normal,
    float historyExposureScale, float invCurrentPreExposure, out ScreenProbeTemporalHistory history)
{
    history = (ScreenProbeTemporalHistory)0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z <= 0.0 || previousClip.z > previousClip.w)
        return false;

    float4 packedMotion = _SdfScreenMotion.Load(int3(pixel, 0));
    if (PixelSetAsNoMotionVectors(packedMotion) || !all(isfinite(packedMotion.xy)))
        return false;

    float2 motion;
    DecodeMotionVector(packedMotion, motion);
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    const bool fullSphere = true;
#else
    bool fullSphere = _SdfScreenProbeFullSphere != 0u;
#endif
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float2 previousUv = (previousPixel + 0.5) * _SdfDiffuseScreenSize.zw;
    if (fullSphere ? (any(previousUv < 0.0) || any(previousUv > 1.0)) : (any(previousUv < 0.0) || any(previousUv >= 1.0)))
        return false;

    int2 size = int2(_SdfDiffuseScreenSize.xy);
    int2 lower;
    float2 fraction;
    if (fullSphere)
    {
        if (_SdfHistorySubPixelGridSizeAndInvSize.x > 0.0f)
        {
            float2 clampedUv = clamp(previousUv, _SdfHistoryGatherUvMinMax.xy, _SdfHistoryGatherUvMinMax.zw);
            float2 historyScreenCoord = clampedUv * _SdfDiffuseScreenSize.xy - 0.5f;
            uint encoded = EncodeHistoryScreenCoord(historyScreenCoord, _SdfHistorySubPixelGridSizeAndInvSize.xy);
            float4 decoded = DecodeHistoryScreenCoord(
                encoded,
                uint2(_SdfHistoryCoordShiftX, _SdfHistoryCoordShiftY),
                _SdfHistorySubPixelGridSizeAndInvSize.zw);
            lower = int2(decoded.xy);
            fraction = decoded.zw;
        }
        else
        {
            float2 guardBand = 0.501953125f * _SdfDiffuseScreenSize.zw;
            float2 clampedUv = clamp(previousUv, guardBand, 1.0f - guardBand);
            float2 historyScreenCoord = clampedUv * _SdfDiffuseScreenSize.xy - 0.5f;
            lower = int2(floor(historyScreenCoord));
            fraction = frac(historyScreenCoord);
        }
    }
    else
    {
        lower = int2(floor(previousPixel));
        fraction = frac(previousPixel);
    }

    float expectedDepth = VividPreviousDeviceZ(packedMotion, _SdfDiffuseDepth.Load(int3(pixel, 0)), previousClip.z / previousClip.w);
    float3 expectedReceiver = ComputeWorldSpacePosition(previousUv, expectedDepth, _SdfScreenPreviousInverseVP);
    history.objectMotionPixels = length((previousUv - ScreenUv(previousClip)) * _SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float4 prevForward = dot(_SdfProbePreviousCameraForward.xyz, _SdfProbePreviousCameraForward.xyz) > 0.5f
        ? _SdfProbePreviousCameraForward : _SdfProbeCameraForward;
    float reprojectedSceneDepth = max(dot(float4(expectedReceiver, 1.0f), prevForward), 1e-4f);
    float4 prevScenePlane = float4(normal, dot(expectedReceiver, normal));
    float distanceThreshold = _SdfHistoryTemporalParams.x > 0.0f ? _SdfHistoryTemporalParams.x : 0.01f;
    float normalCosThreshold = _SdfHistoryTemporalParams.y > 0.0f ? _SdfHistoryTemporalParams.y : 0.70710678f;
    float randomScalar = LoadScreenProbeTemporalScalarNoise(pixel);
    bool usePlaneDisocclusion = (_SdfTemporalReprojectionFlags & 1u) != 0u;
    bool rejectBasedOnNormal = (_SdfTemporalReprojectionFlags & 2u) != 0u;
    bool cameraStatic = (_SdfTemporalReprojectionFlags & 8u) != 0u;
    bool staticSubpixelOnly = cameraStatic && length(motion * _SdfDiffuseScreenSize.xy) < 0.25f;
    history.staticSubpixelOnly = staticSubpixelOnly;
    float3 viewDir = _SdfProbeCameraPosition.w > 0.5f
        ? SafeNormalize(_SdfProbeCameraPosition.xyz - position)
        : -_SdfProbeCameraForward.xyz;
    float grazingNdotV = clamp(saturate(dot(viewDir, normal)), 0.1f, 1.0f);
    // Keep threshold blue-noise dithering narrow (0.85..1.15) to avoid salt-and-pepper false history drops on continuous walls.
    float baseThreshold = distanceThreshold * lerp(0.85f, 1.15f, randomScalar);
    float linearDepthDisocclusionThreshold = (baseThreshold / grazingNdotV) * reprojectedSceneDepth;
    float lumenDisocclusionThreshold = usePlaneDisocclusion
        ? max(baseThreshold, 0.015f) * reprojectedSceneDepth
        : linearDepthDisocclusionThreshold;
    float depthTolerance = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float planeTolerance = clamp(0.006 * eyeDepth, 0.02, 0.10);
    float geometryWeight = 0.0;
    float coveredWeight = 0.0;

    bool applyNormalReject = rejectBasedOnNormal && !staticSubpixelOnly;
    bool needPackedGeometry = !fullSphere || _SdfPreviousPixelDepthValid == 0u || applyNormalReject;

    // Precompute algebraic world-position stepping across the 2x2 history footprint to replace
    // 4 full 4x4 matrix multiplies with 1 base multiply + 3 vector FMAs.
    float2 uv00 = (float2(lower) + 0.5f) * _SdfDiffuseScreenSize.zw;
    float4 cs00 = ComputeClipSpacePosition(uv00, 0.0f);
    float4 cs10 = ComputeClipSpacePosition(uv00 + float2(_SdfDiffuseScreenSize.z, 0.0f), 0.0f);
    float4 cs01 = ComputeClipSpacePosition(uv00 + float2(0.0f, _SdfDiffuseScreenSize.w), 0.0f);
    float4 wsBase = mul(_SdfScreenPreviousInverseVP, cs00);
    float4 wsDx = float4(_SdfScreenPreviousInverseVP[0][0], _SdfScreenPreviousInverseVP[1][0],
                         _SdfScreenPreviousInverseVP[2][0], _SdfScreenPreviousInverseVP[3][0]) * (cs10.x - cs00.x);
    float4 wsDy = float4(_SdfScreenPreviousInverseVP[0][1], _SdfScreenPreviousInverseVP[1][1],
                         _SdfScreenPreviousInverseVP[2][1], _SdfScreenPreviousInverseVP[3][1]) * (cs01.y - cs00.y);
    float4 wsDz = float4(_SdfScreenPreviousInverseVP[0][2], _SdfScreenPreviousInverseVP[1][2],
                         _SdfScreenPreviousInverseVP[2][2], _SdfScreenPreviousInverseVP[3][2]);

    float2 invFrac = 1.0f - fraction;
    float4 bilinearWeights = float4(
        invFrac.x * invFrac.y,
        fraction.x * invFrac.y,
        invFrac.x * fraction.y,
        fraction.x * fraction.y);

    if (fullSphere)
    {
        bool4 inBounds4 = bool4(
            lower.x >= 0 && lower.y >= 0 && lower.x < size.x && lower.y < size.y,
            lower.x + 1 >= 0 && lower.y >= 0 && lower.x + 1 < size.x && lower.y < size.y,
            lower.x >= 0 && lower.y + 1 >= 0 && lower.x < size.x && lower.y + 1 < size.y,
            lower.x + 1 >= 0 && lower.y + 1 >= 0 && lower.x + 1 < size.x && lower.y + 1 < size.y);
        float4 activeWeights = float4(
            (inBounds4.x && bilinearWeights.x > 0.01f) ? bilinearWeights.x : 0.0f,
            (inBounds4.y && bilinearWeights.y > 0.01f) ? bilinearWeights.y : 0.0f,
            (inBounds4.z && bilinearWeights.z > 0.01f) ? bilinearWeights.z : 0.0f,
            (inBounds4.w && bilinearWeights.w > 0.01f) ? bilinearWeights.w : 0.0f);

        bool allInBounds = all(inBounds4);
        uint activeCount = (activeWeights.x > 0.0f ? 1u : 0u) + (activeWeights.y > 0.0f ? 1u : 0u)
            + (activeWeights.z > 0.0f ? 1u : 0u) + (activeWeights.w > 0.0f ? 1u : 0u);
        if (activeCount == 0u)
            return false;

        bool useGather = allInBounds && activeCount > 1u;
        float2 gatherUv = (float2(lower) + 1.0f) * _SdfDiffuseScreenSize.zw;

        uint4 packed4 = 0u;
        float4 depth4 = 0.0f;
        if (useGather)
        {
            if (needPackedGeometry)
                packed4 = _SdfDiffusePreviousPixelGeometry.GatherRed(sampler_PointClamp, gatherUv).wzxy;
            depth4 = _SdfPreviousPixelDepthValid != 0u
                ? _SdfDiffusePreviousPixelDepth.GatherRed(sampler_PointClamp, gatherUv).wzxy
                : float4(f16tof32(packed4.x & 65535u), f16tof32(packed4.y & 65535u),
                         f16tof32(packed4.z & 65535u), f16tof32(packed4.w & 65535u));
        }

        // Stage 1: Evaluate depth/plane/normal validity across active taps before fetching lighting channels.
        float4 validW = 0.0f;
        [unroll]
        for (uint i = 0u; i < 4u; ++i)
        {
            float weight = activeWeights[i];
            if (weight <= 0.0f)
                continue;
            int2 offset = int2(i & 1u, i >> 1u);
            int2 tap = lower + offset;
            uint packed = useGather ? packed4[i] : (needPackedGeometry ? _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0)) : 0u);
            float depth = useGather ? depth4[i]
                : (_SdfPreviousPixelDepthValid != 0u ? _SdfDiffusePreviousPixelDepth.Load(int3(tap, 0)) : f16tof32(packed & 65535u));
            if (depth <= 0.0f)
                continue;

            float4 hws = wsBase + float(offset.x) * wsDx + float(offset.y) * wsDy + depth * wsDz;
            float3 samplePosition = hws.xyz * rcp(hws.w);
            float historySampleSceneDepth = max(dot(float4(samplePosition, 1.0f), prevForward), 1e-4f);
            float linearDepthDelta = abs(historySampleSceneDepth - reprojectedSceneDepth);
            bool depthRejected;
            if (usePlaneDisocclusion)
            {
                float planeDistance = abs(dot(float4(samplePosition, -1.0f), prevScenePlane));
                bool depthDisoccluded = !staticSubpixelOnly && linearDepthDelta >= linearDepthDisocclusionThreshold * 3.0f;
                depthRejected = planeDistance >= lumenDisocclusionThreshold || depthDisoccluded;
            }
            else
            {
                depthRejected = linearDepthDelta >= lumenDisocclusionThreshold;
            }
            if (depthRejected)
                continue;
            if (applyNormalReject && dot(UnpackProbeNormal(float(packed >> 16u)), normal) < normalCosThreshold)
                continue;
            validW[i] = weight;
        }

        uint validCount = (validW.x > 0.0f ? 1u : 0u) + (validW.y > 0.0f ? 1u : 0u)
            + (validW.z > 0.0f ? 1u : 0u) + (validW.w > 0.0f ? 1u : 0u);
        if (validCount == 0u)
            return false;

        // Stage 2: Batch single-channel history fetches with hardware GatherRed when 2+ taps are valid.
        bool gatherChannels = allInBounds && validCount > 1u;
        float4 fastUpdate4 = gatherChannels ? _SdfPreviousFastUpdate.GatherRed(sampler_PointClamp, gatherUv).wzxy : 0.0f;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
        uint4 bent4 = (gatherChannels && _SdfBentHistoryValid != 0u)
            ? _SdfBentPrevious.GatherRed(sampler_PointClamp, gatherUv).wzxy : 0u;
#endif
        float3 lightScale = historyExposureScale * _SdfHistoryLightScale.rgb;
        [unroll]
        for (uint i = 0u; i < 4u; ++i)
        {
            float weight = validW[i];
            if (weight <= 0.0f)
                continue;
            int2 tap = lower + int2(i & 1u, i >> 1u);
            float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
            if (sample.a <= 0.0f)
                continue;
            geometryWeight += weight;

#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
            float3 unscaledRgb = sample.rgb;
#endif
            sample.rgb *= lightScale;
            float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
            float covered = weight * ageAndCoverage.y;
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
            if (_SdfScreenProbeMomentsHistoryValid != 0u)
            {
                float4 moments = _SdfScreenProbePreviousMoments.Load(int3(tap, 0));
                if (moments.w > 0.0 && moments.z >= 1.0)
                {
                    float invPrevPreExposure = historyExposureScale * invCurrentPreExposure;
                    float3 oldLighting = DecodeScreenProbeCoveredHistory(unscaledRgb, ageAndCoverage.y)
                        * (invPrevPreExposure / max(ageAndCoverage.y, 1e-5));
                    float3 newLighting = DecodeScreenProbeCoveredHistory(sample.rgb, ageAndCoverage.y)
                        * (invCurrentPreExposure / max(ageAndCoverage.y, 1e-5));
                    float oldY = RestirLuminance(oldLighting), newY = RestirLuminance(newLighting);
                    float mean = moments.x + log2((1.0 + newY) / (1.0 + oldY));
                    float radianceScale = oldY > 1e-5 ? newY / oldY : RestirLuminance(_SdfHistoryLightScale.rgb);
                    float jacobian = radianceScale * (1.0 + oldY) / (1.0 + newY);
                    float variance = max(0.0, moments.y) * jacobian * jacobian;
                    float combinedWeight = history.momentCoverage + covered;
                    float momentFraction = covered / max(combinedWeight, 1e-5);
                    float delta = mean - history.logMean;
                    history.logMean += momentFraction * delta;
                    history.logVariance += covered * variance + history.momentCoverage * momentFraction * delta * delta;
                    history.momentAge += covered * moments.z;
                    history.momentCoverage += covered;
                }
            }
#endif
            history.coveredLighting += weight * DecodeScreenProbeCoveredHistory(sample.rgb, ageAndCoverage.y);
            float packedFast = gatherChannels ? fastUpdate4[i] : _SdfPreviousFastUpdate.Load(int3(tap, 0));
            float fastUpdate, numFramesAccumulated;
            UnpackFastUpdateModeAmountAndNumFramesAccumulated(packedFast, fastUpdate, numFramesAccumulated);
            history.age += weight * (numFramesAccumulated + 1.0f);
            history.fastUpdate += weight * fastUpdate;
            history.footprint += weight;
            if (_SdfRoughSpecularEnabled != 0u && _SdfPreviousRoughSpecularValid != 0u)
            {
                float4 prevSpec = _SdfPreviousRoughSpecular.Load(int3(tap, 0));
                prevSpec.rgb *= lightScale;
                history.roughSpecular += weight * prevSpec.rgb;
                history.skyVisibility += weight * prevSpec.a;
            }
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
            if (_SdfBentHistoryValid != 0u)
            {
                uint packedBent = gatherChannels ? bent4[i] : _SdfBentPrevious.Load(int3(tap, 0));
                history.shortRangeAO += half(weight) * UnpackSharedShortRangeAO(packedBent);
            }
#endif
            coveredWeight += covered;
        }
    }
    else
    {
        [unroll]
        for (uint i = 0u; i < 4u; ++i)
        {
            int2 offset = int2(i & 1u, i >> 1u);
            int2 tap = lower + offset;
            float weight = bilinearWeights[i];
            if (any(tap < 0) || any(tap >= size) || weight <= 0.0f)
                continue;

            uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
            float depth = _SdfPreviousPixelDepthValid != 0u
                ? _SdfDiffusePreviousPixelDepth.Load(int3(tap, 0))
                : f16tof32(packed & 65535u);
            if (depth <= 0.0)
                continue;

            float4 hws = wsBase + float(offset.x) * wsDx + float(offset.y) * wsDy + depth * wsDz;
            float3 samplePosition = hws.xyz * rcp(hws.w);
            float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
            float4 hExp = wsBase + float(offset.x) * wsDx + float(offset.y) * wsDy + expectedDepth * wsDz;
            float3 expectedTap = hExp.xyz * rcp(hExp.w);
            bool depthMismatch = distance(samplePosition, expectedTap) > depthTolerance;
            bool planeMismatch = abs(dot(samplePosition - expectedReceiver, normal)) > planeTolerance;
            if (depth > expectedDepth && depthMismatch && planeMismatch)
                history.foreground += weight;
            if (depthMismatch || planeMismatch || dot(normal, UnpackProbeNormal(float(packed >> 16u))) < 0.92)
                continue;
            geometryWeight += weight;
            if (sample.a <= 0.0)
                continue;

#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
            float3 unscaledRgb = sample.rgb;
#endif
            sample.rgb *= historyExposureScale * _SdfHistoryLightScale.rgb;
            float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
            float covered = weight * ageAndCoverage.y;
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
            if (_SdfScreenProbeMomentsHistoryValid != 0u)
            {
                float4 moments = _SdfScreenProbePreviousMoments.Load(int3(tap, 0));
                if (moments.w > 0.0 && moments.z >= 1.0)
                {
                    float invPrevPreExposure = historyExposureScale * invCurrentPreExposure;
                    float3 oldLighting = DecodeScreenProbeCoveredHistory(unscaledRgb, ageAndCoverage.y)
                        * (invPrevPreExposure / max(ageAndCoverage.y, 1e-5));
                    float3 newLighting = DecodeScreenProbeCoveredHistory(sample.rgb, ageAndCoverage.y)
                        * (invCurrentPreExposure / max(ageAndCoverage.y, 1e-5));
                    float oldY = RestirLuminance(oldLighting), newY = RestirLuminance(newLighting);
                    float mean = moments.x + log2((1.0 + newY) / (1.0 + oldY));
                    float radianceScale = oldY > 1e-5 ? newY / oldY : RestirLuminance(_SdfHistoryLightScale.rgb);
                    float jacobian = radianceScale * (1.0 + oldY) / (1.0 + newY);
                    float variance = max(0.0, moments.y) * jacobian * jacobian;
                    float combinedWeight = history.momentCoverage + covered;
                    float momentFraction = covered / max(combinedWeight, 1e-5);
                    float delta = mean - history.logMean;
                    history.logMean += momentFraction * delta;
                    history.logVariance += covered * variance + history.momentCoverage * momentFraction * delta * delta;
                    history.momentAge += covered * moments.z;
                    history.momentCoverage += covered;
                }
            }
#endif
            history.coveredLighting += weight * DecodeScreenProbeCoveredHistory(sample.rgb, ageAndCoverage.y);
            float fastUpdate, numFramesAccumulated;
            UnpackFastUpdateModeAmountAndNumFramesAccumulated(_SdfPreviousFastUpdate.Load(int3(tap, 0)),
                fastUpdate, numFramesAccumulated);
            history.age += weight * (numFramesAccumulated + 1.0f);
            history.fastUpdate += weight * fastUpdate;
            history.footprint += weight;
            if (_SdfRoughSpecularEnabled != 0u && _SdfPreviousRoughSpecularValid != 0u)
            {
                float4 prevSpec = _SdfPreviousRoughSpecular.Load(int3(tap, 0));
                prevSpec.rgb *= historyExposureScale * _SdfHistoryLightScale.rgb;
                history.roughSpecular += weight * prevSpec.rgb;
                history.skyVisibility += weight * prevSpec.a;
            }
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
            if (_SdfBentHistoryValid != 0u)
                history.shortRangeAO += half(weight) * UnpackSharedShortRangeAO(_SdfBentPrevious.Load(int3(tap, 0)));
#endif
            coveredWeight += covered;
        }
    }

    if (fullSphere)
    {
        if (history.footprint <= 0.0f)
            return false;
    }
    else if (history.footprint < 0.35 || history.foreground >= 0.25)
    {
        return false;
    }

    float invGeometryWeight = 1.0f / max(geometryWeight, 1e-5f);
    float invFootprint = 1.0f / max(history.footprint, 1e-5f);
    history.coveredLighting *= invGeometryWeight;
    history.coverage = coveredWeight * invGeometryWeight;
    history.age = min(history.age * invFootprint, _SdfPixelHistoryMaxAge);
    history.fastUpdate *= invFootprint;
    history.roughSpecular *= invFootprint;
    history.skyVisibility *= invFootprint;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    history.shortRangeAO /= max(half(history.footprint), half(1e-4));
#endif
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    float momentWeight = history.momentCoverage;
    history.logVariance = max(0.0, history.logVariance / max(momentWeight, 1e-5));
    history.momentAge /= max(momentWeight, 1e-5);
    history.momentCoverage = momentWeight / max(coveredWeight, 1e-5);
#endif
    return true;
}

Texture2D<float> _SdfResolvedMoving;

float ScreenProbePriorFrameCount(float storedAge, float confidence, float fastUpdate)
{
    return min(storedAge * confidence, (1.0 - fastUpdate) * _SdfPixelHistoryMaxAge);
}

float ScreenProbeCurrentSampleWeight(bool bLightingIsValid, float NewNumFramesAccumulated)
{
    float Alpha = 1.0f / (1.0f + NewNumFramesAccumulated);
    if (!bLightingIsValid && NewNumFramesAccumulated >= 1.0f)
        Alpha = 1.0f / (1.0f + 4.0f * NewNumFramesAccumulated);
    return Alpha;
}

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS) && defined(VIVID_SDF_SCREEN_PROBE_AO)
void ScreenProbeTemporalReprojectionWithMomentsAndAOCS(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID, uint3 localId : SV_GroupThreadID, uint lane : SV_GroupIndex)
#elif defined(VIVID_SDF_SCREEN_PROBE_AO)
void ScreenProbeTemporalReprojectionWithAOCS(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID, uint3 localId : SV_GroupThreadID, uint lane : SV_GroupIndex)
#elif defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
void ScreenProbeTemporalReprojectionWithMomentsCS(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID, uint3 localId : SV_GroupThreadID, uint lane : SV_GroupIndex)
#else
void ScreenProbeTemporalReprojectionCS(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID, uint3 localId : SV_GroupThreadID, uint lane : SV_GroupIndex)
#endif
{
    int2 screenSize = int2(_SdfDiffuseScreenSize.xy);
    int2 maxScreenCoord = screenSize - 1;
    float currentPreExposure = _SdfPreExposureHistoryEnabled != 0u ? VividGetPreExposure() : 1.0f;

#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    int2 reconBase, aoBase;
    PreloadShortRangeAOTile(group, lane, screenSize, reconBase, aoBase);
#endif
    // Only preload the 10x10 rough-specular neighborhood when view translation can produce
    // non-zero parallax clamping; static cameras skip 200 RGBA16F loads + 100 tonemaps per tile.
    float3 camDelta = _SdfProbeCameraPosition.xyz - _SdfProbePreviousCameraPosition.xyz;
    bool needRoughSpecClamp = _SdfRoughSpecularEnabled != 0u
        && _SdfDiffuseHasHistory != 0u
        && _SdfPreviousRoughSpecularValid != 0u
        && _SdfProbeCameraPosition.w > 0.5f
        && _SdfProbePreviousCameraPosition.w > 0.5f
        && dot(camDelta, camDelta) > 1e-10f;
    if (needRoughSpecClamp)
        PreloadRoughSpecularTile(group, lane, maxScreenCoord, currentPreExposure);
    GroupMemoryBarrierWithGroupSync();

    if (any(id.xy >= uint2(screenSize)))
        return;

    float prevPreExposure = (_SdfPreExposureHistoryEnabled != 0u && _SdfPreviousPreExposureValid != 0u)
        ? max(_SdfPreviousPreExposure.Load(int3(0, 0, 0)), 1e-4f)
        : currentPreExposure;
    float historyExposureScale = currentPreExposure / prevPreExposure;
    float invCurrentPreExposure = rcp(currentPreExposure);
    if (_SdfPreExposureHistoryEnabled != 0u && all(id.xy == 0u))
        _SdfCurrentPreExposureOutput[uint2(0u, 0u)] = currentPreExposure;

    float depth, roughness;
    float3 position, normal;
    bool receiver = LoadReceiverWithDepthAndRoughness(id.xy, depth, position, normal, roughness);
    if (!receiver)
    {
        // Fast sky/background exit: skip ShortRangeAO reconstruction, history reprojection, and lighting math.
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
        _SdfBentOutput[id.xy] = PackSharedShortRangeAO(half4(0.0, 1.0, 0.0, 1.0));
#endif
        _SdfDiffusePixelGeometryOutput[id.xy] = f32tof16(depth);
        _SdfDiffusePixelDepthOutput[id.xy] = depth;
        _SdfFastUpdateOutput[id.xy] = 0.0f;
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
        _SdfScreenProbeMomentsOutput[id.xy] = 0.0f;
#endif
        if (_SdfRoughSpecularEnabled != 0u)
            _SdfRoughSpecularHistoryOutput[id.xy] = 0.0f;
        float skyAlpha = PackScreenProbePixelHistory(0.0f, 0.0f, ScreenProbeNoHistory);
        _SdfDiffusePixelLightingOutput[id.xy] = float4(0.0f, 0.0f, 0.0f, skyAlpha);
        _SdfDiffuseOutput[id.xy] = 0.0f;
        return;
    }

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    // Depth from an unresolved or unlit foreground still occludes history.
    uint geometry = f32tof16(depth) | (uint(PackProbeNormal(normal)) << 16u);
    bool hasLighting = receiver && result.a > 0.0;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    const bool fullSphere = true;
#else
    bool fullSphere = _SdfScreenProbeFullSphere != 0u;
#endif
    float moving = receiver ? _SdfResolvedMoving.Load(int3(id.xy, 0)) : 0.0;
    float invFractionMoving = _SdfHistoryTemporalParams.z > 0.0f ? _SdfHistoryTemporalParams.z : 10.0f;
    float maxFastUpdateAmount = _SdfHistoryTemporalParams.w > 0.0f ? _SdfHistoryTemporalParams.w : 0.9f;
    float age = hasLighting ? 1.0 : 0.0;
    uint historyStatus = ScreenProbeNoHistory;
    ScreenProbeTemporalHistory history;
    float currentFastUpdate = 0.0;
    float numFramesAccumulated = 0.0;
    bool bValidReconstruction = true;
#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    half4 OutShortRangeAO = half4(0.0, 1.0, 0.0, 1.0);
    half4 FilteredShortRangeAO = half4(0.0, 1.0, 0.0, 1.0);
    int2 SampleCoord = 0;
    if (receiver)
    {
        half4 StochasticShortRangeAO;
        SampleCoord = ReconstructShortRangeAO(id.xy, position, normal, reconBase, aoBase,
            bValidReconstruction, FilteredShortRangeAO, StochasticShortRangeAO);
        OutShortRangeAO = bValidReconstruction ? StochasticShortRangeAO : FilteredShortRangeAO;
    }
#endif
    // LumenScreenProbeGatherTemporal.usf: bValidReconstruction only gates ShortRangeAO,
    // never Diffuse GI or Rough Specular (which would otherwise freeze at 1/(1+4*N) on geometry edges).
    bool bLightingIsValid = hasLighting && (!fullSphere || moving > 0.0);
    bool readHistory = receiver && (fullSphere || hasLighting);
    bool historyRead = readHistory && _SdfDiffuseHasHistory != 0u
        && ReadScreenProbeTemporalHistory(id.xy, position, normal, historyExposureScale, invCurrentPreExposure, history);
    bool historyAccepted = false;
    float fastUpdate = 0.0;
    float ageConfidence = 1.0;
    float coverageAgreement = 1.0;
    if (historyRead)
    {
        coverageAgreement = min(result.a, history.coverage) / max(max(result.a, history.coverage), 1e-5);
        // LumenScreenProbeGatherTemporal.usf accumulates any valid reprojected history (bAnyHistoryValid).
        if (fullSphere || (hasLighting && coverageAgreement >= 0.35))
        {
            historyAccepted = true;
            currentFastUpdate = saturate(moving * invFractionMoving);
            currentFastUpdate = saturate(min((currentFastUpdate - .2f) / .8f, maxFastUpdateAmount));
            // Only this frame's lighting motion is carried into the next frame.
            fastUpdate = max(currentFastUpdate, min(history.fastUpdate, maxFastUpdateAmount));
            if (!fullSphere)
                fastUpdate = max(fastUpdate, SdfPixelHistoryFastUpdate(history.foreground, history.objectMotionPixels));
            // Trace coverage is a stochastic lighting estimate. It must not
            // select the current sample's averaging weight on stable geometry.
            ageConfidence = (_SdfGatherHistoryDiagnostics & 4194304u) != 0u
                ? coverageAgreement : saturate(history.footprint);
            if ((_SdfGatherHistoryDiagnostics & 8u) != 0u)
                ageConfidence = 1.0;
            numFramesAccumulated = ScreenProbePriorFrameCount(history.age, fullSphere ? 1.0 : ageConfidence, fastUpdate);
        }
    }

    float4 currentRoughSpec = _SdfRoughSpecularEnabled != 0u ? _SdfCurrentRoughSpecular.Load(int3(id.xy, 0)) : 0.0f;
    [branch]
    if (_SdfDisocclusionSpatialFilter != 0u && fullSphere && receiver && (numFramesAccumulated < 4.0f || !hasLighting))
    {
        float4 filteredRoughSpec = currentRoughSpec;
        float4 filtered = FilterDisoccludedScreenProbeLighting(
            id.xy, position, normal, result, _SdfRoughSpecularEnabled != 0u, filteredRoughSpec);
        float spatialBlend = hasLighting ? saturate(1.0f - 0.25f * numFramesAccumulated) : 1.0f;
        result = lerp(result, filtered, spatialBlend);
        hasLighting = result.a > 0.0f;
        if (hasLighting)
            age = max(age, 1.0f);
        if (_SdfRoughSpecularEnabled != 0u)
            currentRoughSpec = lerp(currentRoughSpec, filteredRoughSpec, spatialBlend);
    }

#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    float currentLog = ScreenProbeLogLuminance(result.rgb);
    float3 moments = float3(currentLog, 0.0, age);
#endif
    float3 currentPreExposed = result.rgb * currentPreExposure;
    float3 blendedPreExposed = min(currentPreExposed, 65000.0);
    float currentWeight = 1.0f;
    bool steadyStaticPixel = false;
    uint2 maxScreenCoordU = uint2(maxScreenCoord);

    bool effectiveLightingValid = bLightingIsValid;
    if (historyAccepted)
    {
        float3 historyLighting = history.coveredLighting / max(history.coverage, 1e-5);
        float3 rectified = historyLighting;
        float coherentBoost = 0.0f;
        if (fullSphere)
        {
            [branch]
            if (_SdfFastUpdateNeighborhoodClamp != 0u && fastUpdate > 0.0f)
            {
                rectified = ClampScreenProbeHistory(
                    id.xy,
                    uint2(0u, 0u),
                    maxScreenCoordU,
                    currentPreExposed,
                    historyLighting,
                    currentPreExposure);
            }
            [branch]
            if ((_SdfTemporalReprojectionFlags & 4u) != 0u)
            {
                rectified = ApplyCoherentRadianceFastUpdate(
                    id.xy,
                    maxScreenCoordU,
                    position,
                    normal,
                    currentPreExposed,
                    rectified,
                    currentPreExposure,
                    coherentBoost);
                if (coherentBoost > 0.0f)
                {
                    float effectiveFastUpdate = max(fastUpdate, min(coherentBoost, maxFastUpdateAmount));
                    numFramesAccumulated = min(numFramesAccumulated,
                        ScreenProbePriorFrameCount(history.age, 1.0f, effectiveFastUpdate));
                }
            }
        }
        else
        {
            rectified = RectifyPixelHistory(id.xy, position, normal, result,
                historyLighting * invCurrentPreExposure, fastUpdate) * currentPreExposure;
        }
        // Only apply the 4x fallback slowdown when static; under camera motion or coherent shifts,
        // protruding thin edges (capitals/brackets) must converge at normal speed instead of freezing for 40+ frames.
        effectiveLightingValid = bLightingIsValid || (hasLighting && (!history.staticSubpixelOnly || coherentBoost > 0.0f));
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
        if (fullSphere ? history.momentCoverage > 0.0f : history.momentCoverage >= 0.35f)
        {
            float momentPriorFrames = ScreenProbePriorFrameCount(history.momentAge,
                (fullSphere ? 1.0f : ageConfidence) * saturate(history.momentCoverage), fastUpdate);
            float weight = ScreenProbeCurrentSampleWeight(effectiveLightingValid, momentPriorFrames);
            float mean = history.logMean + ScreenProbeLogLuminance(rectified * invCurrentPreExposure)
                - ScreenProbeLogLuminance(historyLighting * invCurrentPreExposure);
            float delta = currentLog - mean;
            // Central variance avoids cancellation in half-precision history.
            // Keep observation variance conservative: sparse probes are correlated.
            moments = float3(lerp(mean, currentLog, weight),
                (1.0 - weight) * (history.logVariance + weight * delta * delta), min(1.0 + momentPriorFrames, _SdfPixelHistoryMaxAge));
        }
#endif
        age = min(1.0 + numFramesAccumulated, _SdfPixelHistoryMaxAge);
        historyStatus = fastUpdate > 0.2 || coverageAgreement < 0.8
            ? ScreenProbeHistoryCoverageLimited : ScreenProbeHistoryAccepted;

        // Extend steady-state convergence weight only when camera, object, and lighting are all static,
        // suppressing residual probe-sampling flicker without adding motion or lighting-change ghosting.
        steadyStaticPixel = fullSphere && history.staticSubpixelOnly
            && (_SdfTemporalReprojectionFlags & 4u) == 0u
            && fastUpdate <= 0.0f
            && numFramesAccumulated >= _SdfPixelHistoryMaxAge * 0.9f;
        float diffusePriorFrames = steadyStaticPixel ? min(numFramesAccumulated * 2.5f, 32.0f) : numFramesAccumulated;
        currentWeight = ScreenProbeCurrentSampleWeight(effectiveLightingValid, diffusePriorFrames);
        float currentCoverage = result.a;
        float3 coveredPreExposed = lerp(rectified * history.coverage, currentPreExposed * currentCoverage, currentWeight);
        float rawBlendedCoverage = lerp(history.coverage, currentCoverage, currentWeight);
        float blendedCoverage = rawBlendedCoverage;
        // Prevent 8-bit PackScreenProbePixelHistory quantization from stalling recovery below 1.0
        // when steady-state currentWeight * (1 - history.coverage) < 0.5 / 255.
        if (currentCoverage >= 1.0f - (0.5f / 255.0f) && blendedCoverage > history.coverage && blendedCoverage < 1.0f)
            blendedCoverage = min(1.0f, max(blendedCoverage, history.coverage + (1.0f / 255.0f)));
        result.a = blendedCoverage;
        blendedPreExposed = min(coveredPreExposed / max(rawBlendedCoverage, 1e-5), 65000.0);
    }

    if (_SdfRoughSpecularEnabled != 0u)
    {
        float3 currentRoughSpecPreExposed = currentRoughSpec.rgb * currentPreExposure;
        float3 blendedRoughSpecPreExposed = currentRoughSpecPreExposed;
        float blendedSkyVis = currentRoughSpec.a;
        if (historyAccepted && _SdfPreviousRoughSpecularValid != 0u)
        {
            float roughSpecMaxAge = lerp(4.0f, _SdfPixelHistoryMaxAge, roughness);
            float specPriorFrames = min(numFramesAccumulated, roughSpecMaxAge);
            float parallaxAmount = 0.0f;
            if (needRoughSpecClamp)
            {
                float3 currV = SafeNormalize(_SdfProbeCameraPosition.xyz - position);
                float3 prevV = SafeNormalize(_SdfProbePreviousCameraPosition.xyz - position);
                float viewAngleSin = length(cross(currV, prevV));
                float lobeWidth = max(roughness * roughness, 0.04f);
                float parallaxRetention = exp(-viewAngleSin / lobeWidth * 1.5f);
                specPriorFrames *= parallaxRetention;
                parallaxAmount = 1.0f - parallaxRetention;
            }
            if (steadyStaticPixel)
                specPriorFrames = min(specPriorFrames * 2.0f, 24.0f);
            else if ((_SdfTemporalReprojectionFlags & 4u) != 0u)
                specPriorFrames = min(specPriorFrames, lerp(4.0f, 8.0f, roughness));
            // Only engage 3x3 neighborhood clamping on real view parallax (where reflections move across surfaces).
            // Under dynamic lighting changes on a static camera, 16x16 Screen Probe jitter shifts all 9 pixels in a
            // 3x3 neighborhood together; hard-clamping history to a single-frame box turns curved metallic props into
            // violent single-frame flicker. Lighting responsiveness is instead driven smoothly via specPriorFrames.
            float coherentClampGate = smoothstep(0.02f, 0.12f, parallaxAmount);
            float3 clampedRoughSpecHistory = history.roughSpecular;
            [branch]
            if (needRoughSpecClamp && parallaxAmount > 0.0f)
            {
                float sigmaScale = lerp(1.5f, 2.25f, roughness);
                clampedRoughSpecHistory = ClampRoughSpecularHistory(
                    localId.xy,
                    currentRoughSpecPreExposed,
                    history.roughSpecular,
                    sigmaScale,
                    parallaxAmount,
                    coherentClampGate);
            }
            float roughSpecWeight = ScreenProbeCurrentSampleWeight(effectiveLightingValid, specPriorFrames);
            blendedRoughSpecPreExposed = lerp(clampedRoughSpecHistory, currentRoughSpecPreExposed, roughSpecWeight);
            // Sky visibility is geometric occlusion (view-independent), so accumulate with Diffuse GI weight.
            blendedSkyVis = lerp(history.skyVisibility, currentRoughSpec.a, currentWeight);
        }
        _SdfRoughSpecularHistoryOutput[id.xy] = RoundSdfHistory(
            float4(min(blendedRoughSpecPreExposed, 65000.0f), saturate(blendedSkyVis)));
    }

#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    if (historyRead && _SdfBentHistoryValid != 0u)
    {
        float FastUpdateModeAmount = saturate(moving * invFractionMoving);
        FastUpdateModeAmount = saturate(min((FastUpdateModeAmount - .2f) / .8f, maxFastUpdateAmount));
        FastUpdateModeAmount = max(FastUpdateModeAmount, min(history.fastUpdate, maxFastUpdateAmount));
        float NewNumFramesAccumulated = min(history.age, (1.0f - FastUpdateModeAmount) * _SdfPixelHistoryMaxAge);
        half aoClampSigma = steadyStaticPixel ? half(2.0) : half(1.75);
        if (steadyStaticPixel)
            NewNumFramesAccumulated = min(NewNumFramesAccumulated * 2.5f, 32.0f);
        half4 aoSample = bValidReconstruction ? OutShortRangeAO : FilteredShortRangeAO;
        half4 HistoryShortRangeAO = ClampShortRangeAOHistory(id.xy, SampleCoord, aoBase, aoSample, history.shortRangeAO, aoClampSigma);
        float Alpha = ScreenProbeCurrentSampleWeight(effectiveLightingValid && bValidReconstruction, NewNumFramesAccumulated);
        OutShortRangeAO = lerp(HistoryShortRangeAO, aoSample, half(Alpha));
    }
    else if (receiver)
    {
        // Freshly disoccluded pixels use the 4-tap geometry-weighted average instead of 1-tap stochastic noise.
        OutShortRangeAO = FilteredShortRangeAO;
    }
#endif

#if defined(VIVID_SDF_SCREEN_PROBE_AO)
    _SdfBentOutput[id.xy] = PackSharedShortRangeAO(OutShortRangeAO);
#endif
    _SdfDiffusePixelGeometryOutput[id.xy] = geometry;
    _SdfDiffusePixelDepthOutput[id.xy] = depth;
    _SdfFastUpdateOutput[id.xy] = PackFastUpdateModeAmountAndNumFramesAccumulated(currentFastUpdate, numFramesAccumulated);
#if defined(VIVID_SDF_SCREEN_PROBE_MOMENTS)
    _SdfScreenProbeMomentsOutput[id.xy] = SdfRoundToNearestHalf(float4(moments, age > 0.0 ? result.a : 0.0));
#endif
    float historyAlpha = PackScreenProbePixelHistory(age, result.a, historyStatus);
    float3 historyRgb = EncodeScreenProbeCoveredHistory(blendedPreExposed, result.a);
    float4 outputResult = RoundSdfHistory(float4(min(blendedPreExposed * invCurrentPreExposure, 65000.0), result.a));
    _SdfDiffusePixelLightingOutput[id.xy] = float4(historyRgb, historyAlpha);
    _SdfDiffuseOutput[id.xy] = outputResult;
}

// Explicit Editor diagnostic dispatch only. Reuse the production history reader
// so a nearest-depth approximation cannot be mistaken for its four-tap decision.
float4 _SdfPixelHistoryInspectRegion; // offset.xy, pixel stride, unused
float4 _SdfPixelHistoryInspectSize;   // sampled width, sampled height, unused
RWStructuredBuffer<float4> _SdfPixelHistoryInspection;

[numthreads(8, 8, 1)]
void InspectScreenProbeTemporalHistoryCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(_SdfPixelHistoryInspectSize.xy)))
        return;
    uint2 pixel = uint2(_SdfPixelHistoryInspectRegion.xy) + id.xy * uint(_SdfPixelHistoryInspectRegion.z);
    uint address = (id.y * uint(_SdfPixelHistoryInspectSize.x) + id.x) * 6u;
    float3 position, normal;
    bool receiver = LoadReceiver(pixel, position, normal);
    ScreenProbeTemporalHistory history = (ScreenProbeTemporalHistory)0;
    bool valid = receiver && ReadScreenProbeTemporalHistory(pixel, position, normal, 1.0f, 1.0f, history);
    float4 clip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    float4 encodedMotion = _SdfScreenMotion.Load(int3(pixel, 0));
    float2 motion = VividDecodeMotionUV(encodedMotion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    _SdfPixelHistoryInspection[address] = float4(valid ? 1.0 : 0.0, history.footprint,
        history.foreground, history.objectMotionPixels);
    _SdfPixelHistoryInspection[address + 1u] = float4(history.coveredLighting, history.coverage);
    _SdfPixelHistoryInspection[address + 2u] = float4(history.age, receiver ? 1.0 : 0.0,
        clamp(0.008 * eyeDepth, 0.025, 0.12), clamp(0.006 * eyeDepth, 0.02, 0.10));
    _SdfPixelHistoryInspection[address + 3u] = float4(position, eyeDepth);
    _SdfPixelHistoryInspection[address + 4u] = float4(normal, _SdfDiffuseDepth.Load(int3(pixel, 0)));
    _SdfPixelHistoryInspection[address + 5u] = float4(previousPixel,
        VividPreviousDeviceZ(encodedMotion, _SdfDiffuseDepth.Load(int3(pixel, 0)), clip.w != 0.0 ? clip.z / clip.w : 0.0),
        PixelSetAsNoMotionVectors(encodedMotion) ? 1.0 : 0.0);
}
#endif

#if defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
RWStructuredBuffer<float4> _SdfCoveredHistoryValidation;

[numthreads(8, 1, 1)]
void InspectSdfCoveredHistoryEnergyCS(uint3 id : SV_DispatchThreadID)
{
    const float coverages[8] = {0.051, 0.101, 0.331, 0.6877, 0.953, 0.1, 0.5, 0.75};
    float currentCoverage = coverages[id.x];
    float3 expected = id.x == 7u ? 0.0 : float3(1.0, 2.0, 0.5);
    float coverage = currentCoverage;
    float3 stored = EncodeScreenProbeCoveredHistory(expected / coverage, coverage);
    float packed = PackScreenProbePixelHistory(32.0, coverage, ScreenProbeHistoryAccepted);
    float3 energy = expected;
    [loop]
    for (uint frame = 0u; frame < 4096u; ++frame)
    {
        float previousCoverage = UnpackScreenProbePixelHistory(packed).y;
        energy = lerp(DecodeScreenProbeCoveredHistory(stored, previousCoverage), expected, 1.0 / 32.0);
        coverage = lerp(previousCoverage, currentCoverage, 1.0 / 32.0);
        stored = EncodeScreenProbeCoveredHistory(energy / coverage, coverage);
        packed = PackScreenProbePixelHistory(32.0, coverage, ScreenProbeHistoryAccepted);
    }
    _SdfCoveredHistoryValidation[id.x] = float4(energy, UnpackScreenProbePixelHistory(packed).y);
}
#endif

RWTexture2D<float4> _SdfHistoryQuantizationFloat;
RWTexture2D<float4> _SdfHistoryQuantizationHalf;

[numthreads(64, 1, 1)]
void InspectSdfHistoryQuantizationCS(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x & 63u;
    uint category = id.x >> 6u;
    float value = category == 0u ? 1.0 + (float(index) + 0.25) / 2048.0
        : category == 1u ? 1.0 + (float(index) + 0.5) / 1024.0
        : category == 2u ? (float(index) + 0.25) * exp2(-25.0) : 65000.0 + 1.25 * float(index);
    float4 rounded = SdfRoundToNearestHalf(float4(value, -value, 0.0, 0.0));
    float4 sample = float4(value, rounded.x, -value, rounded.y);
    _SdfHistoryQuantizationFloat[id.xy] = sample;
    _SdfHistoryQuantizationHalf[id.xy] = sample;
}
