#pragma kernel TemporalSdfDiffuseGI
#pragma kernel ScreenProbeTemporalReprojectionCS VIVID_SDF_SCREEN_PROBE_TEMPORAL
#pragma kernel TemporalSdfRestirDiffuseGI VIVID_SDF_RESTIR_PIXEL_HISTORY
#pragma kernel TemporalSdfRestirVariance VIVID_SDF_RESTIR_PIXEL_HISTORY VIVID_SDF_RESTIR_VARIANCE_HISTORY

#include "SdfScreenProbeCommon.hlsl"
#include "SdfDiffuseReSTIR.hlsl"

float _SdfPixelHistoryMaxAge;

#if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
Texture2D<float> _SdfRestirPreviousVariance;
RWTexture2D<float> _SdfRestirVarianceHistoryOutput;
#endif

#if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
static const uint ScreenProbeNoHistory = 0u;
static const uint ScreenProbeHistoryAccepted = 1u;
static const uint ScreenProbeHistoryCoverageLimited = 2u;

float PackScreenProbePixelHistory(float age, float coverage, uint historyStatus)
{
    if (age == 0.0)
        return 0.0;

    // A normal, finite FP16 encoding preserves the payload through the history RT.
    // Bits after the exponent offset are coverage (8), age (5), and status (2).
    uint coverageBits = max(1u, uint(round(saturate(coverage) * 255.0)));
    uint ageBits = uint(round(clamp(age, 1.0, 32.0))) - 1u;
    return f16tof32(0x0400u + (historyStatus << 13u) + (ageBits << 8u) + coverageBits);
}

float2 UnpackScreenProbePixelHistory(float packed)
{
    uint bits = f32tof16(packed) - 0x0400u;
    return float2(1.0 + ((bits >> 8u) & 31u), (bits & 255u) * (1.0 / 255.0));
}
#endif

float3 SdfHistoryYCoCg(float3 rgb)
{
    return float3(dot(rgb, float3(0.25, 0.5, 0.25)), 0.5 * (rgb.r - rgb.b),
        0.5 * rgb.g - 0.25 * (rgb.r + rgb.b));
}

float3 SdfHistoryRgb(float3 color)
{
    return float3(color.x + color.y - color.z, color.x + color.z, color.x - color.y - color.z);
}

float SdfPixelHistoryFastUpdate(float foreground, float objectMotionPixels)
{
    return max(saturate(4.0 * foreground), 0.85 * smoothstep(0.75, 4.0, objectMotionPixels));
}

float3 RectifyPixelHistory(uint2 pixel, float3 position, float3 normal, float4 current,
    float3 history, inout float fastUpdate)
{
    int2 size = int2(_SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float4 material = _SdfDiffuseGBuffer0.Load(int3(pixel, 0));
    float3 center = SdfHistoryYCoCg(current.rgb);
    float3 sum = center;
    float3 sumSquared = center * center;
    float total = 1.0;
    const int2 offsets[8] = { int2(-1, -1), int2(0, -1), int2(1, -1), int2(-1, 0),
        int2(1, 0), int2(-1, 1), int2(0, 1), int2(1, 1) };
    [loop]
    for (uint i = 0u; i < 8u; ++i)
    {
        int2 tap = int2(pixel) + offsets[i];
        if (any(tap < 0) || any(tap >= size))
            continue;
        float4 lighting = _SdfDiffuseCurrentResolved.Load(int3(tap, 0));
        float coverage = min(abs(current.a), abs(lighting.a)) / max(abs(current.a), abs(lighting.a));
        if (coverage < 0.25 || (lighting.a < 0.0) != (current.a < 0.0))
            continue;
        float4 tapMaterial = _SdfDiffuseGBuffer0.Load(int3(tap, 0));
        float3 albedoDelta = tapMaterial.rgb - material.rgb;
        float3 tapPosition, tapNormal;
        if (tapMaterial.a != material.a || !LoadReceiver(uint2(tap), tapPosition, tapNormal))
            continue;
        float geometryWeight = ProbeGeometryWeight(tapPosition - position, normal, tapNormal, eyeDepth);
        if (geometryWeight < 0.15)
            continue;

        float weight = geometryWeight * coverage * exp2(-16.0 * dot(albedoDelta, albedoDelta));
        float3 color = SdfHistoryYCoCg(lighting.rgb);
        sum += weight * color;
        sumSquared += weight * color * color;
        total += weight;
    }

    float3 mean = sum / total;
    float3 deviation = sqrt(max(0.0, sumSquared / total - mean * mean));
    float3 sigmaScale = lerp(float3(2.5, 2.0, 2.0), float3(1.25, 1.25, 1.25), fastUpdate);
    float3 extent = max(deviation * sigmaScale, 0.01 + 0.04 * max(center.x, mean.x));
    float3 historyColor = SdfHistoryYCoCg(history);
    float3 delta = historyColor - mean;
    float3 normalized = abs(delta) / extent;
    float3 bounded = max(0.0, SdfHistoryRgb(mean + delta / max(1.0, Max3(normalized.x, normalized.y, normalized.z))));
    // A sparse sample can change color abruptly across the entire 3x3 neighborhood.
    // Shorten stable history only for a large, spatially coherent luminance change.
    float lumaScale = max(0.05, max(historyColor.x, mean.x));
    float lumaResidual = max(0.0, abs(delta.x) - extent.x) / lumaScale;
    float coherentChange = smoothstep(0.45, 0.8, lumaResidual)
        * (1.0 - smoothstep(0.05, 0.2, deviation.x / lumaScale));
    fastUpdate = max(fastUpdate, 0.25 * coherentChange);
    // Weak rectification on stable pixels lets the long window absorb sparse trace noise.
    return lerp(history, bounded, lerp(0.10, 1.0, fastUpdate));
}

#if !defined(VIVID_SDF_SCREEN_PROBE_TEMPORAL)
bool ReadPixelHistory(uint2 pixel, float3 position, float3 normal, bool openPbr,
    out float4 history, out float historyCoverage, out float foregroundWeight, out float historyVariance,
    out float objectMotionPixels)
{
    history = 0.0;
    historyCoverage = 0.0;
    foregroundWeight = 0.0;
    historyVariance = 0.0;
    objectMotionPixels = 0.0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z > previousClip.w || previousClip.z <= 0.0)
        return false;

    float4 packedMotion = float4(_SdfScreenMotion.Load(int3(pixel, 0)), 0.0, 0.0);
    if (PixelSetAsNoMotionVectors(packedMotion) || !all(isfinite(packedMotion.xy)))
        return false;
    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float2 previousUv = (previousPixel + 0.5) * _SdfDiffuseScreenSize.zw;
    if (any(previousUv < 0.0) || any(previousUv >= 1.0))
        return false;
    objectMotionPixels = length((previousUv - ScreenUv(previousClip)) * _SdfDiffuseScreenSize.xy);
    int2 low = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    int2 screenSize = int2(_SdfDiffuseScreenSize.xy);
    float expectedDepth = previousClip.z / previousClip.w;
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float thickness = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float totalWeight = 0.0;
    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 offset = int2(i & 1u, i >> 1u);
        int2 tap = low + offset;
        float2 weights = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = weights.x * weights.y;
        if (weight <= 0.0 || any(tap < 0) || any(tap >= screenSize))
            continue;

        uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
        float depth = f16tof32(packed & 65535u);
        float3 previousNormal = UnpackProbeNormal(float(packed >> 16u));
        bool normalMatches = dot(normal, previousNormal) >= 0.92;
        // Reversed Z. Even a mismatched normal may belong to a foreground occluder.
        bool nearer = depth > expectedDepth;
        if (depth <= 0.0 || (!normalMatches && !nearer))
            continue;

        float2 uv = (float2(tap) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 previousPosition = ComputeWorldSpacePosition(uv, depth, _SdfScreenPreviousInverseVP);
        float3 expectedPosition = ComputeWorldSpacePosition(uv, expectedDepth, _SdfScreenPreviousInverseVP);
        float depthError = distance(previousPosition, expectedPosition);
        float planeError = abs(dot(previousPosition - position, normal));
        if (nearer && depthError > thickness && planeError > thickness)
            foregroundWeight += weight;
        if (!normalMatches || depthError > thickness || planeError > thickness)
            continue;

        float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
        #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        if (abs(sample.a) > 0.0 && (sample.a < 0.0) == openPbr)
        {
            totalWeight += weight;
            #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                float2 ageAndCoverage = UnpackRestirPixelHistory(sample.a);
                float covered = weight * ageAndCoverage.y;
                history += covered * float4(sample.rgb, ageAndCoverage.x);
                historyCoverage += covered;
                historyVariance += covered * _SdfRestirPreviousVariance.Load(int3(tap, 0));
            #else
                sample.a = abs(sample.a);
                history += sample * weight;
            #endif
        }
        #else
        if (sample.a > 0.0)
        {
            float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
            float coveredWeight = weight * ageAndCoverage.y;
            history += float4(sample.rgb, ageAndCoverage.x) * coveredWeight;
            historyCoverage += coveredWeight;
            totalWeight += weight;
        }
        #endif
    }
    #if defined(VIVID_SDF_RESTIR_PIXEL_HISTORY) && !defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        history /= max(totalWeight, 1e-5);
    #else
        history /= max(historyCoverage, 1e-5);
        historyVariance /= max(historyCoverage, 1e-5);
        historyCoverage /= max(totalWeight, 1e-5);
    #endif
    return totalWeight >= 0.35 && foregroundWeight < 0.25;
}

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
void TemporalSdfRestirVariance(uint3 id : SV_DispatchThreadID)
#elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
void TemporalSdfRestirDiffuseGI(uint3 id : SV_DispatchThreadID)
#else
void TemporalSdfDiffuseGI(uint3 id : SV_DispatchThreadID)
#endif
{
    if (any(id.xy >= uint2(_SdfDiffuseScreenSize.xy)))
        return;

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    bool openPbr = result.a < 0.0;
    float3 position, normal;
    bool receiver = LoadReceiver(id.xy, position, normal);
    float age = 0.0;
    uint packed = f32tof16(_SdfDiffuseDepth.Load(int3(id.xy, 0)))
        | (receiver ? uint(PackProbeNormal(normal)) << 16u : 0u);
    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        float variance = 0.0;
    #endif
    #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        uint historyStatus = ScreenProbeNoHistory;
    #endif
    if (receiver)
    {
        if (abs(result.a) > 0.0)
        {
            age = 1.0;
            #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                variance = _SdfRestirVariance.Load(int3(id.xy, 0));
            #endif
            float4 history;
            float historyCoverage;
            float foregroundWeight;
            float historyVariance;
            float objectMotionPixels;
            if (_SdfDiffuseHasHistory != 0u
                && ReadPixelHistory(id.xy, position, normal, openPbr, history, historyCoverage, foregroundWeight, historyVariance,
                    objectMotionPixels))
            {
                float confidence = 1.0;
                float fastUpdate = SdfPixelHistoryFastUpdate(foregroundWeight, objectMotionPixels);
                #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY) || defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                    float coverageAgreement = min(abs(result.a), historyCoverage) / max(abs(result.a), historyCoverage);
                    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                        fastUpdate = max(fastUpdate, 1.0 - smoothstep(0.25, 0.65, coverageAgreement));
                    #else
                        confidence = coverageAgreement;
                    #endif
                #endif
                float3 rectified = RectifyPixelHistory(id.xy, position, normal, result, history.rgb, fastUpdate);
                confidence *= 1.0 - fastUpdate;
                age += min(history.a, _SdfPixelHistoryMaxAge - 1.0) * confidence;
                #if !defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    historyStatus = confidence < 0.8 ? ScreenProbeHistoryCoverageLimited : ScreenProbeHistoryAccepted;
                #endif
                float currentWeight = rcp(age);
                #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
                    // A shared bright path can give the current reservoirs low spatial variance.
                    // Also measure the change from the accepted temporal estimate in log luminance.
                    if (confidence > 0.0)
                    {
                        float coverage = abs(result.a);
                        float currentLuminance = RestirLuminance(result.rgb) * coverage;
                        float previousLuminance = RestirLuminance(history.rgb) * historyCoverage;
                        float change = log2(1.0 + currentLuminance) - log2(1.0 + previousLuminance);
                        float observedVariance = max(variance, min(change * change, 4.0));
                        float historyWeight = (1.0 - currentWeight) * confidence;
                        variance = lerp(observedVariance, historyVariance, historyWeight);
                        // Deferred lighting consumes covered radiance. Accumulate both factors together.
                        float3 covered = lerp(rectified * historyCoverage, result.rgb * coverage, currentWeight);
                        result.a = lerp(historyCoverage, coverage, currentWeight);
                        result.rgb = covered / max(result.a, 1e-5);
                    }
                #elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
                    result.rgb = lerp(rectified, result.rgb, currentWeight);
                #else
                    // Accumulate numerator and coverage together so an unstable
                    // coverage estimate cannot bypass temporal filtering.
                    float3 covered = lerp(rectified * historyCoverage, result.rgb * result.a, currentWeight);
                    result.a = lerp(historyCoverage, result.a, currentWeight);
                    result.rgb = covered / result.a;
                #endif
            }
        }
    }

    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        float historyAlpha = PackRestirPixelHistory(age, abs(result.a), openPbr);
    #elif defined(VIVID_SDF_RESTIR_PIXEL_HISTORY)
        float historyAlpha = openPbr ? -age : age;
    #else
        float historyAlpha = PackScreenProbePixelHistory(age, result.a, historyStatus);
    #endif
    _SdfDiffusePixelLightingOutput[id.xy] = float4(result.rgb, historyAlpha);
    _SdfDiffusePixelGeometryOutput[id.xy] = packed;
    #if defined(VIVID_SDF_RESTIR_VARIANCE_HISTORY)
        _SdfRestirVarianceHistoryOutput[id.xy] = variance;
    #endif
    if (_SdfRestirDense == 0u)
        _SdfDiffuseOutput[id.xy] = result;
}
#else
struct ScreenProbeTemporalHistory
{
    float3 coveredLighting;
    float coverage;
    float age;
    float footprint;
    float foreground;
    float objectMotionPixels;
};

bool ReadScreenProbeTemporalHistory(uint2 pixel, float3 position, float3 normal, out ScreenProbeTemporalHistory history)
{
    history = (ScreenProbeTemporalHistory)0;
    float4 previousClip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (previousClip.w <= 0.0 || previousClip.z <= 0.0 || previousClip.z > previousClip.w)
        return false;

    float4 packedMotion = float4(_SdfScreenMotion.Load(int3(pixel, 0)), 0.0, 0.0);
    if (PixelSetAsNoMotionVectors(packedMotion) || !all(isfinite(packedMotion.xy)))
        return false;

    float2 motion;
    DecodeMotionVector(packedMotion, motion);
    float2 previousPixel = float2(pixel) + (_SdfScreenJitterDelta - motion) * _SdfDiffuseScreenSize.xy;
    float2 previousUv = (previousPixel + 0.5) * _SdfDiffuseScreenSize.zw;
    if (any(previousUv < 0.0) || any(previousUv >= 1.0))
        return false;

    int2 lower = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    int2 size = int2(_SdfDiffuseScreenSize.xy);
    float expectedDepth = previousClip.z / previousClip.w;
    // Motion provides the previous XY. Use the projected depth as a
    // conservative anchor when the motion buffer has no depth velocity.
    float3 expectedReceiver = ComputeWorldSpacePosition(previousUv, expectedDepth, _SdfScreenPreviousInverseVP);
    history.objectMotionPixels = length((previousUv - ScreenUv(previousClip)) * _SdfDiffuseScreenSize.xy);
    float eyeDepth = dot(float4(position, 1.0), _SdfProbeCameraForward);
    float depthTolerance = clamp(0.008 * eyeDepth, 0.025, 0.12);
    float planeTolerance = clamp(0.006 * eyeDepth, 0.02, 0.10);
    float geometryWeight = 0.0;
    float coveredWeight = 0.0;

    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 offset = int2(i & 1u, i >> 1u);
        int2 tap = lower + offset;
        float2 bilinear = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = bilinear.x * bilinear.y;
        if (weight <= 0.0 || any(tap < 0) || any(tap >= size))
            continue;

        uint packed = _SdfDiffusePreviousPixelGeometry.Load(int3(tap, 0));
        float depth = f16tof32(packed & 65535u);
        if (depth <= 0.0)
            continue;

        float2 tapUv = (float2(tap) + 0.5) * _SdfDiffuseScreenSize.zw;
        float3 samplePosition = ComputeWorldSpacePosition(tapUv, depth, _SdfScreenPreviousInverseVP);
        float3 expectedTap = ComputeWorldSpacePosition(tapUv, expectedDepth, _SdfScreenPreviousInverseVP);
        bool depthMismatch = distance(samplePosition, expectedTap) > depthTolerance;
        bool planeMismatch = abs(dot(samplePosition - expectedReceiver, normal)) > planeTolerance;
        if (depth > expectedDepth && depthMismatch && planeMismatch)
            history.foreground += weight;
        if (depthMismatch || planeMismatch || dot(normal, UnpackProbeNormal(float(packed >> 16u))) < 0.92)
            continue;

        geometryWeight += weight;
        float4 sample = _SdfDiffusePreviousPixelLighting.Load(int3(tap, 0));
        if (sample.a <= 0.0)
            continue;

        float2 ageAndCoverage = UnpackScreenProbePixelHistory(sample.a);
        float covered = weight * ageAndCoverage.y;
        history.coveredLighting += covered * sample.rgb;
        history.age += covered * ageAndCoverage.x;
        history.footprint += weight;
        coveredWeight += covered;
    }
    if (history.footprint < 0.35 || history.foreground >= 0.25)
        return false;

    history.coveredLighting /= geometryWeight;
    history.coverage = coveredWeight / geometryWeight;
    history.age /= max(coveredWeight, 1e-5);
    return true;
}

[numthreads(8, 8, 1)]
void ScreenProbeTemporalReprojectionCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= uint2(_SdfDiffuseScreenSize.xy)))
        return;

    float4 result = _SdfDiffuseCurrentResolved.Load(int3(id.xy, 0));
    float depth = _SdfDiffuseDepth.Load(int3(id.xy, 0));
    float3 position, normal;
    bool receiver = LoadReceiver(id.xy, position, normal);
    // Depth from an unresolved or unlit foreground still occludes history.
    uint geometry = f32tof16(depth) | (receiver ? uint(PackProbeNormal(normal)) << 16u : 0u);
    float age = receiver && result.a > 0.0 ? 1.0 : 0.0;
    uint historyStatus = ScreenProbeNoHistory;
    ScreenProbeTemporalHistory history;
    if (age > 0.0 && _SdfDiffuseHasHistory != 0u && ReadScreenProbeTemporalHistory(id.xy, position, normal, history))
    {
        float coverageAgreement = min(result.a, history.coverage) / max(result.a, history.coverage);
        if (coverageAgreement >= 0.35)
        {
            float3 historyLighting = history.coveredLighting / history.coverage;
            float fastUpdate = SdfPixelHistoryFastUpdate(history.foreground, history.objectMotionPixels);
            float3 rectified = RectifyPixelHistory(id.xy, position, normal, result, historyLighting, fastUpdate);
            age += min(history.age, _SdfPixelHistoryMaxAge - 1.0) * coverageAgreement * (1.0 - fastUpdate);
            historyStatus = fastUpdate > 0.2 || coverageAgreement < 0.8
                ? ScreenProbeHistoryCoverageLimited : ScreenProbeHistoryAccepted;

            float currentWeight = rcp(age);
            float3 covered = lerp(rectified * history.coverage, result.rgb * result.a, currentWeight);
            result.a = lerp(history.coverage, result.a, currentWeight);
            result.rgb = min(covered / max(result.a, 1e-5), 65000.0);
        }
    }

    _SdfDiffusePixelGeometryOutput[id.xy] = geometry;
    _SdfDiffusePixelLightingOutput[id.xy] = float4(result.rgb, PackScreenProbePixelHistory(age, result.a, historyStatus));
    _SdfDiffuseOutput[id.xy] = result;
}
#endif
