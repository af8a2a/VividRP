#if defined(VIVID_BUILD_MESH_SDF_CARD_GRID)
RWStructuredBuffer<uint> _MeshSdfCardGridWrite;
float4x4 _MeshSdfCardGridInverseProjection;
float4x4 _MeshSdfCardGridInverseView;

[numthreads(4, 4, 2)]
void BuildMeshSdfCardGridCS(uint3 cell : SV_DispatchThreadID)
{
    if (any(cell >= MeshSdfCardGridSize))
        return;

    uint offset = MeshSdfCardGridOffset(cell);
    float4 parameters = _MeshSdfCardGridParameters;
    if (!(parameters.y > 0.0))
    {
        _MeshSdfCardGridWrite[offset] = MeshSdfCardGridUnavailable;
        return;
    }

    float3 boundsMin = FLT_MAX;
    float3 boundsMax = -FLT_MAX;
    float4 clipDepthAxis = mul(_MeshSdfCardGridInverseProjection, float4(0.0, 0.0, 1.0, 0.0));
    [unroll]
    for (uint corner = 0u; corner < 8u; ++corner)
    {
        uint3 boundary = cell + uint3(corner & 1u, (corner >> 1u) & 1u, corner >> 2u);
        float3 fraction = float3(boundary) / float3(MeshSdfCardGridSize);
        float depth = exp2(parameters.x + fraction.z * parameters.y);
        float4 clipBase = mul(_MeshSdfCardGridInverseProjection, float4(2.0 * fraction.xy - 1.0, 0.0, 1.0));
        // Intersect the unprojected clip line with view-space z = -depth in homogeneous coordinates.
        float clipW = clipDepthAxis.z + depth * clipDepthAxis.w;
        float4 cornerVS = clipW * clipBase - (clipBase.z + depth * clipBase.w) * clipDepthAxis;
        float3 positionWS = mul(_MeshSdfCardGridInverseView, float4(cornerVS.xyz / cornerVS.w, 1.0)).xyz;
        if (!(clipW * cornerVS.w > 0.0) || !all(isfinite(positionWS)))
        {
            _MeshSdfCardGridWrite[offset] = MeshSdfCardGridUnavailable;
            return;
        }
        boundsMin = min(boundsMin, positionWS);
        boundsMax = max(boundsMax, positionWS);
    }

    // Include all geometry within reach of a biased detail ray, even outside the camera frustum.
    float3 padding = parameters.z + 0.001 + 1e-6 * max(abs(boundsMin), abs(boundsMax));
    boundsMin -= padding;
    boundsMax += padding;
    uint count = 0u;
    uint nodeIndex = 0u;
    [loop]
    while (nodeIndex < _MeshSdfNodeCount)
    {
        VividMeshSdfNode node = _MeshSdfNodes[nodeIndex];
        if ((node.layerMask & _SdfDiffuseLayerMask) == 0u
            || any(node.boundsMax < boundsMin) || any(node.boundsMin > boundsMax))
        {
            nodeIndex = node.escapeIndex;
            continue;
        }
        if (node.leafCount != 0u)
        {
            if (count == MeshSdfCardGridCapacity)
            {
                _MeshSdfCardGridWrite[offset] = MeshSdfCardGridUnavailable;
                return;
            }
            _MeshSdfCardGridWrite[offset + 1u + count] = nodeIndex;
            ++count;
        }
        ++nodeIndex;
    }
    _MeshSdfCardGridWrite[offset] = count;
}
#endif

uint EncodeProbeRayDistance(float HitDistance, bool bHit, bool bMoving, bool bReachedRadianceCache)
{
    HitDistance = max(HitDistance, 0.0f);

    uint EncodedRay = 0;

    // Encode extra data in sign bit and in the least important bits of mantissa
    EncodedRay = asuint(HitDistance) & 0x7FFFFFFC;
    EncodedRay |= bHit ? (1 << 0) : 0;
    EncodedRay |= bMoving ? (1 << 1) : 0;
    EncodedRay |= bReachedRadianceCache ? (1 << 31) : 0;

    return EncodedRay;
}

struct FProbeRayDistance
{
    float HitDistance;
    bool bHit;
    bool bMoving;
    bool bReachedRadianceCache;
};

FProbeRayDistance DecodeProbeRayDistance(uint Encoded)
{
    FProbeRayDistance ProbeRayDistance;
    ProbeRayDistance.bHit = (Encoded & (1 << 0)) != 0;
    ProbeRayDistance.bMoving = (Encoded & (1 << 1)) != 0;
    ProbeRayDistance.bReachedRadianceCache = (Encoded & (1 << 31)) != 0;
    ProbeRayDistance.HitDistance = asfloat(Encoded & 0x7FFFFFFC);
    return ProbeRayDistance;
}

uint _SdfLumenScreenTrace;
uint _SdfScreenPreviousRadianceValid;
uint _SdfMotionFrame;
RWTexture2D<float> _SdfProbeMovingOutput;
static const uint ScreenMovingBit = 0x10000000u;

float ScreenObjectSpeed(uint2 pixel, float3 position)
{
    float4 packed = _SdfScreenMotion.Load(int3(pixel, 0));
    if (PixelSetAsNoMotionVectors(packed) || !all(isfinite(packed.xy)))
        return 0.0;
    float4 clip = mul(_SdfDiffusePreviousVP, float4(position, 1.0));
    if (clip.w <= 0.0)
        return 0.0;
    float2 motion;
    DecodeMotionVector(packed, motion);
    float2 uv = (float2(pixel) + 0.5) * _SdfDiffuseScreenSize.zw - motion + _SdfScreenJitterDelta;
    float depth = VividPreviousDeviceZ(packed, _SdfDiffuseDepth.Load(int3(pixel, 0)), clip.z / clip.w);
    return length(ComputeWorldSpacePosition(uv, depth, _SdfScreenPreviousInverseVP) - position);
}

float RelativeHitMotion(float speed, float hitSpeed, float3 position)
{
    float depth = max(dot(float4(position, 1.0), _SdfProbeCameraForward), 1.0);
    return abs(speed - hitSpeed) > 0.005 * depth ? 1.0 : 0.0;
}

#if !defined(VIVID_SDF_SCREEN_ONLY)
float InstanceSpeed(uint index, float3 position)
{
    if (index == 0xffffffffu)
        return 0.0;
    VividMeshSdfInstance instance = _MeshSdfInstances[index];
    if (instance.motionFrame != _SdfMotionFrame)
        return 0.0;
    float4 p = float4(position, 1.0);
    float4 local = float4(dot(instance.worldToLocal0, p), dot(instance.worldToLocal1, p), dot(instance.worldToLocal2, p), 1.0);
    float3 previous = float3(dot(instance.previousLocalToWorld0, local), dot(instance.previousLocalToWorld1, local),
        dot(instance.previousLocalToWorld2, local));
    return distance(position, previous);
}
#endif

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceReceiverDiffuseScreenRays(uint3 id : SV_DispatchThreadID)
#else
void TraceDiffuseScreenRays(uint3 id : SV_DispatchThreadID)
#endif
{
    uint2 tile = id.xy;
    uint2 screenSize = uint2(_SdfDiffuseScreenSize.xy);
    if (any(tile >= uint2(ProbeGridSize(screenSize).x, ProbeAtlasHeight(ProbeGridSize(screenSize)))))
        return;

    float3 position = 0.0, normal = 0.0;
    bool receiver = LoadProbeReceiver(tile, screenSize, position, normal);
    if (!receiver)
    {
        position = 0.0;
        normal = float3(0.0, 1.0, 0.0);
    }
    float3x3 basis = DiffuseProbeFrame(receiver ? normal : float3(0.0, 1.0, 0.0));
    float3 origin = position + normal * _SdfDiffuseRayBias;
    uint level = receiver ? GetWorldCoverage(origin) : WorldClipmaps;
    float screenLimit = level < WorldClipmaps ? min(_SdfDiffuseMaxDistance, WorldNearDistance(level)) : _SdfDiffuseMaxDistance;
    uint2 probePixel;
    float probeSpeed = 0.0;
    if (_SdfDirectionalCacheEnabled != 0u && receiver && LoadProbeReceiverPixel(tile, screenSize, probePixel))
        probeSpeed = ScreenObjectSpeed(probePixel, position);
    uint seed = ProbeSeed(tile);
    uint rayCount = ProbeRayCount();
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        float3 radiance = 0.0;
        float encodedHit = 0.0;
        ScreenRayHit hit;
        uint bin;
        float inverseRelativePdf;
        float3 rayDirection = SampleDiffuseProbeRay(tile, ray, seed, basis, bin, inverseRelativePdf);
        if (receiver && TraceScreenGeometry(origin, rayDirection,
            screenLimit, hit))
        {
            encodedHit = -hit.distance;
            bool compatible = true;
            if (_SdfRestirDense != 0u)
            {
                float3 rayToHit = hit.position - origin;
                float3 directionToHit = SafeNormalize(rayToHit);
                compatible = length(rayToHit) <= _SdfDiffuseMaxDistance
                    && dot(normal, directionToHit) > 0.02;
            }
            if (compatible && _SdfScreenPreviousRadianceValid != 0u
                && ReadScreenRadiance(hit.pixel, hit.position, hit.normal, rayDirection, hit.thickness, radiance))
            {
                uint address = ScreenHitPixelBase + hit.pixel.y * screenSize.x + hit.pixel.x;
                if (_SdfDirectionalCacheEnabled != 0u && RelativeHitMotion(probeSpeed, ScreenObjectSpeed(hit.pixel, hit.position), position) > 0.0)
                    address += ScreenMovingBit;
                encodedHit = _SdfRestirDense != 0u || _SdfScreenCardLighting != 0u || _SdfScreenMaterialLookup != 0u || _SdfDirectionalCacheEnabled != 0u
                    ? asfloat(address) : hit.distance;
            }
        }
        // A negative distance retains the geometric hit of a rejected screen candidate.
        _SdfScreenRaysOutput[ProbeTraceAddress(tile, ray)] = float4(encodedHit > 0.0 ? radiance : 0.0, encodedHit);
    }
}

void StoreDistantProbeDirection(uint2 tile, float3 direction)
{
    if (_SdfRestirDense != 0u && (_SdfNearOcclusion.z > 0.0 || _SdfRestirOpenPbrDiffuse != 0u))
        _SdfDiffuseProbes[DistantProbeDirectionAddress(tile)] = float4(direction, any(direction != 0.0) ? 1.0 : 0.0);
}

void StoreDirectionalRay(uint2 tile, uint ray, uint bin, float inverseRelativePdf, uint state,
    float distance, float3 radiance, float3 direction, float3 hitNormal, uint hitInstance)
{
    uint2 address = DirectionalAddress(tile, ray);
    uint source = state & 7u;
    float hit = 0.0;
    if (source == RayScreenHit || source == RaySdfHit || (state & RayFarCache) != 0u
        || (_SdfScreenProbeFullSphere != 0u && (source == RayBackface || source == RayMissingSurface)))
        hit = clamp(distance, 1e-3, 65000.0);
    else if (source == RaySkyVisible || (_SdfScreenProbeFullSphere != 0u && source != RayOffscreenOnlyRejected))
        hit = -1.0;
    // This path writes traces where the legacy gather writes its integrated probe.
    _SdfDiffuseProbes[address] = float4(clamp(radiance, 0.0, 65000.0), hit);
    _SdfDiffuseProbes[address + DirectionalMetadataOffset(DirectionalGrid())] =
        float4(bin, inverseRelativePdf, VividEncodeSurfaceSummaryNormal(direction));
    _SdfDiffuseProbes[address + 2u * DirectionalMetadataOffset(DirectionalGrid())] = hit > 0.0
        ? PackDirectionalHitPlane(hitNormal, hitInstance) : 0.0;
}

void StoreTraceSample(uint2 tile, uint ray, uint state, float distance, float3 radiance,
    float3 direction = 0.0, uint bin = 0u, float inverseRelativePdf = 1.0, float3 hitNormal = 0.0,
    uint hitInstance = 0xffffffffu)
{
    if (_SdfDirectionalCacheEnabled != 0u && state != 0u)
        StoreDirectionalRay(tile, ray, bin, inverseRelativePdf, state, distance, radiance, direction, hitNormal, hitInstance);
    uint2 address = ProbeTraceAddress(tile, ray);
    if (_SdfDiffuseHitFilterEnabled != 0u)
    {
        uint packed = 0u;
        uint hitState = state & 7u;
        if (hitState == RayScreenHit || (hitState == RaySdfHit && (state & RayFarSegment) == 0u))
        {
            // Numeric float32 stores this 24-bit integer exactly. Zero marks an invalid hit.
            uint2 oct = uint2(round(saturate(VividEncodeSurfaceSummaryNormal(direction)) * 63.0));
            uint depth = max(1u, uint(round(saturate(distance / _SdfDiffuseMaxDistance) * 4095.0)));
            packed = (depth << 12u) | (oct.y << 6u) | oct.x;
        }
        _SdfDiffuseHitSamples[address] = float(packed);
    }
    if (_SdfDiffuseRecordRayDiagnostics != 0u)
    {
        // Decode W as floor(W) and frac(W) * 2 * the corresponding trace range.
        float range = (state & (RayFarCache | RayFarSegment)) != 0u ? _SdfFarTraceDistance : _SdfDiffuseMaxDistance;
        float encoded = float(state) + 0.5 * saturate(distance / range);
        _SdfDiffuseRayDiagnostics[address] = float4(radiance, encoded);
    }
}

void StoreFirstHitDiagnostic(uint2 tile, uint ray, float3 origin, float3 direction, VividMeshSdfHit hit,
    uint rejection, bool advancedReceiver = false)
{
    uint2 pixel = ProbeTraceAddress(tile, ray) * uint2(1u, 3u);
    float4 entity = 0.0;
    float4 firstHit = 0.0;
    #if !defined(VIVID_SDF_SCREEN_ONLY)
        if (hit.instanceIndex != 0xffffffffu)
        {
            VividMeshSdfInstance instance = _MeshSdfInstances[hit.instanceIndex];
            VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
            float4 p = float4(origin, 1.0);
            float3 grid = float3(dot(instance.worldToLocal0, p), dot(instance.worldToLocal1, p),
                dot(instance.worldToLocal2, p)) - field.originAndVoxelSize.xyz;
            float3 extent = float3(field.dimensions - 1u) * field.originAndVoxelSize.w;
            float signedVoxels = any(grid < 0.0) || any(grid > extent) ? FLT_MAX
                : VividMeshSdfSample(field, grid) / field.originAndVoxelSize.w;
            // Keep every 16-bit word of the entity ID exact in the float readback.
            entity = float4(hit.entityId.x & 65535u, hit.entityId.x >> 16u,
                hit.entityId.y & 65535u, hit.entityId.y >> 16u);
            firstHit = float4(PackProbeNormal(hit.normalWS), hit.signMode, rejection, signedVoxels);
        }
    #endif
    _SdfDiffuseFirstHitDiagnostics[pixel] = entity;
    _SdfDiffuseFirstHitDiagnostics[pixel + uint2(0u, 1u)] = firstHit;
    _SdfDiffuseFirstHitDiagnostics[pixel + uint2(0u, 2u)] = float4(direction, advancedReceiver ? 1.0 : 0.0);
}

#if !defined(VIVID_SDF_SCREEN_ONLY)
#if defined(VIVID_SDF_SURFACE_CACHE)
float ProbeSdfStart(float screenDistance)
{
    return _SdfLumenScreenTrace != 0u && _SdfDiffuseUseScreenRays != 0u
        ? max(0.0001f, screenDistance - 0.10f) : 0.0f;
}

bool TraceProbeMeshDetail(float3 origin, float3 direction, VividMeshSdfReceiver receiver,
    float screenStart, float detailEnd, uint2 gridRange, out VividMeshSdfHit hit, out bool advancedReceiver, out bool incomplete)
{
    hit = (VividMeshSdfHit)0;
    advancedReceiver = incomplete = false;
    if (!(screenStart < detailEnd)) return false;
    return VividTraceMeshSdfSceneNodes(origin, direction, screenStart, detailEnd,
        _SdfDiffuseLayerMask, 0.0f, false, receiver, gridRange, hit, advancedReceiver, incomplete);
}

bool TraceProbeGlobal(float3 origin, float3 direction, float start, float end, inout VividMeshSdfHit hit)
{
    VividGlobalSdfHit global;
    if (start >= end || !VividTraceGlobalSdf(origin, direction, start, end, global)) return false;
    hit.distance = global.distance;
    hit.lightingDistanceOffset = 0.5f * global.expandSurfaceAmount;
    hit.normalWS = global.normalWS;
    // The card gather needs the distance clipmap index before it resolves an owner.
    hit.instanceIndex = 0xffffffffu;
    hit.signMode = global.level;
    return true;
}
#endif

bool TraceSdfGatherHit(float3 origin, float3 direction, VividMeshSdfReceiver receiver, float screenDistance,
    uint screenState, float nearLimit, bool stopAtCache, out VividMeshSdfHit hit, out bool advancedReceiver, out bool incomplete,
    out uint traceState, out float tracedDistance)
{
    traceState = 0u;
    advancedReceiver = false;
    #if defined(VIVID_SDF_SURFACE_CACHE)
    if (_SdfUseGlobalClipmap == 2u && _SdfScreenProbeFullSphere != 0u)
    {
        float detailEnd = min(nearLimit, _SdfMeshDetailDistance);
        tracedDistance = detailEnd;
        float screenStart = ProbeSdfStart(screenDistance);
        bool detailHit = TraceProbeMeshDetail(origin, direction, receiver, screenStart, detailEnd, 0u,
            hit, advancedReceiver, incomplete);
        if (detailHit || incomplete || detailEnd >= nearLimit) return detailHit;
        tracedDistance = nearLimit;
        if (!TraceProbeGlobal(origin, direction, max(screenStart, detailEnd), nearLimit, hit)) return false;
        traceState = RayGlobalCandidate;
        return true;
    }
    #endif
    bool segmented = _SdfMeshDetailDistance > 0.0;
    float overlap = max(0.04, 2.0 * _SdfDiffuseRayBias);
    float middleEnd = segmented ? min(nearLimit, screenDistance + overlap) : nearLimit;
    float start = 0.0;
    float end = segmented ? min(_SdfMeshDetailDistance, middleEnd) : middleEnd;
    const uint detailStage = 0u, candidateStage = 1u, middleStage = 2u, farStage = 3u;
    uint stage = detailStage;
    [loop]
    for (uint segment = 0u; segment <= farStage; ++segment)
    {
        tracedDistance = end;
        bool advanced;
        bool traced = VividTraceMeshSdfSceneInternal(origin, direction, start, end,
            _SdfDiffuseLayerMask, 0.0, false, receiver, hit, advanced, incomplete);
        advancedReceiver = advancedReceiver || advanced;
        if (stage == farStage && (!traced || hit.distance > middleEnd || incomplete))
            traceState |= RayFarSegment;
        if (traced || incomplete || !segmented || stage == farStage)
            return traced;

        if (stage == detailStage && end < middleEnd)
        {
            float detailEnd = end;
            start = max(0.0, detailEnd - overlap);
            end = middleEnd;
            stage = middleStage;
            VividGlobalSdfHit hint;
            [branch]
            if (_SdfUseGlobalClipmap != 0u && VividTraceGlobalSdf(origin, direction, detailEnd, middleEnd, hint, false))
            {
                end = min(middleEnd, hint.distance + 2.0 * _GlobalSdfLevels[hint.level].w);
                traceState |= RayGlobalCandidate;
                stage = candidateStage;
            }
        }
        else if (stage == candidateStage && end < middleEnd)
        {
            // The clipmap is only a hint. Trace the unproven suffix as well.
            start = max(start, end - overlap);
            end = middleEnd;
            stage = middleStage;
        }
        else
        {
            if (stopAtCache || _SdfFarTraceDistance <= middleEnd || screenState != 0u)
                return false;
            // Reconstruct at the first hit on the continuous receiver ray.
            start = 0.0;
            end = _SdfFarTraceDistance;
            stage = farStage;
        }
    }
    return false;
}
#endif

struct ProbeTraceAccumulation
{
    uint screenHits, skyHits, farHits, cachedSunHits;
    uint valid;
    float validWeight;
    float3 sum;
    float3x3 moments;
    float movingRays;
    float3 distant;
    float3 distantDirection;
    RestirReservoir reservoir;
    float reservoirWeightSum;
};

struct ProbeRaySample
{
    uint state;
    float distance;
    float3 radiance;
    float3 hitNormal;
    uint hitInstance;
    float3 direction;
    uint bin;
    float inverseRelativePdf;
};

#if !defined(VIVID_SDF_SCREEN_ONLY)
static const uint TraceStageLegacy = 0u;
static const uint TraceStageMesh = 1u;
static const uint TraceStageGlobal = 2u;

ProbeRaySample ResolveProbeRay(uint2 tile, uint ray, uint seed, float3 position, float3 normal, float3 origin,
    float receiverSpeed, VividMeshSdfReceiver receiver, bool useSky, uint screenState, uint traceState,
    VividMeshSdfHit hit, bool advancedReceiver, bool incomplete, bool traced, float tracedDistance,
    float3 worldRadiance, float worldDistance, uint traceStage, ProbeRaySample result, inout ProbeTraceAccumulation accum)
{
    float3 direction = result.direction;
    float inverseRelativePdf = result.inverseRelativePdf;
    uint rayState = screenState | traceState;
    if (!traced || incomplete)
    {
        uint missState = RayMiss;
        float3 radiance = 0.0;
        float farDistance = 0.0;
        #if defined(VIVID_SDF_SURFACE_CACHE)
            [branch]
            if (worldDistance > 0.0)
            {
                radiance = worldRadiance;
                farDistance = worldDistance;
                missState |= RayFarCache;
                accum.farHits++;
            }
            else if (traceStage == TraceStageLegacy && _SdfScreenProbeFullSphere == 0u && _SdfMeshDetailDistance <= 0.0 && _SdfFarTraceDistance > 0.0 && !incomplete && screenState == 0u)
            {
                if (TryLoadFarRadiance(origin, direction, radiance, farDistance))
                {
                    missState |= RayFarCache;
                    accum.farHits++;
                }
            }
        #endif
        [branch]
        if (missState == RayMiss && useSky)
        {
            float skyStart = _SdfMeshDetailDistance > 0.0 && (traceState & RayFarSegment) == 0u ? 0.0 : tracedDistance;
            missState = ResolveSdfSkyMiss(origin, direction, skyStart, incomplete, screenState, receiver);
        }
        if (missState == RaySkyVisible)
        {
            radiance = clamp(SampleSkyTexture(direction, 0.0), 0.0, 65000.0);
            accum.skyHits++;
        }
        if (missState == RaySkyVisible || (missState & RayFarCache) != 0u)
        {
            accum.sum += inverseRelativePdf * radiance;
            accum.distant += radiance;
            accum.distantDirection = direction;
            if (traceStage == TraceStageLegacy && _SdfDiffuseDirectionalProbes != 0u && _SdfDirectionalCacheEnabled == 0u)
                accum.moments += ProbeSampleMoments(radiance, direction, normal);
            accum.valid++;
            accum.validWeight += inverseRelativePdf;
        }
        result.state = rayState | missState | (incomplete ? RayTraceIncomplete : 0u);
        result.distance = farDistance;
        result.radiance = radiance;
        if (traceStage == TraceStageLegacy && _SdfDiffuseRecordFirstHitDiagnostics != 0u)
            StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, 0u, advancedReceiver);
        return result;
    }

    #if defined(VIVID_SDF_SURFACE_CACHE)
    if (traceStage == TraceStageGlobal || (traceStage == TraceStageLegacy
        && _SdfUseGlobalClipmap == 2u && (traceState & RayGlobalCandidate) != 0u && hit.instanceIndex == 0xffffffffu))
    {
        float3 endpoint = origin + direction * (hit.distance + hit.lightingDistanceOffset);
        GridCardLighting lighting = EvaluateGlobalDistanceFieldHit(endpoint, hit.normalWS, direction, hit.signMode);
        result.distance = hit.distance;
        result.hitNormal = hit.normalWS;
        result.hitInstance = lighting.instance;
        result.radiance = lighting.sum;
        // EvaluateGlobalDistanceFieldHit always writes an opaque hit distance.
        // No contributing Mesh Card means covered black for this direction.
        result.state = rayState | RaySdfHit;
        accum.valid++;
        accum.validWeight += inverseRelativePdf;
        accum.sum += inverseRelativePdf * lighting.sum;
        if (_SdfDirectionalCacheEnabled != 0u && lighting.instance != 0xffffffffu)
            accum.movingRays += inverseRelativePdf * RelativeHitMotion(receiverSpeed, InstanceSpeed(lighting.instance, endpoint), position);
        if (traceStage == TraceStageLegacy && _SdfDiffuseDirectionalProbes != 0u && _SdfDirectionalCacheEnabled == 0u)
            accum.moments += ProbeSampleMoments(lighting.sum, direction, normal);
        if (traceStage == TraceStageLegacy && _SdfDiffuseRecordFirstHitDiagnostics != 0u)
        {
            hit.instanceIndex = lighting.instance;
            if (lighting.total > 0.0f)
            {
                VividMeshSdfInstance inst = _MeshSdfInstances[lighting.instance];
                hit.entityId = inst.entityId;
                hit.signMode = _MeshSdfFields[inst.fieldIndex].signMode;
            }
            StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, lighting.total > 0.0f ? 0u : 6u, advancedReceiver);
        }
        return result;
    }
    #endif
    DiffuseSurface surface = _SdfDiffuseSurfaces[hit.instanceIndex];
    bool backface = dot(hit.normalWS, direction) >= 0.0;
    bool insideShellExit = false;
    // A biased receiver can start inside a neighboring artificial shell.
    // Only that exit is reliable here; retain rejection for outside starts.
    if (backface && hit.signMode == 2u && surface.albedoAndValid.a != 0.0)
    {
        VividMeshSdfInstance instance = _MeshSdfInstances[hit.instanceIndex];
        VividMeshSdfField field = _MeshSdfFields[instance.fieldIndex];
        float4 shellOrigin = float4(origin, 1.0);
        float3 grid = float3(dot(instance.worldToLocal0, shellOrigin), dot(instance.worldToLocal1, shellOrigin),
            dot(instance.worldToLocal2, shellOrigin)) - field.originAndVoxelSize.xyz;
        float3 extent = float3(field.dimensions - 1u) * field.originAndVoxelSize.w;
        if (all(grid >= 0.0) && all(grid <= extent))
            insideShellExit = VividMeshSdfSample(field, grid) <= 0.0;
    }
    // Recover the captured material normal below: a culled side is covered black.
    if (surface.albedoAndValid.a == 0.0 || (backface && !insideShellExit))
    {
        result.state = rayState | (backface ? RayBackface : RayMissingSurface);
        result.distance = hit.distance;
        if (traceStage == TraceStageLegacy && _SdfDiffuseRecordFirstHitDiagnostics != 0u)
            StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, backface ? 0u : 6u, advancedReceiver);
        return result;
    }
    float3 hitPosition = origin + hit.distance * direction;
    float3 lightingNormal = hit.normalWS;
    float3 originalNormal = lightingNormal;
    #if defined(VIVID_SDF_SURFACE_CACHE)
        uint3 cardTexel;
        float surfaceError;
        uint rejection;
        if (!VividTrySampleSdfSurface(hit, hitPosition, surface, lightingNormal, originalNormal, cardTexel, surfaceError,
            traceStage == TraceStageLegacy && _SdfDiffuseRecordFirstHitDiagnostics != 0u, rejection))
        {
            result.state = rayState | RayMissingSurface;
            result.distance = hit.distance;
            if (traceStage == TraceStageLegacy && _SdfDiffuseRecordFirstHitDiagnostics != 0u)
                StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, rejection, advancedReceiver);
            return result;
        }
    #endif
    if (traceStage == TraceStageLegacy && _SdfDiffuseRecordFirstHitDiagnostics != 0u)
        StoreFirstHitDiagnostic(tile, ray, origin, direction, hit, 0u, advancedReceiver);
    accum.valid++;
    accum.validWeight += inverseRelativePdf;
    if (traceStage == TraceStageLegacy && _SdfDiffuseOffscreenOnly != 0u)
    {
        float4 hitClip = mul(_SdfDiffuseVP, float4(hitPosition, 1.0));
        if (hitClip.w > 0.0 && all(abs(hitClip.xy) <= hitClip.w))
        {
            result.state = screenState | RayOffscreenOnlyRejected;
            result.distance = hit.distance;
            result.direction = 0.0;
            result.bin = 0u;
            result.inverseRelativePdf = 1.0;
            return result;
        }
    }
    bool farSegment = traceStage == TraceStageLegacy && (traceState & RayFarSegment) != 0u;
    float cacheCoverage = 0.0;
    float3 cacheLighting = 0.0;
    #if defined(VIVID_SDF_SURFACE_CACHE)
        if (farSegment && _SdfScreenProbeFullSphere == 0u)
            cacheLighting = ReconstructFarRadiance(origin + _SdfDiffuseMaxDistance * direction, hitPosition, hit, cacheCoverage);
    #endif
    float3 radiance = cacheLighting;
    bool visibleMaterialSide = VividSdfMaterialSideVisible(surface.emission.w, originalNormal, -direction);
    if (!visibleMaterialSide)
    {
        radiance = 0.0;
        rayState |= RayMaterialBackface;
    }
    else if (cacheCoverage < 1.0)
    {
        #if defined(VIVID_SDF_SURFACE_CACHE)
            float3 exactLighting;
            if (!TryLoadCardFinalLighting(surface, cardTexel, exactLighting))
            {
                float cachedVisibility = -1.0;
                #if defined(VIVID_SDF_CACHED_SUN)
                    if (!farSegment)
                    {
                        cachedVisibility = LoadCachedSunVisibility(surface, cardTexel, surfaceError, hit, lightingNormal);
                        accum.cachedSunHits += cachedVisibility >= 0.0 ? 1u : 0u;
                    }
                #endif
                exactLighting = EvaluateUncachedSdfSurfaceRadiance(hitPosition, lightingNormal, hit, surface, cardTexel, cachedVisibility);
            }
        #else
            float3 exactLighting = TraceHitLighting(hitPosition, lightingNormal, hit, surface, -1.0f);
        #endif
        radiance = lerp(exactLighting, cacheLighting, cacheCoverage);
    }
    if (farSegment)
    {
        accum.distant += radiance;
        accum.distantDirection = direction;
        accum.farHits++;
        if (cacheCoverage > 0.0)
            rayState |= RayFarCache;
    }
    else if (traceStage == TraceStageLegacy && _SdfRestirEnabled != 0u)
    {
        RestirSample sample;
        sample.position = hitPosition;
        sample.normal = hit.normalWS;
        sample.radiance = radiance;
        sample.fromScreen = false;
        // Target and the original proposal both contain the receiver cosine.
        RestirUpdate(accum.reservoir, accum.reservoirWeightSum, sample, RestirLuminance(radiance), 0u,
            RestirRandom(seed ^ (0xca5a826bu * (ray + 1u))));
    }
    if (_SdfDirectionalCacheEnabled != 0u)
        accum.movingRays += inverseRelativePdf * RelativeHitMotion(receiverSpeed, InstanceSpeed(hit.instanceIndex, hitPosition), position);
    result.state = rayState | RaySdfHit;
    result.distance = hit.distance;
    result.radiance = radiance;
    result.hitNormal = hit.normalWS;
    result.hitInstance = hit.instanceIndex;
    accum.sum += inverseRelativePdf * radiance;
    if (traceStage == TraceStageLegacy && _SdfDiffuseDirectionalProbes != 0u && _SdfDirectionalCacheEnabled == 0u)
        accum.moments += ProbeSampleMoments(radiance, direction, normal);
    return result;
}
#endif

ProbeRaySample InitProbeRay(float3 direction, uint bin, float inverseRelativePdf)
{
    ProbeRaySample result = (ProbeRaySample)0;
    result.hitInstance = 0xffffffffu;
    result.direction = direction;
    result.bin = bin;
    result.inverseRelativePdf = inverseRelativePdf;
    return result;
}

float ProbeReceiverSpeed(uint2 pixel, float3 position)
{
#if defined(VIVID_SDF_RECEIVER)
    uint receiverIndex = _SdfReceiverVisibility.Load(int3(pixel, 0)).x - VIVID_VISIBILITY_BUFFER_INSTANCE_ID_BIAS;
    if (_SdfDirectionalCacheEnabled != 0u && receiverIndex < _SdfReceiverCount)
        return InstanceSpeed(_SdfReceiverEntities[receiverIndex].z, position);
#endif
    return 0.0;
}

ProbeRaySample TraceProbeRay(uint2 tile, uint ray, uint seed, uint2 screenSize,
    float3 position, float3 normal, float3 origin, float receiverSpeed,
#if !defined(VIVID_SDF_SCREEN_ONLY)
    VividMeshSdfReceiver receiver,
#endif
    uint worldLevel, bool useSky, float3 direction, uint bin, float inverseRelativePdf,
    inout ProbeTraceAccumulation accum)
{
    ProbeRaySample result = InitProbeRay(direction, bin, inverseRelativePdf);
    uint screenState = 0u;
    float screenDistance = FLT_MAX;
    bool reachedRadianceCache = false;
    if (_SdfDiffuseUseScreenRays != 0u)
    {
        float4 screenHit = _SdfScreenRays.Load(int3(ProbeTraceAddress(tile, ray), 0));
        FProbeRayDistance screen = DecodeProbeRayDistance(asuint(screenHit.a));
        if (_SdfLumenScreenTrace != 0u)
        {
            screenDistance = screen.HitDistance;
            reachedRadianceCache = screen.bReachedRadianceCache;
        }
        if (_SdfLumenScreenTrace != 0u ? screen.bHit : screenHit.a > 0.0)
        {
            float distance = _SdfLumenScreenTrace != 0u ? screen.HitDistance : screenHit.a;
            float3 radiance = screenHit.rgb;
            uint hitState = RayScreenHit;
            VividMeshSdfHit screenSurface = (VividMeshSdfHit)0;
            float3 screenNormal = 0.0;
            screenSurface.instanceIndex = 0xffffffffu;
            bool accepted = true;
            if (_SdfLumenScreenTrace == 0u && (_SdfRestirDense != 0u || _SdfScreenCardLighting != 0u || _SdfScreenMaterialLookup != 0u || _SdfDirectionalCacheEnabled != 0u))
            {
                uint address = (asuint(screenHit.a) - ScreenHitPixelBase) & ~ScreenMovingBit;
                uint2 pixel = uint2(address % screenSize.x, address / screenSize.x);
                RestirSample sample;
                accepted = LoadScreenHitGeometry(pixel, _SdfDiffuseDepth.Load(int3(pixel, 0)), sample.position, sample.normal);
                if (accepted)
                {
                    screenNormal = sample.normal;
                    distance = dot(sample.position - origin, direction);
                    bool visibleSide = ScreenMaterialSideVisible(pixel, sample.position, screenNormal, direction);
                    if (!visibleSide)
                    {
                        radiance = 0.0;
                        hitState |= RayMaterialBackface;
                    }
                    #if defined(VIVID_SDF_SURFACE_CACHE) && defined(VIVID_SDF_RECEIVER)
                        float3 indirect;
                        if (visibleSide && _SdfScreenCardLighting != 0u
                            && TryLoadScreenCardIndirect(pixel, sample.position, sample.normal, direction, indirect, screenSurface))
                        {
                            radiance = min(radiance + indirect, 65000.0);
                            hitState |= RayScreenCardIndirect;
                        }
                    #endif
                    if (_SdfRestirDense != 0u)
                    {
                        sample.radiance = radiance;
                        sample.fromScreen = true;
                        RestirUpdate(accum.reservoir, accum.reservoirWeightSum, sample, RestirLuminance(sample.radiance), 0u,
                            RestirRandom(seed ^ (0xca5a826bu * (ray + 1u))));
                    }
                }
            }
            if (accepted)
            {
                result.state = hitState;
                result.distance = distance;
                result.radiance = radiance;
                result.hitNormal = screenNormal;
                result.hitInstance = screenSurface.instanceIndex;
                if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                    StoreFirstHitDiagnostic(tile, ray, origin, direction, screenSurface, 0u);
                accum.sum += inverseRelativePdf * radiance;
                if (_SdfDiffuseDirectionalProbes != 0u && _SdfDirectionalCacheEnabled == 0u)
                    accum.moments += ProbeSampleMoments(radiance, direction, normal);
                if (_SdfDirectionalCacheEnabled != 0u && (_SdfLumenScreenTrace != 0u ? screen.bMoving : ((asuint(screenHit.a) - ScreenHitPixelBase) & ScreenMovingBit) != 0u))
                    accum.movingRays += inverseRelativePdf;
                accum.screenHits++;
                accum.valid++;
                accum.validWeight += inverseRelativePdf;
                return result;
            }
        }
        if (_SdfLumenScreenTrace == 0u)
        {
            screenState = screenHit.a != 0.0 ? RayScreenHistoryRejected : 0u;
            if (screenHit.a < 0.0)
                screenDistance = -screenHit.a;
        }
    }
    #if !defined(VIVID_SDF_SCREEN_ONLY)
    VividMeshSdfHit hit;
    bool advancedReceiver;
    bool incomplete;
    uint traceState;
    float tracedDistance;
    bool useWorld = worldLevel < WorldClipmaps && screenState == 0u;
    float3 worldRadiance = 0.0;
    float worldDistance = 0.0;
    float fullLimit = _SdfScreenProbeFullSphere != 0u ? max(_SdfFarTraceDistance, _SdfDiffuseMaxDistance) : _SdfDiffuseMaxDistance;
    float3 cachePosition = _SdfLumenScreenTrace != 0u ? position : origin;
    bool traced;
    // A missing directional texel retries the same traversal out to the far limit.
    // Keep one traversal body in the shader for both ranges.
    [loop] for (uint attempt = 0u; ; ++attempt)
    {
        if (attempt == 0u && reachedRadianceCache && useWorld)
        {
            if (SampleWorldCache(cachePosition, direction, worldLevel, worldRadiance, worldDistance))
            {
                traced = incomplete = advancedReceiver = false;
                hit = (VividMeshSdfHit)0;
                traceState = 0u;
                tracedDistance = screenDistance;
                break;
            }
        }
        traced = TraceSdfGatherHit(origin, direction, receiver, screenDistance, screenState,
            useWorld && attempt == 0u ? WorldNearDistance(worldLevel) : fullLimit, useWorld,
            hit, advancedReceiver, incomplete, traceState, tracedDistance);
        if (!useWorld || attempt != 0u || traced || incomplete) break;
        if (SampleWorldCache(cachePosition, direction, worldLevel, worldRadiance, worldDistance)) break;
        worldDistance = 0.0;
    }
    return ResolveProbeRay(tile, ray, seed, position, normal, origin, receiverSpeed, receiver, useSky,
        screenState, traceState, hit, advancedReceiver, incomplete, traced, tracedDistance,
        worldRadiance, worldDistance, TraceStageLegacy, result, accum);
    #else
        result.state = screenState | RayMiss;
        if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
        {
            VividMeshSdfHit miss = (VividMeshSdfHit)0;
            miss.instanceIndex = 0xffffffffu;
            StoreFirstHitDiagnostic(tile, ray, origin, direction, miss, 0u);
        }
    #endif
    return result;
}

void TraceProbe(uint3 id)
{
    uint2 screenSize = uint2(_SdfDiffuseScreenSize.xy);
    uint2 tile = id.xy;
    uint rayCount = ProbeRayCount();
    if (any(tile >= uint2(ProbeGridSize(screenSize).x, ProbeAtlasHeight(ProbeGridSize(screenSize)))))
        return;

    float3 position, normal;
    uint2 receiverPixel;
    if (!LoadProbeReceiverPixel(tile, screenSize, receiverPixel) || !LoadReceiver(receiverPixel, position, normal))
    {
        if (_SdfRestirEnabled != 0u)
            StoreInitialRestir(tile, (RestirReservoir)0);
        if (_SdfDirectionalCacheEnabled == 0u)
            StoreProbe(tile, 0.0, (float3x3)0.0);
        StoreDistantProbeDirection(tile, 0.0);
        _SdfDiffuseGeometry[tile] = float4(0.0, 0.0, 0.0, -1.0);
        _SdfDiffuseHitLighting[tile] = 0.0;
        _SdfDiffuseTraceSources[tile] = 0.0;
        if (_SdfDirectionalCacheEnabled != 0u)
            _SdfProbeMovingOutput[tile] = 0.0;
        if (_SdfDiffuseRecordRayDiagnostics != 0u)
        {
            [loop]
            for (uint ray = 0u; ray < rayCount; ++ray)
            {
                StoreTraceSample(tile, ray, 0u, 0.0, 0.0);
                if (_SdfDiffuseRecordFirstHitDiagnostics != 0u)
                {
                    VividMeshSdfHit miss = (VividMeshSdfHit)0;
                    miss.instanceIndex = 0xffffffffu;
                    StoreFirstHitDiagnostic(tile, ray, 0.0, 0.0, miss, 0u);
                }
            }
        }
        #if defined(VIVID_SDF_CACHED_SUN)
            _SdfSunCacheHits[tile] = 0.0;
        #endif
        return;
    }

    float3x3 basis = DiffuseProbeFrame(normal);
    float3 origin = position + normal * _SdfDiffuseRayBias;
    uint worldLevel = GetWorldCoverage(_SdfLumenScreenTrace != 0u ? position : origin);
    #if !defined(VIVID_SDF_SCREEN_ONLY)
        VividMeshSdfReceiver receiver = (VividMeshSdfReceiver)0;
    #endif
    #if defined(VIVID_SDF_RECEIVER)
        if (_SdfCorrectReceiverSelfHits != 0u)
            receiver = LoadSdfReceiver(receiverPixel, position, normal);
    #endif
    uint seed = ProbeSeed(tile);
    float receiverSpeed = ProbeReceiverSpeed(receiverPixel, position);
    ProbeTraceAccumulation accum = (ProbeTraceAccumulation)0;
    #if defined(VIVID_SDF_SCREEN_ONLY)
        const bool useSky = false;
    #else
        bool useSky = HasSkyTexture();
    #endif
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        uint bin;
        float inverseRelativePdf;
        float3 direction = SampleDiffuseProbeRay(tile, ray, seed, basis, bin, inverseRelativePdf);
        ProbeRaySample result = TraceProbeRay(tile, ray, seed, screenSize, position, normal, origin, receiverSpeed,
        #if !defined(VIVID_SDF_SCREEN_ONLY)
            receiver,
        #endif
            worldLevel, useSky, direction, bin, inverseRelativePdf, accum);
        StoreTraceSample(tile, ray, result.state, result.distance, result.radiance, result.direction, result.bin,
            result.inverseRelativePdf, result.hitNormal, result.hitInstance);
    }

    // Cosine sampling estimates irradiance divided by pi, before the receiver's albedo.
    // RGB is the conditional mean; alpha reserves the unresolved fraction for baked fallback.
    float confidence = saturate(accum.validWeight / float(rayCount));
    float normalization = max(1e-5, accum.validWeight);
    float4 current = float4(min(accum.sum / normalization, 65000.0), confidence);
    // Dense gather integrates the distant term separately from positional reservoirs.
    if (_SdfRestirDense != 0u)
        current.rgb = accum.distant;
    accum.moments /= normalization;
    if (_SdfRestirEnabled != 0u)
    {
        // Shaded black counts as a resolved sample. Unshaded misses and missing cards
        // are excluded from both the estimator and its coverage.
        accum.reservoir.count = accum.valid;
        // Use the same packed receiver normal as the resampling passes.
        float3 storedNormal = UnpackProbeNormal(PackProbeNormal(normal));
        RestirFinalize(accum.reservoir, accum.reservoirWeightSum, position + storedNormal * _SdfDiffuseRayBias, storedNormal);
        StoreInitialRestir(tile, accum.reservoir);
    }
    else if (_SdfDiffuseHitFilterEnabled == 0u)
        current = AccumulateProbe(current, position, normal, accum.moments);
    if (_SdfDirectionalCacheEnabled == 0u)
        StoreProbe(tile, current, accum.moments);
    StoreDistantProbeDirection(tile, accum.distantDirection);
    if (_SdfDirectionalCacheEnabled != 0u)
        _SdfProbeMovingOutput[tile] = saturate(accum.movingRays / rayCount);
    _SdfDiffuseGeometry[tile] = float4(position, PackProbeNormal(normal));
    _SdfDiffuseHitLighting[tile] = float4(min(accum.sum / normalization, 65000.0), confidence);
    // Sky and the far cache occupy the residual of the three source fractions.
    _SdfDiffuseTraceSources[tile] = float4(float3(accum.screenHits, accum.valid - accum.screenHits - accum.skyHits - accum.farHits, rayCount - accum.valid) / rayCount, 1.0);
    #if defined(VIVID_SDF_CACHED_SUN)
        _SdfSunCacheHits[tile] = float4(float(accum.cachedSunHits) / rayCount, 0.0, 0.0, 1.0);
    #endif
}

#if defined(VIVID_SDF_SCREEN_ONLY)
[numthreads(8, 8, 1)]
void GatherScreenDiffuseProbes(uint3 id : SV_DispatchThreadID)
{
    TraceProbe(id);
}
#elif defined(VIVID_SDF_CACHED_SUN)
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceSdfReceiverCachedSunProbes(uint3 id : SV_DispatchThreadID)
#else
void TraceSdfDiffuseCachedSunProbes(uint3 id : SV_DispatchThreadID)
#endif
{
    TraceProbe(id);
}
#elif defined(VIVID_SDF_SURFACE_CACHE)
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceSdfReceiverCachedProbes(uint3 id : SV_DispatchThreadID)
#else
void TraceSdfDiffuseCachedProbes(uint3 id : SV_DispatchThreadID)
#endif
{
    TraceProbe(id);
}
#else
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceSdfReceiverProbes(uint3 id : SV_DispatchThreadID)
#else
void TraceSdfDiffuseProbes(uint3 id : SV_DispatchThreadID)
#endif
{
    TraceProbe(id);
}
#endif

#if defined(VIVID_COMPACT_PROBE_TRACE)
// Keep the strides in sync with the transient buffers in SdfDiffuseGatherPass.
struct CompactProbe
{
    float3 position;
    uint valid;
    float3 normal;
    uint worldLevel;
    uint2 pixel;
    float receiverSpeed;
    uint meshCardGridList;
};

struct CompactContribution
{
    float3 radiance;
    float validWeight;
    float movingWeight;
    uint sources;
};

struct CompactGlobalResult
{
    float3 normalOrCacheRadiance;
    float distance;
    float lightingOffsetOrTraceLimit;
    uint source; // 0: queued for Mesh retry, 1: miss, 2 + clipmap level: hit.
};

static const uint CompactGlobalMiss = 1u;
static const uint CompactGlobalHitBase = 2u;

RWStructuredBuffer<CompactProbe> _SdfCompactProbes;
RWStructuredBuffer<CompactContribution> _SdfCompactContributions;
RWStructuredBuffer<uint> _SdfCompactCounts;
RWStructuredBuffer<uint> _SdfCompactMeshRays;
RWStructuredBuffer<uint> _SdfCompactGlobalRays;
RWStructuredBuffer<uint> _SdfCompactRetryRays;
RWStructuredBuffer<CompactGlobalResult> _SdfCompactGlobalResults;
StructuredBuffer<CompactGlobalResult> _SdfCompactGlobalResultsRead;
StructuredBuffer<uint> _SdfCompactInput;
RWStructuredBuffer<uint> _SdfCompactArgs;
uint _SdfCompactQueueIndex;
uint _SdfCompactRetry;
groupshared CompactProbe SharedCompactProbe;

static const uint CompactMeshQueue = 0u;
static const uint CompactGlobalQueue = 1u;
static const uint CompactRetryMeshQueue = 2u;
static const uint CompactRetryGlobalQueue = 3u;
static const uint CompactGroupSize = 64u;
static const uint CompactMaxDispatchWidth = 65535u;

[numthreads(1, 1, 1)]
void ResetCompactTracesCS()
{
    [unroll] for (uint queue = 0u; queue <= CompactRetryGlobalQueue; ++queue)
        _SdfCompactCounts[queue] = 0u;
}

[numthreads(1, 1, 1)]
void SetupIndirectArgsCS()
{
    uint2 grid = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy));
    uint maxRays = grid.x * ProbeAtlasHeight(grid) * CompactGroupSize;
    uint count = min(_SdfCompactCounts[_SdfCompactQueueIndex], maxRays);
    uint groups = max(1u, (count + CompactGroupSize - 1u) / CompactGroupSize);
    uint width = min(groups, CompactMaxDispatchWidth);
    _SdfCompactArgs[0] = width;
    _SdfCompactArgs[1] = (groups + width - 1u) / width;
    _SdfCompactArgs[2] = 1u;
}

uint AllocateCompactRay(uint queue)
{
    uint count = WaveActiveCountBits(true);
    uint lane = WavePrefixCountBits(true);
    uint baseIndex = 0u;
    if (WaveIsFirstLane())
        InterlockedAdd(_SdfCompactCounts[queue], count, baseIndex);
    return WaveReadLaneFirst(baseIndex) + lane;
}

FProbeRayDistance LoadCompactScreenRay(uint2 tile, uint ray, out float3 radiance)
{
    FProbeRayDistance screen = (FProbeRayDistance)0;
    screen.HitDistance = FLT_MAX;
    radiance = 0.0;
    if (_SdfDiffuseUseScreenRays != 0u)
    {
        float4 payload = _SdfScreenRays.Load(int3(ProbeTraceAddress(tile, ray), 0));
        screen = DecodeProbeRayDistance(asuint(payload.a));
        radiance = payload.rgb;
    }
    return screen;
}

ProbeRaySample SampleCompactRay(uint2 tile, uint ray, float3 normal)
{
    uint bin;
    float inverseRelativePdf;
    float3 direction = SampleDiffuseProbeRay(tile, ray, ProbeSeed(tile), DiffuseProbeFrame(normal), bin, inverseRelativePdf);
    return InitProbeRay(direction, bin, inverseRelativePdf);
}

void StoreCompactRay(uint2 tile, uint ray, uint address, ProbeRaySample result, ProbeTraceAccumulation accum)
{
    StoreTraceSample(tile, ray, result.state, result.distance, result.radiance, result.direction, result.bin,
        result.inverseRelativePdf, result.hitNormal, result.hitInstance);
    CompactContribution contribution;
    contribution.radiance = result.radiance;
    contribution.validWeight = accum.validWeight;
    contribution.movingWeight = accum.movingRays;
    contribution.sources = accum.valid | (accum.screenHits << 1u) | (accum.skyHits << 2u)
        | (accum.farHits << 3u) | (accum.cachedSunHits << 4u);
    _SdfCompactContributions[address] = contribution;
}

[numthreads(64, 1, 1)]
#if defined(VIVID_SDF_RECEIVER)
void CompactScreenProbeTracesWithReceiverCS(uint2 tile : SV_GroupID, uint ray : SV_GroupIndex)
#else
void CompactScreenProbeTracesCS(uint2 tile : SV_GroupID, uint ray : SV_GroupIndex)
#endif
{
    uint2 size = uint2(_SdfDiffuseScreenSize.xy);
    uint probeIndex = tile.y * ProbeGridSize(size).x + tile.x;
    if (ray == 0u)
    {
        CompactProbe probe = (CompactProbe)0;
        if (LoadProbeReceiverPixel(tile, size, probe.pixel) && LoadReceiver(probe.pixel, probe.position, probe.normal))
        {
            probe.valid = 1u;
            probe.worldLevel = GetWorldCoverage(probe.position);
            probe.receiverSpeed = ProbeReceiverSpeed(probe.pixel, probe.position);
#if defined(VIVID_MESH_SDF_CARD_GRID)
            probe.meshCardGridList = VividMeshSdfCardGridList(probe.position);
#endif
        }
        _SdfCompactProbes[probeIndex] = probe;
        SharedCompactProbe = probe;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SharedCompactProbe.valid == 0u)
    {
        if (_SdfDiffuseRecordRayDiagnostics != 0u)
            StoreTraceSample(tile, ray, 0u, 0.0, 0.0);
        return;
    }

    uint address = probeIndex * CompactGroupSize + ray;
    float3 radiance;
    FProbeRayDistance screen = LoadCompactScreenRay(tile, ray, radiance);
    if (!screen.bHit)
    {
        _SdfCompactMeshRays[AllocateCompactRay(CompactMeshQueue)] = address;
        return;
    }

    ProbeRaySample result = SampleCompactRay(tile, ray, SharedCompactProbe.normal);
    result.state = RayScreenHit;
    result.distance = screen.HitDistance;
    result.radiance = radiance;
    ProbeTraceAccumulation accum = (ProbeTraceAccumulation)0;
    accum.valid = accum.screenHits = 1u;
    accum.validWeight = result.inverseRelativePdf;
    accum.movingRays = screen.bMoving ? result.inverseRelativePdf : 0.0f;
    StoreCompactRay(tile, ray, address, result, accum);
}

#if defined(VIVID_SDF_SURFACE_CACHE)
uint CompactDispatchIndex(uint2 group, uint lane)
{
    return (group.y * CompactMaxDispatchWidth + group.x) * CompactGroupSize + lane;
}

CompactProbe LoadCompactProbe(uint address, out uint2 tile, out uint ray)
{
    uint probeIndex = address / CompactGroupSize;
    uint width = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy)).x;
    tile = uint2(probeIndex % width, probeIndex / width);
    ray = address % CompactGroupSize;
    return _SdfCompactProbes[probeIndex];
}

VividMeshSdfReceiver LoadCompactReceiver(CompactProbe probe)
{
#if defined(VIVID_SDF_RECEIVER)
    if (_SdfCorrectReceiverSelfHits != 0u)
        return LoadSdfReceiver(probe.pixel, probe.position, probe.normal);
#endif
    return (VividMeshSdfReceiver)0;
}

[numthreads(64, 1, 1)]
#if defined(VIVID_SDF_RECEIVER) && defined(VIVID_SDF_CACHED_SUN)
void TraceMeshSdfReceiverSunCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
#elif defined(VIVID_SDF_RECEIVER)
void TraceMeshSdfReceiverCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
#elif defined(VIVID_SDF_CACHED_SUN)
void TraceMeshSdfSunCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
#else
void TraceMeshSdfCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
#endif
{
    uint index = CompactDispatchIndex(group, lane);
    bool retry = _SdfCompactRetry != 0u;
    if (index >= _SdfCompactCounts[retry ? CompactRetryMeshQueue : CompactMeshQueue]) return;
    uint address = _SdfCompactInput[index];
    uint2 tile;
    uint ray;
    CompactProbe probe = LoadCompactProbe(address, tile, ray);
    ProbeRaySample result = SampleCompactRay(tile, ray, probe.normal);
    float3 origin = probe.position + probe.normal * _SdfDiffuseRayBias;
    float3 unused;
    FProbeRayDistance screen = LoadCompactScreenRay(tile, ray, unused);
    bool useWorld = !retry && probe.worldLevel < WorldClipmaps;
    float3 worldRadiance = 0.0;
    float worldDistance = 0.0;
    ProbeTraceAccumulation accum = (ProbeTraceAccumulation)0;
    VividMeshSdfHit hit = (VividMeshSdfHit)0;
    VividMeshSdfReceiver receiver = LoadCompactReceiver(probe);
    if (useWorld && screen.bReachedRadianceCache)
    {
        if (SampleWorldCache(probe.position, result.direction, probe.worldLevel, worldRadiance, worldDistance))
        {
            result = ResolveProbeRay(tile, ray, 0u, probe.position, probe.normal, origin, probe.receiverSpeed,
                receiver, HasSkyTexture(), 0u, 0u, hit, false, false, false, screen.HitDistance,
                worldRadiance, worldDistance, TraceStageMesh, result, accum);
            StoreCompactRay(tile, ray, address, result, accum);
            return;
        }
    }

    float limit = useWorld ? WorldNearDistance(probe.worldLevel) : max(_SdfFarTraceDistance, _SdfDiffuseMaxDistance);
    float detailEnd = min(limit, _SdfMeshDetailDistance);
    uint2 gridRange = 0u;
#if defined(VIVID_MESH_SDF_CARD_GRID)
    gridRange = VividMeshSdfCardGridRange(probe.meshCardGridList);
#endif
    bool advancedReceiver, incomplete;
    bool traced = TraceProbeMeshDetail(origin, result.direction, receiver, ProbeSdfStart(screen.HitDistance),
        detailEnd, gridRange, hit, advancedReceiver, incomplete);
    if (!traced && !incomplete && (detailEnd < limit || useWorld))
    {
        uint slot = AllocateCompactRay(retry ? CompactRetryGlobalQueue : CompactGlobalQueue);
        _SdfCompactGlobalRays[slot] = address;
        return;
    }
    result = ResolveProbeRay(tile, ray, 0u, probe.position, probe.normal, origin, probe.receiverSpeed,
        receiver, HasSkyTexture(), 0u, 0u, hit, advancedReceiver, incomplete, traced, detailEnd,
        worldRadiance, worldDistance, TraceStageMesh, result, accum);
    StoreCompactRay(tile, ray, address, result, accum);
}

[numthreads(64, 1, 1)]
void TraceGlobalSdfCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint index = CompactDispatchIndex(group, lane);
    bool retry = _SdfCompactRetry != 0u;
    if (index >= _SdfCompactCounts[retry ? CompactRetryGlobalQueue : CompactGlobalQueue]) return;
    uint address = _SdfCompactInput[index];
    uint2 tile;
    uint ray;
    CompactProbe probe = LoadCompactProbe(address, tile, ray);
    ProbeRaySample result = SampleCompactRay(tile, ray, probe.normal);
    float3 origin = probe.position + probe.normal * _SdfDiffuseRayBias;
    float3 unused;
    float screenStart = ProbeSdfStart(LoadCompactScreenRay(tile, ray, unused).HitDistance);
    bool useWorld = !retry && probe.worldLevel < WorldClipmaps;
    float fullLimit = max(_SdfFarTraceDistance, _SdfDiffuseMaxDistance);
    float limit = useWorld ? WorldNearDistance(probe.worldLevel) : fullLimit;
    float detailEnd = min(limit, _SdfMeshDetailDistance);
    VividMeshSdfHit hit = (VividMeshSdfHit)0;
    bool traced;
    float3 worldRadiance = 0.0;
    float worldDistance = 0.0;
    // As in the serial gather, share one traversal body between both ranges.
    [loop] for (uint attempt = 0u; ; ++attempt)
    {
        traced = TraceProbeGlobal(origin, result.direction, max(screenStart, detailEnd), limit, hit);
        if (!useWorld || attempt != 0u || traced) break;
        if (SampleWorldCache(probe.position, result.direction, probe.worldLevel, worldRadiance, worldDistance)) break;

        // The serial path repeats Mesh SDF first. Reuse its miss only if the interval is identical.
        float fullDetailEnd = min(fullLimit, _SdfMeshDetailDistance);
        if (detailEnd != fullDetailEnd && screenStart < fullDetailEnd)
        {
            _SdfCompactGlobalResults[index] = (CompactGlobalResult)0;
            _SdfCompactRetryRays[AllocateCompactRay(CompactRetryMeshQueue)] = address;
            return;
        }
        limit = fullLimit;
        detailEnd = fullDetailEnd;
    }

    // Resolve cards in a separate dispatch to keep their traversal out of the
    // clipmap marcher. Both dispatches consume the same compact ray indices.
    CompactGlobalResult traversal;
    traversal.normalOrCacheRadiance = traced ? hit.normalWS : worldRadiance;
    traversal.distance = traced ? hit.distance : worldDistance;
    traversal.lightingOffsetOrTraceLimit = traced ? hit.lightingDistanceOffset : limit;
    traversal.source = traced ? CompactGlobalHitBase + hit.signMode : CompactGlobalMiss;
    _SdfCompactGlobalResults[index] = traversal;
}

[numthreads(64, 1, 1)]
#if defined(VIVID_SDF_RECEIVER)
void ResolveGlobalSdfReceiverCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
#else
void ResolveGlobalSdfCompactedCS(uint2 group : SV_GroupID, uint lane : SV_GroupIndex)
#endif
{
    uint index = CompactDispatchIndex(group, lane);
    bool retry = _SdfCompactRetry != 0u;
    if (index >= _SdfCompactCounts[retry ? CompactRetryGlobalQueue : CompactGlobalQueue]) return;
    CompactGlobalResult traversal = _SdfCompactGlobalResultsRead[index];
    if (traversal.source == 0u) return;

    uint address = _SdfCompactInput[index];
    uint2 tile;
    uint ray;
    CompactProbe probe = LoadCompactProbe(address, tile, ray);
    ProbeRaySample result = SampleCompactRay(tile, ray, probe.normal);
    float3 origin = probe.position + probe.normal * _SdfDiffuseRayBias;
    bool traced = traversal.source >= CompactGlobalHitBase;
    VividMeshSdfHit hit = (VividMeshSdfHit)0;
    hit.instanceIndex = 0xffffffffu;
    if (traced)
    {
        hit.distance = traversal.distance;
        hit.lightingDistanceOffset = traversal.lightingOffsetOrTraceLimit;
        hit.normalWS = traversal.normalOrCacheRadiance;
        hit.signMode = traversal.source - CompactGlobalHitBase;
    }
    float worldDistance = traced ? 0.0f : traversal.distance;
    float3 worldRadiance = traced ? 0.0f : traversal.normalOrCacheRadiance;
    ProbeTraceAccumulation accum = (ProbeTraceAccumulation)0;
    // Only the sky-visibility miss path needs the original receiver.
    bool useSky = HasSkyTexture();
    VividMeshSdfReceiver receiver = (VividMeshSdfReceiver)0;
    if (!traced && worldDistance <= 0.0 && useSky)
        receiver = LoadCompactReceiver(probe);
    result = ResolveProbeRay(tile, ray, 0u, probe.position, probe.normal, origin, probe.receiverSpeed,
        receiver, useSky, 0u, traced ? RayGlobalCandidate : 0u, hit, false, false, traced, traversal.lightingOffsetOrTraceLimit,
        worldRadiance, worldDistance, TraceStageGlobal, result, accum);
    StoreCompactRay(tile, ray, address, result, accum);
}
#endif

[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_CACHED_SUN)
void FinalizeProbeGatherWithSunCS(uint2 tile : SV_DispatchThreadID)
#else
void FinalizeProbeGatherCS(uint2 tile : SV_DispatchThreadID)
#endif
{
    uint2 grid = ProbeGridSize(uint2(_SdfDiffuseScreenSize.xy));
    if (any(tile >= uint2(grid.x, ProbeAtlasHeight(grid)))) return;
    uint probeIndex = tile.y * grid.x + tile.x;
    CompactProbe probe = _SdfCompactProbes[probeIndex];
    if (probe.valid == 0u)
    {
        _SdfDiffuseGeometry[tile] = float4(0.0, 0.0, 0.0, -1.0);
        _SdfDiffuseHitLighting[tile] = 0.0;
        _SdfDiffuseTraceSources[tile] = 0.0;
        _SdfProbeMovingOutput[tile] = 0.0;
        #if defined(VIVID_SDF_CACHED_SUN)
            _SdfSunCacheHits[tile] = 0.0;
        #endif
        return;
    }

    float3 sum = 0.0;
    float weight = 0.0;
    float moving = 0.0;
    uint valid = 0u, screenHits = 0u, skyHits = 0u, farHits = 0u, sunHits = 0u;
    // Preserve the serial sum order, independent of the order each queue allocated its rays.
    [loop] for (uint ray = 0u; ray < CompactGroupSize; ++ray)
    {
        CompactContribution contribution = _SdfCompactContributions[probeIndex * CompactGroupSize + ray];
        if ((contribution.sources & 1u) == 0u) continue;
        sum += contribution.validWeight * contribution.radiance;
        weight += contribution.validWeight;
        moving += contribution.movingWeight;
        valid++;
        screenHits += (contribution.sources >> 1u) & 1u;
        skyHits += (contribution.sources >> 2u) & 1u;
        farHits += (contribution.sources >> 3u) & 1u;
        sunHits += (contribution.sources >> 4u) & 1u;
    }
    _SdfDiffuseGeometry[tile] = float4(probe.position, PackProbeNormal(probe.normal));
    _SdfDiffuseHitLighting[tile] = float4(min(sum / max(1e-5, weight), 65000.0), saturate(weight / CompactGroupSize));
    _SdfDiffuseTraceSources[tile] = float4(float3(screenHits, valid - screenHits - skyHits - farHits, CompactGroupSize - valid)
        / CompactGroupSize, 1.0);
    _SdfProbeMovingOutput[tile] = saturate(moving / CompactGroupSize);
    #if defined(VIVID_SDF_CACHED_SUN)
        _SdfSunCacheHits[tile] = float4(float(sunHits) / CompactGroupSize, 0.0, 0.0, 1.0);
    #endif
}
#endif

#if defined(VIVID_CAPTURE_SCENE_COLOR)
Texture2D<float4> _SdfResolvedSceneColor;
RWTexture2D<float4> _SdfSceneColorOutput;
RWTexture2D<float2> _SdfDepthExposureOutput;

[numthreads(8, 8, 1)]
void CaptureScreenProbeSceneColor(uint3 id : SV_DispatchThreadID)
{
    uint2 size;
    _SdfSceneColorOutput.GetDimensions(size.x, size.y);
    if (any(id.xy >= size)) return;
    _SdfSceneColorOutput[id.xy] = _SdfResolvedSceneColor.Load(int3(id.xy, 0));
    _SdfDepthExposureOutput[id.xy] = float2(_SdfDiffuseDepth.Load(int3(id.xy, 0)), VividGetPreExposure());
}
#endif

#if defined(VIVID_BUILD_CLOSEST_HZB) || defined(VIVID_LUMEN_SCREEN)
// Unity stores the UE closest mips in adjacent rows of a single R16 UAV.
// Each group emits four mips before reloading conservative FP16 depth.
float4 _SdfClosestHzbSize; // base width, height, mip count, log2(height)
uint2 ClosestMipSize(uint mip) { return max(uint2(_SdfClosestHzbSize.xy) >> mip, 1u); }
uint2 ClosestMipOffset(uint mip)
{
    return uint2(0, 2u * ((uint)_SdfClosestHzbSize.y - ClosestMipSize(mip).y)
        + (uint)max(0, (int)mip - (int)_SdfClosestHzbSize.w));
}
#endif

#if defined(VIVID_BUILD_CLOSEST_HZB)
uint _SdfHzbStartMip;
RWTexture2D<float> _SdfClosestHzbOutput;
groupshared float ClosestTile[64];

float LoadHzbParent(uint2 pixel)
{
    if (_SdfHzbStartMip == 0u) return _SdfDiffuseDepth.Load(int3(pixel, 0));
    return _SdfClosestHzbOutput[ClosestMipOffset(_SdfHzbStartMip - 1u) + pixel];
}

[numthreads(8, 8, 1)]
void BuildScreenProbeClosestHZB(uint3 id : SV_DispatchThreadID, uint lane : SV_GroupIndex)
{
    uint mip = _SdfHzbStartMip;
    uint2 parentSize = mip == 0u ? uint2(_SdfDiffuseScreenSize.xy) : ClosestMipSize(mip - 1u);
    uint2 p = min(id.xy * 2u, (uint2)max(int2(parentSize) - 2, 0));
    uint2 q = min(p + 1u, parentSize - 1u);
    float z = max(max(LoadHzbParent(p), LoadHzbParent(uint2(q.x, p.y))),
                  max(LoadHzbParent(uint2(p.x, q.y)), LoadHzbParent(q)));
    ClosestTile[lane] = z;
    if (all(id.xy < ClosestMipSize(mip)))
        _SdfClosestHzbOutput[ClosestMipOffset(mip) + id.xy] = f16tof32(f32tof16(z) + 1u);
    [unroll] for (uint i = 1u; i < 4u; ++i)
    {
        GroupMemoryBarrierWithGroupSync();
        uint stride = 1u << (i - 1u);
        if (mip + i < (uint)_SdfClosestHzbSize.z && all((id.xy & (2u * stride - 1u)) == 0u))
        {
            z = max(max(z, ClosestTile[lane + stride]), max(ClosestTile[lane + 8u * stride], ClosestTile[lane + 9u * stride]));
            ClosestTile[lane] = z;
            uint2 dst = id.xy >> i;
            if (all(dst < ClosestMipSize(mip + i)))
                _SdfClosestHzbOutput[ClosestMipOffset(mip + i) + dst] = f16tof32(f32tof16(z) + 1u);
        }
    }
}
#endif

#if defined(VIVID_LUMEN_SCREEN)
// Epic Games, UE 5.7.4: HZBTracing.ush, TraceHZB. Default desktop permutation.
Texture2D<float> _SdfClosestHzb;
float4x4 _SdfClipToPrevClip;
float _SdfDepthThicknessScale;

float2 ScreenNdcToUvScale()
{
#if UNITY_UV_STARTS_AT_TOP
    return float2(0.5, -0.5);
#else
    return 0.5;
#endif
}

float ScreenTraceEyeDepth(float z)
{
    return unity_OrthoParams.w != 0 ? lerp(_ProjectionParams.z, _ProjectionParams.y, z) : LinearEyeDepth(z, _ZBufferParams);
}

float LoadClosestHzb(float2 uv, uint mip)
{
    mip = min(mip, (uint)_SdfClosestHzbSize.z - 1u);
    uint2 size = ClosestMipSize(mip);
    return _SdfClosestHzb.Load(int3(ClosestMipOffset(mip) + min((uint2)(saturate(uv) * size), size - 1u), 0));
}
float2 ScreenTraceLineBoxIntersect(float3 RayOrigin, float3 RayEnd, float3 BoxMin, float3 BoxMax)
{
    float3 InvRayDir = 1.0f / (RayEnd - RayOrigin);

    //find the ray intersection with each of the 3 planes defined by the minimum extrema.
    float3 FirstPlaneIntersections = (BoxMin - RayOrigin) * InvRayDir;
    //find the ray intersection with each of the 3 planes defined by the maximum extrema.
    float3 SecondPlaneIntersections = (BoxMax - RayOrigin) * InvRayDir;
    //get the closest of these intersections along the ray
    float3 ClosestPlaneIntersections = min(FirstPlaneIntersections, SecondPlaneIntersections);
    //get the furthest of these intersections along the ray
    float3 FurthestPlaneIntersections = max(FirstPlaneIntersections, SecondPlaneIntersections);

    float2 BoxIntersections;
    //find the furthest near intersection
    BoxIntersections.x = max(ClosestPlaneIntersections.x, max(ClosestPlaneIntersections.y, ClosestPlaneIntersections.z));
    //find the closest far intersection
    BoxIntersections.y = min(FurthestPlaneIntersections.x, min(FurthestPlaneIntersections.y, FurthestPlaneIntersections.z));
    //clamp the intersections to be between RayOrigin and RayEnd on the ray
    return saturate(BoxIntersections);
}

void TraceHZB(
    float2 InHZBBaseTexelSize,
    float4 InHZBUVToScreenUVScaleBias,
    float3 RayTranslatedWorldOrigin,
    float3 RayWorldDirection,
    float MaxWorldTraceDistance,
    float4 InHZBUvFactorAndInvFactor,
    float MaxIterations,
    float RelativeDepthThickness,
    float NumThicknessStepsToDetermineCertainty,
    uint MinimumTracingThreadOccupancy,
    inout bool bHit,
    inout bool bUncertain,
    inout float3 OutScreenUV,
    inout float3 OutLastVisibleScreenUV,
    inout float OutHitTileZ)
{
    float3 RayStartScreenUV;
    {
        float4 RayStartClip = mul(_SdfDiffuseVP, float4(RayTranslatedWorldOrigin, 1.0f));
        float3 RayStartScreenPosition = RayStartClip.xyz / max(RayStartClip.w, 0.01f);
        RayStartScreenUV = float3((RayStartScreenPosition.xy * ScreenNdcToUvScale() + 0.5f) * InHZBUvFactorAndInvFactor.xy, RayStartScreenPosition.z);
    }

    float3 RayEndScreenUV;
    {
        float ViewRayDirectionZ = dot(RayWorldDirection, _SdfProbeCameraForward.xyz);
        float SceneDepth = dot(float4(RayTranslatedWorldOrigin, 1.0f), _SdfProbeCameraForward);
        // Clamps the ray to end at the Z == 0 plane so the end point will be valid in NDC space for clipping
        float RayEndWorldDistance = ViewRayDirectionZ < 0.0 ? min(-0.99f * SceneDepth / ViewRayDirectionZ, MaxWorldTraceDistance) : MaxWorldTraceDistance;

        float3 RayWorldEnd = RayTranslatedWorldOrigin + RayWorldDirection * RayEndWorldDistance;
        float4 RayEndClip = mul(_SdfDiffuseVP, float4(RayWorldEnd, 1.0f));
        float3 RayEndScreenPosition = RayEndClip.xyz / RayEndClip.w;
        RayEndScreenUV = float3((RayEndScreenPosition.xy * ScreenNdcToUvScale() + 0.5f) * InHZBUvFactorAndInvFactor.xy, RayEndScreenPosition.z);

        float2 ScreenEdgeIntersections = ScreenTraceLineBoxIntersect(RayStartScreenUV, RayEndScreenUV, float3(0, 0, 0), float3(InHZBUvFactorAndInvFactor.xy, 1));

        // Recalculate end point where it leaves the screen
        RayEndScreenUV = RayStartScreenUV + (RayEndScreenUV - RayStartScreenUV) * ScreenEdgeIntersections.y;
    }

    float BaseMipLevel = -1;
    float MipLevel = BaseMipLevel;

    float3 RayDirectionScreenUV = RayEndScreenUV - RayStartScreenUV;
    float CurrentIntersectionTime = 0;
    float LastAboveSurfaceTime = 0;

    // Offset to pick which XY boundary planes to intersect
    float2 FloorOffset = float2(RayDirectionScreenUV.x < 0 ? 0 : 1, RayDirectionScreenUV.y < 0 ? 0 : 1);

    float3 RayScreenUV = RayStartScreenUV;

    // Step out of current tile without hit test to avoid self-intersection
    bool bStepOutOfCurrentTile = true;

    if (bStepOutOfCurrentTile)
    {
        float MipLevelForStepOut = MipLevel;
        float2 CurrentMipTexelSize = exp2(MipLevelForStepOut) * InHZBBaseTexelSize;
        float2 CurrentMipResolution = 1.0f / CurrentMipTexelSize;

        float2 UVOffset = .005f * CurrentMipTexelSize;
        UVOffset = float2(RayDirectionScreenUV.x < 0 ? -UVOffset.x : UVOffset.x, RayDirectionScreenUV.y < 0 ? -UVOffset.y : UVOffset.y);

        float2 XYPlane = floor(RayScreenUV.xy * CurrentMipResolution) + FloorOffset;
        XYPlane = XYPlane * CurrentMipTexelSize + UVOffset;

        float2 PlaneIntersectionTimes = (XYPlane - RayStartScreenUV.xy) / RayDirectionScreenUV.xy;
        float IntersectionTime = min(PlaneIntersectionTimes.x, PlaneIntersectionTimes.y);
        CurrentIntersectionTime = IntersectionTime;
        RayScreenUV = RayStartScreenUV + CurrentIntersectionTime * RayDirectionScreenUV;
    }

    if (CurrentIntersectionTime >= 1.0f)
    {
        // If bStepOutOfCurrentTile caused the ray to terminate rewind to the start of the ray since screen trace will be skipped
        RayScreenUV = RayStartScreenUV;
    }

    float NumIterations = 0;
    bHit = false;
    bUncertain = false;
    OutHitTileZ = 0;

    // Stackless HZB traversal
    while (MipLevel >= BaseMipLevel
        && NumIterations < MaxIterations
        && CurrentIntersectionTime < 1.0f

        )
    {
        float2 CurrentMipTexelSize = exp2(MipLevel) * InHZBBaseTexelSize;
        float2 CurrentMipResolution = 1.0f / CurrentMipTexelSize;

        float2 UVOffset = .005f * CurrentMipTexelSize;
        UVOffset = float2(RayDirectionScreenUV.x < 0 ? -UVOffset.x : UVOffset.x, RayDirectionScreenUV.y < 0 ? -UVOffset.y : UVOffset.y);

        float2 XYPlane = floor(RayScreenUV.xy * CurrentMipResolution) + FloorOffset;
        XYPlane = XYPlane * CurrentMipTexelSize + UVOffset;

        float TileZ;

        if (MipLevel < 0)
        {
            TileZ = _SdfDiffuseDepth.SampleLevel(sampler_PointClamp, RayScreenUV.xy * InHZBUVToScreenUVScaleBias.xy + InHZBUVToScreenUVScaleBias.zw, 0).r;

        }
        else

        {
            TileZ = LoadClosestHzb(RayScreenUV.xy, (uint)MipLevel);

        }

        float3 BoundaryPlanes = float3(XYPlane, TileZ);

        float3 PlaneIntersectionTimes = (BoundaryPlanes - RayStartScreenUV) / RayDirectionScreenUV;
        PlaneIntersectionTimes.z = RayDirectionScreenUV.z < 0 ? PlaneIntersectionTimes.z : 1.0f;
        float IntersectionTime = min(PlaneIntersectionTimes.x, PlaneIntersectionTimes.y);

        bool bAboveSurface = RayScreenUV.z > TileZ;
        bool bSkippedTile = bAboveSurface;

        {
            IntersectionTime = min(IntersectionTime, PlaneIntersectionTimes.z);
            bSkippedTile &= IntersectionTime != PlaneIntersectionTimes.z;
        }

        if (bSkippedTile)
        {
            LastAboveSurfaceTime = IntersectionTime;
        }

        CurrentIntersectionTime = bAboveSurface ? IntersectionTime : CurrentIntersectionTime;
        RayScreenUV = RayStartScreenUV + min(CurrentIntersectionTime, 1.0f) * RayDirectionScreenUV;
        MipLevel += bSkippedTile ? 1 : -1;

        NumIterations++;
    }

    if (MipLevel < BaseMipLevel && CurrentIntersectionTime < 1.0f)
    {
        float TileZ;

        TileZ = _SdfDiffuseDepth.SampleLevel(sampler_PointClamp, RayScreenUV.xy * InHZBUVToScreenUVScaleBias.xy + InHZBUVToScreenUVScaleBias.zw, 0).r;

        OutHitTileZ = TileZ;

        float HitSceneDepth = ScreenTraceEyeDepth(TileZ);
        float RaySceneDepth = ScreenTraceEyeDepth(RayScreenUV.z);

        bHit = (RaySceneDepth - HitSceneDepth) < RelativeDepthThickness * max(HitSceneDepth, .0000001f);

        if (!bHit)
        {
            // We went below the surface and couldn't count it as a hit, rewind to the last time we were above
            RayScreenUV = RayStartScreenUV + LastAboveSurfaceTime * RayDirectionScreenUV;
        }
    }

    // Linear steps to determine feature thickness along the ray, to reject hits behind very thin surfaces (grass / hair / foliage)
    if (bHit && !bUncertain && NumThicknessStepsToDetermineCertainty > 0)
    {
        float ThicknessSearchMipLevel = 0.0f;
        float MipNumTexels = exp2(ThicknessSearchMipLevel);
        float2 HZBTileSize = MipNumTexels * InHZBBaseTexelSize;
        float NumSteps = NumThicknessStepsToDetermineCertainty / MipNumTexels;
        float ThicknessSearchEndTime = min(length(RayDirectionScreenUV.xy * HZBTileSize * NumSteps) / length(RayEndScreenUV.xy - RayScreenUV.xy), 1.0f);

        for (float I = 0; I < NumSteps; I++)
        {
            float3 SampleUV = RayScreenUV + (I / NumSteps) * ThicknessSearchEndTime * (RayEndScreenUV - RayScreenUV);

            if (all(SampleUV.xy > 0) && all(SampleUV.xy < InHZBUvFactorAndInvFactor.xy))
            {
                float SampleTileZ = LoadClosestHzb(SampleUV.xy, (uint)ThicknessSearchMipLevel);

                if (SampleUV.z > SampleTileZ)
                {
                    bUncertain = true;
                }
            }
        }
    }

    // Output in GBuffer SceneUV space for xy
    OutScreenUV.xy = RayScreenUV.xy * InHZBUVToScreenUVScaleBias.xy + InHZBUVToScreenUVScaleBias.zw;
    OutScreenUV.z = RayScreenUV.z;

    float3 LastVisibleScreenUV = RayStartScreenUV + LastAboveSurfaceTime * RayDirectionScreenUV;
    OutLastVisibleScreenUV.xy = LastVisibleScreenUV.xy * InHZBUVToScreenUVScaleBias.xy + InHZBUVToScreenUVScaleBias.zw;
    OutLastVisibleScreenUV.z = LastVisibleScreenUV.z;
}

float HitVignette(float2 screenPosition)
{
    float2 vignette = saturate(abs(screenPosition) * 5 - 4);
    return saturate(1.0 - dot(vignette, vignette));
}

// LumenScreenProbeTracing.usf, ScreenProbeTraceScreenTexturesCS, desktop opaque path.
[numthreads(8, 8, 1)]
#if defined(VIVID_SDF_RECEIVER)
void TraceLumenScreenRaysWithSdf(uint3 id : SV_DispatchThreadID)
#else
void TraceLumenScreenRays(uint3 id : SV_DispatchThreadID)
#endif
{
    uint2 tile = id.xy / 8u;
    uint ray = (id.x & 7u) + (id.y & 7u) * 8u;
    uint2 size = uint2(_SdfDiffuseScreenSize.xy);
    uint2 grid = ProbeGridSize(size);
    if (tile.x >= grid.x || tile.y >= ProbeAtlasHeight(grid)) return;
    _SdfScreenRaysOutput[id.xy] = 0.0;
    uint2 pixel;
    float3 position, normal;
    if (!LoadProbeReceiverPixel(tile, size, pixel) || !LoadReceiver(pixel, position, normal)) return;

    uint bin;
    float inverseRelativePdf;
    float3 direction = SampleDiffuseProbeRay(tile, ray, ProbeSeed(tile), DiffuseProbeFrame(normal), bin, inverseRelativePdf);
    float2 uv = (float2(pixel) + 0.5) * _SdfDiffuseScreenSize.zw;
    float depth = _SdfDiffuseDepth.Load(int3(pixel, 0));
    float3 corner = ComputeWorldSpacePosition(uv + 0.5 * _SdfDiffuseScreenSize.zw, depth, _SdfDiffuseInverseVP);
    float normalBias = abs(dot(corner - position, normal)) * 2;
    float3 origin = position + normalBias * normal;
    float4 startClip = mul(_SdfDiffuseVP, float4(origin, 1.0));
    if (any(startClip.xy < -startClip.w) || any(startClip.xy > startClip.w)) return;

    uint level = GetWorldCoverage(position);
    float maxDistance = max(_SdfDiffuseMaxDistance, _SdfFarTraceDistance);
    float traceDistance = level < WorldClipmaps ? min(maxDistance, WorldNearDistance(level)) : maxDistance;
    float thicknessScale = 1.0;
#if defined(VIVID_SDF_RECEIVER)
    uint index = _SdfReceiverVisibility.Load(int3(pixel, 0)).x - VIVID_VISIBILITY_BUFFER_INSTANCE_ID_BIAS;
    thicknessScale = index < _SdfReceiverCount && _SdfReceiverEntities[index].z != 0xffffffffu ? 1.0 : 2.0;
#endif
    float2 hzbFactor = _SdfDiffuseScreenSize.xy / (2.0 * _SdfClosestHzbSize.xy);
    bool hit = false, uncertain = false;
    float3 hitUVz = 0.0, lastVisible = 0.0;
    float hitTileZ = 0.0;
    TraceHZB(rcp(_SdfClosestHzbSize.xy), float4(rcp(hzbFactor), 0, 0), origin, direction,
        traceDistance, float4(hzbFactor, rcp(hzbFactor)), 50, 0.02 * _SdfDepthThicknessScale * thicknessScale,
        0, 0, hit, uncertain, hitUVz, lastVisible, hitTileZ);
    hit = hit && !uncertain;
    float3 hitPosition = ComputeWorldSpacePosition(hitUVz.xy, hitUVz.z, _SdfDiffuseInverseVP);
    float hitDistance = min(distance(position, hitPosition) + (!hit && !uncertain ? 0.02 : 0.0), maxDistance);

    bool moving = false;
    float3 lighting = 0.0;
    if (hit)
    {
        float2 ndc = (hitUVz.xy - 0.5) / ScreenNdcToUvScale();
        float4 prevClip = mul(_SdfClipToPrevClip, float4(ndc, hitUVz.z, 1.0));
        float3 prevNdc = prevClip.xyz / prevClip.w;
        float4 encoded = _SdfScreenMotion.SampleLevel(sampler_PointClamp, hitUVz.xy, 0);
        if (VividHasObjectVelocity(encoded))
        {
            prevNdc.xy = ndc - VividDecodeMotionUV(encoded) / ScreenNdcToUvScale();
            prevNdc.z = hitUVz.z - VividDecodeMotionDeviceZ(encoded);
        }
        float2 prevUV = prevNdc.xy * ScreenNdcToUvScale() + 0.5;
        float vignette = min(HitVignette(ndc), HitVignette(prevNdc.xy));
        float2 noiseUV = id.xy + 0.5f + (_SdfDiffuseFrame % 8u) * (float2(47, 17) * 0.695f);
        float noise = frac(52.9829189f * frac(dot(noiseUV, float2(0.06711056f, 0.00583715f))));
        hit = vignette >= noise;
        if (hit)
        {
            float2 history = _SdfScreenPreviousGeometry.SampleLevel(sampler_PointClamp, prevUV, 0);
            hit = abs(history.x - prevNdc.z) < 0.005 * _SdfDepthThicknessScale * lerp(0.5f, 2.0f, noise);
            if (hit)
            {
                float2 edge = 0.5 * _SdfDiffuseScreenSize.zw;
                float3 color = _SdfScreenPreviousRadiance.SampleLevel(sampler_PointClamp, clamp(prevUV, edge, 1.0 - edge), 0).rgb;
                float exposure = VividGetPreExposure();
                color = -min(-color, 0.0) * (exposure / history.y);
                // Lumen QuantizeFloatColor, followed by the default R11G11B10 trace target conversion.
                float3 error = asfloat(asuint(color * float3(1.0/64, 1.0/64, 1.0/32)) & ~0x007fffffu);
                lighting = UnpackFromR11G11B10f(PackToR11G11B10f(color + error * noise)) / exposure;
                float3 prevPosition = ComputeWorldSpacePosition(prevUV, prevNdc.z, _SdfScreenPreviousInverseVP);
                moving = RelativeHitMotion(ScreenObjectSpeed(pixel, position), distance(hitPosition, prevPosition), position) > 0.0;
            }
        }
    }
    _SdfScreenRaysOutput[id.xy] = float4(lighting, asfloat(EncodeProbeRayDistance(hitDistance, hit, moving,
        level < WorldClipmaps && hitDistance >= traceDistance)));
}
#endif
