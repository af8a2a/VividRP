#pragma kernel TraceSdfReceiverCachedProbes VIVID_SDF_RECEIVER VIVID_SDF_SURFACE_CACHE
#pragma kernel TraceSdfReceiverCachedSunProbes VIVID_SDF_RECEIVER VIVID_SDF_SURFACE_CACHE VIVID_SDF_CACHED_SUN

#pragma kernel BuildScreenProbeClosestHZB VIVID_BUILD_CLOSEST_HZB
#pragma kernel CaptureScreenProbeSceneColor VIVID_CAPTURE_SCENE_COLOR
#pragma kernel TraceLumenScreenRays VIVID_LUMEN_SCREEN
#pragma kernel TraceLumenScreenRaysWithSdf VIVID_LUMEN_SCREEN VIVID_SDF_RECEIVER
