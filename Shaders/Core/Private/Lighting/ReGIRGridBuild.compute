#pragma kernel ReGIRGridBuild
#pragma enable_d3d11_debug_symbols

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/ReGIR.hlsl"

StructuredBuffer<VividReGIRLightData> _ReGIRLights;
StructuredBuffer<VividReGIRParameters> _ReGIRParameters;
RWStructuredBuffer<VividReGIRReservoir> _ReGIRReservoirs;

uint VividReGIRHash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float VividReGIRRandom01(inout uint state)
{
    state = VividReGIRHash(state);
    return (state & 0x00ffffffu) / 16777216.0;
}

VividReGIRReservoir VividReGIRInvalidReservoir()
{
    VividReGIRReservoir reservoir;
    reservoir.lightIndex = VIVID_REGIR_INVALID_LIGHT_INDEX;
    reservoir.weight = 0.0;
    reservoir.pad0 = 0u;
    reservoir.pad1 = 0u;
    return reservoir;
}

[numthreads(256, 1, 1)]
void ReGIRGridBuild(uint globalIndex : SV_DispatchThreadID)
{
    VividReGIRParameters parameters = _ReGIRParameters[0];
    if (globalIndex >= parameters.slotCount)
        return;

    if (parameters.lightCount == 0u || parameters.buildSamples == 0u || parameters.lightsPerCell == 0u)
    {
        _ReGIRReservoirs[globalIndex] = VividReGIRInvalidReservoir();
        return;
    }

    uint cellIndex = globalIndex / parameters.lightsPerCell;
    uint lightInCell = globalIndex - cellIndex * parameters.lightsPerCell;
    uint rng = VividReGIRHash(
        globalIndex
        ^ (parameters.frameIndex * 1664525u)
        ^ (lightInCell * 1013904223u));

    float3 cellCenter;
    float cellRadius;
    if (!VividReGIRCellIndexToWorldPos(parameters, cellIndex, cellCenter, cellRadius))
    {
        _ReGIRReservoirs[globalIndex] = VividReGIRInvalidReservoir();
        return;
    }

    float jitterScale = max(parameters.samplingJitter, 0.0);
    if (jitterScale > 0.0)
    {
        float3 jitter = float3(
            VividReGIRRandom01(rng),
            VividReGIRRandom01(rng),
            VividReGIRRandom01(rng)) - 0.5;
        cellCenter += jitter * VividReGIRGetJitterScale(parameters, cellCenter);
    }

    uint selectedLightIndex = VIVID_REGIR_INVALID_LIGHT_INDEX;
    float selectedTargetWeight = 0.0;
    float weightSum = 0.0;
    uint sampleCount = max(parameters.buildSamples, 1u);
    float invSourcePdfPerSample = float(parameters.lightCount) / float(sampleCount);

    [loop]
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; sampleIndex++)
    {
        rng = VividReGIRHash(rng + sampleIndex + 1u);
        uint candidateLightIndex = rng % parameters.lightCount;
        VividReGIRLightData candidateLight = _ReGIRLights[candidateLightIndex];
        float targetWeight = VividReGIREvaluateLightTargetWeight(candidateLight, cellCenter, cellRadius);
        float risWeight = targetWeight * invSourcePdfPerSample;
        weightSum += risWeight;

        if (risWeight <= 0.0)
            continue;

        float randomValue = VividReGIRRandom01(rng);
        if (randomValue * weightSum < risWeight)
        {
            selectedLightIndex = candidateLightIndex;
            selectedTargetWeight = targetWeight;
        }
    }

    VividReGIRReservoir reservoir;
    reservoir.lightIndex = selectedLightIndex;
    reservoir.weight = selectedTargetWeight > 0.0 ? weightSum / selectedTargetWeight : 0.0;
    reservoir.pad0 = 0u;
    reservoir.pad1 = 0u;

    if (reservoir.weight <= 0.0)
        reservoir = VividReGIRInvalidReservoir();

    _ReGIRReservoirs[globalIndex] = reservoir;
}
