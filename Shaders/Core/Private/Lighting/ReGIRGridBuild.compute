#pragma kernel ReGIRGridBuild
#pragma kernel ReGIRPrepareLightPdf
#pragma kernel ReGIRReduceLightPdf
#pragma kernel ReGIRPresampleLocalLights
#pragma enable_d3d11_debug_symbols

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/ReGIR.hlsl"

#define VIVID_REGIR_PRESAMPLED_LIGHT_TILE_SIZE 1024u
#define VIVID_REGIR_PRESAMPLED_LIGHT_TILE_COUNT 128u
#define VIVID_REGIR_PRESAMPLED_LIGHT_COUNT (VIVID_REGIR_PRESAMPLED_LIGHT_TILE_SIZE * VIVID_REGIR_PRESAMPLED_LIGHT_TILE_COUNT)

StructuredBuffer<VividReGIRLightData> _ReGIRLights;
StructuredBuffer<VividReGIRParameters> _ReGIRParameters;
RWStructuredBuffer<VividReGIRReservoir> _ReGIRReservoirs;
RWStructuredBuffer<uint2> _ReGIRPresampledLights;
Texture2D<float> _ReGIRLightPdfTexture;
RWTexture2D<float> _ReGIRLightPdfMipInput;
RWTexture2D<float> _ReGIRLightPdfMipOutput;
uint _ReGIRLightPdfSourceMip;

uint VividReGIRHash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float VividReGIRRandom01(inout uint state)
{
    state = VividReGIRHash(state);
    return (state & 0x00ffffffu) / 16777216.0;
}

uint VividReGIRIntegerExplode(uint value)
{
    value = (value | (value << 8)) & 0x00FF00FFu;
    value = (value | (value << 4)) & 0x0F0F0F0Fu;
    value = (value | (value << 2)) & 0x33333333u;
    value = (value | (value << 1)) & 0x55555555u;
    return value;
}

uint VividReGIRZCurveToLinearIndex(uint2 position)
{
    return VividReGIRIntegerExplode(position.x)
        | (VividReGIRIntegerExplode(position.y) << 1);
}

VividReGIRReservoir VividReGIRInvalidReservoir()
{
    VividReGIRReservoir reservoir;
    reservoir.lightIndex = VIVID_REGIR_INVALID_LIGHT_INDEX;
    reservoir.weight = 0.0;
    reservoir.pad0 = 0u;
    reservoir.pad1 = 0u;
    return reservoir;
}

uint2 VividReGIRInvalidPresampledLight()
{
    return uint2(VIVID_REGIR_INVALID_LIGHT_INDEX, 0u);
}

uint VividReGIRGetPdfMipSize(uint baseSize, uint mipLevel)
{
    return max(baseSize >> mipLevel, 1u);
}

float VividReGIRLoadPdfTexel(VividReGIRParameters parameters, uint2 position, uint mipLevel)
{
    uint mipWidth = VividReGIRGetPdfMipSize(max(parameters.lightPdfTextureWidth, 1u), mipLevel);
    uint mipHeight = VividReGIRGetPdfMipSize(max(parameters.lightPdfTextureHeight, 1u), mipLevel);
    if (position.x >= mipWidth || position.y >= mipHeight)
        return 0.0;

    return max(_ReGIRLightPdfTexture.Load(int3(int2(position), int(mipLevel))), 0.0);
}

float VividReGIRLoadPdfMipInputTexel(VividReGIRParameters parameters, uint2 position, uint mipLevel)
{
    uint mipWidth = VividReGIRGetPdfMipSize(max(parameters.lightPdfTextureWidth, 1u), mipLevel);
    uint mipHeight = VividReGIRGetPdfMipSize(max(parameters.lightPdfTextureHeight, 1u), mipLevel);
    if (position.x >= mipWidth || position.y >= mipHeight)
        return 0.0;

    return max(_ReGIRLightPdfMipInput[position], 0.0);
}

[numthreads(256, 1, 1)]
void ReGIRPrepareLightPdf(uint globalIndex : SV_DispatchThreadID)
{
    VividReGIRParameters parameters = _ReGIRParameters[0];
    uint pdfWidth = max(parameters.lightPdfTextureWidth, 1u);
    uint pdfHeight = max(parameters.lightPdfTextureHeight, 1u);
    uint texelCount = pdfWidth * pdfHeight;
    if (globalIndex >= texelCount)
        return;

    uint2 texelPosition = uint2(globalIndex % pdfWidth, globalIndex / pdfWidth);
    float power = 0.0;
    uint lightIndex = VividReGIRZCurveToLinearIndex(texelPosition);
    if (lightIndex < parameters.lightCount)
        power = max(_ReGIRLights[lightIndex].power, 0.0);

    _ReGIRLightPdfMipOutput[texelPosition] = power;
}

[numthreads(8, 8, 1)]
void ReGIRReduceLightPdf(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    VividReGIRParameters parameters = _ReGIRParameters[0];
    uint sourceMip = _ReGIRLightPdfSourceMip;
    uint destinationMip = sourceMip + 1u;
    uint destinationWidth = VividReGIRGetPdfMipSize(max(parameters.lightPdfTextureWidth, 1u), destinationMip);
    uint destinationHeight = VividReGIRGetPdfMipSize(max(parameters.lightPdfTextureHeight, 1u), destinationMip);
    uint2 destinationPosition = dispatchThreadId.xy;
    if (destinationPosition.x >= destinationWidth || destinationPosition.y >= destinationHeight)
        return;

    uint2 sourcePosition = destinationPosition * 2u;
    float sum = 0.0;
    sum += VividReGIRLoadPdfMipInputTexel(parameters, sourcePosition + uint2(0u, 0u), sourceMip);
    sum += VividReGIRLoadPdfMipInputTexel(parameters, sourcePosition + uint2(1u, 0u), sourceMip);
    sum += VividReGIRLoadPdfMipInputTexel(parameters, sourcePosition + uint2(0u, 1u), sourceMip);
    sum += VividReGIRLoadPdfMipInputTexel(parameters, sourcePosition + uint2(1u, 1u), sourceMip);

    _ReGIRLightPdfMipOutput[destinationPosition] = sum;
}

bool VividReGIRSampleLightPdf(
    VividReGIRParameters parameters,
    inout uint rng,
    out uint lightIndex,
    out float invSourcePdf)
{
    lightIndex = VIVID_REGIR_INVALID_LIGHT_INDEX;
    invSourcePdf = 0.0;

    uint pdfWidth = max(parameters.lightPdfTextureWidth, 1u);
    uint pdfHeight = max(parameters.lightPdfTextureHeight, 1u);
    uint mipCount = max(parameters.lightPdfTextureMipCount, 1u);
    uint lastMip = mipCount - 1u;
    float totalPower = VividReGIRLoadPdfTexel(parameters, uint2(0u, 0u), lastMip);
    if (totalPower <= 0.0)
        return false;

    uint2 position = uint2(0u, 0u);
    [loop]
    for (int mipLevel = int(lastMip) - 1; mipLevel >= 0; mipLevel--)
    {
        uint sourceMip = uint(mipLevel);
        uint2 basePosition = position * 2u;

        float4 weights = float4(
            VividReGIRLoadPdfTexel(parameters, basePosition + uint2(0u, 0u), sourceMip),
            VividReGIRLoadPdfTexel(parameters, basePosition + uint2(1u, 0u), sourceMip),
            VividReGIRLoadPdfTexel(parameters, basePosition + uint2(0u, 1u), sourceMip),
            VividReGIRLoadPdfTexel(parameters, basePosition + uint2(1u, 1u), sourceMip));
        float weightSum = weights.x + weights.y + weights.z + weights.w;
        if (weightSum <= 0.0)
            return false;

        float randomValue = VividReGIRRandom01(rng) * weightSum;
        if (randomValue < weights.x)
        {
            position = basePosition + uint2(0u, 0u);
        }
        else if (randomValue < weights.x + weights.y)
        {
            position = basePosition + uint2(1u, 0u);
        }
        else if (randomValue < weights.x + weights.y + weights.z)
        {
            position = basePosition + uint2(0u, 1u);
        }
        else
        {
            position = basePosition + uint2(1u, 1u);
        }
    }

    if (position.x >= pdfWidth || position.y >= pdfHeight)
        return false;

    uint texelIndex = VividReGIRZCurveToLinearIndex(position);
    if (texelIndex >= parameters.lightCount)
        return false;

    float selectedPower = VividReGIRLoadPdfTexel(parameters, position, 0u);
    if (selectedPower <= 0.0)
        return false;

    lightIndex = texelIndex;
    invSourcePdf = totalPower / selectedPower;
    return true;
}

uint VividReGIRSelectPresampledLightTileOffset(inout uint coherentRng)
{
    float tileRandom = VividReGIRRandom01(coherentRng);
    uint tileIndex = min(
        (uint)floor(tileRandom * VIVID_REGIR_PRESAMPLED_LIGHT_TILE_COUNT),
        VIVID_REGIR_PRESAMPLED_LIGHT_TILE_COUNT - 1u);
    return tileIndex * VIVID_REGIR_PRESAMPLED_LIGHT_TILE_SIZE;
}

bool VividReGIRSelectPresampledSourceLight(
    VividReGIRParameters parameters,
    inout uint rng,
    uint presampledLightTileOffset,
    out uint lightIndex,
    out float invSourcePdf)
{
    float sampleRandom = VividReGIRRandom01(rng);
    uint sampleInTile = min(
        (uint)floor(sampleRandom * VIVID_REGIR_PRESAMPLED_LIGHT_TILE_SIZE),
        VIVID_REGIR_PRESAMPLED_LIGHT_TILE_SIZE - 1u);
    uint2 presampledLight = _ReGIRPresampledLights[presampledLightTileOffset + sampleInTile];

    lightIndex = presampledLight.x;
    invSourcePdf = asfloat(presampledLight.y);
    return lightIndex < parameters.lightCount && invSourcePdf > 0.0;
}

void VividReGIRSelectSourceLight(
    VividReGIRParameters parameters,
    inout uint rng,
    uint presampledLightTileOffset,
    out uint lightIndex,
    out float invSourcePdf)
{
    if (parameters.sourceSamplingMode == VIVID_REGIR_SOURCE_SAMPLING_POWER_RIS
        && VividReGIRSelectPresampledSourceLight(parameters, rng, presampledLightTileOffset, lightIndex, invSourcePdf))
    {
        return;
    }

    lightIndex = min(
        (uint)floor(VividReGIRRandom01(rng) * parameters.lightCount),
        parameters.lightCount - 1u);
    invSourcePdf = float(parameters.lightCount);
}

[numthreads(256, 1, 1)]
void ReGIRPresampleLocalLights(uint globalIndex : SV_DispatchThreadID)
{
    if (globalIndex >= VIVID_REGIR_PRESAMPLED_LIGHT_COUNT)
        return;

    VividReGIRParameters parameters = _ReGIRParameters[0];
    if (parameters.lightCount == 0u)
    {
        _ReGIRPresampledLights[globalIndex] = VividReGIRInvalidPresampledLight();
        return;
    }

    uint rng = VividReGIRHash(
        globalIndex
        ^ (parameters.frameIndex * 1664525u)
        ^ 0x9e3779b9u);

    uint lightIndex;
    float invSourcePdf;
    if (!VividReGIRSampleLightPdf(parameters, rng, lightIndex, invSourcePdf))
    {
        _ReGIRPresampledLights[globalIndex] = VividReGIRInvalidPresampledLight();
        return;
    }

    _ReGIRPresampledLights[globalIndex] = uint2(lightIndex, asuint(invSourcePdf));
}

[numthreads(256, 1, 1)]
void ReGIRGridBuild(uint globalIndex : SV_DispatchThreadID)
{
    VividReGIRParameters parameters = _ReGIRParameters[0];
    if (globalIndex >= parameters.slotCount)
        return;

    if (parameters.lightCount == 0u || parameters.buildSamples == 0u || parameters.lightsPerCell == 0u)
    {
        _ReGIRReservoirs[globalIndex] = VividReGIRInvalidReservoir();
        return;
    }

    uint cellIndex = globalIndex / parameters.lightsPerCell;
    uint lightInCell = globalIndex - cellIndex * parameters.lightsPerCell;
    uint rng = VividReGIRHash(
        globalIndex
        ^ (parameters.frameIndex * 1664525u)
        ^ (lightInCell * 1013904223u));

    float3 cellCenter;
    float cellRadius;
    if (!VividReGIRCellIndexToWorldPos(parameters, cellIndex, cellCenter, cellRadius))
    {
        _ReGIRReservoirs[globalIndex] = VividReGIRInvalidReservoir();
        return;
    }

    cellRadius *= max(parameters.samplingJitter, 0.0) + 1.0;
    uint coherentRng = VividReGIRHash(
        cellIndex
        ^ (parameters.frameIndex * 747796405u)
        ^ (lightInCell * 2891336453u));
    uint presampledLightTileOffset = parameters.sourceSamplingMode == VIVID_REGIR_SOURCE_SAMPLING_POWER_RIS
        ? VividReGIRSelectPresampledLightTileOffset(coherentRng)
        : 0u;

    uint selectedLightIndex = VIVID_REGIR_INVALID_LIGHT_INDEX;
    float selectedTargetWeight = 0.0;
    float weightSum = 0.0;
    uint sampleCount = max(parameters.buildSamples, 1u);
    float invSampleCount = 1.0 / float(sampleCount);

    [loop]
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; sampleIndex++)
    {
        rng = VividReGIRHash(rng + sampleIndex + 1u);
        uint candidateLightIndex;
        float invSourcePdf;
        VividReGIRSelectSourceLight(parameters, rng, presampledLightTileOffset, candidateLightIndex, invSourcePdf);
        VividReGIRLightData candidateLight = _ReGIRLights[candidateLightIndex];
        float targetWeight = VividReGIREvaluateLightTargetWeight(candidateLight, cellCenter, cellRadius);
        float risWeight = targetWeight * invSourcePdf * invSampleCount;
        weightSum += risWeight;

        if (risWeight <= 0.0)
            continue;

        float randomValue = VividReGIRRandom01(rng);
        if (randomValue * weightSum < risWeight)
        {
            selectedLightIndex = candidateLightIndex;
            selectedTargetWeight = targetWeight;
        }
    }

    VividReGIRReservoir reservoir;
    reservoir.lightIndex = selectedLightIndex;
    reservoir.weight = selectedTargetWeight > 0.0 ? weightSum / selectedTargetWeight : 0.0;
    reservoir.pad0 = 0u;
    reservoir.pad1 = 0u;

    if (reservoir.weight <= 0.0)
        reservoir = VividReGIRInvalidReservoir();

    _ReGIRReservoirs[globalIndex] = reservoir;
}
