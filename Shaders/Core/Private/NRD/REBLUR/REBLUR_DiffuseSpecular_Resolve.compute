#pragma kernel Prepare
#pragma kernel Resolve
#pragma kernel ResolveRaw
#pragma use_dxc

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/NRD/REBLUR/VividReblurSignalEncoding.hlsli"

Texture2D<float4> _ReblurDiffuse;
Texture2D<float4> _ReblurSpecular;
Texture2D<float4> _ReblurResolvedDiffuse;
Texture2D<float4> _ReblurResolvedSpecular;
Texture2D<float4> _ReblurDiffuseMaterialFactor;
Texture2D<float4> _ReblurSpecularMaterialFactor;
Texture2D<float4> _ReblurDirectLighting;
Texture2D<float4> _ReblurEmission;
RWTexture2D<float4> _ReblurPreparedDiffuse;
RWTexture2D<float4> _ReblurPreparedSpecular;
RWTexture2D<float4> _ReblurResolvedColor;
float2 _ReblurResolveScreenSize;
float2 _ReblurCheckerboardModes;
int _ReblurFrameIndex;
int _ReblurMainLightInSignals;

float3 ReblurSanitizeHalfRadiance(float3 radiance)
{
    if (any(isnan(radiance)) || any(isinf(radiance)))
        return 0.0;

    return clamp(radiance, 0.0, 65504.0);
}

float3 ReblurPreparePresentationRadiance(float3 sceneRadiance)
{
    if (any(isnan(sceneRadiance)) || any(isinf(sceneRadiance)))
        return 0.0;

    // REBLUR history and all path-tracing AOVs remain in absolute scene-linear radiance.
    // Only the final presentation color is converted to VividRP's pre-exposed lighting space.
    float3 preExposedRadiance = VividApplyPreExposure(max(sceneRadiance, 0.0));
    return any(isnan(preExposedRadiance)) || any(isinf(preExposedRadiance))
        ? 0.0
        : max(preExposedRadiance, 0.0);
}

uint ReblurCheckerboard(uint2 pixelCoord)
{
    return (pixelCoord.x ^ pixelCoord.y ^ (uint)_ReblurFrameIndex) & 1u;
}

uint2 ReblurGetMaterialFactorPixel(uint2 packedPixelCoord, uint checkerboardMode)
{
    if (checkerboardMode == 2u)
        return packedPixelCoord;

    uint2 pixelCoord = uint2(packedPixelCoord.x << 1u, packedPixelCoord.y);
    if (ReblurCheckerboard(pixelCoord) != checkerboardMode)
        pixelCoord.x++;

    return min(pixelCoord, (uint2)_ReblurResolveScreenSize - 1u);
}

[numthreads(8, 8, 1)]
void Prepare(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= (uint2)_ReblurResolveScreenSize))
        return;

    uint diffuseCheckerboard = (uint)_ReblurCheckerboardModes.x;
    uint specularCheckerboard = (uint)_ReblurCheckerboardModes.y;
    uint packedWidth = ((uint)_ReblurResolveScreenSize.x + 1u) >> 1u;
    if (diffuseCheckerboard != 2u && pixelCoord.x >= packedWidth)
    {
        _ReblurPreparedDiffuse[pixelCoord] = 0.0;
        _ReblurPreparedSpecular[pixelCoord] = 0.0;
        return;
    }

    uint2 diffuseMaterialPixel =
        ReblurGetMaterialFactorPixel(pixelCoord, diffuseCheckerboard);
    uint2 specularMaterialPixel =
        ReblurGetMaterialFactorPixel(pixelCoord, specularCheckerboard);
    float4 diffuse = _ReblurDiffuse.Load(int3(pixelCoord, 0));
    float4 specular = _ReblurSpecular.Load(int3(pixelCoord, 0));
    float3 diffuseFactor = max(
        _ReblurDiffuseMaterialFactor.Load(int3(diffuseMaterialPixel, 0)).xyz,
        0.02);
    float3 specularFactor = max(
        _ReblurSpecularMaterialFactor.Load(int3(specularMaterialPixel, 0)).xyz,
        0.02);
    float3 diffuseRadiance = ReblurSanitizeHalfRadiance(
        VividReblurDecodeRadiance(diffuse.xyz) / diffuseFactor);
    float3 specularRadiance = ReblurSanitizeHalfRadiance(
        VividReblurDecodeRadiance(specular.xyz) / specularFactor);

    _ReblurPreparedDiffuse[pixelCoord] =
        float4(VividReblurEncodeRadiance(diffuseRadiance), diffuse.w);
    _ReblurPreparedSpecular[pixelCoord] =
        float4(VividReblurEncodeRadiance(specularRadiance), specular.w);
}

[numthreads(8, 8, 1)]
void Resolve(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= (uint2)_ReblurResolveScreenSize))
        return;

    float4 diffuse = _ReblurResolvedDiffuse.Load(int3(pixelCoord, 0));
    float4 specular = _ReblurResolvedSpecular.Load(int3(pixelCoord, 0));
    float3 diffuseFactor =
        _ReblurDiffuseMaterialFactor.Load(int3(pixelCoord, 0)).xyz;
    float3 specularFactor =
        _ReblurSpecularMaterialFactor.Load(int3(pixelCoord, 0)).xyz;
    float4 directLighting = _ReblurDirectLighting.Load(int3(pixelCoord, 0));
    float4 emission = _ReblurEmission.Load(int3(pixelCoord, 0));
    float3 unfilteredDirectLighting = _ReblurMainLightInSignals != 0
        ? 0.0
        : max(directLighting.xyz, 0.0);
    float3 color =
        VividReblurDecodeRadiance(diffuse.xyz) * max(diffuseFactor, 0.0)
        + VividReblurDecodeRadiance(specular.xyz) * max(specularFactor, 0.0)
        + unfilteredDirectLighting
        + max(emission.xyz, 0.0);
    _ReblurResolvedColor[pixelCoord] =
        float4(ReblurPreparePresentationRadiance(color), max(directLighting.w, emission.w));
}

[numthreads(8, 8, 1)]
void ResolveRaw(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= (uint2)_ReblurResolveScreenSize))
        return;

    uint diffuseCheckerboard = (uint)_ReblurCheckerboardModes.x;
    uint specularCheckerboard = (uint)_ReblurCheckerboardModes.y;
    uint2 signalPixelCoord = diffuseCheckerboard == 2u
        ? pixelCoord
        : uint2(pixelCoord.x >> 1u, pixelCoord.y);
    uint checkerboard = ReblurCheckerboard(pixelCoord);
    float4 diffuse = diffuseCheckerboard == 2u || checkerboard == diffuseCheckerboard
        ? _ReblurDiffuse.Load(int3(signalPixelCoord, 0))
        : 0.0;
    float4 specular = specularCheckerboard == 2u || checkerboard == specularCheckerboard
        ? _ReblurSpecular.Load(int3(signalPixelCoord, 0))
        : 0.0;
    float4 directLighting = _ReblurDirectLighting.Load(int3(pixelCoord, 0));
    float4 emission = _ReblurEmission.Load(int3(pixelCoord, 0));
    float3 unfilteredDirectLighting = _ReblurMainLightInSignals != 0
        ? 0.0
        : max(directLighting.xyz, 0.0);
    float3 color = VividReblurDecodeRadiance(diffuse.xyz)
        + VividReblurDecodeRadiance(specular.xyz)
        + unfilteredDirectLighting
        + max(emission.xyz, 0.0);
    _ReblurResolvedColor[pixelCoord] =
        float4(ReblurPreparePresentationRadiance(color), max(directLighting.w, emission.w));
}
