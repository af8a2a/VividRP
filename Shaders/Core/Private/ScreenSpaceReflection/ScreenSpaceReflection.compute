
#pragma kernel ScreenSpaceReflectionsClassifyTiles
#pragma kernel ScreenSpaceReflectionsTracing
#pragma kernel ScreenSpaceReflectionsResolve
#pragma kernel ScreenSpaceReflectionsAccumulate
#pragma kernel ScreenSpaceReflectionsHDRPTracing
#pragma kernel ScreenSpaceReflectionsHDRPReprojection
#pragma kernel ScreenSpaceReflectionsHDRPAccumulate
#pragma kernel CopyScreenSpaceReflection
#pragma use_dxc
#pragma require Native16Bit



#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/Core.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/DebugUtil.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/GBuffer.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/BlueNoise.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/ImageBasedLighting.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"

#define SSR_TRACE_BEHIND_OBJECTS
#define SSR_TRACE_EPS 0.000488281f
#define SSR_THREAD_GROUP_SIZE 8u
#define SSR_THREAD_COUNT 64
#define SSR_TILE_COORD_MASK 0xffffu
#define SSR_MIN_GGX_ROUGHNESS 0.00001f
#define SSR_MAX_GGX_ROUGHNESS 0.99999f




RWTexture2D<float4> _OutputColorTexture;
RWTexture2D<float4> _SSRTraceTexture;
RWTexture2D<float4> _SSRResolveTexture;
RWTexture2D<float4> _SSRRayInfoTexture;
RWTexture2D<float4> _SSRDebugTexture;
RWTexture2D<float4> _SSRHDRPHitPointTexture;
RWTexture2D<float4> _SSRHDRPAccumTexture;
RWTexture2D<float4> _SSRHDRPOutputTexture;
RWStructuredBuffer<uint> _SSRDispatchIndirectArgs;
RWStructuredBuffer<uint> _SSRTileList;
Texture2D<float> _DepthTexture;
Texture2D<float> _HZBTexture;
StructuredBuffer<int2> _DepthPyramidMipLevelOffsets;
Texture2D<float4> _GBuffer0;
Texture2D<float4> _GBuffer1;
Texture2D<float4> _GBuffer2;
Texture2D<float4> _PreviousColorPyramidTexture;
TEXTURECUBE(_SkyTexture);
SAMPLER(sampler_SkyTexture);
float4 _SkyTextureTint;
float4 _SkyTextureParams;
int _SsrWriteHDRPToOutput;

CBUFFER_START(ShaderVariablesScreenSpaceReflection)
    float4 _SsrTraceScreenSize;
    float _SsrThicknessScale;
    float _SsrThicknessBias;
    int _SsrIterLimit;
    int _SsrDepthPyramidMaxMip;
    float _SsrRoughnessFadeEnd;
    float _SsrRoughnessFadeRcpLength;
    float _SsrRoughnessFadeEndTimesRcpLength;
    float _SsrEdgeFadeRcpLength;
    float _SsrIntensity;
    float _SsrIntensityClamp;
    int _SsrReflectsSky;
    int _SsrFrameIndex;
    float4 _SsrHistoryColorPyramidSize;
    int _SsrUseHistoryColorPyramid;
    int _SsrHistoryColorPyramidMaxMip;
    float2 _SsrPadding1;
    float4 _SsrWorldSpaceCameraPos;
    float4x4 _SsrViewProjMatrix;
    float4x4 _SsrInvViewProjMatrix;
    float4x4 _SsrPrevViewProjMatrix;
CBUFFER_END

uint EncodeSSRTileIndex(uint2 tileCoord)
{
    return (tileCoord.x & SSR_TILE_COORD_MASK) | ((tileCoord.y & SSR_TILE_COORD_MASK) << 16);
}

uint2 DecodeSSRTileIndex(uint encodedTile)
{
    return uint2(encodedTile & SSR_TILE_COORD_MASK, (encodedTile >> 16) & SSR_TILE_COORD_MASK);
}

uint2 GetTilePixelCoord(uint groupIndex, uint2 groupThreadId)
{
    return DecodeSSRTileIndex(_SSRTileList[groupIndex]) * SSR_THREAD_GROUP_SIZE + groupThreadId;
}

float Min3Value(float x, float y, float z)
{
    return min(min(x, y), z);
}

float3 ComputeSsrWorldSpacePosition(float2 screenUV, float deviceDepth)
{
    return ComputeWorldSpacePosition(screenUV, deviceDepth, _SsrInvViewProjMatrix);
}

float3 ComputeSsrNormalizedDeviceCoordinatesWithZ(float3 positionWS)
{
    return ComputeNormalizedDeviceCoordinatesWithZ(positionWS, _SsrViewProjMatrix);
}

float3 GetSsrWorldSpaceNormalizeViewDir(float3 positionWS)
{
    return normalize(_SsrWorldSpaceCameraPos.xyz - positionWS);
}

void StoreSsrWorldGridDebug(uint2 coordSS, float3 positionWS)
{
    if (any(isnan(positionWS)) || any(isinf(positionWS)))
    {
        _SSRDebugTexture[coordSS] = float4(Debug_CheckInvalid(positionWS), 1.0);
        return;
    }

    float3 gridColor = Debug_WorldGrid(positionWS, 1.0, 0.02);
    float3 axisColor = Debug_WorldAxis(positionWS, 0.05) * 0.25;
    _SSRDebugTexture[coordSS] = float4(max(gridColor, axisColor), 1.0);
}

bool IsOutsideScreen(uint2 pixelCoord)
{
    return pixelCoord.x >= (uint)_SsrTraceScreenSize.x || pixelCoord.y >= (uint)_SsrTraceScreenSize.y;
}

int2 ClampPixelCoord(int2 pixelCoord)
{
    int2 maxCoord = int2((int)_SsrTraceScreenSize.x - 1, (int)_SsrTraceScreenSize.y - 1);
    return clamp(pixelCoord, int2(0, 0), maxCoord);
}

float3 SanitizeSsrRadiance(float3 color)
{
    if (any(isnan(color)) || any(isinf(color)))
        return 0.0;

    return min(max(color, 0.0), _SsrIntensityClamp);
}

float4 EmptySsrResult()
{
    return float4(0.0, 0.0, 0.0, 0.0);
}

void StoreEmptySsrTrace(uint2 coordSS)
{
    _SSRTraceTexture[coordSS] = EmptySsrResult();
    _SSRRayInfoTexture[coordSS] = EmptySsrResult();
}

bool IsRawFarDepth(float deviceDepth)
{
    return abs(deviceDepth - UNITY_RAW_FAR_CLIP_VALUE) <= 1e-5f;
}

float3 LoadHistoryPyramidColor(int2 pixelCoord, int mipLevel)
{
    uint width;
    uint height;
    uint mipCount;
    _PreviousColorPyramidTexture.GetDimensions((uint)mipLevel, width, height, mipCount);

    int2 maxCoord = int2(max((int)width - 1, 0), max((int)height - 1, 0));
    pixelCoord = clamp(pixelCoord, int2(0, 0), maxCoord);
    return SanitizeSsrRadiance(_PreviousColorPyramidTexture.Load(int3(pixelCoord, mipLevel)).rgb);
}

float3 SampleHistoryPyramidBilinear(float2 screenUV, int mipLevel)
{
    uint width;
    uint height;
    uint mipCount;
    _PreviousColorPyramidTexture.GetDimensions((uint)mipLevel, width, height, mipCount);

    float2 mipSize = float2((float)max(width, 1u), (float)max(height, 1u));
    float2 pixelCoord = screenUV * mipSize - 0.5;
    int2 baseCoord = (int2)floor(pixelCoord);
    float2 factor = frac(pixelCoord);

    float3 c00 = LoadHistoryPyramidColor(baseCoord, mipLevel);
    float3 c10 = LoadHistoryPyramidColor(baseCoord + int2(1, 0), mipLevel);
    float3 c01 = LoadHistoryPyramidColor(baseCoord + int2(0, 1), mipLevel);
    float3 c11 = LoadHistoryPyramidColor(baseCoord + int2(1, 1), mipLevel);

    float3 cx0 = lerp(c00, c10, factor.x);
    float3 cx1 = lerp(c01, c11, factor.x);
    return lerp(cx0, cx1, factor.y);
}

float3 SampleReflectionColor(float2 screenUV, float perceptualRoughness)
{
    if (_SsrUseHistoryColorPyramid == 0)
        return 0.0;

    uint width;
    uint height;
    uint mipCount;
    _PreviousColorPyramidTexture.GetDimensions((uint)0, width, height, mipCount);

    int maxMip = min(max((int)mipCount - 1, 0), _SsrHistoryColorPyramidMaxMip);
    float lod = saturate(perceptualRoughness) * (float)maxMip;
    int mip0 = (int)floor(lod);
    int mip1 = min(mip0 + 1, maxMip);
    float factor = frac(lod);

    float3 color0 = SampleHistoryPyramidBilinear(screenUV, mip0);
    float3 color1 = SampleHistoryPyramidBilinear(screenUV, mip1);
    return lerp(color0, color1, factor);
}

float ComputeHistoryColorPyramidReliability(float2 currentScreenUV, float2 historyScreenUV)
{
    float pixelMotion = length((historyScreenUV - currentScreenUV) * _SsrTraceScreenSize.xy);
    return saturate(1.0 - pixelMotion * rcp(32.0));
}

bool TryComputeHistoryPyramidUV(
    int2 coordSS,
    float deviceDepth,
    out float2 historyScreenUV,
    out float historyReliability)
{
    historyScreenUV = 0.0;
    historyReliability = 0.0;

    if (_SsrUseHistoryColorPyramid == 0)
        return false;

    if (IsRawFarDepth(deviceDepth))
        return false;

    float2 screenUV = ((float2)coordSS + 0.5) * _SsrTraceScreenSize.zw;
    float3 positionWS = ComputeSsrWorldSpacePosition(screenUV, deviceDepth);
    float3 previousNDC = ComputeNormalizedDeviceCoordinatesWithZ(positionWS, _SsrPrevViewProjMatrix);

    historyScreenUV = previousNDC.xy;
    bool insideHistory = all(historyScreenUV >= 0.0) && all(historyScreenUV <= 1.0);
    bool insideHistoryDepth = previousNDC.z >= 0.0 && previousNDC.z <= 1.0;
    historyReliability = insideHistory
        ? ComputeHistoryColorPyramidReliability(screenUV, historyScreenUV)
        : 0.0;
    historyScreenUV = saturate(historyScreenUV);
    return insideHistoryDepth;
}

bool IsHitDepthConsistent(float tracedDeviceDepth, float sceneDeviceDepth)
{
    if (IsRawFarDepth(tracedDeviceDepth) || IsRawFarDepth(sceneDeviceDepth))
        return false;

    float tracedEyeDepth = LinearEyeDepth(tracedDeviceDepth, _ZBufferParams);
    float sceneEyeDepth = LinearEyeDepth(sceneDeviceDepth, _ZBufferParams);
    if (isnan(tracedEyeDepth) || isinf(tracedEyeDepth) || tracedEyeDepth <= 0.0)
        return false;
    if (isnan(sceneEyeDepth) || isinf(sceneEyeDepth) || sceneEyeDepth <= 0.0)
        return false;

    float depthTolerance = max(0.05f, max(sceneEyeDepth, tracedEyeDepth) * 0.03f);
    return abs(sceneEyeDepth - tracedEyeDepth) <= depthTolerance;
}

float ResolveDepthWeight(float centerDeviceDepth, float sampleDeviceDepth)
{
    if (IsRawFarDepth(centerDeviceDepth) || IsRawFarDepth(sampleDeviceDepth))
        return 0.0;

    float centerEyeDepth = LinearEyeDepth(centerDeviceDepth, _ZBufferParams);
    float sampleEyeDepth = LinearEyeDepth(sampleDeviceDepth, _ZBufferParams);
    if (isnan(centerEyeDepth) || isinf(centerEyeDepth) || centerEyeDepth <= 0.0)
        return 0.0;
    if (isnan(sampleEyeDepth) || isinf(sampleEyeDepth) || sampleEyeDepth <= 0.0)
        return 0.0;

    float depthTolerance = max(0.1f, max(centerEyeDepth, sampleEyeDepth) * 0.04f);
    float depthWeight = saturate(1.0 - abs(centerEyeDepth - sampleEyeDepth) / depthTolerance);
    return depthWeight * depthWeight;
}

bool IsValidSsrRayInfo(float4 rayInfo)
{
    if (any(isnan(rayInfo)) || any(isinf(rayInfo)))
        return false;

    return rayInfo.x > 0.0001 && rayInfo.w > 0.0001;
}

float4 BuildSsrRayInfo(float hitDistance, float historyReliability, float deviceDepth, float contribution)
{
    if (hitDistance <= 0.0001 || contribution <= 0.0001)
        return EmptySsrResult();

    if (IsRawFarDepth(deviceDepth))
        return EmptySsrResult();

    float hitEyeDepth = LinearEyeDepth(deviceDepth, _ZBufferParams);
    if (isnan(hitEyeDepth) || isinf(hitEyeDepth) || hitEyeDepth <= 0.0)
        return EmptySsrResult();

    return float4(min(hitDistance, 65504.0), saturate(historyReliability), hitEyeDepth, saturate(contribution));
}

float ResolveRayDistanceWeight(float centerHitDistance, float sampleHitDistance)
{
    if (centerHitDistance <= 0.0001 || sampleHitDistance <= 0.0001)
        return 0.0;

    float distanceTolerance = max(0.25, max(centerHitDistance, sampleHitDistance) * 0.2);
    float distanceWeight = saturate(1.0 - abs(centerHitDistance - sampleHitDistance) / distanceTolerance);
    return distanceWeight * distanceWeight;
}

float ResolveRadianceWeight(float3 centerRadiance, float3 sampleRadiance)
{
    return max(0.01, exp(-length(centerRadiance - sampleRadiance) * 2.0));
}

float LoadHZBDepth(int2 mipCoord, int mipLevel)
{
    mipLevel = clamp(mipLevel, 0, _SsrDepthPyramidMaxMip);

    int mipDivisor = 1 << mipLevel;
    int2 mipSize = max(
        int2(1, 1),
        (int2(_SsrTraceScreenSize.xy) + int2(mipDivisor - 1, mipDivisor - 1)) / mipDivisor);
    mipCoord = clamp(mipCoord, int2(0, 0), mipSize - int2(1, 1));

    uint width;
    uint height;
    _HZBTexture.GetDimensions(width, height);

    int2 atlasCoord = _DepthPyramidMipLevelOffsets[mipLevel] + mipCoord;
    int2 maxAtlasCoord = int2(max((int)width - 1, 0), max((int)height - 1, 0));
    atlasCoord = clamp(atlasCoord, int2(0, 0), maxAtlasCoord);
    return _HZBTexture.Load(int3(atlasCoord, 0));
}

float PerceptualRoughnessFade(float perceptualRoughness)
{
    float t = saturate(_SsrRoughnessFadeEndTimesRcpLength - perceptualRoughness * _SsrRoughnessFadeRcpLength);
    return t * t * (3.0 - 2.0 * t);
}

float3 LoadNormalWS(uint2 coordSS)
{
    return normalize(DecodeVividNormalOct(_GBuffer1.Load(int3(coordSS, 0)).xy));
}

bool TryLoadValidHitNormalWS(int2 hitCoordSS, float3 reflectionDirWS, out float3 hitNormalWS)
{
    hitNormalWS = LoadNormalWS((uint2)ClampPixelCoord(hitCoordSS));
    if (any(isnan(hitNormalWS)) || any(isinf(hitNormalWS)))
        return false;

    return dot(hitNormalWS, -normalize(reflectionDirWS)) > 0.02;
}

bool IsSameReceiverPlaneHit(float3 receiverNormalWS, float3 hitNormalWS, float3 receiverToHitWS, float hitDistance)
{
    float normalSimilarity = dot(receiverNormalWS, hitNormalWS);
    float normalSeparation = abs(dot(receiverToHitWS, receiverNormalWS));
    float separationTolerance = max(0.02, hitDistance * 0.01);
    return normalSimilarity > 0.97 && normalSeparation <= separationTolerance;
}

bool IsHitPositionConsistentWithReflectionRay(float3 reflectionDirWS, float3 receiverToHitWS, float hitDistance)
{
    if (hitDistance <= 0.0001)
        return false;

    float rayAlignment = dot(normalize(reflectionDirWS), receiverToHitWS * rcp(hitDistance));
    return rayAlignment > 0.9;
}

float LoadPerceptualRoughness(uint2 coordSS)
{
    return GetPerceptualRoughnessFromLinearRoughness(_GBuffer1.Load(int3(coordSS, 0)).z);
}

bool ShouldTracePixel(uint2 coordSS)
{
    if (IsOutsideScreen(coordSS))
        return false;

    float deviceDepth = _DepthTexture.Load(int3(coordSS, 0));
    if (IsRawFarDepth(deviceDepth))
        return false;

    float perceptualRoughness = LoadPerceptualRoughness(coordSS);
    if (perceptualRoughness >= _SsrRoughnessFadeEnd)
        return false;

    return PerceptualRoughnessFade(perceptualRoughness) > 0.0001;
}

float EdgeOfScreenFade(float2 screenUV)
{
    float2 edgeDistance = min(screenUV, 1.0 - screenUV);
    float fade = saturate(min(edgeDistance.x, edgeDistance.y) * _SsrEdgeFadeRcpLength);
    return fade * fade * (3.0 - 2.0 * fade);
}

float3 FresnelSchlick(float3 f0, float cosTheta)
{
    float f = pow(1.0 - saturate(cosTheta), 5.0);
    return f0 + (1.0 - f0) * f;
}

bool HasSsrSkyTexture()
{
    return _SkyTextureParams.w > 0.5;
}

float3 RotateSsrSkyDirectionAroundYAxis(float3 directionWS, float rotationDegrees)
{
    float rotationRadians = radians(rotationDegrees);
    float s = 0.0;
    float c = 1.0;
    sincos(rotationRadians, s, c);

    return float3(
        c * directionWS.x - s * directionWS.z,
        directionWS.y,
        s * directionWS.x + c * directionWS.z);
}

float3 SampleSsrSkyFallback(float3 directionWS, float perceptualRoughness)
{
    if (_SsrReflectsSky == 0 || !HasSsrSkyTexture())
        return 0.0;

    float skyMipLevel = saturate(perceptualRoughness) * max(_SkyTextureParams.z, 0.0);
    float3 rotatedDirectionWS = RotateSsrSkyDirectionAroundYAxis(directionWS, _SkyTextureParams.y);
    float3 skyRadiance = SAMPLE_TEXTURECUBE_LOD(_SkyTexture, sampler_SkyTexture, rotatedDirectionWS, skyMipLevel).rgb;
    float3 exposedSkyRadiance = VividApplyPreExposure(max(skyRadiance * _SkyTextureTint.rgb * _SkyTextureParams.x, 0.0));
    float3 exposedSkyHsv = RgbToHsv(exposedSkyRadiance);
    exposedSkyHsv.z = clamp(exposedSkyHsv.z, 0.0, _SsrIntensityClamp);
    return ClampToFloat16Max(HsvToRgb(exposedSkyHsv));
}

float4 BuildSsrSkyFallback(
    float3 normalWS,
    float3 viewDirWS,
    float3 reflectionDirWS,
    float3 baseColor,
    float metallic,
    float perceptualRoughness,
    float roughnessFade)
{
    float3 reflectedColor = SampleSsrSkyFallback(reflectionDirWS, perceptualRoughness);
    if (all(reflectedColor <= 0.0))
        return float4(0.0, 0.0, 0.0, 0.0);

    float3 f0 = lerp(float3(0.04, 0.04, 0.04), baseColor, metallic);
    float3 fresnel = FresnelSchlick(f0, dot(normalWS, viewDirWS));
    float contribution = saturate(roughnessFade * _SsrIntensity);
    return float4(reflectedColor * fresnel, contribution);
}

float2 GetSsrBlueNoiseSample(uint2 coordSS)
{
    return float2(
        GetBNDSequenceSample(coordSS, (uint)_SsrFrameIndex, 0),
        GetBNDSequenceSample(coordSS, (uint)_SsrFrameIndex, 1));
}

float GetSsrSampleWeight(float3 viewDirTS, float3 reflectionDirTS, float roughness)
{
    float lambdaVPlusOne = Lambda_GGX(roughness, viewDirTS) + 1.0;
    float lambdaL = Lambda_GGX(roughness, reflectionDirTS);
    return lambdaVPlusOne / (lambdaVPlusOne + lambdaL);
}

bool SampleSsrGGXVNDF(
    float roughness,
    float3x3 localToWorld,
    float3 viewDirWS,
    float2 inputSample,
    out float3 reflectionDirWS,
    out float sampleWeight)
{
    sampleWeight = 0.0;

    roughness = clamp(roughness, SSR_MIN_GGX_ROUGHNESS, SSR_MAX_GGX_ROUGHNESS);

    float VdotH;
    float3 localV;
    float3 localH;
    SampleGGXVisibleNormal(inputSample.xy, viewDirWS, localToWorld, roughness, localV, localH, VdotH);

    float3 localReflectionDir = 2.0 * VdotH * localH - localV;
    reflectionDirWS = mul(localReflectionDir, localToWorld);

    if (localReflectionDir.z < 0.001)
        return false;

    sampleWeight = GetSsrSampleWeight(localV, localReflectionDir, roughness);
    if (sampleWeight < 0.001)
        return false;

    return true;
}

float3 SampleSsrReflectionDir(
    float3 normalWS,
    float3 viewDirWS,
    float perceptualRoughness,
    float2 blueNoiseSample,
    out float sampleWeight)
{
    float roughness = PerceptualRoughnessToRoughness(perceptualRoughness);
    float3x3 localToWorld = GetLocalFrame(normalWS);
    float3 reflectionDirWS = reflect(-viewDirWS, normalWS);

    if (!SampleSsrGGXVNDF(roughness, localToWorld, viewDirWS, blueNoiseSample, reflectionDirWS, sampleWeight))
        sampleWeight = 0.0;

    return normalize(reflectionDirWS);
}

bool TraceScreenSpaceReflection(
    uint2 coordSS,
    float2 screenUV,
    float deviceDepth,
    float3 normalWS,
    float3 viewDirWS,
    float3 reflectionDirWS,
    out int2 hitCoordSS,
    out float hitDeviceDepth,
    out bool hitSky)
{
    hitCoordSS = int2(0, 0);
    hitDeviceDepth = deviceDepth;
    hitSky = false;

    float3 positionWS = ComputeSsrWorldSpacePosition(screenUV, deviceDepth);

    float3 cameraPositionWS = _SsrWorldSpaceCameraPos.xyz;
    positionWS = cameraPositionWS + (positionWS - cameraPositionWS) * (1.0 - 0.001 * rcp(max(dot(normalWS, viewDirWS), 1e-6)));
    deviceDepth = ComputeSsrNormalizedDeviceCoordinatesWithZ(positionWS).z;

    float3 rayOrigin = float3((float2)coordSS + 0.5, deviceDepth);
    float3 reflPosWS = positionWS + reflectionDirWS;
    float3 reflPosNDC = ComputeSsrNormalizedDeviceCoordinatesWithZ(reflPosWS);
    float3 reflPosSS = float3(reflPosNDC.xy * _SsrTraceScreenSize.xy, reflPosNDC.z);
    float3 rayDir = reflPosSS - rayOrigin;

    float3 raySignFloat = float3(
        rayDir.x >= 0.0 ? 1.0 : -1.0,
        rayDir.y >= 0.0 ? 1.0 : -1.0,
        rayDir.z >= 0.0 ? 1.0 : -1.0);
    float3 rcpRayDir = raySignFloat / max(abs(rayDir), SSR_TRACE_EPS);
    int2 rayStep = int2(rcpRayDir.x >= 0.0 ? 1 : 0, rcpRayDir.y >= 0.0 ? 1 : 0);
    float3 raySign = float3(rcpRayDir.x >= 0.0 ? 1.0 : -1.0,
                            rcpRayDir.y >= 0.0 ? 1.0 : -1.0,
                            rcpRayDir.z >= 0.0 ? 1.0 : -1.0);
    bool rayTowardsEye = rcpRayDir.z >= 0.0;

    bool killRay = IsRawFarDepth(deviceDepth);
    killRay = killRay || (reflPosSS.z <= 0.0);
    killRay = killRay || (dot(normalWS, viewDirWS) <= 0.0);
#ifndef SSR_TRACE_TOWARDS_EYE
    killRay = killRay || rayTowardsEye;
#endif
    if (killRay)
        return false;

    float tMax;
    {
        const float halfTexel = 0.5;

        float3 bounds;
        bounds.x = (rcpRayDir.x >= 0.0) ? _SsrTraceScreenSize.x - halfTexel : halfTexel;
        bounds.y = (rcpRayDir.y >= 0.0) ? _SsrTraceScreenSize.y - halfTexel : halfTexel;
        float maxDepth = (_SsrReflectsSky != 0) ? -0.00000024 : 0.00000024;
        bounds.z = (rcpRayDir.z >= 0.0) ? 1.0 : maxDepth;

        float3 dist = bounds * rcpRayDir - (rayOrigin * rcpRayDir);
        tMax = Min3Value(dist.x, dist.y, dist.z);
    }

    int maxMipLevel = min(_SsrDepthPyramidMaxMip, 14);

    float2 startDistance = abs(0.5 * rcpRayDir.xy);
    float t = min(startDistance.x, startDistance.y);

    float3 rayPos = rayOrigin;
    int mipLevel = 0;
    int iterCount = 0;
    bool hit = false;
    bool miss = false;
    bool belowMip0 = false;
    float3 hitRayPos = rayOrigin;

    while (!(hit || miss) && (t <= tMax) && (iterCount < _SsrIterLimit))
    {
        rayPos = rayOrigin + t * rayDir;

        float2 sgnEdgeDist = round(rayPos.xy) - rayPos.xy;
        float2 satEdgeDist = clamp(raySign.xy * sgnEdgeDist + SSR_TRACE_EPS, 0.0, SSR_TRACE_EPS);
        rayPos.xy += raySign.xy * satEdgeDist;

        int2 mipCoord = (int2)rayPos.xy >> mipLevel;

        float4 bounds;
        bounds.xy = (float2)((mipCoord + rayStep) << mipLevel);
        bounds.z = LoadHZBDepth(mipCoord, mipLevel);
        bounds.w = bounds.z * _SsrThicknessScale + _SsrThicknessBias;

        float4 dist = bounds * rcpRayDir.xyzz - (rayOrigin.xyzz * rcpRayDir.xyzz);
        float distWall = min(dist.x, dist.y);
        float distFloor = dist.z;

        bool belowFloor = rayPos.z < bounds.z;
        bool aboveBase = rayPos.z >= bounds.w;
        bool insideFloor = belowFloor && aboveBase;
        bool hitFloor = (t <= distFloor) && (distFloor <= distWall);

#ifdef SSR_TRACE_BEHIND_OBJECTS
        miss = belowMip0 && insideFloor;
#else
        miss = belowMip0;
#endif
        hit = (mipLevel == 0) && (hitFloor || insideFloor);
        belowMip0 = (mipLevel == 0) && belowFloor;

        t = hitFloor ? distFloor : (((mipLevel != 0) && belowFloor) ? t : distWall);
        rayPos.z = bounds.z;
        if (hit)
            hitRayPos = rayPos;

        mipLevel += (hitFloor || belowFloor || rayTowardsEye) ? -1 : 1;
        mipLevel = clamp(mipLevel, 0, maxMipLevel);

        iterCount++;
    }

    bool reachedRayBounds = !hit && !miss && (t > tMax) && (iterCount < _SsrIterLimit);
    hitSky = (_SsrReflectsSky != 0) && reachedRayBounds && !rayTowardsEye;

    miss = miss || ((_SsrReflectsSky == 0) && IsRawFarDepth(rayPos.z));
    hit = hit && !miss;

    if (!hit)
        return false;

    if (hitRayPos.z < 0.0 || hitRayPos.z > 1.0 || IsRawFarDepth(hitRayPos.z))
        return false;

    hitCoordSS = ClampPixelCoord((int2)floor(hitRayPos.xy));
    hitDeviceDepth = hitRayPos.z;
    return true;
}

bool TraceScreenSpaceReflectionHDRP(
    uint2 coordSS,
    float2 screenUV,
    float deviceDepth,
    float3 normalWS,
    float3 viewDirWS,
    float3 reflectionDirWS,
    out float2 hitScreenUV)
{
    hitScreenUV = 0.0;

    float3 positionWS = ComputeSsrWorldSpacePosition(screenUV, deviceDepth);

    float3 cameraPositionWS = _SsrWorldSpaceCameraPos.xyz;
    positionWS = cameraPositionWS + (positionWS - cameraPositionWS) * (1.0 - 0.001 * rcp(max(dot(normalWS, viewDirWS), 1e-6)));
    deviceDepth = ComputeSsrNormalizedDeviceCoordinatesWithZ(positionWS).z;

    float3 rayOrigin = float3((float2)coordSS + 0.5, deviceDepth);
    float3 reflPosWS = positionWS + reflectionDirWS;
    float3 reflPosNDC = ComputeSsrNormalizedDeviceCoordinatesWithZ(reflPosWS);
    float3 reflPosSS = float3(reflPosNDC.xy * _SsrTraceScreenSize.xy, reflPosNDC.z);
    float3 rayDir = reflPosSS - rayOrigin;

    float3 raySignFloat = float3(
        rayDir.x >= 0.0 ? 1.0 : -1.0,
        rayDir.y >= 0.0 ? 1.0 : -1.0,
        rayDir.z >= 0.0 ? 1.0 : -1.0);
    float3 rcpRayDir = raySignFloat / max(abs(rayDir), SSR_TRACE_EPS);
    int2 rayStep = int2(rcpRayDir.x >= 0.0 ? 1 : 0, rcpRayDir.y >= 0.0 ? 1 : 0);
    float3 raySign = float3(rcpRayDir.x >= 0.0 ? 1.0 : -1.0,
                            rcpRayDir.y >= 0.0 ? 1.0 : -1.0,
                            rcpRayDir.z >= 0.0 ? 1.0 : -1.0);
    bool rayTowardsEye = rcpRayDir.z >= 0.0;

    bool killRay = IsRawFarDepth(deviceDepth);
    killRay = killRay || (reflPosSS.z <= 0.0);
    killRay = killRay || (dot(normalWS, viewDirWS) <= 0.0);
    if (killRay)
        return false;

    float tMax;
    {
        const float halfTexel = 0.5;

        float3 bounds;
        bounds.x = (rcpRayDir.x >= 0.0) ? _SsrTraceScreenSize.x - halfTexel : halfTexel;
        bounds.y = (rcpRayDir.y >= 0.0) ? _SsrTraceScreenSize.y - halfTexel : halfTexel;
        float maxDepth = (_SsrReflectsSky != 0) ? -0.00000024 : 0.00000024;
        bounds.z = (rcpRayDir.z >= 0.0) ? 1.0 : maxDepth;

        float3 dist = bounds * rcpRayDir - (rayOrigin * rcpRayDir);
        tMax = Min3Value(dist.x, dist.y, dist.z);
    }

    int maxMipLevel = min(_SsrDepthPyramidMaxMip, 14);
    float2 startDistance = abs(0.5 * rcpRayDir.xy);
    float t = min(startDistance.x, startDistance.y);

    float3 rayPos = rayOrigin;
    int mipLevel = 0;
    int iterCount = 0;
    bool hit = false;
    bool miss = false;
    bool belowMip0 = false;

    while (!(hit || miss) && (t <= tMax) && (iterCount < _SsrIterLimit))
    {
        rayPos = rayOrigin + t * rayDir;

        float2 sgnEdgeDist = round(rayPos.xy) - rayPos.xy;
        float2 satEdgeDist = clamp(raySign.xy * sgnEdgeDist + SSR_TRACE_EPS, 0.0, SSR_TRACE_EPS);
        rayPos.xy += raySign.xy * satEdgeDist;

        int2 mipCoord = (int2)rayPos.xy >> mipLevel;

        float4 bounds;
        bounds.xy = (float2)((mipCoord + rayStep) << mipLevel);
        bounds.z = LoadHZBDepth(mipCoord, mipLevel);
        bounds.w = bounds.z * _SsrThicknessScale + _SsrThicknessBias;

        float4 dist = bounds * rcpRayDir.xyzz - (rayOrigin.xyzz * rcpRayDir.xyzz);
        float distWall = min(dist.x, dist.y);
        float distFloor = dist.z;

        bool belowFloor = rayPos.z < bounds.z;
        bool aboveBase = rayPos.z >= bounds.w;
        bool insideFloor = belowFloor && aboveBase;
        bool hitFloor = (t <= distFloor) && (distFloor <= distWall);

#ifdef SSR_TRACE_BEHIND_OBJECTS
        miss = belowMip0 && insideFloor;
#else
        miss = belowMip0;
#endif
        hit = (mipLevel == 0) && (hitFloor || insideFloor);
        belowMip0 = (mipLevel == 0) && belowFloor;

        t = hitFloor ? distFloor : (((mipLevel != 0) && belowFloor) ? t : distWall);
        rayPos.z = bounds.z;

        mipLevel += (hitFloor || belowFloor || rayTowardsEye) ? -1 : 1;
        mipLevel = clamp(mipLevel, 0, maxMipLevel);

        iterCount++;
    }

    miss = miss || ((_SsrReflectsSky == 0) && IsRawFarDepth(rayPos.z));
    hit = hit && !miss;
    if (!hit)
        return false;

    hitScreenUV = (floor(rayPos.xy) + 0.5) * _SsrTraceScreenSize.zw;
    return all(hitScreenUV >= 0.0) && all(hitScreenUV <= 1.0);
}

groupshared uint g_SSRClassifiedTileWaves[SSR_THREAD_COUNT];

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsClassifyTiles(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 groupId : SV_GroupID)
{
    uint2 coordSS = dispatchThreadId.xy;
    bool shouldTracePixel = false;
    if (!IsOutsideScreen(coordSS))
    {
        StoreEmptySsrTrace(coordSS);
        _SSRResolveTexture[coordSS] = float4(0.0, 0.0, 0.0, 0.0);
        _OutputColorTexture[coordSS] = float4(0.0, 0.0, 0.0, 0.0);
        _SSRDebugTexture[coordSS] = float4(0.0, 0.0, 0.0, 0.0);

        float debugDeviceDepth = _DepthTexture.Load(int3(coordSS, 0));
        if (!IsRawFarDepth(debugDeviceDepth))
        {
            float2 debugScreenUV = ((float2)coordSS + 0.5) * _SsrTraceScreenSize.zw;
            StoreSsrWorldGridDebug(coordSS, ComputeSsrWorldSpacePosition(debugScreenUV, debugDeviceDepth));
        }

        shouldTracePixel = ShouldTracePixel(coordSS);
    }

    uint linearThreadIndex = groupThreadId.y * SSR_THREAD_GROUP_SIZE + groupThreadId.x;
    g_SSRClassifiedTileWaves[linearThreadIndex] = 0u;
    GroupMemoryBarrierWithGroupSync();

    bool waveHasTracePixel = WaveActiveAnyTrue(shouldTracePixel);

    if (WaveIsFirstLane())
        g_SSRClassifiedTileWaves[linearThreadIndex] = waveHasTracePixel ? 1u : 0u;

    GroupMemoryBarrierWithGroupSync();

    if (linearThreadIndex == 0u)
    {
        bool tileHasTracePixel = false;
        for (uint wave = 0u; wave < SSR_THREAD_COUNT; wave++)
            tileHasTracePixel = tileHasTracePixel || g_SSRClassifiedTileWaves[wave] != 0u;

        if (tileHasTracePixel)
        {
            uint tileOffset;
            InterlockedAdd(_SSRDispatchIndirectArgs[0], 1u, tileOffset);
            _SSRTileList[tileOffset] = EncodeSSRTileIndex(groupId.xy);
        }
    }
}

[numthreads(8, 8, 1)]
void CopyScreenSpaceReflection(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coordSS = dispatchThreadId.xy;
    if (IsOutsideScreen(coordSS))
        return;

    _OutputColorTexture[coordSS] = EmptySsrResult();
    _SSRHDRPOutputTexture[coordSS] = EmptySsrResult();
}

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsTracing(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 coordSS = GetTilePixelCoord(groupId.x, groupThreadId.xy);
    if (IsOutsideScreen(coordSS))
        return;

    float deviceDepth = _DepthTexture.Load(int3(coordSS, 0));
    if (IsRawFarDepth(deviceDepth))
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float4 gbuffer0 = _GBuffer0.Load(int3(coordSS, 0));
    float4 gbuffer1 = _GBuffer1.Load(int3(coordSS, 0));
    float4 gbuffer2 = _GBuffer2.Load(int3(coordSS, 0));

    float3 baseColor = saturate(gbuffer0.rgb);
    float3 normalWS = normalize(DecodeVividNormalOct(gbuffer1.xy));
    float perceptualRoughness = GetPerceptualRoughnessFromLinearRoughness(gbuffer1.z);
    float metallic = saturate(gbuffer2.r);

    if (perceptualRoughness >= _SsrRoughnessFadeEnd)
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float roughnessFade = PerceptualRoughnessFade(perceptualRoughness);
    if (roughnessFade <= 0.0001)
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float2 screenUV = ((float2)coordSS + 0.5) * _SsrTraceScreenSize.zw;
    float3 positionWS = ComputeSsrWorldSpacePosition(screenUV, deviceDepth);
    StoreSsrWorldGridDebug(coordSS, positionWS);
    float3 viewDirWS = GetSsrWorldSpaceNormalizeViewDir(positionWS);

    float traceSampleWeight;
    float2 traceBlueNoiseSample = GetSsrBlueNoiseSample(coordSS);
    float3 reflectionDirWS = SampleSsrReflectionDir(normalWS, viewDirWS, perceptualRoughness, traceBlueNoiseSample, traceSampleWeight);
    if (traceSampleWeight <= 0.0)
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    int2 hitCoordSS;
    float hitDeviceDepth;
    bool hitSky;
    bool hit = TraceScreenSpaceReflection(
        coordSS,
        screenUV,
        deviceDepth,
        normalWS,
        viewDirWS,
        reflectionDirWS,
        hitCoordSS,
        hitDeviceDepth,
        hitSky);

    if (!hit)
    {
        if (hitSky)
        {
            float4 skyReflection = BuildSsrSkyFallback(
                normalWS,
                viewDirWS,
                reflectionDirWS,
                baseColor,
                metallic,
                perceptualRoughness,
                roughnessFade);
            _SSRTraceTexture[coordSS] = skyReflection;
            _SSRRayInfoTexture[coordSS] = BuildSsrRayInfo(5000.0, 1.0, deviceDepth, skyReflection.a);
        }
        else
        {
            StoreEmptySsrTrace(coordSS);
        }

        return;
    }

    float hitSceneDeviceDepth = _DepthTexture.Load(int3(hitCoordSS, 0));
    if (!IsHitDepthConsistent(hitDeviceDepth, hitSceneDeviceDepth))
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float3 hitNormalWS;
    if (!TryLoadValidHitNormalWS(hitCoordSS, reflectionDirWS, hitNormalWS))
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float2 hitScreenUV = ((float2)hitCoordSS + 0.5) * _SsrTraceScreenSize.zw;
    float3 hitPositionWS = ComputeSsrWorldSpacePosition(hitScreenUV, hitSceneDeviceDepth);
    float3 receiverToHitWS = hitPositionWS - positionWS;
    float hitDistance = length(receiverToHitWS);
    if (!IsHitPositionConsistentWithReflectionRay(reflectionDirWS, receiverToHitWS, hitDistance))
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    if (IsSameReceiverPlaneHit(normalWS, hitNormalWS, receiverToHitWS, hitDistance))
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float2 historyScreenUV;
    float historyReliability;
    if (!TryComputeHistoryPyramidUV(hitCoordSS, hitSceneDeviceDepth, historyScreenUV, historyReliability))
    {
        StoreEmptySsrTrace(coordSS);
        return;
    }

    float hitEdgeFade = EdgeOfScreenFade(hitScreenUV);
    float historyEdgeFade = min(hitEdgeFade, EdgeOfScreenFade(historyScreenUV));
    float edgeFade = lerp(hitEdgeFade, historyEdgeFade, historyReliability);
    float3 historyColor = SanitizeSsrRadiance(SampleReflectionColor(historyScreenUV, perceptualRoughness));
    float3 reflectedColor = historyColor;
    float3 f0 = lerp(float3(0.04, 0.04, 0.04), baseColor, metallic);
    float3 fresnel = FresnelSchlick(f0, dot(normalWS, viewDirWS));
    float contribution = saturate(edgeFade * roughnessFade * _SsrIntensity * historyReliability);

    _SSRTraceTexture[coordSS] = float4(reflectedColor * fresnel, contribution);
    _SSRRayInfoTexture[coordSS] = BuildSsrRayInfo(hitDistance, historyReliability, hitSceneDeviceDepth, contribution);
}

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsResolve(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 coordSS = GetTilePixelCoord(groupId.x, groupThreadId.xy);
    if (IsOutsideScreen(coordSS))
        return;

    float4 centerReflection = _SSRTraceTexture[coordSS];
    float4 centerRayInfo = _SSRRayInfoTexture[coordSS];
    float centerDepth = _DepthTexture.Load(int3(coordSS, 0));
    float3 centerNormalWS = LoadNormalWS(coordSS);

    if (centerReflection.a <= 0.0001 || !IsValidSsrRayInfo(centerRayInfo))
    {
        _SSRResolveTexture[coordSS] = EmptySsrResult();
        return;
    }

    centerReflection.rgb = SanitizeSsrRadiance(centerReflection.rgb);
    float3 colorSum = centerReflection.rgb * centerReflection.a;
    float alphaSum = centerReflection.a * centerReflection.a;
    float weightSum = centerReflection.a;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0)
                continue;

            int2 sampleCoord = ClampPixelCoord((int2)coordSS + int2(x, y));
            float4 sampleReflection = _SSRTraceTexture[sampleCoord];
            float4 sampleRayInfo = _SSRRayInfoTexture[sampleCoord];
            if (sampleReflection.a <= 0.0001 || !IsValidSsrRayInfo(sampleRayInfo))
                continue;

            sampleReflection.rgb = SanitizeSsrRadiance(sampleReflection.rgb);
            float sampleDepth = _DepthTexture.Load(int3(sampleCoord, 0));
            float3 sampleNormalWS = LoadNormalWS((uint2)sampleCoord);
            float normalWeight = pow(saturate(dot(centerNormalWS, sampleNormalWS)), 128.0);
            float depthWeight = ResolveDepthWeight(centerDepth, sampleDepth);
            float rayDistanceWeight = ResolveRayDistanceWeight(centerRayInfo.x, sampleRayInfo.x);
            float radianceWeight = ResolveRadianceWeight(centerReflection.rgb, sampleReflection.rgb);
            float reliabilityWeight = min(centerRayInfo.y, sampleRayInfo.y);

            float weight = normalWeight * depthWeight * rayDistanceWeight * radianceWeight * reliabilityWeight * sampleReflection.a;
            colorSum += sampleReflection.rgb * weight;
            alphaSum += sampleReflection.a * weight;
            weightSum += weight;
        }
    }

    if (weightSum <= 0.0001)
    {
        _SSRResolveTexture[coordSS] = EmptySsrResult();
        return;
    }

    float rcpWeightSum = rcp(max(weightSum, 0.0001));
    _SSRResolveTexture[coordSS] = float4(colorSum * rcpWeightSum, saturate(alphaSum * rcpWeightSum));
}

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsAccumulate(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 coordSS = GetTilePixelCoord(groupId.x, groupThreadId.xy);
    if (IsOutsideScreen(coordSS))
        return;

    _OutputColorTexture[coordSS] = _SSRResolveTexture[coordSS];
}

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsHDRPTracing(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coordSS = dispatchThreadId.xy;
    if (IsOutsideScreen(coordSS))
        return;

    _SSRHDRPHitPointTexture[coordSS] = EmptySsrResult();

    float deviceDepth = _DepthTexture.Load(int3(coordSS, 0));
    if (IsRawFarDepth(deviceDepth))
        return;

    float3 normalWS = LoadNormalWS(coordSS);
    float perceptualRoughness = LoadPerceptualRoughness(coordSS);
    if (perceptualRoughness >= _SsrRoughnessFadeEnd)
        return;

    float2 screenUV = ((float2)coordSS + 0.5) * _SsrTraceScreenSize.zw;
    float3 positionWS = ComputeSsrWorldSpacePosition(screenUV, deviceDepth);
    float3 viewDirWS = GetSsrWorldSpaceNormalizeViewDir(positionWS);

    float sampleWeight;
    float2 blueNoiseSample = GetSsrBlueNoiseSample(coordSS);
    float3 reflectionDirWS = SampleSsrReflectionDir(normalWS, viewDirWS, perceptualRoughness, blueNoiseSample, sampleWeight);
    if (sampleWeight <= 0.0)
        return;

    float2 hitScreenUV;
    if (TraceScreenSpaceReflectionHDRP(coordSS, screenUV, deviceDepth, normalWS, viewDirWS, reflectionDirWS, hitScreenUV))
        _SSRHDRPHitPointTexture[coordSS] = float4(hitScreenUV, 1.0, 1.0);
}

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsHDRPReprojection(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coordSS = dispatchThreadId.xy;
    if (IsOutsideScreen(coordSS))
        return;

    _SSRHDRPAccumTexture[coordSS] = EmptySsrResult();

    float4 hitData = _SSRHDRPHitPointTexture[coordSS];
    if (hitData.z <= 0.0)
        return;

    float perceptualRoughness = LoadPerceptualRoughness(coordSS);
    float opacity = EdgeOfScreenFade(hitData.xy) * PerceptualRoughnessFade(perceptualRoughness) * saturate(_SsrIntensity);
    if (opacity <= 0.0001)
        return;

    float3 color = SanitizeSsrRadiance(SampleReflectionColor(hitData.xy, perceptualRoughness));
    if (all(color <= 0.0))
        return;

    _SSRHDRPAccumTexture[coordSS] = float4(color, 1.0) * opacity;
}

[numthreads(8, 8, 1)]
void ScreenSpaceReflectionsHDRPAccumulate(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coordSS = dispatchThreadId.xy;
    if (IsOutsideScreen(coordSS))
        return;

    _SSRHDRPOutputTexture[coordSS] = _SSRHDRPAccumTexture[coordSS];
    if (_SsrWriteHDRPToOutput != 0)
        _OutputColorTexture[coordSS] = _SSRHDRPAccumTexture[coordSS];
}
