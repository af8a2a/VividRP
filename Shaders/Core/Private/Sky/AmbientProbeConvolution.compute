#define HAMMERSLEY_USE_CB
#pragma use_dxc

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/GlobalSamplers.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/ImageBasedLighting.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/SphericalHarmonics.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Sampling/Hammersley.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Sampling/Sampling.hlsl"
#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2
#pragma kernel AmbientProbeConvolution
#pragma kernel SkySpecularPrefilter

TEXTURECUBE(_AmbientProbeInputCubemap);
RWStructuredBuffer<float4> _AmbientProbeOutputBuffer;
TEXTURECUBE(_SkySpecularSourceCubemap);
RWTexture2DArray<float4> _SkySpecularMipOutput;

float4 _SkyConvolutionTint;
float4 _SkyConvolutionParams;
float4 _SkySpecularMipParams;

#define _SkyExposure _SkyConvolutionParams.x
#define _SkyRotation _SkyConvolutionParams.y
#define _SkySpecularMaxSampleCount ((uint)_SkySpecularMipParams.z)

#define SAMPLE_COUNT 256
#define SH_COEFF_COUNT 27

#if defined(PLATFORM_SUPPORTS_WAVE_INTRINSICS) && defined(PLATFORM_LANE_COUNT)
groupshared float outputSHCoeffsLDS[SH_COEFF_COUNT * SAMPLE_COUNT / PLATFORM_LANE_COUNT];
#else
groupshared float outputSHCoeffsLDS[SH_COEFF_COUNT * SAMPLE_COUNT / 2];
#endif

float3 RotateAroundYAxis(float3 directionWS, float rotationDegrees)
{
    float rotationRadians = radians(rotationDegrees);
    float s = 0.0;
    float c = 1.0;
    sincos(rotationRadians, s, c);

    return float3(
        c * directionWS.x - s * directionWS.z,
        directionWS.y,
        s * directionWS.x + c * directionWS.z);
}

float3 GetCubemapDirection(uint faceIndex, float2 uv)
{
    float u = uv.x * 2.0f - 1.0f;
    float v = uv.y * 2.0f - 1.0f;

    float3 directionWS = float3(0.0f, 0.0f, 1.0f);
    switch (faceIndex)
    {
        case 0:
            directionWS = float3(1.0f, -v, -u);
            break;
        case 1:
            directionWS = float3(-1.0f, -v, u);
            break;
        case 2:
            directionWS = float3(u, 1.0f, v);
            break;
        case 3:
            directionWS = float3(u, -1.0f, -v);
            break;
        case 4:
            directionWS = float3(u, -v, 1.0f);
            break;
        case 5:
            directionWS = float3(-u, -v, -1.0f);
            break;
    }

    return normalize(directionWS);
}

float3 IntegrateSkySpecularGGX(float3 normalWS, uint mipLevel, uint maxMipLevel)
{
    if (mipLevel == 0)
        return SAMPLE_TEXTURECUBE_LOD(_SkySpecularSourceCubemap, sampler_LinearClamp, normalWS, 0.0f).rgb;

    float sourceWidth;
    float sourceHeight;
    _SkySpecularSourceCubemap.GetDimensions(sourceWidth, sourceHeight);
    real invOmegaP = (6.0 * sourceWidth * sourceHeight) / FOUR_PI;
    real scaledMipLevel = maxMipLevel > 0 ? ((real)mipLevel * UNITY_SPECCUBE_LOD_STEPS) / (real)maxMipLevel : 0.0;
    real perceptualRoughness = MipmapLevelToPerceptualRoughness(scaledMipLevel);
    real roughness = PerceptualRoughnessToRoughness(perceptualRoughness);
    uint runtimeFilterMip = (uint)clamp(ceil(scaledMipLevel), 1.0, (real)UNITY_SPECCUBE_LOD_STEPS);
    uint sampleCount = max(GetIBLRuntimeFilterSampleCount(runtimeFilterMip), 1u);
    if (_SkySpecularMaxSampleCount > 0u)
        sampleCount = min(sampleCount, _SkySpecularMaxSampleCount);

    real3x3 localToWorld = GetLocalFrame(normalWS);
    real3 viewDirectionWS = normalWS;
    real NdotV = 1.0;
    real partLambdaV = GetSmithJointGGXPartLambdaV(NdotV, roughness);
    float3 accumulatedLighting = 0.0;
    float accumulatedWeight = 0.0;

    for (uint sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex)
    {
        real2 sampleUv = Fibonacci2d(sampleIndex, sampleCount);
        real3 lightDirectionWS;
        real NdotL;
        real NdotH;
        real VdotH;
        SampleGGXDir(sampleUv, viewDirectionWS, localToWorld, roughness, lightDirectionWS, NdotL, NdotH, VdotH, true);

        if (NdotL <= 0.0)
            continue;

        real pdf = max(0.25 * D_GGX(NdotH, roughness), REAL_EPS);
        real omegaS = rcp(sampleCount) * rcp(pdf);
        real sampleMipLevel = 0.5 * log2(max(omegaS * invOmegaP, REAL_EPS)) + roughness;
        real3 sampleValue = SAMPLE_TEXTURECUBE_LOD(_SkySpecularSourceCubemap, sampler_LinearClamp, lightDirectionWS, sampleMipLevel).rgb;
        real visibility = V_SmithJointGGX(NdotL, NdotV, roughness, partLambdaV) * NdotL * NdotV;

        accumulatedLighting += visibility * sampleValue;
        accumulatedWeight += visibility;
    }

    return accumulatedWeight > REAL_EPS
        ? accumulatedLighting / accumulatedWeight
        : SAMPLE_TEXTURECUBE_LOD(_SkySpecularSourceCubemap, sampler_LinearClamp, normalWS, 0.0f).rgb;
}

[numthreads(SAMPLE_COUNT, 1, 1)]
void AmbientProbeConvolution(uint dispatchThreadId : SV_DispatchThreadID)
{
    uint sampleCount = SAMPLE_COUNT;

    float2 u = Hammersley2d(dispatchThreadId, sampleCount);
    float3 n = SampleSphereUniform(u.x, u.y);
    n = RotateAroundYAxis(n, _SkyRotation);

    float2 cubeSize;
    _AmbientProbeInputCubemap.GetDimensions(cubeSize.x, cubeSize.y);

    float invOmegaP = (6.0 * cubeSize.x * cubeSize.y) / FOUR_PI;
    float pdf = 1.0 / FOUR_PI;
    float omegaS = rcp(sampleCount) * rcp(pdf);
    float mipLevel = 0.5 * log2(omegaS * invOmegaP);

    float3 value = SAMPLE_TEXTURECUBE_LOD(_AmbientProbeInputCubemap, sampler_LinearClamp, n, mipLevel).rgb;
    value *= _SkyConvolutionTint.rgb * _SkyExposure;

    float outputSHCoeffs[SH_COEFF_COUNT];

    [unroll]
    for (int channel = 0; channel < 3; ++channel)
    {
        outputSHCoeffs[channel * 9 + 0] = value[channel];
        outputSHCoeffs[channel * 9 + 1] = n.y * value[channel];
        outputSHCoeffs[channel * 9 + 2] = n.z * value[channel];
        outputSHCoeffs[channel * 9 + 3] = n.x * value[channel];
        outputSHCoeffs[channel * 9 + 4] = n.x * n.y * value[channel];
        outputSHCoeffs[channel * 9 + 5] = n.y * n.z * value[channel];
        outputSHCoeffs[channel * 9 + 6] = (3.0 * n.z * n.z - 1.0) * value[channel];
        outputSHCoeffs[channel * 9 + 7] = n.x * n.z * value[channel];
        outputSHCoeffs[channel * 9 + 8] = (n.x * n.x - n.y * n.y) * value[channel];
    }

#if defined(PLATFORM_SUPPORTS_WAVE_INTRINSICS) && defined(PLATFORM_LANE_COUNT)
    [unroll]
    for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
    {
        outputSHCoeffs[coeff] = WaveActiveSum(outputSHCoeffs[coeff]);
    }

    uint laneCount = WaveGetLaneCount();
    if (dispatchThreadId % laneCount == 0)
    {
        [unroll]
        for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
        {
            uint offset = (dispatchThreadId / laneCount) * SH_COEFF_COUNT;
            outputSHCoeffsLDS[coeff + offset] = outputSHCoeffs[coeff];
        }
    }

    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
    {
        outputSHCoeffs[coeff] = outputSHCoeffsLDS[coeff];
    }

    uint waveCount = sampleCount / laneCount;
    for (uint wave = 1; wave < waveCount; ++wave)
    {
        [unroll]
        for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
        {
            outputSHCoeffs[coeff] += outputSHCoeffsLDS[coeff + wave * SH_COEFF_COUNT];
        }
    }
#else
    for (uint reductionStep = 0; reductionStep < FastLog2(SAMPLE_COUNT); ++reductionStep)
    {
        if ((dispatchThreadId & ((2 << reductionStep) - 1)) == (1 << reductionStep))
        {
            uint index = dispatchThreadId >> (reductionStep + 1);
            [unroll]
            for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
            {
                outputSHCoeffsLDS[index * SH_COEFF_COUNT + coeff] = outputSHCoeffs[coeff];
            }
        }

        GroupMemoryBarrierWithGroupSync();

        if ((dispatchThreadId & ((2 << reductionStep) - 1)) == 0)
        {
            uint index = dispatchThreadId >> (reductionStep + 1);
            [unroll]
            for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
            {
                outputSHCoeffs[coeff] += outputSHCoeffsLDS[index * SH_COEFF_COUNT + coeff];
            }
        }

        GroupMemoryBarrierWithGroupSync();
    }
#endif

    if (dispatchThreadId != 0)
        return;

    float weight = FOUR_PI / sampleCount;

    [unroll]
    for (uint coeff = 0; coeff < SH_COEFF_COUNT; ++coeff)
    {
        outputSHCoeffs[coeff] *= kSHBasisCoef[coeff % 9] * weight;
        outputSHCoeffs[coeff] *= kClampedCosineCoefs[coeff % 9] * kSHBasisCoef[coeff % 9];
    }

    PackSH(_AmbientProbeOutputBuffer, outputSHCoeffs);
}

[numthreads(8, 8, 1)]
void SkySpecularPrefilter(uint3 tid : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint elements;
    _SkySpecularMipOutput.GetDimensions(width, height, elements);
    if (tid.x >= width || tid.y >= height || tid.z >= min(elements, 6u))
        return;

    uint mipLevel = (uint)_SkySpecularMipParams.x;
    uint maxMipLevel = max((uint)_SkySpecularMipParams.y, 1u);
    float2 uv = (tid.xy + 0.5f) / float2(width, height);
    float3 directionWS = GetCubemapDirection(tid.z, uv);
    _SkySpecularMipOutput[tid] = float4(IntegrateSkySpecularGGX(directionWS, mipLevel, maxMipLevel), 1.0f);
}
