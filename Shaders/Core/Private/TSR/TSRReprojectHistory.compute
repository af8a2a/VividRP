#pragma use_dxc
#pragma kernel CS
#pragma multi_compile_local _ VIVID_TSR_WAVE_OPS
#pragma multi_compile _ UNITY_DEVICE_SUPPORTS_NATIVE_16BIT

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/TSR/TSRCommon.hlsl"

Texture2D<float2> _DilatedMotion;
Texture2D<float> _ReprojectionBoundary;
Texture2D<float> _ThinGeometryCoverage;
Texture2D<float> _LumaInstability;
Texture2D<float4> _HistoryColor;
Texture2D<float2> _HistoryMeta;
Texture2D<float4> _ResurrectionColor;
Texture2D<float2> _ResurrectionMeta;

RWTexture2D<float4> _ReprojectedHistoryColor;
RWTexture2D<float2> _ReprojectedHistoryMeta;
RWTexture2D<float4> _ReprojectedResurrectionColor;
RWTexture2D<float2> _ReprojectedResurrectionMeta;

float4 _RenderSize;
float4 _OutputSize;
float4 _PreviousOutputSize;
float4 _Jitter;
float4 _TSRParams;

[numthreads(8, 8, 1)]
void CS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 renderSize = int2(_RenderSize.xy);
    int2 outputSize = int2(_OutputSize.xy);
    int2 pixelCoord = int2(dispatchThreadId.xy);
    if (any(pixelCoord >= outputSize))
        return;

    float2 uv = TSR_OutputUV(pixelCoord, outputSize);
    int2 renderCoord = TSR_OutputToRenderCoord(pixelCoord, outputSize, renderSize);
    float2 motion = _DilatedMotion[renderCoord];
    float2 jitterDelta = (_Jitter.zw - _Jitter.xy) * 0.5;
#if UNITY_UV_STARTS_AT_TOP
    jitterDelta.y = -jitterDelta.y;
#endif
    float2 historyUV = uv - motion + jitterDelta;
    bool validHistoryUV = all(historyUV >= 0.0) && all(historyUV <= 1.0);
    bool hasHistory = _TSRParams.x > 0.5 && validHistoryUV;

    if (!hasHistory)
    {
        _ReprojectedHistoryColor[pixelCoord] = 0.0;
        _ReprojectedHistoryMeta[pixelCoord] = 0.0;
        _ReprojectedResurrectionColor[pixelCoord] = 0.0;
        _ReprojectedResurrectionMeta[pixelCoord] = 0.0;
        return;
    }

    float2 previousSize = max(_PreviousOutputSize.xy, float2(1.0, 1.0));
    float localBoundary = _ReprojectionBoundary[renderCoord];
    float thinGeometryCoverage = _ThinGeometryCoverage[renderCoord];
    float lumaInstability = _LumaInstability[renderCoord];
    float2 historyTexelBoundary = min(historyUV, 1.0 - historyUV) * previousSize;
    float uvBoundary = saturate(1.0 - min(historyTexelBoundary.x, historyTexelBoundary.y));
    float historyConfidence = saturate(1.0 - max(localBoundary, uvBoundary) * 0.75);
    historyConfidence *= lerp(1.0, 0.55, thinGeometryCoverage);
    historyConfidence *= lerp(1.0, 0.75, lumaInstability * max(localBoundary, thinGeometryCoverage));
    float2 historyMeta = _HistoryMeta.SampleLevel(sampler_LinearClamp, historyUV, 0);
    float2 resurrectionMeta = _ResurrectionMeta.SampleLevel(sampler_LinearClamp, historyUV, 0);

    _ReprojectedHistoryColor[pixelCoord] = TSR_SampleCatmullRom(_HistoryColor, historyUV, previousSize);
    _ReprojectedHistoryMeta[pixelCoord] = float2(historyMeta.x * historyConfidence, historyMeta.y);
    _ReprojectedResurrectionColor[pixelCoord] = TSR_SampleCatmullRom(_ResurrectionColor, historyUV, previousSize);
    _ReprojectedResurrectionMeta[pixelCoord] = float2(resurrectionMeta.x * historyConfidence, resurrectionMeta.y);
}
