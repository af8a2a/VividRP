#pragma use_dxc
#pragma kernel CS
#pragma kernel CSHistoryDiagnostics VIVID_TSR_HISTORY_DIAGNOSTICS
#pragma multi_compile_local _ VIVID_TSR_WAVE_OPS
#pragma multi_compile _ UNITY_DEVICE_SUPPORTS_NATIVE_16BIT

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/TSR/TSRCommon.hlsl"

Texture2D<float4> _CurrentFrameColor;
Texture2D<float2> _DilatedMotion;
Texture2D<float> _DilatedDepth;
Texture2D<float> _ReprojectionBoundary;
Texture2D<float> _ThinGeometryCoverage;
Texture2D<float> _LumaInstability;
Texture2D<float4> _AcceptedHistoryColor;
Texture2D<float2> _ReprojectedHistoryMeta;
Texture2D<float4> _ReprojectedResurrectionColor;
Texture2D<float4> _ReprojectedResurrectionMeta;
Texture2D<float> _RejectionMask;
Texture2D<float4> _HistoryWeightControl;

RWTexture2D<float> _TSROutputPreExposure;
RWTexture2D<float4> _UpdatedHistoryColor;
RWTexture2D<float2> _UpdatedHistoryMeta;
RWTexture2D<float4> _UpdatedResurrectionColor;
RWTexture2D<float2> _UpdatedResurrectionMeta;

#if defined(VIVID_TSR_HISTORY_DIAGNOSTICS)
RWTexture2D<float4> _HistoryLossDiagnostics;
#define CS CSHistoryDiagnostics
#endif

float4 _RenderSize;
float4 _OutputSize;
float4 _TSRParams;



// UE ComputeSampleWeigth, evaluated on our existing Catmull-Rom input grid.
float TSR_InputAlignment(float factor, float2 delta)
{
    float x2 = saturate(factor * factor * dot(delta, delta));
    return saturate((0.9 * x2 - 1.9) * x2 + 1.0);
}

[numthreads(8, 8, 1)]
void CS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 renderSize = int2(_RenderSize.xy);
    int2 outputSize = int2(_OutputSize.xy);
    int2 pixelCoord = int2(dispatchThreadId.xy);
    if (any(pixelCoord >= outputSize))
        return;

    // Persist the exposure after every write, including retained resurrection RGB,
    // which was already converted by ReprojectHistory. No CPU readback is needed.
    if (all(pixelCoord == 0))
        _TSROutputPreExposure[int2(0, 0)] = TSR_CurrentPreExposure();

    int2 renderCoord = TSR_OutputToRenderCoord(pixelCoord, outputSize, renderSize);

    float3 currentColor = _CurrentFrameColor[pixelCoord].rgb;
    float3 historyColor = _AcceptedHistoryColor[pixelCoord].rgb;
    bool resurrected = _HistoryWeightControl[pixelCoord].z > 0.5;
    float previousSampleCount = resurrected ? _ReprojectedResurrectionMeta[pixelCoord].x
        : _ReprojectedHistoryMeta[pixelCoord].x;
    float accepted = _RejectionMask[pixelCoord] > 0.5 ? 1.0 : 0.0;
    float shadingState = _AcceptedHistoryColor[pixelCoord].a;
    bool stationaryShadingChange = shadingState < -1.5;
    float reprojectionBoundary = _ReprojectionBoundary[renderCoord];
    float thinGeometryCoverage = _ThinGeometryCoverage[renderCoord];
    float lumaInstability = _LumaInstability[renderCoord];
    float2 motion = resurrected ? _ReprojectedResurrectionMeta[pixelCoord].zw : _DilatedMotion[renderCoord];
    float velocityPixels = length(motion * float2(renderSize));
    float velocityFactor = saturate((velocityPixels - 0.5) * (1.0 / 7.5));
    // Retained only for diagnostics. Primary
    // history validity has one owner below; reprojection no longer decays it.
    float updateInstability = max(max(velocityFactor, reprojectionBoundary), thinGeometryCoverage);
    float maxSampleCount = max(_TSRParams.y, 1.0);
    float hysteresis = rcp(maxSampleCount);
    float2 inputPosition = TSR_OutputUV(pixelCoord, outputSize) * float2(renderSize);
    float2 inputDelta = frac(inputPosition) - 0.5;
    float inputToHistoryFactor = max((float)outputSize.x / renderSize.x, 1.0);
    float coarseContribution = TSR_InputAlignment(1.0, inputDelta) * hysteresis;
    float idealContribution = TSR_InputAlignment(inputToHistoryFactor, inputDelta) * hysteresis;
    float previousValidity = accepted > 0.5 ? saturate(previousSampleCount / maxSampleCount) : 0.0;
    float2 control = saturate(_HistoryWeightControl[pixelCoord].xy);
    if (stationaryShadingChange)
        control.y = 1.0;
    // UE defaults: rejection retains two samples, motion retains four samples.
    float rejectionClamp = 1.0 - min(2.0 / maxSampleCount, 1.0);
    previousValidity = min(previousValidity, 1.0 - rejectionClamp * control.y);
    float minBlend = 1.0 - control.x;
    float refiningBlend = idealContribution / max(previousValidity + idealContribution, 1e-8);
    float coarseRejected = minBlend > 0.0 ? min(coarseContribution * control.x / minBlend, 1.0) : 1.0;
    float coarseRefining = refiningBlend > 0.0 ? min(coarseContribution * (1.0 - refiningBlend) / refiningBlend, 1.0) : 1.0;
    float refining = coarseRejected >= coarseRefining ? saturate(previousValidity * maxSampleCount) : 0.0;
    float kernelLerp = accepted > 0.5 ? saturate(control.x * 16.0 - 13.0) * refining : 0.0;
    float currentWeight = TSR_InputAlignment(lerp(1.0, inputToHistoryFactor, kernelLerp), inputDelta) * hysteresis;
    float rejectionContribution = currentWeight > 0.0 ? currentWeight : coarseContribution;
    // Explicit endpoint avoids 0/0 and infinity in the fully trusted case.
    float previousWeight = minBlend > 0.0
        ? min(rejectionContribution * control.x / minBlend, previousValidity)
        : previousValidity;
    previousWeight = min(previousWeight, 1.0 - currentWeight);
#if defined(VIVID_TSR_HISTORY_DIAGNOSTICS)
    float initialHistoryWeight = previousWeight / max(currentWeight + previousWeight, 1e-8);
#endif
    float outputVelocity = length(motion * float2(outputSize));
    float maxMovingValidity = 1.0 - (1.0 - min(4.0 / maxSampleCount, 1.0)) * saturate(outputVelocity);
    float currentLuma = max(dot(currentColor, float3(1.0, 2.0, 1.0)), 0.0);
    float historyLuma = max(dot(historyColor, float3(1.0, 2.0, 1.0)), 0.0);
    float contrastValidity = abs(currentLuma - historyLuma) / max(max(currentLuma, historyLuma), 1e-8);
    previousWeight = min(previousWeight, max(maxMovingValidity, contrastValidity));
    float outputValidity = saturate(currentWeight + previousWeight);
    // Keep the public metadata in sample-count units, with UE's upward 8-bit
    // validity quantization. Color uses the unquantized contribution weights.
    float sampleCount = ceil(outputValidity * 255.0) * (maxSampleCount / 255.0);
    float historyToneWeight = max(0.0001, rcp(historyLuma + 4.0));
    float currentToneWeight = max(0.0001, rcp(currentLuma + 4.0));
    float historyContribution = previousWeight * historyToneWeight;
    float currentContribution = currentWeight * currentToneWeight;
    float historyWeight = historyContribution / max(historyContribution + currentContribution, 1e-8);
    float3 result = TSR_BlendColorVALU(currentColor, historyColor, historyWeight);

    float currentDepth = _DilatedDepth[renderCoord];
    _UpdatedHistoryColor[pixelCoord] = float4(max(result, 0.0), 1.0);
    _UpdatedHistoryMeta[pixelCoord] = float2(sampleCount, currentDepth);
    // This two-frame surface only retains the stationary-lighting confirmation.
    // Persistent color/validity are recorded separately, without a lifetime lerp.
    _UpdatedResurrectionColor[pixelCoord] = float4(0, 0, 0, max(shadingState, 0.0));
    _UpdatedResurrectionMeta[pixelCoord] = 0.0;
#if defined(VIVID_TSR_HISTORY_DIAGNOSTICS)
    _HistoryLossDiagnostics[pixelCoord] = float4(historyWeight, initialHistoryWeight, resurrected ? historyWeight : 0.0, updateInstability);
#endif
}
