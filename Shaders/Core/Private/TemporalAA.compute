#pragma kernel TemporalAA
#pragma kernel CopyColor

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/Core.hlsl"

Texture2D<float4> _InputColor;
Texture2D<float2> _MotionVectors;
Texture2D<float> _DepthTexture;
Texture2D<float4> _HistoryColor;

RWTexture2D<float4> _OutputColor;
RWTexture2D<float4> _HistoryColorWrite;

float4 _TAAParams;
float4 _Jitter;

float3 RGBToYCoCg(float3 rgb)
{
    float y = dot(rgb, float3(0.25, 0.5, 0.25));
    float co = dot(rgb, float3(0.5, 0.0, -0.5));
    float cg = dot(rgb, float3(-0.25, 0.5, -0.25));
    return float3(y, co, cg);
}

float3 YCoCgToRGB(float3 ycocg)
{
    float y = ycocg.x;
    float co = ycocg.y;
    float cg = ycocg.z;
    return float3(y + co - cg, y + cg, y - co - cg);
}

float4 SampleHistoryCatmullRom(Texture2D<float4> tex, float2 uv, float2 texSize)
{
    float2 position = uv * texSize;
    float2 center = floor(position - 0.5) + 0.5;
    float2 f = position - center;
    float2 f2 = f * f;
    float2 f3 = f2 * f;

    float2 w0 = f2 - 0.5 * (f3 + f);
    float2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    float2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    float2 w3 = 0.5 * (f3 - f2);

    float2 w12 = w1 + w2;
    float2 tc0 = (center - 1.0) / texSize;
    float2 tc12 = (center + w2 / w12) / texSize;
    float2 tc3 = (center + 2.0) / texSize;

    float4 result =
        tex.SampleLevel(sampler_LinearClamp, float2(tc12.x, tc0.y), 0) * (w12.x * w0.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc0.x, tc12.y), 0) * (w0.x * w12.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc12.x, tc12.y), 0) * (w12.x * w12.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc3.x, tc12.y), 0) * (w3.x * w12.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc12.x, tc3.y), 0) * (w12.x * w3.y);

    return max(result, 0.0);
}

float3 ClipToAABB(float3 color, float3 aabbMin, float3 aabbMax)
{
    float3 center = 0.5 * (aabbMax + aabbMin);
    float3 extents = 0.5 * (aabbMax - aabbMin) + 1e-8;
    float3 offset = color - center;
    float3 ts = abs(extents) / max(abs(offset), 1e-8);
    float t = saturate(min(min(ts.x, ts.y), ts.z));
    return center + offset * t;
}

[numthreads(8, 8, 1)]
void TemporalAA(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 pixelCoord = int2(dispatchThreadId.xy);
    if (any(pixelCoord >= int2(_ScreenSize.xy)))
        return;

    float2 uv = (float2(pixelCoord) + 0.5) * _ScreenSize.zw;
    float3 currentColor = _InputColor[pixelCoord].rgb;

    float2 motionVector = _MotionVectors[pixelCoord].xy;
    float2 historyUV = uv - motionVector;

    float3 m1 = 0.0;
    float3 m2 = 0.0;
    float3 neighborMin = 1e10;
    float3 neighborMax = -1e10;

    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 sampleCoord = clamp(pixelCoord + int2(dx, dy), 0, int2(_ScreenSize.xy) - 1);
            float3 sampleColor = RGBToYCoCg(_InputColor[sampleCoord].rgb);
            neighborMin = min(neighborMin, sampleColor);
            neighborMax = max(neighborMax, sampleColor);
            m1 += sampleColor;
            m2 += sampleColor * sampleColor;
        }
    }

    float3 mean = m1 * (1.0 / 9.0);
    float3 stddev = sqrt(abs(m2 * (1.0 / 9.0) - mean * mean));
    float3 clampMin = max(mean - 1.25 * stddev, neighborMin);
    float3 clampMax = min(mean + 1.25 * stddev, neighborMax);

    bool isHistoryValid = _TAAParams.w > 0.5 && all(historyUV >= 0.0) && all(historyUV <= 1.0);

    float3 historyColor;
    if (isHistoryValid)
        historyColor = SampleHistoryCatmullRom(_HistoryColor, historyUV, _ScreenSize.xy).rgb;
    else
        historyColor = currentColor;

    float3 historyYCoCg = RGBToYCoCg(historyColor);
    historyYCoCg = ClipToAABB(historyYCoCg, clampMin, clampMax);
    historyColor = YCoCgToRGB(historyYCoCg);
    historyColor = max(historyColor, 0.0);

    float motionLength = length(motionVector * _ScreenSize.xy);
    float velocityWeight = exp(-motionLength * _TAAParams.y);

    float currentLuma = RGBToYCoCg(currentColor).x;
    float historyLuma = historyYCoCg.x;
    float lumaDiff = abs(currentLuma - historyLuma) / max(max(currentLuma, historyLuma), 0.2);
    float antiFlicker = 1.0 - saturate(lumaDiff * _TAAParams.z);

    float blendFactor = _TAAParams.x * velocityWeight * antiFlicker;
    blendFactor = isHistoryValid ? blendFactor : 0.0;

    float3 result = lerp(currentColor, historyColor, blendFactor);

    _OutputColor[pixelCoord] = float4(result, 1.0);
    _HistoryColorWrite[pixelCoord] = float4(result, 1.0);
}

[numthreads(8, 8, 1)]
void CopyColor(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 pixelCoord = int2(dispatchThreadId.xy);
    if (any(pixelCoord >= int2(_ScreenSize.xy)))
        return;

    _OutputColor[pixelCoord] = _InputColor[pixelCoord];
}
