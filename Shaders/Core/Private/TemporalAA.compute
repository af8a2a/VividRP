#pragma kernel TemporalAA
#pragma kernel CopyColor
#pragma kernel ComputeDispatchArgsCS
#pragma kernel EdgesColor2x2CS
#pragma kernel ProcessCandidatesCS
#pragma kernel DeferredColorApply2x2CS

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Core.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/MotionVectorsCommon.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/AutoExposure.hlsl"

Texture2D<float4> _InputColor;
Texture2D<float4> _MotionVectors;
Texture2D<float> _DepthTexture;
Texture2D<float4> _HistoryColor;

RWTexture2D<float4> _OutputColor;
RWTexture2D<float4> _HistoryColorWrite;

float4 _TAAParams;
float4 _Jitter;
float _TAAUsePreExposure;

float TAALuminance(float3 rgb)
{
    return dot(rgb, float3(0.2126, 0.7152, 0.0722));
}

float3 TonemapTAA(float3 rgb)
{
    float3 clamped = max(rgb, 0.0);
    return clamped * rcp(1.0 + TAALuminance(clamped));
}

float3 InverseTonemapTAA(float3 rgb)
{
    float3 clamped = max(rgb, 0.0);
    return clamped * rcp(max(1.0 - TAALuminance(clamped), 1e-4));
}

float3 RGBToYCoCg(float3 rgb)
{
    float y = dot(rgb, float3(0.25, 0.5, 0.25));
    float co = dot(rgb, float3(0.5, 0.0, -0.5));
    float cg = dot(rgb, float3(-0.25, 0.5, -0.25));
    return float3(y, co, cg);
}

float3 YCoCgToRGB(float3 ycocg)
{
    float y = ycocg.x;
    float co = ycocg.y;
    float cg = ycocg.z;
    return float3(y + co - cg, y + cg, y - co - cg);
}

float4 SampleHistoryCatmullRom(Texture2D<float4> tex, float2 uv, float2 texSize)
{
    float2 position = uv * texSize;
    float2 center = floor(position - 0.5) + 0.5;
    float2 f = position - center;
    float2 f2 = f * f;
    float2 f3 = f2 * f;

    float2 w0 = f2 - 0.5 * (f3 + f);
    float2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    float2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    float2 w3 = 0.5 * (f3 - f2);

    float2 w12 = w1 + w2;
    float2 tc0 = (center - 1.0) / texSize;
    float2 tc12 = (center + w2 / w12) / texSize;
    float2 tc3 = (center + 2.0) / texSize;

    float4 result =
        tex.SampleLevel(sampler_LinearClamp, float2(tc12.x, tc0.y), 0) * (w12.x * w0.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc0.x, tc12.y), 0) * (w0.x * w12.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc12.x, tc12.y), 0) * (w12.x * w12.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc3.x, tc12.y), 0) * (w3.x * w12.y) +
        tex.SampleLevel(sampler_LinearClamp, float2(tc12.x, tc3.y), 0) * (w12.x * w3.y);

    return max(result, 0.0);
}

float3 ClipToAABB(float3 color, float3 aabbMin, float3 aabbMax)
{
    float3 center = 0.5 * (aabbMax + aabbMin);
    float3 extents = 0.5 * (aabbMax - aabbMin) + 1e-8;
    float3 offset = color - center;
    float3 ts = abs(extents) / max(abs(offset), 1e-8);
    float t = saturate(min(min(ts.x, ts.y), ts.z));
    return center + offset * t;
}

[numthreads(8, 8, 1)]
void TemporalAA(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 pixelCoord = int2(dispatchThreadId.xy);
    int2 screenSize = int2(_ScreenSize.xy);
    if (any(pixelCoord >= screenSize))
        return;

    int2 screenMax = screenSize - 1;
    float2 uv = (float2(pixelCoord) + 0.5) * _ScreenSize.zw;
    float3 currentColor = max(_InputColor[pixelCoord].rgb, 0.0);

    // 3x3 closest-depth velocity dilation prevents foreground silhouettes from smearing onto disoccluded backgrounds.
    int2 closestCoord = pixelCoord;
    float closestDepth = _DepthTexture[pixelCoord];
    [unroll]
    for (int ddy = -1; ddy <= 1; ddy++)
    {
        [unroll]
        for (int ddx = -1; ddx <= 1; ddx++)
        {
            if (ddx == 0 && ddy == 0)
                continue;
            int2 sampleCoord = clamp(pixelCoord + int2(ddx, ddy), 0, screenMax);
            float sampleDepth = _DepthTexture[sampleCoord];
#if UNITY_REVERSED_Z
            if (sampleDepth > closestDepth)
#else
            if (sampleDepth < closestDepth)
#endif
            {
                closestDepth = sampleDepth;
                closestCoord = sampleCoord;
            }
        }
    }

    float2 motionVector;
    DecodeMotionVector(_MotionVectors[closestCoord], motionVector);
    // _Jitter stores unflipped camera projection offsets (m03, m13), where +Y already matches RT +V after GPU Y-flip.
    float2 jitterDelta = (_Jitter.zw - _Jitter.xy) * 0.5;
    float2 historyUV = uv - motionVector + jitterDelta;

    float3 m1 = 0.0;
    float3 m2 = 0.0;
    float3 neighborMin = 1e10;
    float3 neighborMax = -1e10;

    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 sampleCoord = clamp(pixelCoord + int2(dx, dy), 0, screenMax);
            float3 sampleColor = RGBToYCoCg(TonemapTAA(_InputColor[sampleCoord].rgb));
            neighborMin = min(neighborMin, sampleColor);
            neighborMax = max(neighborMax, sampleColor);
            m1 += sampleColor;
            m2 += sampleColor * sampleColor;
        }
    }

    float3 mean = m1 * (1.0 / 9.0);
    float3 stddev = sqrt(max(m2 * (1.0 / 9.0) - mean * mean, 0.0));
    float3 clampMin = max(mean - 1.0 * stddev, neighborMin);
    float3 clampMax = min(mean + 1.0 * stddev, neighborMax);

    float currentPreExposure = _TAAUsePreExposure > 0.5 ? VividGetPreExposure() : 1.0;
    bool isHistoryValid = _TAAParams.w > 0.5 && all(historyUV >= 0.0) && all(historyUV <= 1.0);

    float3 historyColor;
    if (isHistoryValid)
    {
        historyColor = SampleHistoryCatmullRom(_HistoryColor, historyUV, _ScreenSize.xy).rgb;
        if (_TAAUsePreExposure > 0.5)
        {
            int2 histCoord = clamp(int2(historyUV * _ScreenSize.xy), 0, screenMax);
            float prevPreExposure = _HistoryColor[histCoord].a;
            if (prevPreExposure > 1e-4)
                historyColor *= currentPreExposure / prevPreExposure;
        }
    }
    else
    {
        historyColor = currentColor;
    }

    float3 currentTone = TonemapTAA(currentColor);
    float3 historyToneYCoCg = RGBToYCoCg(TonemapTAA(historyColor));
    float3 clippedToneYCoCg = ClipToAABB(historyToneYCoCg, clampMin, clampMax);
    float clipDistance = length(clippedToneYCoCg - historyToneYCoCg);
    float3 clippedHistoryTone = max(YCoCgToRGB(clippedToneYCoCg), 0.0);

    float motionLength = length(motionVector * _ScreenSize.xy);
    float velocityWeight = lerp(0.55, 1.0, exp(-motionLength * (_TAAParams.y * 0.08)));
    float clipConfidence = exp(-clipDistance * 8.0);

    float currentLuma = RGBToYCoCg(currentTone).x;
    float historyLuma = clippedToneYCoCg.x;
    float lumaDiff = abs(currentLuma - historyLuma) / max(max(currentLuma, historyLuma), 0.1);
    float antiFlicker = 1.0 - saturate(lumaDiff * _TAAParams.z);

    float blendFactor = _TAAParams.x * velocityWeight * clipConfidence * antiFlicker;
    blendFactor = isHistoryValid ? blendFactor : 0.0;

    float3 blendedTone = lerp(currentTone, clippedHistoryTone, blendFactor);
    float3 result = max(InverseTonemapTAA(blendedTone), 0.0);

    _OutputColor[pixelCoord] = float4(result, 1.0);
    _HistoryColorWrite[pixelCoord] = float4(result, currentPreExposure);
}

[numthreads(8, 8, 1)]
void CopyColor(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    int2 pixelCoord = int2(dispatchThreadId.xy);
    if (any(pixelCoord >= int2(_ScreenSize.xy)))
        return;

    _OutputColor[pixelCoord] = _InputColor[pixelCoord];
}

#define CMAA2_UAV_STORE_TYPED 1
#define CMAA2_UAV_STORE_CONVERT_TO_SRGB 0
#define CMAA2_UAV_STORE_TYPED_UNORM_FLOAT 0
#define CMAA2_SUPPORT_HDR_COLOR_RANGE 1
#define CMAA2_EDGE_DETECTION_LUMA_PATH 1

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/CMAA2.hlsl"
