#pragma use_dxc
#pragma kernel ClearVBufferLighting
#pragma kernel VolumetricLighting
#pragma kernel FilterVolumetricLighting

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/LightingLoop.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Private/Volumetric/VBuffer.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/EntityLighting.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/GeometricTools.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/VolumeRendering.hlsl"

Texture2D<float> _CameraDepth;
Texture2D<float> _DirectionalShadowTexture;
Texture2D<float> _VBufferMaxZ;
Texture3D<float4> _VBufferDensity;
Texture3D<float4> _VBufferLightingInput;
RWTexture3D<float4> _VBufferLighting;
RWTexture3D<float4> _VBufferLightingOutput;
StructuredBuffer<float4> _VolumetricAmbientProbeBuffer;
float _VBufferMaxZEnabled;
uint _VolumetricUseBigTileLightList;

#define GROUP_SIZE_1D           8
#define VBUFFER_MAX_AREA_LIGHTS 8u
#define VBUFFER_FILTER_GAUSSIAN_SIGMA 1.0
#define VBUFFER_FILTER_GROUP_SIZE_XY 8
#define VBUFFER_FILTER_SIZE_1D (VBUFFER_FILTER_GROUP_SIZE_XY + 2)
#define VBUFFER_FILTER_LDS_SIZE (VBUFFER_FILTER_SIZE_1D * VBUFFER_FILTER_SIZE_1D)
#define VBUFFER_FILTER_THREAD_COUNT (VBUFFER_FILTER_GROUP_SIZE_XY * VBUFFER_FILTER_GROUP_SIZE_XY)

groupshared float4 gs_VBufferFilterCache[VBUFFER_FILTER_LDS_SIZE];

struct VoxelLighting
{
    float3 radianceComplete;  // includes CornetteShanksPhasePartVarying
    float3 radianceNoPhase;   // without phase (for future reprojection)
};

struct JitteredRay
{
    float3 originWS;
    float3 centerDirWS;
    float3 jitterDirWS;
    float3 xDirDerivWS;
    float3 yDirDerivWS;
    float geomDist;
    float maxDist;
};

uint HashVBufferUint(uint value)
{
    value ^= value >> 16;
    value *= 2246822519u;
    value ^= value >> 13;
    value *= 3266489917u;
    value ^= value >> 16;
    return value;
}

float GenerateVBufferRandom(uint3 voxelCoord, uint lightIndex, uint sampleIndex)
{
    uint seed = voxelCoord.x * 73856093u
        ^ voxelCoord.y * 19349663u
        ^ voxelCoord.z * 83492791u
        ^ lightIndex * 2654435761u
        ^ sampleIndex * 1597334677u;
    return (float)(HashVBufferUint(seed) & 0x00ffffffu) * (1.0 / 16777216.0);
}

float GenerateVBufferRandom(uint2 pixelCoord)
{
    uint seed = pixelCoord.x * 73856093u
        ^ pixelCoord.y * 19349663u
        ^ 0x9e3779b9u;
    return (float)(HashVBufferUint(seed) & 0x00ffffffu) * (1.0 / 16777216.0);
}

float2 GetVBufferSampleUV(uint2 vBufferPixel, float2 sampleOffset)
{
    return (float2(vBufferPixel) + 0.5 + sampleOffset) * _VBufferRcpViewportSize;
}

uint2 GetVBufferCameraPixel(uint2 vBufferPixel, float2 sampleOffset)
{
    return (uint2)((float2(vBufferPixel) + 0.5 + sampleOffset) * _VBufferCameraToVBufferScale);
}

float SampleDirectionalShadow(uint2 vBufferPixel, uint lightIndex, DirectionalLightData directionalLight, float3 samplePositionWS)
{
    if ((int)lightIndex != _MainDirectionalLightIndex)
        return 1.0;

    float2 cameraPixel = (float2(vBufferPixel) + 0.5) * _VBufferCameraToVBufferScale;
    float2 cameraDimensions = _VBufferViewportSize.xy * _VBufferCameraToVBufferScale;
    float2 uv = cameraPixel / max(cameraDimensions, float2(1.0, 1.0));
    float shadow = _DirectionalShadowTexture.SampleLevel(sampler_PointClamp, saturate(uv), 0).x;
    float volumetricShadowStrength = saturate(directionalLight.shadowStrength * directionalLight.volumetricShadowDimmer);
    return lerp(1.0, saturate(shadow), volumetricShadowStrength);
}

bool LightAffectsVolumetrics(uint affectVolumetric, float volumetricDimmer)
{
    return affectVolumetric != 0u && volumetricDimmer > 0.0;
}

bool IsInRange(float value, float2 range)
{
    return clamp(value, range.x, range.y) == value;
}

float GetVolumetricLightCameraDistance(float3 lightPositionWS)
{
    return distance(_WorldSpaceCameraPos, lightPositionWS);
}

float EvaluateVolumetricLightFade(float distanceToCamera, float fadeDistance)
{
    return fadeDistance > 0.0 ? saturate(1.0 - distanceToCamera / fadeDistance) : 0.0;
}

bool ShouldEvaluateVBufferLighting(float extinction)
{
    return extinction > _VBufferDensityCutoff;
}

float4 EncodeIntegratedVBufferLighting(float3 totalRadiance, float opticalDepth)
{
    float transmittance = TransmittanceFromOpticalDepth(opticalDepth);
    return float4(VividApplyPreExposure(max(totalRadiance, 0.0)), saturate(transmittance));
}

void StoreIntegratedVBufferLighting(uint3 voxelCoord, float3 totalRadiance, float opticalDepth)
{
    _VBufferLighting[voxelCoord] = EncodeIntegratedVBufferLighting(totalRadiance, opticalDepth);
}

void StoreEmptyVBufferLighting(uint3 voxelCoord)
{
    _VBufferLighting[voxelCoord] = float4(0.0, 0.0, 0.0, 1.0);
}

JitteredRay BuildVBufferJitteredRay(uint2 vBufferPixel, float2 sampleOffset)
{
    float3 F = GetViewForwardDir();
    float3 U = GetViewUpDir();
    float2 centerCoord = float2(vBufferPixel) + 0.5;

    // Same convention as HDRP: ViewSpace(rayDirWS).z == 1 before normalization.
    float3 rayDirWS = mul(-float4(centerCoord, 1.0, 1.0), _VBufferCoordToViewDirWS).xyz;
    float3 rightDirWS = cross(rayDirWS, U);
    float rcpLenRayDir = rsqrt(max(dot(rayDirWS, rayDirWS), 1e-8));
    float rcpLenRightDir = rsqrt(max(dot(rightDirWS, rightDirWS), 1e-8));

    JitteredRay ray;
    ray.originWS = _WorldSpaceCameraPos;
    ray.centerDirWS = rayDirWS * rcpLenRayDir;

    float FdotD = max(dot(F, ray.centerDirWS), 1e-4);
    float unitDistFaceSize = _VBufferUnitDepthTexelSpacing * FdotD * rcpLenRayDir;
    ray.xDirDerivWS = rightDirWS * (rcpLenRightDir * unitDistFaceSize);
    ray.yDirDerivWS = cross(ray.xDirDerivWS, ray.centerDirWS);
    ray.jitterDirWS = SafeNormalize(ray.centerDirWS + sampleOffset.x * ray.xDirDerivWS + sampleOffset.y * ray.yDirDerivWS);
    ray.geomDist = FLT_MAX;
    ray.maxDist = FLT_MAX;
    return ray;
}

float GetVBufferJitteredRayStartDistance(JitteredRay ray)
{
    float forwardDistance = _VBufferIsOrthographic > 0.5 ? 1.0 : max(dot(ray.jitterDirWS, GetViewForwardDir()), 1e-4);
    return max(GetVBufferSliceBoundaryDistance(0.0), g_fNearPlane / forwardDistance);
}

float GetVBufferLinearDistanceFromEyeDepthForRay(float linearEyeDepth, JitteredRay ray)
{
    if (_VBufferIsOrthographic > 0.5)
        return linearEyeDepth;

    float forwardDistance = max(dot(ray.jitterDirWS, GetViewForwardDir()), 1e-4);
    return linearEyeDepth / forwardDistance;
}

float GetVBufferOpaqueGeometryDistanceForRay(float2 vBufferUV, JitteredRay ray, out bool hasOpaqueGeometry)
{
    float deviceDepth = _CameraDepth.SampleLevel(sampler_PointClamp, vBufferUV, 0);
    hasOpaqueGeometry = !IsVBufferFarDepth(deviceDepth);

    return hasOpaqueGeometry
        ? GetVBufferLinearDistanceFromEyeDepthForRay(LinearEyeDepth(deviceDepth, _ZBufferParams), ray)
        : _VBufferLastSliceDistance;
}

float LoadVBufferMaxZ(int2 maxZPixel, int2 maxZDimensions)
{
    int2 maxCoord = max(maxZDimensions - 1, int2(0, 0));
    int2 coord = clamp(maxZPixel, int2(0, 0), maxCoord);
    return _VBufferMaxZ.Load(int3(coord, 0));
}

float GetVBufferMaxOpaqueGeometryDistance(float2 vBufferUV, float3 rayDirectionWS, float fallbackDistance)
{
    if (_VBufferMaxZEnabled <= 0.5)
        return fallbackDistance;

    uint maxZWidth;
    uint maxZHeight;
    _VBufferMaxZ.GetDimensions(maxZWidth, maxZHeight);
    if (maxZWidth == 0u || maxZHeight == 0u)
        return fallbackDistance;

    float2 maxZDimensions = float2((float)maxZWidth, (float)maxZHeight);
    float2 maxZTexelCoord = vBufferUV * maxZDimensions - 0.5;
    int2 baseCoord = (int2)floor(maxZTexelCoord);
    int2 dimensions = int2((int)maxZWidth, (int)maxZHeight);
    float maxLinearEyeDepth = -1.0;

    [unroll]
    for (int y = 0; y <= 1; y++)
    {
        [unroll]
        for (int x = 0; x <= 1; x++)
        {
            maxLinearEyeDepth = max(maxLinearEyeDepth, LoadVBufferMaxZ(baseCoord + int2(x, y), dimensions));
        }
    }

    if (maxLinearEyeDepth < 0.0)
        return fallbackDistance;

    float forwardDistance = _VBufferIsOrthographic > 0.5 ? 1.0 : max(dot(rayDirectionWS, GetViewForwardDir()), 1e-4);
    float maxDistance = max(maxLinearEyeDepth / forwardDistance, fallbackDistance);
    return clamp(maxDistance, GetVBufferSliceBoundaryDistance(0.0), _VBufferLastSliceDistance);
}

float EvaluatePunctualLightDistanceAttenuation(PunctualLightData punctualLight, float distanceSquared)
{
    float distanceAttenuation = rcp(max(distanceSquared, 1e-6));
    float rangeAttenuation = saturate(1.0 - distanceSquared * punctualLight.inverseRangeSquared);
    return distanceAttenuation * rangeAttenuation * rangeAttenuation;
}

float EvaluatePunctualLightSpotAttenuation(PunctualLightData punctualLight, float3 lightDirectionWS)
{
    float attenuation = 1.0;

    if (punctualLight.lightType == VIVID_PUNCTUAL_LIGHT_TYPE_SPOT)
    {
        float spotCosine = saturate(dot(punctualLight.directionWS, -lightDirectionWS));
        attenuation = saturate(spotCosine * punctualLight.angleScale + punctualLight.angleOffset);
        attenuation *= attenuation;
    }

    return attenuation;
}

float3 EvaluatePunctualLightRadiance(PunctualLightData light, float3 positionWS)
{
    float3 lightVector = light.positionWS - positionWS;
    float distanceSquared = max(dot(lightVector, lightVector), 1e-6);
    float3 lightDirectionWS = lightVector * rsqrt(distanceSquared);
    float attenuation = EvaluatePunctualLightDistanceAttenuation(light, distanceSquared)
        * EvaluatePunctualLightSpotAttenuation(light, lightDirectionWS);

    if (attenuation <= 0.0)
        return 0.0;

    float volumetricFade = EvaluateVolumetricLightFade(
        GetVolumetricLightCameraDistance(light.positionWS),
        light.volumetricFadeDistance);
    return max(light.color, 0.0) * light.volumetricDimmer * volumetricFade * attenuation;
}

void CreatePerpendicularBasis(float3 forward, out float3 axisX, out float3 axisY)
{
    float3 up = abs(forward.y) < 0.999 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    axisX = SafeNormalize(cross(up, forward));
    axisY = cross(forward, axisX);
}

bool TryGetSpotConeAxes(PunctualLightData light, out float3 coneDirection, out float3 coneAxisX, out float3 coneAxisY)
{
    coneDirection = SafeNormalize(light.directionWS);
    coneAxisX = 0.0;
    coneAxisY = 0.0;

    if (light.lightType != VIVID_PUNCTUAL_LIGHT_TYPE_SPOT)
        return false;

    coneAxisX = light.rightWS;
    coneAxisY = light.upWS;

    if (dot(coneAxisX, coneAxisX) <= 1e-8 || dot(coneAxisY, coneAxisY) <= 1e-8)
    {
        float cosOuter = saturate(-light.angleOffset / max(light.angleScale, 1e-6));
        cosOuter = clamp(cosOuter, 1e-3, 0.999999);
        float sinOuter = sqrt(max(1.0 - cosOuter * cosOuter, 1e-6));
        float cotanOuter = cosOuter / sinOuter;
        float3 axisX;
        float3 axisY;
        CreatePerpendicularBasis(coneDirection, axisX, axisY);
        coneAxisX = axisX * cotanOuter;
        coneAxisY = axisY * cotanOuter;
    }

    return true;
}

bool IntersectRaySpotConeRange(float3 rayOriginWS, float3 rayDirectionWS, PunctualLightData light, float tMin, float tMax, out float tEntr, out float tExit)
{
    float3 coneDirection;
    float3 coneAxisX;
    float3 coneAxisY;
    if (!TryGetSpotConeAxes(light, coneDirection, coneAxisX, coneAxisY))
    {
        tEntr = tMin;
        tExit = tMax;
        return true;
    }

    return IntersectRayCone(
        rayOriginWS,
        rayDirectionWS,
        light.positionWS,
        coneDirection,
        coneAxisX,
        coneAxisY,
        tMin,
        tMax,
        tEntr,
        tExit);
}

VoxelLighting EvaluateVoxelLightingDirectional(uint3 voxelCoord, JitteredRay ray, float t0, float dt, float rndVal, float extinction, float anisotropy)
{
    VoxelLighting lighting = (VoxelLighting)0;
    uint directionalCount = min(_DirectionalLightCount, 8u);
    float tOffset;
    float weight;
    ImportanceSampleHomogeneousMedium(rndVal, extinction, dt, tOffset, weight);

    float t = t0 + tOffset;
    float3 sampleWS = ray.originWS + t * ray.jitterDirWS;

    [loop]
    for (uint i = 0; i < directionalCount; i++)
    {
        DirectionalLightData light = GetDirectionalLight((int)i);
        if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
            continue;

        float3 L = SafeNormalize(-light.directionWS);
        float3 lightColor = max(light.color, 0.0) * light.volumetricDimmer;
        float shadow = SampleDirectionalShadow(voxelCoord.xy, i, light, sampleWS);
        lightColor *= shadow;

        float cosTheta = dot(L, ray.centerDirWS);
        float g = clamp(anisotropy, -0.95, 0.95);
        float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);

        lighting.radianceNoPhase += weight * lightColor;
        lighting.radianceComplete += weight * lightColor * phaseVarying;
    }

    return lighting;
}

VoxelLighting EvaluateVoxelLightingLocal(uint3 voxelCoord, uint2 vBufferPixel, float3 centerWS, JitteredRay ray, float t0, float t1, float dt, float rndVal, float extinction, float anisotropy)
{
    VoxelLighting lighting = (VoxelLighting)0;

    if (_VBufferFogDirectionalOnly > 0.5)
        return lighting;

    float g = clamp(anisotropy, -0.95, 0.95);

    // Punctual lights via big tile light list
    bool hasVolumetricBigTileLightList = true;
    if (_VolumetricUseBigTileLightList == 0u || _NumTileBigTileX == 0u || _NumTileBigTileY == 0u)
        hasVolumetricBigTileLightList = false;

    if (hasVolumetricBigTileLightList)
    {
        uint2 cameraPixel = GetVBufferCameraPixel(vBufferPixel, float2(0.0, 0.0));
        VividBigTileLightingLoopContext bigTileLoop = VividLightingLoop::CreateBigTile(cameraPixel);
        uint lightCount = VividLightingLoop::GetBigTileLightCount(bigTileLoop);

        [loop]
        for (uint lightOffset = 0; lightOffset < lightCount; lightOffset++)
        {
            PunctualLightData light = VividLightingLoop::LoadBigTilePunctualLight(bigTileLoop, lightOffset);
            if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
                continue;

            float tEntr = t0;
            float tExit = t1;
            bool sampleLight = true;
            if (light.lightType == VIVID_PUNCTUAL_LIGHT_TYPE_SPOT)
            {
                float coneEntry;
                float coneExit;
                sampleLight = IntersectRaySpotConeRange(ray.originWS, ray.jitterDirWS, light, t0, t1, coneEntry, coneExit);
                tEntr = coneEntry;
                tExit = coneExit;
            }

            if (!sampleLight || tEntr >= tExit)
                continue;

            float voxelArcLength = _VBufferUnitDepthTexelSpacing * max(tEntr, 0.0);
            float lightSqRadius = max(max(light.shapeRadiusSquared, voxelArcLength), 1e-4);

            float t;
            float sqDist;
            float rcpPdf;
            ImportanceSamplePunctualLight(
                rndVal,
                light.positionWS,
                lightSqRadius,
                ray.originWS,
                ray.jitterDirWS,
                tEntr,
                tExit,
                t,
                sqDist,
                rcpPdf);

            float3 samplePosWS = ray.originWS + ray.jitterDirWS * t;
            float3 lightRadiance = EvaluatePunctualLightRadiance(light, samplePosWS);
            if (max(max(lightRadiance.x, lightRadiance.y), lightRadiance.z) <= 0.0)
                continue;

            float3 centerToLight = light.positionWS - centerWS;
            float cosTheta = dot(centerToLight, ray.centerDirWS) * rsqrt(dot(centerToLight, centerToLight));
            float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);
            float weight = TransmittanceHomogeneousMedium(extinction, max(t - t0, 0.0)) * rcpPdf;

            lighting.radianceNoPhase += weight * lightRadiance;
            lighting.radianceComplete += weight * lightRadiance * phaseVarying;
        }
    }

    // Area lights from cluster
    {
        float2 cameraPixel = (float2(vBufferPixel) + 0.5) * _VBufferCameraToVBufferScale;
        VividLightingLoopContext lightLoop = VividLightingLoop::Create((uint2)cameraPixel, centerWS);
        uint lightCount = min(min(VividLightingLoop::GetAreaLightCount(lightLoop), _AreaLightCount), VBUFFER_MAX_AREA_LIGHTS);

        [loop]
        for (uint localLightIndex = 0; localLightIndex < lightCount; localLightIndex++)
        {
            AreaLightData light = VividLightingLoop::LoadAreaLight(lightLoop, localLightIndex);
            if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
                continue;

            float3 lightVector = light.positionWS - centerWS;
            float distanceSq = max(dot(lightVector, lightVector), 1e-4);
            float distanceToLight = sqrt(distanceSq);
            float3 lightDirectionWS = lightVector / distanceToLight;

            float cosTheta = dot(lightDirectionWS, ray.centerDirWS);
            float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);

            float rangeAttenuation = saturate(1.0 - distanceToLight / max(light.range, 1e-4));
            rangeAttenuation *= rangeAttenuation;
            float volumetricFade = EvaluateVolumetricLightFade(
                GetVolumetricLightCameraDistance(light.positionWS),
                light.volumetricFadeDistance);

            float weight = TransmittanceIntegralHomogeneousMedium(extinction, dt);
            float3 lightRadiance = max(light.color, 0.0) * light.volumetricDimmer * volumetricFade * rangeAttenuation / max(distanceSq, 1.0);

            lighting.radianceNoPhase += weight * lightRadiance;
            lighting.radianceComplete += weight * lightRadiance * phaseVarying;
        }
    }

    return lighting;
}

float3 EvaluateAmbientLighting()
{
    return max(unity_AmbientSky.rgb, 0.0) * _VBufferGlobalProbeDimmer;
}

float3 EvaluateVolumetricAmbientProbe(float3 normalWS)
{
    return SampleSH9(_VolumetricAmbientProbeBuffer, SafeNormalize(normalWS));
}

void FillVolumetricLightingBuffer(PositionInputs posInput, uint tileIndex, int groupIdx, JitteredRay ray, float tStart)
{
    uint lightCount, lightStart;

#ifdef USE_BIG_TILE_LIGHTLIST
    // Offset for stereo rendering
    tileIndex += unity_StereoEyeIndex * _NumTileBigTileX * _NumTileBigTileY;

    GetBigTileLightCountAndStart(tileIndex, lightCount, lightStart);

#else  // USE_BIG_TILE_LIGHTLIST

    lightCount = _PunctualLightCount;
    lightStart = 0;

#endif // USE_BIG_TILE_LIGHTLIST

    float t0 = max(tStart, DecodeLogarithmicDepthGeneralized(0, _VBufferDistanceDecodingParams));
    float de = _VBufferRcpSliceCount; // Log-encoded distance between slices

    // The contribution of the ambient probe does not depend on the position,
    // only on the direction and the length of the interval.
    // SampleSH9() evaluates the 3-band SH in a given direction.
    // The probe is already pre-convolved with the phase function.
    // Note: anisotropic, no jittering.
    float3 probeInScatteredRadiance = EvaluateVolumetricAmbientProbe(ray.centerDirWS);

    float waterDistance = FLT_MIN;
    #if SUPPORT_WATER_ABSORPTION
    float2 posSS = posInput.positionNDC.xy * _ScreenSize.xy;
    bool underWater = posInput.positionWS.y < _UnderWaterUpHeight.w || IsUnderWater(posSS.xy);
    if (underWater && (GetStencilValue(LOAD_TEXTURE2D_X(_StencilTexture, posInput.positionSS.xy)) & STENCILUSAGE_WATER_SURFACE) != 0)
    {
        waterDistance = LinearEyeDepth(LOAD_TEXTURE2D_X(_RefractiveDepthBuffer, posSS).r, _ZBufferParams);
        waterDistance = waterDistance * rcp(dot(ray.centerDirWS, GetViewForwardDir()));
    }
    else
        waterDistance = underWater ? FLT_MAX : 0.0f;
    #endif

    float3 totalRadiance = 0;
    float  opticalDepth  = 0;
    uint slice = 0;
    for (; slice < _VBufferSliceCount; slice++)
    {
        uint3 voxelCoord = uint3(posInput.positionSS, slice + _VBufferSliceCount * unity_StereoEyeIndex);

        float e1 = slice * de + de; // (slice + 1) / sliceCount
        float t1 = max(tStart, DecodeLogarithmicDepthGeneralized(e1, _VBufferDistanceDecodingParams));
        float tNext = t1;

    #if USE_DEPTH_BUFFER
        bool containsOpaqueGeometry = IsInRange(ray.geomDist, float2(t0, t1));

        if (containsOpaqueGeometry)
        {
            // Only integrate up to the opaque surface (make the voxel shorter, but not completely flat).
            // Note that we can NOT completely stop integrating when the ray reaches geometry, since
            // otherwise we get flickering at geometric discontinuities if reprojection is enabled.
            // In this case, a temporally stable light leak is better than flickering.
            t1 = max(t0 * 1.0001, ray.geomDist);
        }
    #endif
        float dt = t1 - t0; // Is geometry-aware
        if(dt <= 0.0)
        {
            _VBufferLighting[voxelCoord] = 0;
#ifdef ENABLE_REPROJECTION
            _VBufferFeedback[voxelCoord] = 0;
#endif
            t0 = t1;
            continue;
        }

        // Accurately compute the center of the voxel in the log space. It's important to perform
        // the inversion exactly, since the accumulated value of the integral is stored at the center.
        // We will use it for participating media sampling, asymmetric scattering and reprojection.
        float  t = DecodeLogarithmicDepthGeneralized(e1 - 0.5 * de, _VBufferDistanceDecodingParams);
        float3 centerWS = ray.originWS + t * ray.centerDirWS;

        // Sample the participating medium at the center of the voxel.
        // We consider it to be constant along the interval [t0, t1] (within the voxel).
        float4 density = LOAD_TEXTURE3D(_VBufferDensity, voxelCoord);

        float3 scattering = density.rgb;
        float  extinction = density.a;
        float  anisotropy = _GlobalFogAnisotropy;

        float voxelOpticalDepth = extinction * dt;

        // When extinction is 0, we can skip the light evaluation as we there be no contribution
        // We can write the value of previous voxels in the buffer
        if (extinction > _VolumetricLightingExtinctionCutoff)
        {
            // Perform per-pixel randomization by adding an offset and then sampling uniformly
            // (in the log space) in a vein similar to Stochastic Universal Sampling:
            // https://en.wikipedia.org/wiki/Stochastic_universal_sampling
            float perPixelRandomOffset = GenerateHashedRandomFloat(posInput.positionSS);

        #ifdef ENABLE_REPROJECTION
            // This is a time-based sequence of 7 equidistant numbers from 1/14 to 13/14.
            // Each of them is the centroid of the interval of length 2/14.
            float rndVal = frac(perPixelRandomOffset + _VBufferSampleOffset.z);
        #else
            float rndVal = frac(perPixelRandomOffset + 0.5);
        #endif

            VoxelLighting aggregateLighting;
            ZERO_INITIALIZE(VoxelLighting, aggregateLighting);

            // Prevent division by 0.
            extinction = max(extinction, FLT_MIN);

            if (featureFlags & LIGHTFEATUREFLAGS_DIRECTIONAL)
            {
                VoxelLighting lighting = EvaluateVoxelLightingDirectional(context, featureFlags, posInput,
                                                                          centerWS, ray, t0, t1, dt, rndVal,
                                                                          extinction, anisotropy, t < waterDistance);

                aggregateLighting.radianceNoPhase  += lighting.radianceNoPhase;
                aggregateLighting.radianceComplete += lighting.radianceComplete;
            }

            #ifdef SUPPORT_LOCAL_LIGHTS
            {
                VoxelLighting lighting = EvaluateVoxelLightingLocal(context, groupIdx, featureFlags, posInput,
                                                                    lightCount, lightStart,
                                                                    centerWS, ray, t0, t1, dt, rndVal,
                                                                    extinction, anisotropy);

                aggregateLighting.radianceNoPhase  += lighting.radianceNoPhase;
                aggregateLighting.radianceComplete += lighting.radianceComplete;
            }
            #endif

            #if SAMPLE_PROBE_VOLUMES
            {
                float3 apvDiffuseGI = EvaluateVoxelDiffuseGI(posInput, ray, t0, dt, rndVal, extinction);
                aggregateLighting.radianceNoPhase += apvDiffuseGI;
                aggregateLighting.radianceComplete += apvDiffuseGI;

            }
            #endif

        #ifdef ENABLE_REPROJECTION
            // Clamp here to prevent generation of NaNs.
            float4 voxelValue           = float4(aggregateLighting.radianceNoPhase, extinction * dt);
            float4 linearizedVoxelValue = LinearizeRGBD(voxelValue);
            float4 normalizedVoxelValue = linearizedVoxelValue * rcp(dt);
            float4 normalizedBlendValue = normalizedVoxelValue;

        #if (SHADEROPTIONS_CAMERA_RELATIVE_RENDERING != 0) && defined(USING_STEREO_MATRICES)
            // With XR single-pass, remove the camera-relative offset for the reprojected sample
            centerWS -= _WorldSpaceCameraPosViewOffset;
        #endif

            // Reproject the history at 'centerWS'.
            float4 reprojValue = SampleVBuffer(TEXTURE3D_ARGS(_VBufferHistory, s_linear_clamp_sampler),
                                               centerWS,
                                               _PrevCamPosRWS.xyz,
                                               UNITY_MATRIX_PREV_VP,
                                               _VBufferPrevViewportSize,
                                               _VBufferHistoryViewportScale.xyz,
                                               _VBufferHistoryViewportLimit.xyz,
                                               _VBufferPrevDistanceEncodingParams,
                                               _VBufferPrevDistanceDecodingParams,
                                               false, false, true) * float4(GetInversePreviousExposureMultiplier().xxx, 1);

            bool reprojSuccess = (_VBufferHistoryIsValid != 0) && (reprojValue.a != 0);

            if (reprojSuccess)
            {
                // Perform temporal blending in the log space ("Pixar blend").
                normalizedBlendValue = lerp(normalizedVoxelValue, reprojValue, ComputeHistoryWeight());
            }

            // Store the feedback for the voxel.
            // TODO: dynamic lights (which update their position, rotation, cookie or shadow at runtime)
            // do not support reprojection and should neither read nor write to the history buffer.
            // This will cause them to alias, but it is the only way to prevent ghosting.
            _VBufferFeedback[voxelCoord] = clamp(normalizedBlendValue * float4(GetCurrentExposureMultiplier().xxx, 1), 0, HALF_MAX);

            float4 linearizedBlendValue = normalizedBlendValue * dt;
            float4 blendValue = DelinearizeRGBD(linearizedBlendValue);

        #ifdef ENABLE_ANISOTROPY
            // Estimate the influence of the phase function on the results of the current frame.
            float3 phaseCurrFrame;

            phaseCurrFrame.r = SafeDiv(aggregateLighting.radianceComplete.r, aggregateLighting.radianceNoPhase.r);
            phaseCurrFrame.g = SafeDiv(aggregateLighting.radianceComplete.g, aggregateLighting.radianceNoPhase.g);
            phaseCurrFrame.b = SafeDiv(aggregateLighting.radianceComplete.b, aggregateLighting.radianceNoPhase.b);

            // Warning: in general, this does not work!
            // For a voxel with a single light, 'phaseCurrFrame' is monochromatic, and since
            // we don't jitter anisotropy, its value does not change from frame to frame
            // for a static camera/scene. This is fine.
            // If you have two lights per voxel, we compute:
            // phaseCurrFrame = (phaseA * lightingA + phaseB * lightingB) / (lightingA + lightingB).
            // 'phaseA' and 'phaseB' are still (different) constants for a static camera/scene.
            // 'lightingA' and 'lightingB' are jittered, so they change from frame to frame.
            // Therefore, 'phaseCurrFrame' becomes temporarily unstable and can cause flickering in practice. :-(
            blendValue.rgb *= phaseCurrFrame;
        #endif // ENABLE_ANISOTROPY

        #else // NO REPROJECTION

        #ifdef ENABLE_ANISOTROPY
            float4 blendValue = float4(aggregateLighting.radianceComplete, extinction * dt);
        #else
            float4 blendValue = float4(aggregateLighting.radianceNoPhase,  extinction * dt);
        #endif // ENABLE_ANISOTROPY

        #endif // ENABLE_REPROJECTION

            // Compute the transmittance from the camera to 't0'.
            float transmittance = TransmittanceFromOpticalDepth(opticalDepth);

        #ifdef ENABLE_ANISOTROPY
            float phase = _CornetteShanksConstant;
        #else
            float phase = IsotropicPhaseFunction();
        #endif // ENABLE_ANISOTROPY

            // Integrate the contribution of the probe over the interval.
            // Integral{a, b}{Transmittance(0, t) * L_s(t) dt} = Transmittance(0, a) * Integral{a, b}{Transmittance(0, t - a) * L_s(t) dt}.
            float3 probeRadiance = probeInScatteredRadiance * TransmittanceIntegralHomogeneousMedium(extinction, dt);

            // Accumulate radiance along the ray.
            totalRadiance += transmittance * scattering * (phase * blendValue.rgb + probeRadiance);
        }

        // Compute the optical depth up to the center of the interval.
        opticalDepth += 0.5 * voxelOpticalDepth;

        // Store the voxel data.
        // Note: for correct filtering, the data has to be stored in the perceptual space.
        // This means storing the tone mapped radiance and transmittance instead of optical depth.
        // See "A Fresh Look at Generalized Sampling", p. 51.
        // TODO: re-enable tone mapping after implementing pre-exposure.
        _VBufferLighting[voxelCoord] = max(0, LinearizeRGBD(float4(/*FastTonemap*/(totalRadiance), opticalDepth)) * float4(GetCurrentExposureMultiplier().xxx, 1));

        // Compute the optical depth up to the end of the interval.
        opticalDepth += 0.5 * voxelOpticalDepth;

        if (t0 * 0.99 > ray.maxDist)
        {
            break;
        }

        t0 = tNext;
    }

    for (; slice < _VBufferSliceCount; slice++)
    {
        uint3 voxelCoord = uint3(posInput.positionSS, slice + _VBufferSliceCount * unity_StereoEyeIndex);
        _VBufferLighting[voxelCoord] = 0;
#ifdef ENABLE_REPROJECTION
        _VBufferFeedback[voxelCoord] = 0;
#endif

    }

}

[numthreads(8, 8, 4)]
void ClearVBufferLighting(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (!IsInsideVBuffer(dispatchThreadId))
        return;

    _VBufferLighting[dispatchThreadId] = float4(0.0, 0.0, 0.0, 1.0);
}

[numthreads(8, 8, 1)]
void VolumetricLighting(uint3 dispatchThreadId : SV_DispatchThreadID,
                        uint2 groupId : SV_GroupID,
                        uint2 groupThreadId : SV_GroupThreadID,
                        uint groupIndex : SV_GroupIndex)
{
    uint2 groupOffset = groupId * GROUP_SIZE_1D;
    uint2 voxelCoord  = groupOffset + groupThreadId;

    // Reminder: our voxels are sphere-capped right frustums (truncated right pyramids).
    // The curvature of the front and back faces is quite gentle, so we can use
    // the right frustum approximation (thus the front and the back faces are squares).
    // Note, that since we still rely on the perspective camera model, pixels at the center
    // of the screen correspond to larger solid angles than those at the edges.
    // Basically, sizes of front and back faces depend on the XY coordinate.
    // https://www.desmos.com/calculator/i3rkesvidk

    float3 F = GetViewForwardDir();
    float3 U = GetViewUpDir();
    float3 R = cross(F, U);

    float2 centerCoord = voxelCoord + float2(0.5, 0.5);

    // Compute a ray direction s.t. ViewSpace(rayDirWS).z = 1.
    float3 rayDirWS       = mul(-float4(centerCoord, 1, 1), _VBufferCoordToViewDirWS[unity_StereoEyeIndex]).xyz;
    float3 rightDirWS     = cross(rayDirWS, U);
    float  rcpLenRayDir   = rsqrt(dot(rayDirWS, rayDirWS));
    float  rcpLenRightDir = rsqrt(dot(rightDirWS, rightDirWS));

    JitteredRay ray;
    ray.originWS    = GetCurrentViewPosition();
    ray.centerDirWS = rayDirWS * rcpLenRayDir; // Normalize

    float FdotD = dot(F, ray.centerDirWS);
    float unitDistFaceSize = _VBufferUnitDepthTexelSpacing * FdotD * rcpLenRayDir;

    ray.xDirDerivWS = rightDirWS * (rcpLenRightDir * unitDistFaceSize); // Normalize & rescale
    ray.yDirDerivWS = cross(ray.xDirDerivWS, ray.centerDirWS); // Will have the length of 'unitDistFaceSize' by construction


    #ifdef ENABLE_REPROJECTION
    float2 sampleOffset = _VBufferSampleOffset.xy;
    #else
    float2 sampleOffset = 0;
    #endif

    ray.jitterDirWS = normalize(ray.centerDirWS + sampleOffset.x * ray.xDirDerivWS
                                            + sampleOffset.y * ray.yDirDerivWS);
    float tStart = g_fNearPlane / dot(ray.jitterDirWS, F);

    // We would like to determine the screen pixel (at the full resolution) which
    // the jittered ray corresponds to. The exact solution can be obtained by intersecting
    // the ray with the screen plane, e.i. (ViewSpace(jitterDirWS).z = 1). That's a little expensive.
    // So, as an approximation, we ignore the curvature of the frustum.
    uint2 pixelCoord = (uint2)((voxelCoord + 0.5 + sampleOffset) * _VBufferVoxelSize);


    #ifdef VL_PRESET_OPTIMAL
    // The entire thread group is within the same light tile.
    uint2 tileCoord = groupOffset * VBUFFER_VOXEL_SIZE / TILE_SIZE_BIG_TILE;
    #else
    // No compile-time optimizations, no scalarization.
    uint2 tileCoord = pixelCoord / TILE_SIZE_BIG_TILE;
    #endif

    uint  tileIndex = tileCoord.x + _NumTileBigTileX * tileCoord.y;
    // This clamp is important as _VBufferVoxelSize can have float value which can cause en overflow (Crash on Vulkan and Metal)
    tileIndex = min(tileIndex, _NumTileBigTileX * _NumTileBigTileY);

    // Do not jitter 'voxelCoord' else. It's expected to correspond to the center of the voxel.
    PositionInputs posInput = GetPositionInput(voxelCoord, _VBufferViewportSize.zw, tileCoord);
    ray.geomDist = FLT_INF;
    ray.maxDist = FLT_INF;

    float deviceDepth = _CameraDepth[pixelCoord];

    if (deviceDepth > 0) // Skip the skybox
    {
        // Convert it to distance along the ray. Doesn't work with tilt shift, etc.
        float linearDepth = LinearEyeDepth(deviceDepth, _ZBufferParams);
        ray.geomDist = linearDepth * rcp(dot(ray.jitterDirWS, F));

        float2 UV = posInput.positionNDC * _RTHandleScale.xy;

        // This should really be using a max sampler here. This is a bit overdilating given that it is already dilated.
        // Better to be safer though.
        float4 d = GATHER_RED_TEXTURE2D_X(_VBufferMaxZ, sampler_PointClamp, UV) * rcp(dot(ray.jitterDirWS, F));
        ray.maxDist = max(Max3(d.x, d.y, d.z), d.w);
    }


    float4 value = 0.0;
    float weightSum = 0.0;
    FillVolumetricLightingBuffer( posInput, tileIndex, groupIndex, ray, tStart);
}

float4 LoadLightingClamped(int3 coord)
{
    int3 maxCoord = int3((int)_VBufferWidth - 1, (int)_VBufferHeight - 1, (int)_VBufferSliceCount - 1);
    return _VBufferLightingInput.Load(int4(clamp(coord, int3(0, 0, 0), maxCoord), 0));
}

void PrefetchVBufferFilterData(uint sampleID, uint2 groupOrigin, uint sliceIndex)
{
    int2 originXY = int2(groupOrigin) - 1;
    int offsetX = (int)(sampleID % VBUFFER_FILTER_SIZE_1D);
    int offsetY = (int)(sampleID / VBUFFER_FILTER_SIZE_1D);
    int3 sampleCoord = int3(originXY.x + offsetX, originXY.y + offsetY, (int)sliceIndex);
    gs_VBufferFilterCache[offsetX + offsetY * VBUFFER_FILTER_SIZE_1D] = LoadLightingClamped(sampleCoord);
}

float Gaussian(float radius, float sigma)
{
    float v = radius / sigma;
    return exp(-(v * v));
}

[numthreads(GROUP_SIZE_1D, GROUP_SIZE_1D, 1)]
void FilterVolumetricLighting(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex,
    uint2 groupId : SV_GroupID,
    uint2 groupThreadId : SV_GroupThreadID)
{
    uint currentSlice = dispatchThreadId.z;
    uint2 groupOrigin = groupId * VBUFFER_FILTER_GROUP_SIZE_XY;
    uint2 currentCoord = groupOrigin + groupThreadId;
    uint3 voxelCoord = uint3(currentCoord, currentSlice);

    for (uint sampleID = groupIndex; sampleID < VBUFFER_FILTER_LDS_SIZE; sampleID += VBUFFER_FILTER_THREAD_COUNT)
        PrefetchVBufferFilterData(sampleID, groupOrigin, currentSlice);

    GroupMemoryBarrierWithGroupSync();

    if (!IsInsideVBuffer(voxelCoord))
        return;

    float4 value = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (int idx = -1; idx <= 1; idx++)
    {
        [unroll]
        for (int idx2 = -1; idx2 <= 1; idx2++)
        {
            int2 tapAddress = (int2(groupThreadId) + 1) + int2(idx2, idx);
            uint ldsTapAddress = (uint)tapAddress.x + (uint)tapAddress.y * VBUFFER_FILTER_SIZE_1D;
            float weight = Gaussian(length(float2(idx, idx2)), VBUFFER_FILTER_GAUSSIAN_SIGMA);

            value += gs_VBufferFilterCache[ldsTapAddress] * weight;
            weightSum += weight;
        }
    }

    _VBufferLightingOutput[voxelCoord] = value / max(weightSum, 1e-4);
}
