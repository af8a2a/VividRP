#pragma use_dxc
#pragma kernel ClearVBufferLighting
#pragma kernel VolumetricLighting
#pragma kernel FilterVolumetricLighting

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/LightingLoop.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Private/Volumetric/VBuffer.hlsl"

Texture2D<float> _CameraDepth;
Texture2D<float> _DirectionalShadowTexture;
Texture3D<float4> _VBufferDensity;
Texture3D<float4> _VBufferLightingInput;
RWTexture3D<float4> _VBufferLighting;
RWTexture3D<float4> _VBufferLightingOutput;

#define VBUFFER_FILTER_GAUSSIAN_SIGMA 1.0
#define VBUFFER_FILTER_GROUP_SIZE_XY 8
#define VBUFFER_FILTER_SIZE_1D (VBUFFER_FILTER_GROUP_SIZE_XY + 2)
#define VBUFFER_FILTER_LDS_SIZE (VBUFFER_FILTER_SIZE_1D * VBUFFER_FILTER_SIZE_1D)
#define VBUFFER_FILTER_THREAD_COUNT (VBUFFER_FILTER_GROUP_SIZE_XY * VBUFFER_FILTER_GROUP_SIZE_XY)

groupshared float4 gs_VBufferFilterCache[VBUFFER_FILTER_LDS_SIZE];

float HenyeyGreensteinPhase(float cosTheta, float anisotropy)
{
    float g = clamp(anisotropy, -0.95, 0.95);
    float g2 = g * g;
    float denominator = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denominator * sqrt(denominator));
}

float SampleDirectionalShadow(uint2 vBufferPixel, uint lightIndex, DirectionalLightData directionalLight)
{
    if ((int)lightIndex != _MainDirectionalLightIndex)
        return 1.0;

    float2 cameraPixel = (float2(vBufferPixel) + 0.5) * _VBufferCameraToVBufferScale;
    float2 cameraDimensions = _VBufferViewportSize.xy * _VBufferCameraToVBufferScale;
    float2 uv = cameraPixel / max(cameraDimensions, float2(1.0, 1.0));
    float shadow = _DirectionalShadowTexture.SampleLevel(sampler_PointClamp, saturate(uv), 0).x;
    float volumetricShadowStrength = saturate(directionalLight.shadowStrength * directionalLight.volumetricShadowDimmer);
    return lerp(1.0, saturate(shadow), volumetricShadowStrength);
}

bool LightAffectsVolumetrics(uint affectVolumetric, float volumetricDimmer)
{
    return affectVolumetric != 0u && volumetricDimmer > 0.0;
}

float GetVolumetricLightCameraDistance(float3 lightPositionWS)
{
    return distance(_WorldSpaceCameraPos, lightPositionWS);
}

float EvaluateVolumetricLightFade(float distanceToCamera, float fadeDistance)
{
    return fadeDistance > 0.0 ? saturate(1.0 - distanceToCamera / fadeDistance) : 0.0;
}

float TransmittanceFromOpticalDepth(float opticalDepth)
{
    return exp(-opticalDepth);
}

float TransmittanceIntegralHomogeneousMedium(float extinction, float intervalLength)
{
    return (1.0 - exp(-extinction * intervalLength)) / max(extinction, 1e-4);
}

bool ShouldEvaluateVBufferLighting(float extinction)
{
    return extinction > _VBufferDensityCutoff;
}

float4 EncodeIntegratedVBufferLighting(float3 totalRadiance, float opticalDepth)
{
    float transmittance = TransmittanceFromOpticalDepth(opticalDepth);
    return float4(VividApplyPreExposure(max(totalRadiance, 0.0)), saturate(transmittance));
}

void StoreIntegratedVBufferLighting(uint3 voxelCoord, float3 totalRadiance, float opticalDepth)
{
    _VBufferLighting[voxelCoord] = EncodeIntegratedVBufferLighting(totalRadiance, opticalDepth);
}

void StoreEmptyVBufferLighting(uint3 voxelCoord)
{
    _VBufferLighting[voxelCoord] = float4(0.0, 0.0, 0.0, 1.0);
}

float GetVBufferOpaqueGeometryDistance(float2 vBufferUV, out bool hasOpaqueGeometry)
{
    float deviceDepth = _CameraDepth.SampleLevel(sampler_PointClamp, vBufferUV, 0);
    hasOpaqueGeometry = !IsVBufferFarDepth(deviceDepth);
    return GetVBufferLinearDistanceFromDeviceDepth(vBufferUV, deviceDepth);
}

float3 EvaluateDirectionalLighting(uint3 voxelCoord, float3 positionWS)
{
    float3 lighting = 0.0;
    float3 viewDirectionWS = SafeNormalize(_WorldSpaceCameraPos - positionWS);
    uint directionalCount = min(_DirectionalLightCount, 8u);

    [loop]
    for (uint lightIndex = 0; lightIndex < directionalCount; lightIndex++)
    {
        DirectionalLightData light = GetDirectionalLight((int)lightIndex);
        if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
            continue;

        float3 lightDirectionWS = SafeNormalize(-light.directionWS);
        float phase = HenyeyGreensteinPhase(dot(lightDirectionWS, viewDirectionWS), _VBufferFogAnisotropy);
        float shadow = SampleDirectionalShadow(voxelCoord.xy, lightIndex, light);
        lighting += max(light.color, 0.0) * light.volumetricDimmer * phase * shadow;
    }

    return lighting;
}

float3 EvaluateClusteredPunctualLighting(uint2 vBufferPixel, float3 positionWS)
{
    if (_VBufferFogDirectionalOnly > 0.5)
        return 0.0;

    float2 cameraPixel = (float2(vBufferPixel) + 0.5) * _VBufferCameraToVBufferScale;
    VividLightingLoopContext lightLoop = VividLightingLoop::Create((uint2)cameraPixel, positionWS);
    uint lightCount = min(VividLightingLoop::GetPunctualLightCount(lightLoop), 16u);
    float3 viewDirectionWS = SafeNormalize(_WorldSpaceCameraPos - positionWS);
    float3 lighting = 0.0;

    [loop]
    for (uint localLightIndex = 0; localLightIndex < lightCount; localLightIndex++)
    {
        PunctualLightData light = VividLightingLoop::LoadPunctualLight(lightLoop, localLightIndex);
        if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
            continue;

        float3 lightVector = light.positionWS - positionWS;
        float distanceSq = max(dot(lightVector, lightVector), 1e-4);
        float distanceToLight = sqrt(distanceSq);
        float3 lightDirectionWS = lightVector / distanceToLight;
        float phase = HenyeyGreensteinPhase(dot(lightDirectionWS, viewDirectionWS), _VBufferFogAnisotropy);
        float rangeAttenuation = saturate(1.0 - distanceToLight / max(light.range, 1e-4));
        rangeAttenuation *= rangeAttenuation;
        float volumetricFade = EvaluateVolumetricLightFade(
            GetVolumetricLightCameraDistance(light.positionWS),
            light.volumetricFadeDistance);
        lighting += max(light.color, 0.0) * light.volumetricDimmer * volumetricFade * phase * rangeAttenuation / max(distanceSq, 1.0);
    }

    return lighting;
}

float3 EvaluateClusteredAreaLighting(uint2 vBufferPixel, float3 positionWS)
{
    if (_VBufferFogDirectionalOnly > 0.5)
        return 0.0;

    float2 cameraPixel = (float2(vBufferPixel) + 0.5) * _VBufferCameraToVBufferScale;
    VividLightingLoopContext lightLoop = VividLightingLoop::Create((uint2)cameraPixel, positionWS);
    uint lightCount = min(VividLightingLoop::GetAreaLightCount(lightLoop), 8u);
    float3 viewDirectionWS = SafeNormalize(_WorldSpaceCameraPos - positionWS);
    float3 lighting = 0.0;

    [loop]
    for (uint localLightIndex = 0; localLightIndex < lightCount; localLightIndex++)
    {
        AreaLightData light = VividLightingLoop::LoadAreaLight(lightLoop, localLightIndex);
        if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
            continue;

        float3 lightVector = light.positionWS - positionWS;
        float distanceSq = max(dot(lightVector, lightVector), 1e-4);
        float distanceToLight = sqrt(distanceSq);
        float3 lightDirectionWS = lightVector / distanceToLight;
        float phase = HenyeyGreensteinPhase(dot(lightDirectionWS, viewDirectionWS), _VBufferFogAnisotropy);
        float rangeAttenuation = saturate(1.0 - distanceToLight / max(light.range, 1e-4));
        rangeAttenuation *= rangeAttenuation;
        float volumetricFade = EvaluateVolumetricLightFade(
            GetVolumetricLightCameraDistance(light.positionWS),
            light.volumetricFadeDistance);
        lighting += max(light.color, 0.0) * light.volumetricDimmer * volumetricFade * phase * rangeAttenuation / max(distanceSq, 1.0);
    }

    return lighting;
}

float3 EvaluateAmbientLighting()
{
    return max(unity_AmbientSky.rgb, 0.0) * _VBufferGlobalProbeDimmer;
}

[numthreads(8, 8, 4)]
void ClearVBufferLighting(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (!IsInsideVBuffer(dispatchThreadId))
        return;

    _VBufferLighting[dispatchThreadId] = float4(0.0, 0.0, 0.0, 1.0);
}

[numthreads(8, 8, 1)]
void VolumetricLighting(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 vBufferPixel = dispatchThreadId.xy;
    if (vBufferPixel.x >= (uint)_VBufferWidth || vBufferPixel.y >= (uint)_VBufferHeight)
        return;

    float2 vBufferUV = (float2(vBufferPixel) + 0.5) * _VBufferRcpViewportSize;
    float3 rayDirectionWS = GetVBufferRayDirectionWSFromUV(vBufferUV);
    bool hasOpaqueGeometry;
    float opaqueGeometryDistance = GetVBufferOpaqueGeometryDistance(vBufferUV, hasOpaqueGeometry);

    float t0 = GetVBufferSliceBoundaryDistance(0.0);
    float de = _VBufferRcpSliceCount;
    uint sliceCount = (uint)_VBufferSliceCount;
    float3 totalRadiance = 0.0;
    float opticalDepth = 0.0;

    [loop]
    for (uint slice = 0; slice < sliceCount; slice++)
    {
        uint3 voxelCoord = uint3(vBufferPixel, slice);
        if (hasOpaqueGeometry && opaqueGeometryDistance <= t0)
        {
            StoreEmptyVBufferLighting(voxelCoord);
            continue;
        }

        float e1 = ((float)slice + 1.0) * de;
        float t1 = GetVBufferSliceBoundaryDistance((float)slice + 1.0);
        float tNext = t1;
        if (hasOpaqueGeometry && opaqueGeometryDistance >= t0 && opaqueGeometryDistance <= t1)
            t1 = max(t0 * 1.0001, opaqueGeometryDistance);

        float dt = max(t1 - t0, 0.0);
        float voxelOpticalDepth = 0.0;
        if (dt > 0.0)
        {
            float centerDistance = DecodeLogarithmicDepthGeneralized(e1 - 0.5 * de, _VBufferDepthDecodingParams);
            float3 positionWS = _WorldSpaceCameraPos + rayDirectionWS * centerDistance;
            float4 density = _VBufferDensity.Load(int4(voxelCoord, 0));
            float3 scattering = max(density.rgb, 0.0);
            float extinction = max(density.a, 0.0);
            voxelOpticalDepth = extinction * dt;

            if (ShouldEvaluateVBufferLighting(extinction))
            {
                float3 lighting = EvaluateAmbientLighting();
                lighting += EvaluateDirectionalLighting(voxelCoord, positionWS);
                lighting += EvaluateClusteredPunctualLighting(vBufferPixel, positionWS);
                lighting += EvaluateClusteredAreaLighting(vBufferPixel, positionWS);

                float transmittanceToSlice = TransmittanceFromOpticalDepth(opticalDepth);
                float integratedTransmittance = TransmittanceIntegralHomogeneousMedium(extinction, dt);
                totalRadiance += transmittanceToSlice * scattering * lighting * integratedTransmittance;
            }
        }

        opticalDepth += 0.5 * voxelOpticalDepth;
        StoreIntegratedVBufferLighting(voxelCoord, totalRadiance, opticalDepth);
        opticalDepth += 0.5 * voxelOpticalDepth;
        t0 = tNext;
    }
}

float4 LoadLightingClamped(int3 coord)
{
    int3 maxCoord = int3((int)_VBufferWidth - 1, (int)_VBufferHeight - 1, (int)_VBufferSliceCount - 1);
    return _VBufferLightingInput.Load(int4(clamp(coord, int3(0, 0, 0), maxCoord), 0));
}

void PrefetchVBufferFilterData(uint sampleID, uint2 groupOrigin, uint sliceIndex)
{
    int2 originXY = int2(groupOrigin) - 1;
    int offsetX = (int)(sampleID % VBUFFER_FILTER_SIZE_1D);
    int offsetY = (int)(sampleID / VBUFFER_FILTER_SIZE_1D);
    int3 sampleCoord = int3(originXY.x + offsetX, originXY.y + offsetY, (int)sliceIndex);
    gs_VBufferFilterCache[offsetX + offsetY * VBUFFER_FILTER_SIZE_1D] = LoadLightingClamped(sampleCoord);
}

float Gaussian(float radius, float sigma)
{
    float v = radius / sigma;
    return exp(-(v * v));
}

[numthreads(8, 8, 1)]
void FilterVolumetricLighting(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex,
    uint2 groupId : SV_GroupID,
    uint2 groupThreadId : SV_GroupThreadID)
{
    uint currentSlice = dispatchThreadId.z;
    uint2 groupOrigin = groupId * VBUFFER_FILTER_GROUP_SIZE_XY;
    uint2 currentCoord = groupOrigin + groupThreadId;
    uint3 voxelCoord = uint3(currentCoord, currentSlice);

    for (uint sampleID = groupIndex; sampleID < VBUFFER_FILTER_LDS_SIZE; sampleID += VBUFFER_FILTER_THREAD_COUNT)
        PrefetchVBufferFilterData(sampleID, groupOrigin, currentSlice);

    GroupMemoryBarrierWithGroupSync();

    if (!IsInsideVBuffer(voxelCoord))
        return;

    float4 value = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (int idx = -1; idx <= 1; idx++)
    {
        [unroll]
        for (int idx2 = -1; idx2 <= 1; idx2++)
        {
            int2 tapAddress = (int2(groupThreadId) + 1) + int2(idx2, idx);
            uint ldsTapAddress = (uint)tapAddress.x + (uint)tapAddress.y * VBUFFER_FILTER_SIZE_1D;
            float weight = Gaussian(length(float2(idx, idx2)), VBUFFER_FILTER_GAUSSIAN_SIGMA);

            value += gs_VBufferFilterCache[ldsTapAddress] * weight;
            weightSum += weight;
        }
    }

    _VBufferLightingOutput[voxelCoord] = value / max(weightSum, 1e-4);
}
