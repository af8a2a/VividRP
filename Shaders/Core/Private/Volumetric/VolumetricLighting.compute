#pragma use_dxc
#pragma kernel ClearVBufferLighting
#pragma kernel VolumetricLighting
#pragma kernel FilterVolumetricLighting

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/LightingLoop.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/PunctualLightCommon.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/Volumetric/VBuffer.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/EntityLighting.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/GeometricTools.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/VolumeRendering.hlsl"

Texture2D<float> _CameraDepth;
Texture2D<float> _DirectionalShadowTexture;
Texture2DArray<float> _CSMShadowAtlas;
Texture2D<float> _VBufferMaxZ;
Texture3D<float4> _VBufferDensity;
Texture3D<float> _VBufferAnisotropy;
Texture3D<float4> _VBufferHistory;
Texture3D<float4> _VBufferLightingInput;
RWTexture3D<float4> _VBufferLighting;
RWTexture3D<float4> _VBufferFeedback;
RWTexture3D<float4> _VBufferLightingOutput;
StructuredBuffer<float4> _VolumetricAmbientProbeBuffer;
SamplerComparisonState sampler_CSMShadowAtlas;
float _VBufferMaxZEnabled;
uint _VolumetricUseBigTileLightList;
uint _VBufferHistoryIsValid;
float4 _VBufferSampleOffset;
float4 _VBufferPrevViewportSize;
float4 _VBufferHistoryViewportScale;
float4 _VBufferHistoryViewportLimit;
float4 _VBufferPrevDepthEncodingParams;
float4 _VBufferPrevDepthDecodingParams;
float4 _VBufferPrevCameraPositionWS;
float4x4 _CSMViewProjMatrices[4];
float4 _CSMCascadeSpheres[4];
int _CSMCascadeCount;
float _CSMMaxShadowDistance;
float _CSMNormalBias;
int _CSMCascadeResolution;
float4 _CSMCascadeWorldTexelSizes;
float4 _CSMCascadeBorders;
int _CSMShadowQuality;

#define GROUP_SIZE_1D           8
#define VBUFFER_MAX_AREA_LIGHTS 8u
#define VBUFFER_FILTER_GAUSSIAN_SIGMA 1.0
#define VBUFFER_FILTER_GROUP_SIZE_XY 8
#define VBUFFER_FILTER_SIZE_1D (VBUFFER_FILTER_GROUP_SIZE_XY + 2)
#define VBUFFER_FILTER_LDS_SIZE (VBUFFER_FILTER_SIZE_1D * VBUFFER_FILTER_SIZE_1D)
#define VBUFFER_FILTER_THREAD_COUNT (VBUFFER_FILTER_GROUP_SIZE_XY * VBUFFER_FILTER_GROUP_SIZE_XY)

static const int kCSMShadowQualityLow = 0;
static const int kCSMShadowQualityMedium = 1;
static const int kCSMShadowQualityHigh = 2;
static const int kCSMShadowQualityVeryHigh = 3;
static const int kCSMShadowQualityUnreal = 4;
static const float kFixedUniformDepthBias = 1.0 / 65536.0;

groupshared float4 gs_VBufferFilterCache[VBUFFER_FILTER_LDS_SIZE];

struct VoxelLighting
{
    float3 radianceComplete;  // includes CornetteShanksPhasePartVarying
    float3 radianceNoPhase;   // without phase (for future reprojection)
};

struct JitteredRay
{
    float3 originWS;
    float3 centerDirWS;
    float3 jitterDirWS;
    float3 xDirDerivWS;
    float3 yDirDerivWS;
    float geomDist;
    float maxDist;
};

uint HashVBufferUint(uint value)
{
    value ^= value >> 16;
    value *= 2246822519u;
    value ^= value >> 13;
    value *= 3266489917u;
    value ^= value >> 16;
    return value;
}

float GenerateVBufferRandom(uint3 voxelCoord, uint lightIndex, uint sampleIndex)
{
    uint seed = voxelCoord.x * 73856093u
        ^ voxelCoord.y * 19349663u
        ^ voxelCoord.z * 83492791u
        ^ lightIndex * 2654435761u
        ^ sampleIndex * 1597334677u;
    return (float)(HashVBufferUint(seed) & 0x00ffffffu) * (1.0 / 16777216.0);
}

float GenerateVBufferRandom(uint2 pixelCoord)
{
    uint seed = pixelCoord.x * 73856093u
        ^ pixelCoord.y * 19349663u
        ^ 0x9e3779b9u;
    return (float)(HashVBufferUint(seed) & 0x00ffffffu) * (1.0 / 16777216.0);
}

float2 GetVBufferSampleUV(uint2 vBufferPixel, float2 sampleOffset)
{
    return (float2(vBufferPixel) + 0.5 + sampleOffset) * _VBufferRcpViewportSize;
}

uint2 GetVBufferCameraPixel(uint2 vBufferPixel, float2 sampleOffset)
{
    return (uint2)((float2(vBufferPixel) + 0.5 + sampleOffset) * _VBufferCameraToVBufferScale);
}

int SelectCSMCascade(float3 positionWS, out float distFromSphere)
{
    distFromSphere = 1.0;

    for (int i = 0; i < _CSMCascadeCount; i++)
    {
        float4 sphere = _CSMCascadeSpheres[i];
        float3 delta = positionWS - sphere.xyz;
        float distSq = dot(delta, delta);
        if (distSq < sphere.w) // sphere.w = radiusSq
        {
            distFromSphere = distSq / sphere.w;
            return i;
        }
    }

    return -1;
}

float3 TransformWorldToShadowCoord(float3 positionWS, int cascadeIndex)
{
    return mul(_CSMViewProjMatrices[cascadeIndex], float4(positionWS, 1.0)).xyz;
}

float GetCascadeWorldTexelSize(int cascadeIndex)
{
    return max(_CSMCascadeWorldTexelSizes[cascadeIndex], 0.0);
}

float ApplyShadowComparisonDepthBias(float shadowDepth)
{
    return shadowDepth + kFixedUniformDepthBias;
}

void GetCascadeShadowMapBounds(out float2 cascadeMinUV, out float2 cascadeMaxUV, out float2 texelSize)
{
    texelSize = 1.0 / max((float)_CSMCascadeResolution, 1.0);
    cascadeMinUV = texelSize * 0.5;
    cascadeMaxUV = 1.0 - cascadeMinUV;
}

float2 ClampShadowMapUV(float2 shadowUV)
{
    float2 cascadeMinUV;
    float2 cascadeMaxUV;
    float2 texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);
    return clamp(shadowUV, cascadeMinUV, cascadeMaxUV);
}

float SampleCSMShadowMap(float2 shadowUV, float depth, int cascadeIndex)
{
    return _CSMShadowAtlas.SampleCmpLevelZero(
        sampler_CSMShadowAtlas,
        float3(shadowUV, cascadeIndex),
        depth);
}

float SampleShadowPCF3x3(float2 shadowUV, float depth, int cascadeIndex)
{
    float2 cascadeMinUV, cascadeMaxUV, texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);

    float2 texCoord = shadowUV / texelSize + 0.5;
    float2 texCoordFloor = floor(texCoord);
    float2 s = texCoord - texCoordFloor;
    float2 base = (texCoordFloor - 0.5) * texelSize;

    float uw0 = 3.0 - 2.0 * s.x;
    float uw1 = 1.0 + 2.0 * s.x;
    float vw0 = 3.0 - 2.0 * s.y;
    float vw1 = 1.0 + 2.0 * s.y;

    float u0 = (2.0 - s.x) / uw0 - 1.0;
    float u1 = s.x / uw1 + 1.0;
    float v0 = (2.0 - s.y) / vw0 - 1.0;
    float v1 = s.y / vw1 + 1.0;

    float shadow = 0.0;
    shadow += uw0 * vw0 * SampleCSMShadowMap(clamp(base + float2(u0, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw0 * SampleCSMShadowMap(clamp(base + float2(u1, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw0 * vw1 * SampleCSMShadowMap(clamp(base + float2(u0, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw1 * SampleCSMShadowMap(clamp(base + float2(u1, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);

    return shadow / 16.0;
}

float SampleShadowPCF5x5(float2 shadowUV, float depth, int cascadeIndex)
{
    float2 cascadeMinUV, cascadeMaxUV, texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);

    float2 texCoord = shadowUV / texelSize + 0.5;
    float2 texCoordFloor = floor(texCoord);
    float2 s = texCoord - texCoordFloor;
    float2 base = (texCoordFloor - 0.5) * texelSize;

    float uw0 = 4.0 - 3.0 * s.x;
    float uw1 = 7.0;
    float uw2 = 1.0 + 3.0 * s.x;
    float vw0 = 4.0 - 3.0 * s.y;
    float vw1 = 7.0;
    float vw2 = 1.0 + 3.0 * s.y;

    float u0 = (3.0 - 2.0 * s.x) / uw0 - 2.0;
    float u1 = (3.0 + s.x) / uw1;
    float u2 = s.x / uw2 + 2.0;
    float v0 = (3.0 - 2.0 * s.y) / vw0 - 2.0;
    float v1 = (3.0 + s.y) / vw1;
    float v2 = s.y / vw2 + 2.0;

    float shadow = 0.0;
    shadow += uw0 * vw0 * SampleCSMShadowMap(clamp(base + float2(u0, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw0 * SampleCSMShadowMap(clamp(base + float2(u1, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw2 * vw0 * SampleCSMShadowMap(clamp(base + float2(u2, v0) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw0 * vw1 * SampleCSMShadowMap(clamp(base + float2(u0, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw1 * SampleCSMShadowMap(clamp(base + float2(u1, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw2 * vw1 * SampleCSMShadowMap(clamp(base + float2(u2, v1) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw0 * vw2 * SampleCSMShadowMap(clamp(base + float2(u0, v2) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw1 * vw2 * SampleCSMShadowMap(clamp(base + float2(u1, v2) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);
    shadow += uw2 * vw2 * SampleCSMShadowMap(clamp(base + float2(u2, v2) * texelSize, cascadeMinUV, cascadeMaxUV), depth, cascadeIndex);

    return shadow / 144.0;
}

float SampleShadowPCF7x7(float2 shadowUV, float depth, int cascadeIndex)
{
    float2 cascadeMinUV, cascadeMaxUV, texelSize;
    GetCascadeShadowMapBounds(cascadeMinUV, cascadeMaxUV, texelSize);

    float shadow = 0.0;

    [unroll]
    for (int j = 0; j < 4; j++)
    {
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            float2 offset = float2(i * 2.0 - 3.0, j * 2.0 - 3.0) * texelSize;
            float2 sampleUV = clamp(shadowUV + offset, cascadeMinUV, cascadeMaxUV);
            shadow += SampleCSMShadowMap(sampleUV, depth, cascadeIndex);
        }
    }

    return shadow / 16.0;
}

float EvaluateCSMShadow(float2 shadowUV, float receiverDepth, int cascadeIndex)
{
    switch (_CSMShadowQuality)
    {
        case kCSMShadowQualityLow:
            return SampleShadowPCF3x3(shadowUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityMedium:
            return SampleShadowPCF5x5(shadowUV, receiverDepth, cascadeIndex);
        case kCSMShadowQualityHigh:
        case kCSMShadowQualityVeryHigh:
        case kCSMShadowQualityUnreal:
            return SampleShadowPCF7x7(shadowUV, receiverDepth, cascadeIndex);
        default:
            return SampleShadowPCF5x5(shadowUV, receiverDepth, cascadeIndex);
    }
}

float3 ClampShadowCoordToShadowMap(float3 shadowCoord)
{
    shadowCoord.xy = saturate(shadowCoord.xy);
    return shadowCoord;
}

bool IsWithinCascadeBlendSamplingBounds(float3 shadowCoord)
{
    float halfTexel = 0.5 / max((float)_CSMCascadeResolution, 1.0);
    return all(shadowCoord.xy >= halfTexel) && all(shadowCoord.xy <= (1.0 - halfTexel));
}

bool TryGetBiasedShadowCoord(float3 positionWS, float3 normalWS, int cascadeIndex, out float3 shadowCoord)
{
    shadowCoord = 0.0;

    if (cascadeIndex < 0 || cascadeIndex >= _CSMCascadeCount)
        return false;

    float receiverNormalBias = _CSMNormalBias * GetCascadeWorldTexelSize(cascadeIndex);
    float3 biasedPositionWS = positionWS + normalWS * receiverNormalBias;
    shadowCoord = TransformWorldToShadowCoord(biasedPositionWS, cascadeIndex);
    return true;
}

bool TryEvaluateCascadeShadow(float3 positionWS, float3 normalWS, int cascadeIndex, out float shadow)
{
    shadow = 1.0;

    float3 shadowCoord;
    if (!TryGetBiasedShadowCoord(positionWS, normalWS, cascadeIndex, shadowCoord))
        return false;

    shadowCoord = ClampShadowCoordToShadowMap(shadowCoord);
    shadowCoord.z = ApplyShadowComparisonDepthBias(shadowCoord.z);
    float2 shadowUV = ClampShadowMapUV(shadowCoord.xy);
    shadow = EvaluateCSMShadow(shadowUV, shadowCoord.z, cascadeIndex);
    return true;
}

bool TryEvaluateCascadeBlendShadow(float3 positionWS, float3 normalWS, int cascadeIndex, out float shadow)
{
    shadow = 1.0;

    float3 shadowCoord;
    if (!TryGetBiasedShadowCoord(positionWS, normalWS, cascadeIndex, shadowCoord))
        return false;

    if (!IsWithinCascadeBlendSamplingBounds(shadowCoord))
        return false;

    shadowCoord = ClampShadowCoordToShadowMap(shadowCoord);
    shadowCoord.z = ApplyShadowComparisonDepthBias(shadowCoord.z);
    float2 shadowUV = ClampShadowMapUV(shadowCoord.xy);
    shadow = EvaluateCSMShadow(shadowUV, shadowCoord.z, cascadeIndex);
    return true;
}

float GetCascadeBorder(int cascadeIndex)
{
    return cascadeIndex >= 0 && cascadeIndex < _CSMCascadeCount ? max(_CSMCascadeBorders[cascadeIndex], 0.0) : 0.0;
}

float ComputeCascadeBlendAlpha(int cascadeIndex, float relDistance)
{
    float border = GetCascadeBorder(cascadeIndex);
    if (border <= 0.0)
        return 0.0;

    return saturate((relDistance - (1.0 - border)) / border);
}

float EvaluateDirectionalCSMShadow(uint2 vBufferPixel, float3 samplePositionWS, float3 rayDirectionWS)
{
    if (_CSMCascadeCount <= 0 || _CSMMaxShadowDistance <= 0.0)
        return 1.0;

    float relDistance;
    int cascadeIndex = SelectCSMCascade(samplePositionWS, relDistance);
    if (cascadeIndex < 0)
        return 1.0;

    // Our shadows only support normal bias. Volumetrics has no access to the
    // surface normal, so approximate the bias direction with the view direction.
    float3 shadowBiasDirectionWS = -SafeNormalize(rayDirectionWS);
    float shadowCurrent;
    if (!TryEvaluateCascadeShadow(samplePositionWS, shadowBiasDirectionWS, cascadeIndex, shadowCurrent))
        return 1.0;

    float shadow = shadowCurrent;
    float cascadeBlendAlpha = ComputeCascadeBlendAlpha(cascadeIndex, relDistance);
    if (cascadeBlendAlpha > 0.0)
    {
        float shadowNext = shadowCurrent;
        int nextCascadeIndex = cascadeIndex + 1;
        if (nextCascadeIndex < _CSMCascadeCount)
        {
            float nextCascadeShadow;
            if (TryEvaluateCascadeBlendShadow(samplePositionWS, shadowBiasDirectionWS, nextCascadeIndex, nextCascadeShadow))
                shadowNext = nextCascadeShadow;
        }

        shadow = lerp(shadowCurrent, shadowNext, cascadeBlendAlpha);
    }

    float pixelDistance = length(samplePositionWS - _WorldSpaceCameraPos);
    float fadeStart = _CSMMaxShadowDistance * 0.8;
    if (pixelDistance > fadeStart)
    {
        float distanceFade = 1.0 - saturate((pixelDistance - fadeStart) / max(_CSMMaxShadowDistance - fadeStart, 1e-4));
        shadow = lerp(1.0, shadow, distanceFade);
    }

    return saturate(shadow);
}

float SampleDirectionalShadow(uint2 vBufferPixel, uint lightIndex, DirectionalLightData directionalLight, float3 samplePositionWS, float3 rayDirectionWS)
{
    if ((int)lightIndex != _MainDirectionalLightIndex)
        return 1.0;

    float shadowDimmer = saturate(directionalLight.shadowStrength * directionalLight.volumetricShadowDimmer);
    if (shadowDimmer <= 0.0)
        return 1.0;

    float shadow = EvaluateDirectionalCSMShadow(vBufferPixel, samplePositionWS, rayDirectionWS);
    return lerp(1.0, shadow, shadowDimmer);
}

bool LightAffectsVolumetrics(uint affectVolumetric, float volumetricDimmer)
{
    return affectVolumetric != 0u && volumetricDimmer > 0.0;
}

bool IsInRange(float value, float2 range)
{
    return clamp(value, range.x, range.y) == value;
}

float ComputeHistoryWeight()
{
    // Compute the exponential moving average over 'n' frames:
    // X = (1 - a) * ValueAtFrame[n] + a * AverageOverPreviousFrames.
    // We want each sample to be uniformly weighted by (1 / n):
    // X = (1 / n) * Sum{i from 1 to n}{ValueAtFrame[i]}.
    // Therefore, we get:
    // (1 - a) = (1 / n) => a = (1 - 1 / n) = (n - 1) / n,
    // X = (1 / n) * ValueAtFrame[n] + (1 - 1 / n) * AverageOverPreviousFrames.
    // Why does it work? We need to make the following assumption:
    // AverageOverPreviousFrames ≈ AverageOverFrames[n - 1].
    // AverageOverFrames[n - 1] = (1 / (n - 1)) * Sum{i from 1 to n - 1}{ValueAtFrame[i]}.
    // This implies that the reprojected (accumulated) value has mostly converged.
    // X = (1 / n) * ValueAtFrame[n] + ((n - 1) / n) * (1 / (n - 1)) * Sum{i from 1 to n - 1}{ValueAtFrame[i]}.
    // X = (1 / n) * ValueAtFrame[n] + (1 / n) * Sum{i from 1 to n - 1}{ValueAtFrame[i]}.
    // X = Sum{i from 1 to n}{ValueAtFrame[i] / n}.
    float numFrames = 7;
    float frameWeight = 1.0 / numFrames;
    float historyWeight = 1.0 - frameWeight;

    return historyWeight;
}

float4 SampleVBufferHistory(float3 positionWS)
{
    float4 positionCS = mul(_PrevViewProjMatrix, float4(positionWS, 1.0));
    if (positionCS.w <= 1e-5)
        return 0.0;

#if UNITY_UV_STARTS_AT_TOP
    positionCS.y = -positionCS.y;
#endif

    float2 positionNDC = positionCS.xy * rcp(positionCS.w) * 0.5 + 0.5;
    float linearDistance = distance(positionWS, _VBufferPrevCameraPositionWS.xyz);
    float w = EncodeLogarithmicDepthGeneralized(linearDistance, _VBufferPrevDepthEncodingParams);
    float3 frustumCoord = float3(positionNDC, w) * 2.0 - 1.0;

    if (max(max(abs(frustumCoord.x), abs(frustumCoord.y)), abs(frustumCoord.z)) >= 1.0)
        return 0.0;

    float3 texUVW = float3(positionNDC, w) * _VBufferHistoryViewportScale.xyz;
    return _VBufferHistory.SampleLevel(sampler_LinearClamp, min(texUVW, _VBufferHistoryViewportLimit.xyz), 0);
}

float GetVolumetricLightCameraDistance(float3 lightPositionWS)
{
    return distance(_WorldSpaceCameraPos, lightPositionWS);
}

float EvaluateVolumetricLightFade(float distanceToCamera, float fadeDistance)
{
    return fadeDistance > 0.0 ? saturate(1.0 - distanceToCamera / fadeDistance) : 0.0;
}

bool ShouldEvaluateVBufferLighting(float extinction)
{
    return extinction > _VBufferDensityCutoff;
}

float4 EncodeIntegratedVBufferLighting(float3 totalRadiance, float opticalDepth)
{
    float transmittance = TransmittanceFromOpticalDepth(opticalDepth);
    return float4(VividApplyPreExposure(max(totalRadiance, 0.0)), saturate(transmittance));
}

void StoreIntegratedVBufferLighting(uint3 voxelCoord, float3 totalRadiance, float opticalDepth)
{
    _VBufferLighting[voxelCoord] = EncodeIntegratedVBufferLighting(totalRadiance, opticalDepth);
}

void StoreEmptyVBufferLighting(uint3 voxelCoord)
{
    _VBufferLighting[voxelCoord] = float4(0.0, 0.0, 0.0, 1.0);
}

void StoreVBufferFeedback(uint3 voxelCoord, float4 value)
{
    _VBufferFeedback[voxelCoord] = clamp(value, 0.0, HALF_MAX);
}

void StoreEmptyVBufferFeedback(uint3 voxelCoord)
{
    _VBufferFeedback[voxelCoord] = 0.0;
}

JitteredRay BuildVBufferJitteredRay(uint2 vBufferPixel, float2 sampleOffset)
{
    // Reminder: our voxels are sphere-capped right frustums (truncated right pyramids).
    // The curvature of the front and back faces is quite gentle, so we can use
    // the right frustum approximation (thus the front and the back faces are squares).
    // Note, that since we still rely on the perspective camera model, pixels at the center
    // of the screen correspond to larger solid angles than those at the edges.
    // Basically, sizes of front and back faces depend on the XY coordinate.
    // https://www.desmos.com/calculator/i3rkesvidk
    float3 F = GetViewForwardDir();
    float3 U = GetViewUpDir();
    float2 centerCoord = float2(vBufferPixel) + 0.5;

    // Compute a ray direction s.t. ViewSpace(rayDirWS).z = 1.
    float3 rayDirWS = mul(-float4(centerCoord, 1.0, 1.0), _VBufferCoordToViewDirWS).xyz;
    float3 rightDirWS = cross(rayDirWS, U);
    float rcpLenRayDir = rsqrt(max(dot(rayDirWS, rayDirWS), 1e-8));
    float rcpLenRightDir = rsqrt(max(dot(rightDirWS, rightDirWS), 1e-8));

    JitteredRay ray;
    ray.originWS = _WorldSpaceCameraPos;
    ray.centerDirWS = rayDirWS * rcpLenRayDir; // Normalize

    float FdotD = max(dot(F, ray.centerDirWS), 1e-4);
    float unitDistFaceSize = _VBufferUnitDepthTexelSpacing * FdotD * rcpLenRayDir;
    ray.xDirDerivWS = rightDirWS * (rcpLenRightDir * unitDistFaceSize); // Normalize & rescale
    ray.yDirDerivWS = cross(ray.xDirDerivWS, ray.centerDirWS); // Will have the length of 'unitDistFaceSize' by construction
    ray.jitterDirWS = SafeNormalize(ray.centerDirWS + sampleOffset.x * ray.xDirDerivWS + sampleOffset.y * ray.yDirDerivWS);
    ray.geomDist = FLT_MAX;
    ray.maxDist = FLT_MAX;
    return ray;
}

float GetVBufferJitteredRayStartDistance(JitteredRay ray)
{
    float forwardDistance = _VBufferIsOrthographic > 0.5 ? 1.0 : max(dot(ray.jitterDirWS, GetViewForwardDir()), 1e-4);
    return max(GetVBufferSliceBoundaryDistance(0.0), g_fNearPlane / forwardDistance);
}

float GetVBufferLinearDistanceFromEyeDepthForRay(float linearEyeDepth, JitteredRay ray)
{
    if (_VBufferIsOrthographic > 0.5)
        return linearEyeDepth;

    float forwardDistance = max(dot(ray.jitterDirWS, GetViewForwardDir()), 1e-4);
    return linearEyeDepth / forwardDistance;
}

float GetVBufferOpaqueGeometryDistanceForRay(float2 vBufferUV, JitteredRay ray, out bool hasOpaqueGeometry)
{
    float deviceDepth = _CameraDepth.SampleLevel(sampler_PointClamp, vBufferUV, 0);
    hasOpaqueGeometry = !IsVBufferFarDepth(deviceDepth);

    return hasOpaqueGeometry
        ? GetVBufferLinearDistanceFromEyeDepthForRay(LinearEyeDepth(deviceDepth, _ZBufferParams), ray)
        : _VBufferLastSliceDistance;
}

float LoadVBufferMaxZ(int2 maxZPixel, int2 maxZDimensions)
{
    int2 maxCoord = max(maxZDimensions - 1, int2(0, 0));
    int2 coord = clamp(maxZPixel, int2(0, 0), maxCoord);
    return _VBufferMaxZ.Load(int3(coord, 0));
}

float GetVBufferMaxOpaqueGeometryDistance(float2 vBufferUV, float3 rayDirectionWS, float fallbackDistance)
{
    if (_VBufferMaxZEnabled <= 0.5)
        return fallbackDistance;

    uint maxZWidth;
    uint maxZHeight;
    _VBufferMaxZ.GetDimensions(maxZWidth, maxZHeight);
    if (maxZWidth == 0u || maxZHeight == 0u)
        return fallbackDistance;

    float2 maxZDimensions = float2((float)maxZWidth, (float)maxZHeight);
    float2 maxZTexelCoord = vBufferUV * maxZDimensions - 0.5;
    int2 baseCoord = (int2)floor(maxZTexelCoord);
    int2 dimensions = int2((int)maxZWidth, (int)maxZHeight);
    float maxLinearEyeDepth = -1.0;

    [unroll]
    for (int y = 0; y <= 1; y++)
    {
        [unroll]
        for (int x = 0; x <= 1; x++)
        {
            maxLinearEyeDepth = max(maxLinearEyeDepth, LoadVBufferMaxZ(baseCoord + int2(x, y), dimensions));
        }
    }

    if (maxLinearEyeDepth < 0.0)
        return fallbackDistance;

    float forwardDistance = _VBufferIsOrthographic > 0.5 ? 1.0 : max(dot(rayDirectionWS, GetViewForwardDir()), 1e-4);
    float maxDistance = max(maxLinearEyeDepth / forwardDistance, fallbackDistance);
    return clamp(maxDistance, GetVBufferSliceBoundaryDistance(0.0), _VBufferLastSliceDistance);
}

float3 EvaluatePunctualLightRadiance(PunctualLightData light, float3 positionWS)
{
    float3 lightDirectionWS = 0.0;
    float4 distances = 0.0;
    GetVividPunctualLightVectors(positionWS, light, lightDirectionWS, distances);

    if (distances.y <= 1e-6)
        return 0.0;

    float attenuation = VividPunctualLightAttenuationWithDistanceModification(
        light,
        positionWS - light.positionWS,
        distances);

    if (attenuation <= 0.0)
        return 0.0;

    float volumetricFade = EvaluateVolumetricLightFade(
        GetVolumetricLightCameraDistance(light.positionWS),
        light.volumetricFadeDistance);
    return max(light.color, 0.0) * light.volumetricDimmer * volumetricFade * attenuation;
}

void CreatePerpendicularBasis(float3 forward, out float3 axisX, out float3 axisY)
{
    float3 up = abs(forward.y) < 0.999 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    axisX = SafeNormalize(cross(up, forward));
    axisY = cross(forward, axisX);
}

bool TryGetSpotConeAxes(PunctualLightData light, out float3 coneDirection, out float3 coneAxisX, out float3 coneAxisY)
{
    coneDirection = SafeNormalize(light.directionWS);
    coneAxisX = 0.0;
    coneAxisY = 0.0;

    if (light.lightType != VIVID_PUNCTUAL_LIGHT_TYPE_SPOT)
        return false;

    coneAxisX = light.rightWS;
    coneAxisY = light.upWS;

    if (dot(coneAxisX, coneAxisX) <= 1e-8 || dot(coneAxisY, coneAxisY) <= 1e-8)
    {
        float cosOuter = saturate(-light.angleOffset / max(light.angleScale, 1e-6));
        cosOuter = clamp(cosOuter, 1e-3, 0.999999);
        float sinOuter = sqrt(max(1.0 - cosOuter * cosOuter, 1e-6));
        float cotanOuter = cosOuter / sinOuter;
        float3 axisX;
        float3 axisY;
        CreatePerpendicularBasis(coneDirection, axisX, axisY);
        coneAxisX = axisX * cotanOuter;
        coneAxisY = axisY * cotanOuter;
    }

    return true;
}

bool IntersectRaySpotConeRange(float3 rayOriginWS, float3 rayDirectionWS, PunctualLightData light, float tMin, float tMax, out float tEntr, out float tExit)
{
    float3 coneDirection;
    float3 coneAxisX;
    float3 coneAxisY;
    if (!TryGetSpotConeAxes(light, coneDirection, coneAxisX, coneAxisY))
    {
        tEntr = tMin;
        tExit = tMax;
        return true;
    }

    return IntersectRayCone(
        rayOriginWS,
        rayDirectionWS,
        light.positionWS,
        coneDirection,
        coneAxisX,
        coneAxisY,
        tMin,
        tMax,
        tEntr,
        tExit);
}

bool IntersectRaySlab(float origin, float direction, float slabMin, float slabMax, inout float tEntr, inout float tExit)
{
    if (abs(direction) <= 1e-6)
        return origin >= slabMin && origin <= slabMax;

    float invDirection = rcp(direction);
    float slabT0 = (slabMin - origin) * invDirection;
    float slabT1 = (slabMax - origin) * invDirection;
    float slabEntry = min(slabT0, slabT1);
    float slabExit = max(slabT0, slabT1);

    tEntr = max(tEntr, slabEntry);
    tExit = min(tExit, slabExit);
    return tEntr <= tExit;
}

bool IntersectRayProjectorBoxRange(float3 rayOriginWS, float3 rayDirectionWS, PunctualLightData light, float tMin, float tMax, out float tEntr, out float tExit)
{
    float3x3 lightToWorld = float3x3(light.rightWS, light.upWS, light.directionWS);
    float3 originLS = mul(rayOriginWS - light.positionWS, transpose(lightToWorld));
    float3 directionLS = mul(rayDirectionWS, transpose(lightToWorld));

    tEntr = tMin;
    tExit = tMax;

    if (!IntersectRaySlab(originLS.x, directionLS.x, -1.0, 1.0, tEntr, tExit))
        return false;

    if (!IntersectRaySlab(originLS.y, directionLS.y, -1.0, 1.0, tEntr, tExit))
        return false;

    return IntersectRaySlab(originLS.z, directionLS.z, 0.0, light.range, tEntr, tExit);
}

// Computes the light integral (in-scattered radiance) within the voxel.
// Multiplication by the scattering coefficient and the phase function is performed outside.
VoxelLighting EvaluateVoxelLightingDirectional(uint3 voxelCoord, JitteredRay ray, float t0, float t1, float dt, float rndVal, float extinction, float anisotropy)
{
    VoxelLighting lighting = (VoxelLighting)0;
    uint directionalCount = min(_DirectionalLightCount, 8u);

    float tOffset, weight;
    ImportanceSampleHomogeneousMedium(rndVal, extinction, dt, tOffset, weight);
    float t = t0 + tOffset;
    float3 sampleWS = ray.originWS + t * ray.jitterDirWS;

    [loop]
    for (uint i = 0; i < directionalCount; i++)
    {
        DirectionalLightData light = GetDirectionalLight((int)i);
        if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
            continue;

        float3 L = SafeNormalize(light.directionWS);
        float3 lightColor = max(light.color, 0.0) * light.volumetricDimmer;
        float shadow = SampleDirectionalShadow(voxelCoord.xy, i, light, sampleWS, ray.jitterDirWS);
        lightColor *= shadow;

        // Important:
        // Ideally, all scattering calculations should use the jittered versions
        // of the sample position and the ray direction. However, correct reprojection
        // of asymmetrically scattered lighting (affected by an anisotropic phase
        // function) is not possible. We work around this issue by reprojecting
        // lighting not affected by the phase function. This basically removes
        // the phase function from the temporal integration process. It is a hack.
        // The downside is that anisotropy no longer benefits from temporal averaging,
        // and any temporal instability of anisotropy causes causes visible jitter.
        // In order to stabilize the image, we use the voxel center for all
        // anisotropy-related calculations.
        float cosTheta = dot(L, ray.centerDirWS);
        float g = clamp(anisotropy, -0.95, 0.95);
        float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);

        // Compute the amount of in-scattered radiance.
        // Note: the 'weight' accounts for transmittance from 't0' to 't'.
        lighting.radianceNoPhase += weight * lightColor;
        lighting.radianceComplete += weight * lightColor * phaseVarying;
    }

    return lighting;
}

// Computes the light integral (in-scattered radiance) within the voxel.
// Multiplication by the scattering coefficient and the phase function is performed outside.
VoxelLighting EvaluateVoxelLightingLocal(uint3 voxelCoord, uint2 vBufferPixel, float3 centerWS, JitteredRay ray, float t0, float t1, float dt, float rndVal, float extinction, float anisotropy)
{
    VoxelLighting lighting = (VoxelLighting)0;

    if (_VBufferFogDirectionalOnly > 0.5)
        return lighting;

    float g = clamp(anisotropy, -0.95, 0.95);

    // Punctual lights via big tile light list
    bool hasVolumetricBigTileLightList = true;
    if (_VolumetricUseBigTileLightList == 0u || _NumTileBigTileX == 0u || _NumTileBigTileY == 0u)
        hasVolumetricBigTileLightList = false;

    if (hasVolumetricBigTileLightList)
    {
        uint lightOffset = 0;
        uint2 cameraPixel = GetVBufferCameraPixel(vBufferPixel, float2(0.0, 0.0));
        VividBigTileLightingLoopContext bigTileLoop = VividLightingLoop::CreateBigTile(cameraPixel);
        uint lightCount = VividLightingLoop::GetBigTileLightCount(bigTileLoop);

        [loop]
        for (; lightOffset < lightCount; lightOffset++)
        {
            PunctualLightData light = VividLightingLoop::LoadBigTilePunctualLight(bigTileLoop, lightOffset);
            if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
                continue;

            bool sampleLight = true;

            float tEntr = t0;
            float tExit = t1;

            if (light.lightType == VIVID_PUNCTUAL_LIGHT_TYPE_PROJECTOR_BOX)
            {
                sampleLight = IntersectRayProjectorBoxRange(ray.originWS, ray.jitterDirWS, light, t0, t1, tEntr, tExit);

                if (!sampleLight || tEntr >= tExit)
                    continue;

                float tOffset;
                float weight;
                ImportanceSampleHomogeneousMedium(rndVal, extinction, tExit - tEntr, tOffset, weight);
                weight *= TransmittanceHomogeneousMedium(extinction, tEntr - t0);

                float t = tEntr + tOffset;
                float3 samplePosWS = ray.originWS + ray.jitterDirWS * t;
                float3 lightRadiance = EvaluatePunctualLightRadiance(light, samplePosWS);
                if (max(max(lightRadiance.x, lightRadiance.y), lightRadiance.z) <= 0.0)
                    continue;

                float3 centerToLight = light.positionWS - centerWS;
                float cosTheta = dot(centerToLight, ray.centerDirWS) * rsqrt(max(dot(centerToLight, centerToLight), 1e-6));
                float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);

                lighting.radianceNoPhase += weight * lightRadiance;
                lighting.radianceComplete += weight * lightRadiance * phaseVarying;
                continue;
            }

            // Perform ray-cone intersection for spot lights.
            if (light.lightType == VIVID_PUNCTUAL_LIGHT_TYPE_SPOT)
            {
                float coneEntry;
                float coneExit;
                sampleLight = IntersectRaySpotConeRange(ray.originWS, ray.jitterDirWS, light, t0, t1, coneEntry, coneExit);
                tEntr = coneEntry;
                tExit = coneExit;
            }

            if (!sampleLight || tEntr >= tExit)
                continue;

            // Is it worth evaluating the light?
            float lightSqRadius = max(light.shapeRadiusSquared, 1e-4);

            float t;
            float sqDist;
            float rcpPdf;
            ImportanceSamplePunctualLight(
                rndVal,
                light.positionWS,
                lightSqRadius,
                ray.originWS,
                ray.jitterDirWS,
                tEntr,
                tExit,
                t,
                sqDist,
                rcpPdf);

            float3 samplePosWS = ray.originWS + ray.jitterDirWS * t;
            float3 lightRadiance = EvaluatePunctualLightRadiance(light, samplePosWS);
            if (max(max(lightRadiance.x, lightRadiance.y), lightRadiance.z) <= 0.0)
                continue;

            // Important:
            // Ideally, all scattering calculations should use the jittered versions
            // of the sample position and the ray direction. However, correct reprojection
            // of asymmetrically scattered lighting (affected by an anisotropic phase
            // function) is not possible. We work around this issue by reprojecting
            // lighting not affected by the phase function. This basically removes
            // the phase function from the temporal integration process. It is a hack.
            // The downside is that anisotropy no longer benefits from temporal averaging,
            // and any temporal instability of anisotropy causes causes visible jitter.
            // In order to stabilize the image, we use the voxel center for all
            // anisotropy-related calculations.
            float3 centerToLight = light.positionWS - centerWS;
            float cosTheta = dot(centerToLight, ray.centerDirWS) * rsqrt(dot(centerToLight, centerToLight));
            float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);

            // Compute transmittance from 't0' to 't'.
            float weight = TransmittanceHomogeneousMedium(extinction, t - t0) * rcpPdf;

            // Compute the amount of in-scattered radiance.
            lighting.radianceNoPhase += weight * lightRadiance;
            lighting.radianceComplete += weight * lightRadiance * phaseVarying;
        }
    }

    // Area lights from cluster
    {
        float2 cameraPixel = (float2(vBufferPixel) + 0.5) * _VBufferCameraToVBufferScale;
        VividLightingLoopContext lightLoop = VividLightingLoop::Create((uint2)cameraPixel, centerWS);
        uint lightCount = min(min(VividLightingLoop::GetAreaLightCount(lightLoop), _AreaLightCount), VBUFFER_MAX_AREA_LIGHTS);

        [loop]
        for (uint localLightIndex = 0; localLightIndex < lightCount; localLightIndex++)
        {
            AreaLightData light = VividLightingLoop::LoadAreaLight(lightLoop, localLightIndex);
            if (!LightAffectsVolumetrics(light.affectVolumetric, light.volumetricDimmer))
                continue;

            float tOffset, weight;
            ImportanceSampleHomogeneousMedium(rndVal, extinction, dt, tOffset, weight);

            float sampleT = t0 + tOffset;
            float3 sampleWS = ray.originWS + sampleT * ray.jitterDirWS;

            float3 lightVector = light.positionWS - sampleWS;
            float distanceSq = max(dot(lightVector, lightVector), 1e-4);
            float distanceToLight = sqrt(distanceSq);

            // Important:
            // Ideally, all scattering calculations should use the jittered versions
            // of the sample position and the ray direction. However, correct reprojection
            // of asymmetrically scattered lighting (affected by an anisotropic phase
            // function) is not possible. We work around this issue by reprojecting
            // lighting not affected by the phase function. This basically removes
            // the phase function from the temporal integration process. It is a hack.
            // The downside is that anisotropy no longer benefits from temporal averaging,
            // and any temporal instability of anisotropy causes causes visible jitter.
            // In order to stabilize the image, we use the voxel center for all
            // anisotropy-related calculations.
            float3 centerToLight = light.positionWS - centerWS;
            float cosTheta = dot(centerToLight, ray.centerDirWS) * rsqrt(dot(centerToLight, centerToLight));
            float phaseVarying = CornetteShanksPhasePartVarying(g, cosTheta);

            float rangeAttenuation = saturate(1.0 - distanceToLight / max(light.range, 1e-4));
            rangeAttenuation *= rangeAttenuation;
            float volumetricFade = EvaluateVolumetricLightFade(
                GetVolumetricLightCameraDistance(light.positionWS),
                light.volumetricFadeDistance);

            float3 lightRadiance = max(light.color, 0.0) * light.volumetricDimmer * volumetricFade * rangeAttenuation / max(distanceSq, 1.0);

            // Compute the amount of in-scattered radiance.
            // Note: the 'weight' accounts for transmittance from 't0' to 't'.
            lighting.radianceNoPhase += weight * lightRadiance;
            lighting.radianceComplete += weight * lightRadiance * phaseVarying;
        }
    }

    return lighting;
}

float3 EvaluateAmbientLighting()
{
    return max(unity_AmbientSky.rgb, 0.0) * _VBufferGlobalProbeDimmer;
}

float3 EvaluateVolumetricAmbientProbe(float3 normalWS)
{
#if defined(VIVID_USE_VOLUMETRIC_AMBIENT_PROBE_BUFFER)
    return SampleSH9(_VolumetricAmbientProbeBuffer, SafeNormalize(normalWS));
#else
    return EvaluateAmbientLighting();
#endif
}

// Computes the in-scattered radiance along the ray.
void FillVolumetricLightingBuffer(uint2 vBufferPixel, JitteredRay ray, bool hasMaxZ)
{
    uint sliceCount = (uint)_VBufferSliceCount;
    float t0 = GetVBufferJitteredRayStartDistance(ray);
    float de = _VBufferRcpSliceCount;

    // The contribution of the ambient probe does not depend on the position,
    // only on the direction and the length of the interval.
    // SampleSH9() evaluates the 3-band SH in a given direction.
    // The probe is already pre-convolved with the phase function.
    // Note: anisotropic, no jittering.
    float3 probeInScatteredRadiance = EvaluateVolumetricAmbientProbe(ray.centerDirWS);

    float3 totalRadiance = 0.0;
    float opticalDepth = 0.0;
    uint slice = 0;

    for (; slice < sliceCount; slice++)
    {
        uint3 voxelCoord = uint3(vBufferPixel, slice);
        float e1 = ((float)slice + 1.0) * de;
        float t1 = max(t0, DecodeLogarithmicDepthGeneralized(e1, _VBufferDepthDecodingParams));
        float tNext = t1;

        bool containsOpaqueGeometry = IsInRange(ray.geomDist, float2(t0, t1));
        if (containsOpaqueGeometry)
        {
            // Only integrate up to the opaque surface (make the voxel shorter, but not completely flat).
            // Note that we can NOT completely stop integrating when the ray reaches geometry, since
            // otherwise we get flickering at geometric discontinuities if reprojection is enabled.
            // In this case, a temporally stable light leak is better than flickering.
            t1 = max(t0 * 1.0001, ray.geomDist);
        }

        float dt = t1 - t0; // Is geometry-aware
        if (dt <= 0.0)
        {
            StoreEmptyVBufferFeedback(voxelCoord);
            StoreIntegratedVBufferLighting(voxelCoord, totalRadiance, opticalDepth);
            t0 = tNext;
            continue;
        }

        // Accurately compute the center of the voxel in the log space. It's important to perform
        // the inversion exactly, since the accumulated value of the integral is stored at the center.
        // We will use it for participating media sampling, asymmetric scattering and reprojection.
        float t = DecodeLogarithmicDepthGeneralized(e1 - 0.5 * de, _VBufferDepthDecodingParams);
        float3 centerWS = ray.originWS + t * ray.centerDirWS;

        // Sample the participating medium at the center of the voxel.
        // We consider it to be constant along the interval [t0, t1] (within the voxel).
        float4 density = _VBufferDensity.Load(int4(voxelCoord, 0));

        float3 scattering = max(density.rgb, 0.0);
        float extinction = max(density.a, 0.0);
        float anisotropyMoment = _VBufferAnisotropy.Load(int4(voxelCoord, 0));
        float anisotropy = extinction > FLT_MIN ? anisotropyMoment / extinction : _VBufferFogAnisotropy;
        float voxelOpticalDepth = extinction * dt;
        float blendOpticalDepth = voxelOpticalDepth;

        if (ShouldEvaluateVBufferLighting(extinction))
        {
            // Perform per-pixel randomization by adding an offset and then sampling uniformly
            // (in the log space) in a vein similar to Stochastic Universal Sampling:
            // https://en.wikipedia.org/wiki/Stochastic_universal_sampling
            float perPixelRandomOffset = GenerateVBufferRandom(vBufferPixel);

            // This is a time-based sequence of 7 equidistant numbers from 1/14 to 13/14.
            // Each of them is the centroid of the interval of length 2/14.
            float rndVal = frac(perPixelRandomOffset + _VBufferSampleOffset.z);

            VoxelLighting aggregate = (VoxelLighting)0;

            // Prevent division by 0.
            float sampledExtinction = max(extinction, FLT_MIN);
            VoxelLighting directionalLighting = EvaluateVoxelLightingDirectional(
                voxelCoord,
                ray,
                t0,
                t1,
                dt,
                rndVal,
                sampledExtinction,
                anisotropy);
            aggregate.radianceNoPhase += directionalLighting.radianceNoPhase;
            aggregate.radianceComplete += directionalLighting.radianceComplete;

            VoxelLighting localLighting = EvaluateVoxelLightingLocal(
                voxelCoord,
                vBufferPixel,
                centerWS,
                ray,
                t0,
                t1,
                dt,
                rndVal,
                sampledExtinction,
                anisotropy);
            aggregate.radianceNoPhase += localLighting.radianceNoPhase;
            aggregate.radianceComplete += localLighting.radianceComplete;

            // Clamp here to prevent generation of NaNs.
            float4 voxelValue = float4(aggregate.radianceNoPhase, sampledExtinction * dt);
            float4 normalizedVoxelValue = LinearizeRGBD(voxelValue) * rcp(max(dt, FLT_MIN));
            float4 normalizedBlendValue = normalizedVoxelValue;

            // Reproject the history at 'centerWS'.
            float4 reprojValue = (_VBufferHistoryIsValid != 0u) ? SampleVBufferHistory(centerWS) : 0.0;
            bool reprojSuccess = (_VBufferHistoryIsValid != 0u) && (reprojValue.a != 0.0);

            if (reprojSuccess)
            {
                // Perform temporal blending in the log space ("Pixar blend").
                normalizedBlendValue = lerp(normalizedVoxelValue, reprojValue, ComputeHistoryWeight());
            }

            // Store the feedback for the voxel.
            // TODO: dynamic lights (which update their position, rotation, cookie or shadow at runtime)
            // do not support reprojection and should neither read nor write to the history buffer.
            // This will cause them to alias, but it is the only way to prevent ghosting.
            StoreVBufferFeedback(voxelCoord, normalizedBlendValue);

            float4 blendValue = DelinearizeRGBD(normalizedBlendValue * dt);

            // Estimate the influence of the phase function on the results of the current frame.
            float3 phaseCurrFrame = float3(
                SafeDiv(aggregate.radianceComplete.r, aggregate.radianceNoPhase.r),
                SafeDiv(aggregate.radianceComplete.g, aggregate.radianceNoPhase.g),
                SafeDiv(aggregate.radianceComplete.b, aggregate.radianceNoPhase.b));

            // Warning: in general, this does not work!
            // For a voxel with a single light, 'phaseCurrFrame' is monochromatic, and since
            // we don't jitter anisotropy, its value does not change from frame to frame
            // for a static camera/scene. This is fine.
            // If you have two lights per voxel, we compute:
            // phaseCurrFrame = (phaseA * lightingA + phaseB * lightingB) / (lightingA + lightingB).
            // 'phaseA' and 'phaseB' are still (different) constants for a static camera/scene.
            // 'lightingA' and 'lightingB' are jittered, so they change from frame to frame.
            // Therefore, 'phaseCurrFrame' becomes temporarily unstable and can cause flickering in practice. :-(
            float3 lightingRadiance = blendValue.rgb * phaseCurrFrame;

            // Compute the transmittance from the camera to 't0'.
            float transmittanceToSlice = TransmittanceFromOpticalDepth(opticalDepth);
            float phaseConstant = CornetteShanksPhasePartConstant(clamp(anisotropy, -0.95, 0.95));

            // Integrate the contribution of the probe over the interval.
            // Integral{a, b}{Transmittance(0, t) * L_s(t) dt} = Transmittance(0, a) * Integral{a, b}{Transmittance(0, t - a) * L_s(t) dt}.
            float3 probeRadiance = probeInScatteredRadiance * TransmittanceIntegralHomogeneousMedium(sampledExtinction, dt);

            // Accumulate radiance along the ray.
            totalRadiance += transmittanceToSlice * scattering * (phaseConstant * lightingRadiance + probeRadiance);
            blendOpticalDepth = blendValue.a;
        }
        else
        {
            StoreEmptyVBufferFeedback(voxelCoord);
        }

        opticalDepth += 0.5 * blendOpticalDepth;

        // Store the voxel data.
        // Note: for correct filtering, the data has to be stored in the perceptual space.
        // This means storing the tone mapped radiance and transmittance instead of optical depth.
        // See "A Fresh Look at Generalized Sampling", p. 51.
        StoreIntegratedVBufferLighting(voxelCoord, totalRadiance, opticalDepth);

        // Compute the optical depth up to the end of the interval.
        opticalDepth += 0.5 * blendOpticalDepth;

        if (hasMaxZ && t0 * 0.99 > ray.maxDist)
        {
            slice++;
            break;
        }

        t0 = tNext;
    }

    for (; slice < sliceCount; slice++)
    {
        uint3 voxelCoord = uint3(vBufferPixel, slice);
        StoreEmptyVBufferFeedback(voxelCoord);
        StoreEmptyVBufferLighting(voxelCoord);
    }
}

[numthreads(8, 8, 4)]
void ClearVBufferLighting(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (!IsInsideVBuffer(dispatchThreadId))
        return;

    _VBufferLighting[dispatchThreadId] = float4(0.0, 0.0, 0.0, 1.0);
}

[numthreads(8, 8, 1)]
void VolumetricLighting(uint3 dispatchThreadId : SV_DispatchThreadID,
                        uint2 groupId : SV_GroupID,
                        uint2 groupThreadId : SV_GroupThreadID,
                        uint groupIndex : SV_GroupIndex)
{
    uint2 groupOffset = groupId * GROUP_SIZE_1D;
    uint2 vBufferPixel = groupOffset + groupThreadId;

    if (vBufferPixel.x >= (uint)_VBufferWidth || vBufferPixel.y >= (uint)_VBufferHeight)
        return;

    float2 sampleOffset = _VBufferSampleOffset.xy;
    JitteredRay ray = BuildVBufferJitteredRay(vBufferPixel, sampleOffset);

    // We would like to determine the screen pixel (at the full resolution) which
    // the jittered ray corresponds to. The exact solution can be obtained by intersecting
    // the ray with the screen plane, e.i. (ViewSpace(jitterDirWS).z = 1). That's a little expensive.
    // So, as an approximation, we ignore the curvature of the frustum.
    float2 vBufferUV = GetVBufferSampleUV(vBufferPixel, sampleOffset);
    bool hasOpaqueGeometry;
    ray.geomDist = GetVBufferOpaqueGeometryDistanceForRay(vBufferUV, ray, hasOpaqueGeometry);

    float fallbackDistance = hasOpaqueGeometry ? ray.geomDist : _VBufferLastSliceDistance;
    bool hasMaxZ = _VBufferMaxZEnabled > 0.5;
    ray.maxDist = GetVBufferMaxOpaqueGeometryDistance(vBufferUV, ray.jitterDirWS, fallbackDistance);

    // Do not jitter 'vBufferPixel' else. It's expected to correspond to the center of the voxel.
    FillVolumetricLightingBuffer(vBufferPixel, ray, hasMaxZ);
}

float4 LoadLightingClamped(int3 coord)
{
    int3 maxCoord = int3((int)_VBufferWidth - 1, (int)_VBufferHeight - 1, (int)_VBufferSliceCount - 1);
    return _VBufferLightingInput.Load(int4(clamp(coord, int3(0, 0, 0), maxCoord), 0));
}

void PrefetchVBufferFilterData(uint sampleID, uint2 groupOrigin, uint sliceIndex)
{
    int2 originXY = int2(groupOrigin) - 1;
    int offsetX = (int)(sampleID % VBUFFER_FILTER_SIZE_1D);
    int offsetY = (int)(sampleID / VBUFFER_FILTER_SIZE_1D);
    int3 sampleCoord = int3(originXY.x + offsetX, originXY.y + offsetY, (int)sliceIndex);
    gs_VBufferFilterCache[offsetX + offsetY * VBUFFER_FILTER_SIZE_1D] = LoadLightingClamped(sampleCoord);
}

float Gaussian(float radius, float sigma)
{
    float v = radius / sigma;
    return exp(-(v * v));
}

[numthreads(GROUP_SIZE_1D, GROUP_SIZE_1D, 1)]
void FilterVolumetricLighting(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex,
    uint2 groupId : SV_GroupID,
    uint2 groupThreadId : SV_GroupThreadID)
{
    uint currentSlice = dispatchThreadId.z;
    uint2 groupOrigin = groupId * VBUFFER_FILTER_GROUP_SIZE_XY;
    uint2 currentCoord = groupOrigin + groupThreadId;
    uint3 voxelCoord = uint3(currentCoord, currentSlice);

    for (uint sampleID = groupIndex; sampleID < VBUFFER_FILTER_LDS_SIZE; sampleID += VBUFFER_FILTER_THREAD_COUNT)
        PrefetchVBufferFilterData(sampleID, groupOrigin, currentSlice);

    GroupMemoryBarrierWithGroupSync();

    if (!IsInsideVBuffer(voxelCoord))
        return;

    float4 value = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (int idx = -1; idx <= 1; idx++)
    {
        [unroll]
        for (int idx2 = -1; idx2 <= 1; idx2++)
        {
            int2 tapAddress = (int2(groupThreadId) + 1) + int2(idx2, idx);
            uint ldsTapAddress = (uint)tapAddress.x + (uint)tapAddress.y * VBUFFER_FILTER_SIZE_1D;
            float weight = Gaussian(length(float2(idx, idx2)), VBUFFER_FILTER_GAUSSIAN_SIGMA);

            value += gs_VBufferFilterCache[ldsTapAddress] * weight;
            weightSum += weight;
        }
    }

    _VBufferLightingOutput[voxelCoord] = value / max(weightSum, 1e-4);
}
