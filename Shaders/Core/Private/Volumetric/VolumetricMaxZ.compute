#pragma use_dxc
#pragma kernel ComputeMaxZ
#pragma kernel ComputeFinalMask
#pragma kernel DilateMask

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Private/Volumetric/VBuffer.hlsl"

#define VBUFFER_MAX_Z_GROUP_SIZE 8
#define VBUFFER_MAX_Z_FAR_DEPTH 1.0e10

Texture2D<float> _CameraDepth;
Texture2D<float> _InputTexture;
RWTexture2D<float> _OutputTexture;

float4 _SrcOffsetAndLimit;
float _DilationWidth;

#define _SrcLimit _SrcOffsetAndLimit.xy

groupshared float gs_MaxDepth[VBUFFER_MAX_Z_GROUP_SIZE * VBUFFER_MAX_Z_GROUP_SIZE];

float2 GetVBufferCameraSize()
{
    return max(round(_VBufferViewportSize.xy * _VBufferCameraToVBufferScale), float2(1.0, 1.0));
}

float GetDepthToDownsample(uint2 cameraPixel)
{
    float2 cameraSize = GetVBufferCameraSize();
    if (any(cameraPixel >= (uint2)cameraSize))
        return -1.0;

    float deviceDepth = _CameraDepth.Load(int3(cameraPixel, 0));
    if (IsVBufferFarDepth(deviceDepth))
        return VBUFFER_MAX_Z_FAR_DEPTH;

    return LinearEyeDepth(deviceDepth, _ZBufferParams);
}

[numthreads(VBUFFER_MAX_Z_GROUP_SIZE, VBUFFER_MAX_Z_GROUP_SIZE, 1)]
void ComputeMaxZ(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex,
    uint3 groupId : SV_GroupID)
{
    gs_MaxDepth[groupIndex] = GetDepthToDownsample(dispatchThreadId.xy);
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint stride = (VBUFFER_MAX_Z_GROUP_SIZE * VBUFFER_MAX_Z_GROUP_SIZE) >> 1; stride > 0; stride >>= 1)
    {
        if (groupIndex < stride)
            gs_MaxDepth[groupIndex] = max(gs_MaxDepth[groupIndex], gs_MaxDepth[groupIndex + stride]);
        GroupMemoryBarrierWithGroupSync();
    }

    if (groupIndex == 0u)
        _OutputTexture[groupId.xy] = gs_MaxDepth[0];
}

float LoadInputMaxZ(uint2 pixel, uint2 limit)
{
    uint2 coord = min(pixel, limit - uint2(1u, 1u));
    return _InputTexture.Load(int3(coord, 0));
}

[numthreads(8, 8, 1)]
void ComputeFinalMask(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 srcLimit = max((uint2)_SrcLimit, uint2(1u, 1u));
    uint2 outputLimit = (srcLimit + uint2(1u, 1u)) / uint2(2u, 2u);
    uint2 outputPixel = dispatchThreadId.xy;
    if (any(outputPixel >= outputLimit))
        return;

    uint2 srcPixelUL = outputPixel << 1;
    float s0 = LoadInputMaxZ(srcPixelUL + uint2(0u, 0u), srcLimit);
    float s1 = LoadInputMaxZ(srcPixelUL + uint2(1u, 0u), srcLimit);
    float s2 = LoadInputMaxZ(srcPixelUL + uint2(0u, 1u), srcLimit);
    float s3 = LoadInputMaxZ(srcPixelUL + uint2(1u, 1u), srcLimit);

    _OutputTexture[outputPixel] = max(max(s0, s1), max(s2, s3));
}

[numthreads(8, 8, 1)]
void DilateMask(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 srcLimit = max((uint2)_SrcLimit, uint2(1u, 1u));
    uint2 outputPixel = dispatchThreadId.xy;
    if (any(outputPixel >= srcLimit))
        return;

    int dilationWidth = max((int)_DilationWidth, 0);
    int2 currentCoord = (int2)outputPixel;
    int2 maxCoord = (int2)srcLimit - int2(1, 1);
    float dilatedMaxZ = -1.0;

    [loop]
    for (int y = -dilationWidth; y <= dilationWidth; y++)
    {
        [loop]
        for (int x = -dilationWidth; x <= dilationWidth; x++)
        {
            int2 tapCoord = clamp(currentCoord + int2(x, y), int2(0, 0), maxCoord);
            dilatedMaxZ = max(dilatedMaxZ, _InputTexture.Load(int3(tapCoord, 0)));
        }
    }

    _OutputTexture[outputPixel] = dilatedMaxZ;
}
