#pragma use_dxc
#pragma kernel ClearDeferredLit
#pragma kernel DeferredLit_Variant0
#pragma kernel DeferredLit_Variant1
#pragma kernel DeferredLit_Variant2
#pragma kernel DeferredLit_Variant3
#pragma multi_compile _ PROBE_VOLUMES_L1 PROBE_VOLUMES_L2

#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Input.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/GBuffer.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/SurfaceSummaryGBuffer.hlsl"
#define CLASSIFY_TILE_SIZE 8
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/TileClassification.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/HdrpLitLighting.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/LightingLoop.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Private/Sky/SkyUtils.hlsl"


Texture2D<float4> _GBuffer0;
Texture2D<float4> _GBuffer1;
Texture2D<float4> _GBuffer2;
Texture2D<float4> _GBuffer3;
Texture2D<float4> _DiffuseIrradiance;
Texture2D<float> _DepthTexture;
Texture2D<float> _DirectionalShadowTexture;
Texture2D<float> _GTAOTexture;
Texture2D<float4> _ScreenSpaceReflectionTexture;
StructuredBuffer<uint> _MaterialTileFeatureFlags;
StructuredBuffer<uint> _MaterialFeatureTileList;

RWTexture2D<float4> _LightingTexture;
RWTexture2D<float4> _LightingDebugTexture;

uint _ScreenSpaceReflectionEnabled;
uint _MaterialTileCountX;
uint _MaterialFeatureTileListOffset;

bool IsSkyPixel(float deviceDepth)
{
    return deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
}

float3 GetCameraPositionWS()
{
    return _WorldSpaceCameraPos;
}

float3 EvaluateDeferredSkyLighting(uint2 pixelCoord)
{
    float3 viewDirectionWS = GetSkyViewDirWS(float2(pixelCoord) + 0.5);
    float3 skyRadiance = SampleSkyTexture(-viewDirectionWS, 0.0);
    return VividApplyPreExposure(max(skyRadiance, 0.0));
}

VividSurfaceSummaryData LoadVividSurfaceSummary(uint2 pixelCoord)
{
    float4 rt0 = _GBuffer0.Load(int3(pixelCoord, 0));
    float4 rt1 = _GBuffer1.Load(int3(pixelCoord, 0));
    float4 rt2 = _GBuffer2.Load(int3(pixelCoord, 0));
    float4 rt3 = _GBuffer3.Load(int3(pixelCoord, 0));
    float4 rt4 = _DiffuseIrradiance.Load(int3(pixelCoord, 0));
    return VividUnpackSurfaceSummaryGBuffer(rt0, rt1, rt2, rt3, rt4);
}

VividGBufferSurfaceData BuildFastSlabLightingSurfaceData(
    VividSurfaceSummaryData summary)
{
    VividGBufferSurfaceData surfaceData = (VividGBufferSurfaceData)0;
    surfaceData.normalWS = summary.normalWS;
    surfaceData.linearRoughness =
        summary.perceptualRoughness * summary.perceptualRoughness;
    surfaceData.ambientOcclusion = summary.ambientOcclusion;
    surfaceData.materialFeatures = VIVID_MATERIALFEATURE_LIT;
    if (VividHasDeferredExportFlag(
            summary.deferredExportHeader,
            VIVID_DEFERRED_EXPORT_FLAG_RECEIVE_SSR))
    {
        surfaceData.materialFeatures |= VIVID_MATERIALFEATURE_SSR_RECEIVE;
    }
    if (VividHasDeferredExportFlag(
            summary.deferredExportHeader,
            VIVID_DEFERRED_EXPORT_FLAG_RECEIVE_DECALS))
    {
        surfaceData.materialFeatures |= VIVID_MATERIALFEATURE_DECAL_RECEIVE;
    }
    surfaceData.emissive = summary.emissive;
    surfaceData.builtinData = CreateVividBuiltinData(
        summary.diffuseIrradiance,
        VividHasDeferredExportFlag(
            summary.deferredExportHeader,
            VIVID_DEFERRED_EXPORT_FLAG_HAS_DIFFUSE_IRRADIANCE)
                ? 1.0
                : 0.0,
        0.0,
        1.0);
    return surfaceData;
}

VividLitBSDFData BuildFastSlabBSDFData(VividSurfaceSummaryData summary)
{
    VividLitBSDFData bsdfData = (VividLitBSDFData)0;
    bsdfData.diffuseColor = summary.diffuseAlbedo;
    bsdfData.fresnel0 = summary.specularF0;
    bsdfData.fresnel90 = 1.0;
    bsdfData.perceptualRoughness = summary.perceptualRoughness;
    bsdfData.roughness = ClampRoughnessForAnalyticalLights(
        summary.perceptualRoughness * summary.perceptualRoughness);
    bsdfData.coatMask = 0.0;
    bsdfData.coatRoughness = kVividClearCoatRoughness;
    return bsdfData;
}

float SampleDirectionalShadow(uint2 pixelCoord)
{
    float2 uv = (float2(pixelCoord) + 0.5) * _ScreenSize.zw;
    return _DirectionalShadowTexture.SampleLevel(sampler_PointClamp, uv, 0).x;
}

float SampleGTAO(uint2 pixelCoord)
{
    return LOAD_TEXTURE2D(_GTAOTexture,pixelCoord).x;
}

float4 LoadScreenSpaceReflection(
    uint2 pixelCoord,
    VividSurfaceSummaryData summary)
{
    if (_ScreenSpaceReflectionEnabled == 0)
        return float4(0.0, 0.0, 0.0, 0.0);

    if (!VividHasDeferredExportFlag(
            summary.deferredExportHeader,
            VIVID_DEFERRED_EXPORT_FLAG_RECEIVE_SSR))
        return float4(0.0, 0.0, 0.0, 0.0);

    float4 reflection = _ScreenSpaceReflectionTexture.Load(int3(pixelCoord, 0));
    return float4(VividApplyPreExposure(max(reflection.rgb, 0.0)), saturate(reflection.a));
}

float EvaluateDeferredDirectionalShadowAttenuation(
    uint2 pixelCoord,
    uint lightIndex,
    DirectionalLightData directionalLight)
{
    if ((int)lightIndex != _MainDirectionalLightIndex)
        return 1.0;

    float directionalShadow = saturate(SampleDirectionalShadow(pixelCoord));
    return lerp(1.0, directionalShadow, saturate(directionalLight.shadowStrength));
}

VividIndirectLighting EvaluateDeferredReflectionProbeIndirectLighting(
    VividLightingLoopContext lightLoop,
    VividIndirectLighting indirectLighting,
    VividGBufferSurfaceData surfaceData,
    VividLitBSDFData bsdfData,
    VividPreLightData preLightData,
    float3 positionWS,
    float3 viewDirectionWS)
{
    float3 probeDirectionWS;
    float probePerceptualRoughness;
    GetVividReflectionProbeSampleInputs(
        surfaceData,
        preLightData,
        viewDirectionWS,
        probeDirectionWS,
        probePerceptualRoughness);

    float3 weightedProbeRadiance;
    float reflectionProbeWeight;
    if (!VividLightingLoop::TryEvaluateReflectionProbes(
            lightLoop,
            positionWS,
            surfaceData.normalWS,
            probeDirectionWS,
            probePerceptualRoughness,
            weightedProbeRadiance,
            reflectionProbeWeight))
    {
        return indirectLighting;
    }

    float3 weightedCoatProbeRadiance = 0.0;
    if (NeedsVividClearCoatReflectionProbeSample(bsdfData))
    {
        float3 coatProbeDirectionWS;
        float coatProbePerceptualRoughness;
        float coatProbeWeight;
        GetVividClearCoatReflectionProbeSampleInputs(
            surfaceData,
            bsdfData,
            preLightData,
            coatProbeDirectionWS,
            coatProbePerceptualRoughness);
        VividLightingLoop::TryEvaluateReflectionProbes(
            lightLoop,
            positionWS,
            surfaceData.normalWS,
            coatProbeDirectionWS,
            coatProbePerceptualRoughness,
            weightedCoatProbeRadiance,
            coatProbeWeight);
    }

    return ApplyVividReflectionProbeSpecularLighting(
        indirectLighting,
        weightedProbeRadiance,
        reflectionProbeWeight,
        weightedCoatProbeRadiance,
        surfaceData,
        bsdfData,
        preLightData,
        viewDirectionWS);
}

VividLightLoopOutput EvaluateDeferredLitLightLoop(
    VividSurfaceSummaryData summary,
    uint2 pixelCoord,
    float3 positionWS,
    out float3 indirectDiffuseLighting,
    out float3 indirectSpecularLighting,
    out float3 screenSpaceReflectionFGD)
{
    VividGBufferSurfaceData surfaceData =
        BuildFastSlabLightingSurfaceData(summary);
    float3 viewDirectionWS = SafeNormalize(GetWorldSpaceViewDir(positionWS));
    VividLitBSDFData bsdfData = BuildFastSlabBSDFData(summary);
    VividPreLightData preLightData = GetVividPreLightData(viewDirectionWS, surfaceData, bsdfData);
    screenSpaceReflectionFGD = preLightData.specularFGD;
    VividAggregateLighting aggregateLighting = (VividAggregateLighting)0;
    VividLightingLoopContext lightLoop = VividLightingLoop::Create(pixelCoord, positionWS);

    AccumulateIndirectLighting(
        EvaluateDeferredReflectionProbeIndirectLighting(
            lightLoop,
            EvaluateBSDF_Env(positionWS, viewDirectionWS, preLightData, surfaceData, bsdfData),
            surfaceData,
            bsdfData,
            preLightData,
            positionWS,
            viewDirectionWS),
        aggregateLighting);

    [loop]
    for (uint lightIndex = 0; lightIndex < _DirectionalLightCount; lightIndex++)
    {
        DirectionalLightData directionalLight = GetDirectionalLight(lightIndex);
        float shadowAttenuation = EvaluateDeferredDirectionalShadowAttenuation(pixelCoord, lightIndex, directionalLight);

        VividDirectLighting lighting = EvaluateBSDF_Directional(surfaceData, bsdfData, preLightData, viewDirectionWS, directionalLight, shadowAttenuation);
        AccumulateDirectLighting(lighting, aggregateLighting);
    }

    uint punctualLightCount = VividLightingLoop::GetPunctualLightCount(lightLoop);

    [loop]
    for (uint localLightIndex = 0; localLightIndex < punctualLightCount; localLightIndex++)
    {
        PunctualLightData punctualLight = VividLightingLoop::LoadPunctualLight(lightLoop, localLightIndex);
        VividDirectLighting lighting = EvaluateBSDF_Punctual(surfaceData, bsdfData, preLightData, positionWS, viewDirectionWS, punctualLight);
        AccumulateDirectLighting(lighting, aggregateLighting);
    }
    _LightingDebugTexture[pixelCoord] = aggregateLighting.direct.specular.xyzz;

    uint areaLightCount = VividLightingLoop::GetAreaLightCount(lightLoop);

    [loop]
    for (uint localAreaLightIndex = 0; localAreaLightIndex < areaLightCount; localAreaLightIndex++)
    {
        AreaLightData areaLight = VividLightingLoop::LoadAreaLight(lightLoop, localAreaLightIndex);
        AccumulateDirectLighting(
            EvaluateBSDF_Area(
                surfaceData,
                bsdfData,
                preLightData,
                positionWS,
                viewDirectionWS,
                areaLight),
            aggregateLighting);
    }

    VividLightLoopOutput lightLoopOutput = (VividLightLoopOutput)0;
    PostEvaluateBSDF(surfaceData, bsdfData, preLightData, aggregateLighting, lightLoopOutput);
    indirectDiffuseLighting = bsdfData.diffuseColor * aggregateLighting.indirect.diffuse;
    indirectSpecularLighting = FinalizeVividSpecularLighting(
        surfaceData,
        bsdfData,
        preLightData,
        aggregateLighting.indirect.specularReflected);
    // ClearDeferredLit owns emissive so unsupported/culled pixels still preserve it.
    lightLoopOutput.diffuseLighting = max(lightLoopOutput.diffuseLighting - surfaceData.emissive, 0.0);
    return lightLoopOutput;
}

VividLightLoopOutput EvaluateDeferredLitLighting(
    VividSurfaceSummaryData summary,
    uint2 pixelCoord,
    float3 positionWS,
    out float3 indirectDiffuseLighting,
    out float3 indirectSpecularLighting,
    out float3 screenSpaceReflectionFGD)
{
    return EvaluateDeferredLitLightLoop(
        summary,
        pixelCoord,
        positionWS,
        indirectDiffuseLighting,
        indirectSpecularLighting,
        screenSpaceReflectionFGD);
}

[numthreads(8, 8, 1)]
void ClearDeferredLit(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x >= (uint)_ScreenSize.x || dispatchThreadId.y >= (uint)_ScreenSize.y)
        return;

    uint2 pixelCoord = dispatchThreadId.xy;
    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));
    float3 lighting = IsSkyPixel(deviceDepth)
        ? EvaluateDeferredSkyLighting(pixelCoord)
        : VividApplyPreExposure(max(_GBuffer3.Load(int3(pixelCoord, 0)).rgb, 0.0));
    _LightingTexture[pixelCoord] = float4(lighting, 1.0);
    _LightingDebugTexture[pixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
}

uint GetDeferredVariantBit(uint deferredVariant)
{
    if (deferredVariant == 0u)
        return VIVID_DEFERRED_CLASS_BIT_FAST_SLAB;
    if (deferredVariant == 1u)
        return VIVID_DEFERRED_CLASS_BIT_GENERAL_SLAB;
    if (deferredVariant == 2u)
        return VIVID_DEFERRED_CLASS_BIT_DUAL_SLAB;
    return VIVID_DEFERRED_CLASS_BIT_CATCH_ALL;
}

void DeferredLitVariant(
    uint deferredVariant,
    uint3 groupId,
    uint3 groupThreadId)
{
    uint tileListIndex = groupId.x;
    uint2 tileCoord = TileClassifaction::UnpackTileCoord(_MaterialFeatureTileList[_MaterialFeatureTileListOffset + tileListIndex]);
    uint tileIndex = tileCoord.y * _MaterialTileCountX + tileCoord.x;
    uint tileClassMask = _MaterialTileFeatureFlags[tileIndex];
    uint deferredVariantBit = GetDeferredVariantBit(deferredVariant);
    if ((tileClassMask & deferredVariantBit) == 0u)
        return;

    uint2 pixelCoord = tileCoord * CLASSIFY_TILE_SIZE + groupThreadId.xy;
    if (pixelCoord.x >= (uint)_ScreenSize.x || pixelCoord.y >= (uint)_ScreenSize.y)
        return;

    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

    if (IsSkyPixel(deviceDepth))
        return;

    VividSurfaceSummaryData summary = LoadVividSurfaceSummary(pixelCoord);
    uint deferredExportClass = VividGetDeferredExportClass(
        summary.deferredExportHeader);
    if (deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_ERROR)
    {
        float3 errorColor = VividApplyPreExposure(float3(1.0, 0.0, 1.0));
        _LightingTexture[pixelCoord] = float4(errorColor, 1.0);
        _LightingDebugTexture[pixelCoord] = float4(1.0, 0.0, 1.0, 1.0);
        return;
    }

    if (deferredExportClass != VIVID_DEFERRED_EXPORT_CLASS_FAST_SLAB)
        return;

    summary.ambientOcclusion *= saturate(SampleGTAO(pixelCoord));

    float2 uv = (float2(pixelCoord) + 0.5) * _ScreenSize.zw;
    float3 positionWS = ComputeWorldSpacePosition(uv, deviceDepth, UNITY_MATRIX_I_VP);
    float3 indirectDiffuseLighting;
    float3 indirectSpecularLighting;
    float3 screenSpaceReflectionFGD;
    VividLightLoopOutput lightLoopOutput = EvaluateDeferredLitLighting(
        summary,
        pixelCoord,
        positionWS,
        indirectDiffuseLighting,
        indirectSpecularLighting,
        screenSpaceReflectionFGD);
    float3 diffuseLighting = VividApplyPreExposure(max(lightLoopOutput.diffuseLighting, 0.0));
    float3 specularLighting = VividApplyPreExposure(max(lightLoopOutput.specularLighting, 0.0));
    float4 screenSpaceReflection = LoadScreenSpaceReflection(pixelCoord, summary);
    float reflectionWeight = screenSpaceReflection.a;
    float3 preExposedIndirectSpecular = VividApplyPreExposure(max(indirectSpecularLighting, 0.0));
    specularLighting = max(specularLighting - preExposedIndirectSpecular * reflectionWeight, 0.0)
        + screenSpaceReflection.rgb * screenSpaceReflectionFGD * reflectionWeight;
    float3 lighting = diffuseLighting + specularLighting;
    float3 indirectLighting = VividApplyPreExposure(max(indirectDiffuseLighting + indirectSpecularLighting, 0.0));
    _LightingDebugTexture[pixelCoord] = float4(indirectLighting, reflectionWeight);
    float4 currentLighting = _LightingTexture[pixelCoord];
    _LightingTexture[pixelCoord] = float4(currentLighting.rgb + lighting, currentLighting.a);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void DeferredLit_Variant0(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    DeferredLitVariant(0u, groupId, groupThreadId);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void DeferredLit_Variant1(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    DeferredLitVariant(1u, groupId, groupThreadId);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void DeferredLit_Variant2(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    DeferredLitVariant(2u, groupId, groupThreadId);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void DeferredLit_Variant3(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    DeferredLitVariant(3u, groupId, groupThreadId);
}
