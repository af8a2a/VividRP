#pragma use_dxc
#pragma kernel ClearDeferredLit
#pragma kernel DeferredLit
#pragma multi_compile _ PROBE_VOLUMES_L1 PROBE_VOLUMES_L2

#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/Input.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/AutoExposure.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/GBuffer.hlsl"
#define CLASSIFY_TILE_SIZE 8
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/TileClassification.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/HdrpLitLighting.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/LightingLoop.hlsl"


Texture2D<float4> _GBuffer0;
Texture2D<float4> _GBuffer1;
Texture2D<float4> _GBuffer2;
Texture2D<float4> _GBuffer3;
Texture2D<float4> _GBuffer4;
Texture2D<float> _DepthTexture;
Texture2D<float> _DirectionalShadowTexture;
StructuredBuffer<uint> _MaterialPixelIndices;

RWTexture2D<float4> _LightingTexture;

uint _LightingWidth;
uint _LightingHeight;

bool IsSkyPixel(float deviceDepth)
{
    return deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
}

float3 GetCameraPositionWS()
{
    return _WorldSpaceCameraPos;
}


VividGBufferSurfaceData LoadVividGBuffer(uint2 pixelCoord)
{
    float4 rt0 = _GBuffer0.Load(int3(pixelCoord, 0));
    float4 rt1 = _GBuffer1.Load(int3(pixelCoord, 0));
    float4 rt2 = _GBuffer2.Load(int3(pixelCoord, 0));
    float4 rt3 = _GBuffer3.Load(int3(pixelCoord, 0));
    float4 rt4 = _GBuffer4.Load(int3(pixelCoord, 0));
    return UnpackVividGBufferSurfaceData(rt0, rt1, rt2, rt3, rt4);
}

float SampleDirectionalShadow(uint2 pixelCoord)
{
    float2 uv = (float2(pixelCoord) + 0.5) / float2(_LightingWidth, _LightingHeight);
    return _DirectionalShadowTexture.SampleLevel(sampler_PointClamp, uv, 0).x;
}

float EvaluateDeferredDirectionalShadowAttenuation(
    uint2 pixelCoord,
    uint lightIndex,
    DirectionalLightData directionalLight)
{
    if ((int)lightIndex != _MainDirectionalLightIndex)
        return 1.0;

    float directionalShadow = saturate(SampleDirectionalShadow(pixelCoord));
    return lerp(1.0, directionalShadow, saturate(directionalLight.shadowStrength));
}

VividLightLoopOutput EvaluateDeferredLitLightLoop(
    VividGBufferSurfaceData surfaceData,
    uint2 pixelCoord,
    float3 positionWS)
{
    float3 viewDirectionWS = SafeNormalize(GetWorldSpaceViewDir(positionWS));
    VividLitBSDFData bsdfData = BuildVividHDRPLitBSDFData(surfaceData);
    VividPreLightData preLightData = GetVividPreLightData(viewDirectionWS, surfaceData, bsdfData);
    VividAggregateLighting aggregateLighting = (VividAggregateLighting)0;

    AccumulateIndirectLighting(
        EvaluateBSDF_Env(positionWS, viewDirectionWS, preLightData, surfaceData, bsdfData),
        aggregateLighting);

    [loop]
    for (uint lightIndex = 0; lightIndex < _DirectionalLightCount; lightIndex++)
    {
        DirectionalLightData directionalLight = GetDirectionalLight(lightIndex);
        float shadowAttenuation = EvaluateDeferredDirectionalShadowAttenuation(
            pixelCoord,
            lightIndex,
            directionalLight);
        AccumulateDirectLighting(
            EvaluateBSDF_Directional(
                surfaceData,
                bsdfData,
                preLightData,
                viewDirectionWS,
                directionalLight,
                shadowAttenuation),
            aggregateLighting);
    }

    if (HasPunctualLights())
    {
        VividLightingLoopContext lightLoop = VividLightingLoop::Create(pixelCoord, positionWS);
        uint punctualLightCount = VividLightingLoop::GetPunctualLightCount(lightLoop);

        [loop]
        for (uint localLightIndex = 0; localLightIndex < punctualLightCount; localLightIndex++)
        {
            PunctualLightData punctualLight = VividLightingLoop::LoadPunctualLight(lightLoop, localLightIndex);
            AccumulateDirectLighting(
                EvaluateBSDF_Punctual(
                    surfaceData,
                    bsdfData,
                    preLightData,
                    positionWS,
                    viewDirectionWS,
                    punctualLight),
                aggregateLighting);
        }
    }

    VividLightLoopOutput lightLoopOutput = (VividLightLoopOutput)0;
    PostEvaluateBSDF(surfaceData, bsdfData, preLightData, aggregateLighting, lightLoopOutput);
    return lightLoopOutput;
}

float3 EvaluateDeferredLitLighting(VividGBufferSurfaceData surfaceData, uint2 pixelCoord, float3 positionWS)
{
    VividLightLoopOutput lightLoopOutput = EvaluateDeferredLitLightLoop(surfaceData, pixelCoord, positionWS);
    return CombineVividLightLoopOutput(lightLoopOutput);
}

[numthreads(8, 8, 1)]
void ClearDeferredLit(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x >= _LightingWidth || dispatchThreadId.y >= _LightingHeight)
        return;

    float3 emissive = VividApplyPreExposure(max(_GBuffer3.Load(int3(dispatchThreadId.xy, 0)).rgb, 0.0));
    _LightingTexture[dispatchThreadId.xy] = float4(emissive, 1.0);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void DeferredLit(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint tileListIndex = groupId.x;
    uint2 tileCoord = TileClassifaction::UnpackTileCoord(_MaterialPixelIndices[tileListIndex]);
    uint2 pixelCoord = tileCoord * CLASSIFY_TILE_SIZE + groupThreadId.xy;
    if (pixelCoord.x >= _LightingWidth || pixelCoord.y >= _LightingHeight)
        return;

    float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

    if (IsSkyPixel(deviceDepth))
        return;

    VividGBufferSurfaceData surfaceData = LoadVividGBuffer(pixelCoord);
    if (surfaceData.materialId > VIVID_GBUFFER_MATERIAL_CLEARCOAT)
        return;

    float2 uv = (float2(pixelCoord) + 0.5) * _ScreenSize.zw;
    float3 positionWS = ComputeWorldSpacePosition(uv, deviceDepth, UNITY_MATRIX_I_VP);
    float3 lighting = VividApplyPreExposure(EvaluateDeferredLitLighting(surfaceData, pixelCoord, positionWS));
    float4 currentLighting = _LightingTexture[pixelCoord];
    _LightingTexture[pixelCoord] = float4(currentLighting.rgb + lighting, currentLighting.a);
}
