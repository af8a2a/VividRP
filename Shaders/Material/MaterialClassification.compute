#pragma kernel ClearDeferredVariantArgs
#pragma kernel ClassifyDeferredExports
#pragma kernel ClassifyDeferredExportsWave32 VIVID_MATERIAL_WAVE_32
#pragma kernel ClassifyDeferredExportsWave64 VIVID_MATERIAL_WAVE_64
#pragma kernel BuildDeferredVariantIndirectArgs
#pragma kernel BuildDeferredVariantIndirectArgsWave32 VIVID_MATERIAL_WAVE_32
#pragma kernel BuildDeferredVariantIndirectArgsWave64 VIVID_MATERIAL_WAVE_64
#pragma kernel ClearDualSlabSidecarDrawArgs
#pragma kernel ClassifyDualSlabSidecarTiles
#pragma use_dxc
#pragma multi_compile _ UNITY_DEVICE_SUPPORTS_WAVE_32 UNITY_DEVICE_SUPPORTS_WAVE_64

#define CLASSIFY_TILE_SIZE 8
#define BUILD_INDIRECT_THREADS 64
#define VIVID_MATERIAL_CLASSIFY_THREAD_COUNT (CLASSIFY_TILE_SIZE * CLASSIFY_TILE_SIZE)
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/SurfaceSummaryGBuffer.hlsl"
#include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/TileClassification.hlsl"

#define VIVID_DEFERRED_VARIANT_COUNT 4
#define VIVID_DEFERRED_VARIANT_FAST_SLAB 0u
#define VIVID_DEFERRED_VARIANT_GENERAL_SLAB 1u
#define VIVID_DEFERRED_VARIANT_DUAL_SLAB 2u
#define VIVID_DEFERRED_VARIANT_CATCH_ALL 3u
#define VIVID_INDIRECT_ARGS_ELEMENT_COUNT 4
#define VIVID_INVALID_DEFERRED_VARIANT VIVID_DEFERRED_VARIANT_COUNT

#if defined(VIVID_MATERIAL_WAVE_64) && defined(UNITY_DEVICE_SUPPORTS_WAVE_64) && defined(UNITY_HW_WAVE_SIZE) && UNITY_HW_WAVE_SIZE == 64
#define VIVID_MATERIAL_WAVE_SIZE 64
#define VIVID_MATERIAL_USE_WAVE_INTRINSICS 1
#elif defined(VIVID_MATERIAL_WAVE_32) && defined(UNITY_DEVICE_SUPPORTS_WAVE_32) && defined(UNITY_HW_WAVE_SIZE) && UNITY_HW_WAVE_SIZE == 32
#define VIVID_MATERIAL_WAVE_SIZE 32
#define VIVID_MATERIAL_USE_WAVE_INTRINSICS 1
#else
#define VIVID_MATERIAL_WAVE_SIZE 0
#define VIVID_MATERIAL_USE_WAVE_INTRINSICS 0
#endif

#if VIVID_MATERIAL_USE_WAVE_INTRINSICS
#define VIVID_MATERIAL_WAVES_PER_CLASSIFY_GROUP ((VIVID_MATERIAL_CLASSIFY_THREAD_COUNT + VIVID_MATERIAL_WAVE_SIZE - 1) / VIVID_MATERIAL_WAVE_SIZE)
#define VIVID_MATERIAL_WAVES_PER_BUILD_GROUP ((BUILD_INDIRECT_THREADS + VIVID_MATERIAL_WAVE_SIZE - 1) / VIVID_MATERIAL_WAVE_SIZE)
#endif

Texture2D<float4> _GBuffer0;
Texture2D<float4> _GBuffer1;
Texture2D<float> _DepthTexture;

RWStructuredBuffer<uint> _MaterialTileFeatureFlags;
RWStructuredBuffer<uint> _MaterialFeatureTileList;
RWStructuredBuffer<uint> _MaterialFeatureIndirectArgs;

uint _ClassificationWidth;
uint _ClassificationHeight;
uint _MaterialTileCount;
uint _MaterialTileCountX;

#if VIVID_MATERIAL_USE_WAVE_INTRINSICS
groupshared uint gs_TileWaveMasks[VIVID_MATERIAL_WAVES_PER_CLASSIFY_GROUP];
groupshared uint gs_WaveVariantCounts[VIVID_DEFERRED_VARIANT_COUNT * VIVID_MATERIAL_WAVES_PER_BUILD_GROUP];
groupshared uint gs_GlobalVariantOffsets[VIVID_DEFERRED_VARIANT_COUNT];
#else
groupshared uint gs_LocalVariantCounts[VIVID_DEFERRED_VARIANT_COUNT];
groupshared uint gs_GlobalVariantOffsets[VIVID_DEFERRED_VARIANT_COUNT];
groupshared uint gs_LocalTileOffsets[BUILD_INDIRECT_THREADS];
groupshared uint gs_LocalTileVariants[BUILD_INDIRECT_THREADS];
#endif

uint GetDeferredClassOneHot(uint deferredExportClass)
{
    if (deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_EMPTY
        || deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_UNLIT)
    {
        return 0u;
    }

    if (deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_FAST_SLAB)
        return VIVID_DEFERRED_CLASS_BIT_FAST_SLAB;

    if (deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_GENERAL_SLAB)
        return VIVID_DEFERRED_CLASS_BIT_GENERAL_SLAB;

    if (deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_DUAL_SLAB)
        return VIVID_DEFERRED_CLASS_BIT_DUAL_SLAB;

    if (deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_SUBSURFACE
        || deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_CATCH_ALL
        || deferredExportClass == VIVID_DEFERRED_EXPORT_CLASS_ERROR)
    {
        return VIVID_DEFERRED_CLASS_BIT_CATCH_ALL;
    }

    // Unknown values are sanitized to Error by VividDecodeDeferredExportHeader.
    return 0u;
}

uint SelectDeferredVariant(uint deferredClassMask)
{
    if (deferredClassMask == 0u)
        return VIVID_INVALID_DEFERRED_VARIANT;

    if ((deferredClassMask & VIVID_DEFERRED_CLASS_BIT_CATCH_ALL) != 0u)
        return VIVID_DEFERRED_VARIANT_CATCH_ALL;

    // Fast < General < Dual: the most capable class covers a mixed tile.
    if ((deferredClassMask & VIVID_DEFERRED_CLASS_BIT_DUAL_SLAB) != 0u)
        return VIVID_DEFERRED_VARIANT_DUAL_SLAB;

    if ((deferredClassMask & VIVID_DEFERRED_CLASS_BIT_GENERAL_SLAB) != 0u)
        return VIVID_DEFERRED_VARIANT_GENERAL_SLAB;

    if ((deferredClassMask & VIVID_DEFERRED_CLASS_BIT_FAST_SLAB) != 0u)
        return VIVID_DEFERRED_VARIANT_FAST_SLAB;

    return VIVID_DEFERRED_VARIANT_CATCH_ALL;
}

#if VIVID_MATERIAL_USE_WAVE_INTRINSICS
uint GetWaveVariantCountIndex(uint variant, uint waveIndex)
{
    return variant * VIVID_MATERIAL_WAVES_PER_BUILD_GROUP + waveIndex;
}

void WriteDeferredVariantTile(uint tileIndex, uint variant, uint globalTileOffset)
{
    uint tileY = tileIndex / _MaterialTileCountX;
    uint tileX = tileIndex - tileY * _MaterialTileCountX;
    uint packedTileCoord = TileClassifaction::PackTileCoord(uint2(tileX, tileY));
    _MaterialFeatureTileList[variant * _MaterialTileCount + globalTileOffset] = packedTileCoord;
}

uint GetWaveVariantLocalTileOffset(uint variant, bool isLiveTile)
{
    uint localTileOffset = 0u;

    [unroll]
    for (uint currentVariant = 0u; currentVariant < VIVID_DEFERRED_VARIANT_COUNT; currentVariant++)
    {
        bool belongsToVariant = isLiveTile && variant == currentVariant;
        uint variantLocalTileOffset = WavePrefixCountBits(belongsToVariant);

        if (variant == currentVariant)
            localTileOffset = variantLocalTileOffset;
    }

    return localTileOffset;
}

uint GetWaveVariantTileCount(uint variant, bool isLiveTile, uint targetVariant)
{
    uint tileCount = 0u;

    [unroll]
    for (uint currentVariant = 0u; currentVariant < VIVID_DEFERRED_VARIANT_COUNT; currentVariant++)
    {
        uint currentVariantTileCount = WaveActiveCountBits(isLiveTile && variant == currentVariant);

        if (targetVariant == currentVariant)
            tileCount = currentVariantTileCount;
    }

    return tileCount;
}

void StoreWaveVariantCounts(uint variant, bool isLiveTile, uint waveIndex)
{
    bool isFirstLane = WaveIsFirstLane();

    [unroll]
    for (uint currentVariant = 0u; currentVariant < VIVID_DEFERRED_VARIANT_COUNT; currentVariant++)
    {
        uint waveTileCount = WaveActiveCountBits(isLiveTile && variant == currentVariant);

        if (isFirstLane)
            gs_WaveVariantCounts[GetWaveVariantCountIndex(currentVariant, waveIndex)] = waveTileCount;
    }
}

uint SumWaveVariantCounts(uint variant, uint waveCount)
{
    uint localTileCount = 0u;

    [loop]
    for (uint waveIndex = 0u; waveIndex < waveCount; waveIndex++)
        localTileCount += gs_WaveVariantCounts[GetWaveVariantCountIndex(variant, waveIndex)];

    return localTileCount;
}

uint SumPreviousWaveVariantCounts(uint variant, uint waveIndex)
{
    uint previousWaveTileCount = 0u;

    [loop]
    for (uint previousWaveIndex = 0u; previousWaveIndex < waveIndex; previousWaveIndex++)
        previousWaveTileCount += gs_WaveVariantCounts[GetWaveVariantCountIndex(variant, previousWaveIndex)];

    return previousWaveTileCount;
}

void WriteDeferredClassTileMaskWithWaveOps(uint deferredClassOneHot, uint3 groupId, uint groupIndex)
{
    uint tileIndex = groupId.y * _MaterialTileCountX + groupId.x;
    uint waveTileMask = WaveActiveBitOr(deferredClassOneHot);

#if VIVID_MATERIAL_WAVE_SIZE >= VIVID_MATERIAL_CLASSIFY_THREAD_COUNT
    if (WaveIsFirstLane())
        _MaterialTileFeatureFlags[tileIndex] = waveTileMask;
#else
    uint waveIndex = groupIndex / VIVID_MATERIAL_WAVE_SIZE;

    if (WaveIsFirstLane())
        gs_TileWaveMasks[waveIndex] = waveTileMask;

    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0u)
    {
        uint tileMask = 0u;

        [unroll]
        for (uint currentWaveIndex = 0u; currentWaveIndex < VIVID_MATERIAL_WAVES_PER_CLASSIFY_GROUP; currentWaveIndex++)
            tileMask |= gs_TileWaveMasks[currentWaveIndex];

        _MaterialTileFeatureFlags[tileIndex] = tileMask;
    }
#endif
}

void BuildDeferredVariantIndirectArgsWithWaveOps(uint tileIndex, uint variant, uint groupIndex)
{
    bool isLiveTile = tileIndex < _MaterialTileCount && variant < VIVID_DEFERRED_VARIANT_COUNT;
    uint localTileOffset = GetWaveVariantLocalTileOffset(variant, isLiveTile);

#if VIVID_MATERIAL_WAVE_SIZE >= BUILD_INDIRECT_THREADS
    uint variantGlobalOffset = 0u;
    uint variantLane = WaveGetLaneIndex();
    uint localTileCount = GetWaveVariantTileCount(variant, isLiveTile, variantLane);

    if (variantLane < VIVID_DEFERRED_VARIANT_COUNT)
    {
        if (localTileCount > 0u)
        {
            uint argsOffset = variantLane * VIVID_INDIRECT_ARGS_ELEMENT_COUNT;
            InterlockedAdd(_MaterialFeatureIndirectArgs[argsOffset], localTileCount, variantGlobalOffset);
        }
    }

    uint globalVariantOffset = WaveReadLaneAt(variantGlobalOffset, variant);

    if (isLiveTile)
    {
        uint globalTileOffset = globalVariantOffset + localTileOffset;
        WriteDeferredVariantTile(tileIndex, variant, globalTileOffset);
    }
#else
    uint waveIndex = groupIndex / VIVID_MATERIAL_WAVE_SIZE;
    StoreWaveVariantCounts(variant, isLiveTile, waveIndex);
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < VIVID_DEFERRED_VARIANT_COUNT)
    {
        uint localTileCount = SumWaveVariantCounts(groupIndex, VIVID_MATERIAL_WAVES_PER_BUILD_GROUP);
        uint globalTileOffset = 0u;

        if (localTileCount > 0u)
        {
            uint argsOffset = groupIndex * VIVID_INDIRECT_ARGS_ELEMENT_COUNT;
            InterlockedAdd(_MaterialFeatureIndirectArgs[argsOffset], localTileCount, globalTileOffset);
        }

        gs_GlobalVariantOffsets[groupIndex] = globalTileOffset;
    }

    GroupMemoryBarrierWithGroupSync();

    if (!isLiveTile)
        return;

    uint previousWaveTileCount = SumPreviousWaveVariantCounts(variant, waveIndex);
    uint globalTileOffset = gs_GlobalVariantOffsets[variant] + previousWaveTileCount + localTileOffset;
    WriteDeferredVariantTile(tileIndex, variant, globalTileOffset);
#endif
}
#else
void WriteDeferredVariantTile(uint tileIndex, uint variant, uint globalTileOffset)
{
    uint tileY = tileIndex / _MaterialTileCountX;
    uint tileX = tileIndex - tileY * _MaterialTileCountX;
    uint packedTileCoord = TileClassifaction::PackTileCoord(uint2(tileX, tileY));
    _MaterialFeatureTileList[variant * _MaterialTileCount + globalTileOffset] = packedTileCoord;
}

void InitializeMaterialFeatureTileListBuild(uint groupIndex)
{
    if (groupIndex < VIVID_DEFERRED_VARIANT_COUNT)
    {
        gs_LocalVariantCounts[groupIndex] = 0u;
        gs_GlobalVariantOffsets[groupIndex] = 0u;
    }

    gs_LocalTileOffsets[groupIndex] = 0u;
    gs_LocalTileVariants[groupIndex] = VIVID_INVALID_DEFERRED_VARIANT;
    GroupMemoryBarrierWithGroupSync();
}
#endif

void WriteDeferredClassTileMask(uint deferredClassOneHot, uint3 groupId, uint groupIndex)
{
#if VIVID_MATERIAL_USE_WAVE_INTRINSICS
    WriteDeferredClassTileMaskWithWaveOps(deferredClassOneHot, groupId, groupIndex);
#else
    TileClassifaction::InitializeTileClassification(groupIndex);
    TileClassifaction::SubmitPixelClassification(deferredClassOneHot);

    if (groupIndex == 0u)
    {
        uint tileIndex = groupId.y * _MaterialTileCountX + groupId.x;
        _MaterialTileFeatureFlags[tileIndex] = gs_TileMask;
    }
#endif
}

void BuildDeferredVariantIndirectArgsInternal(uint tileIndex, uint groupIndex)
{
    uint variant = VIVID_INVALID_DEFERRED_VARIANT;

    if (tileIndex < _MaterialTileCount)
        variant = SelectDeferredVariant(_MaterialTileFeatureFlags[tileIndex]);

#if VIVID_MATERIAL_USE_WAVE_INTRINSICS
    BuildDeferredVariantIndirectArgsWithWaveOps(tileIndex, variant, groupIndex);
#else
    InitializeMaterialFeatureTileListBuild(groupIndex);

    uint localTileOffset = 0u;

    if (variant < VIVID_DEFERRED_VARIANT_COUNT)
        InterlockedAdd(gs_LocalVariantCounts[variant], 1u, localTileOffset);

    gs_LocalTileOffsets[groupIndex] = localTileOffset;
    gs_LocalTileVariants[groupIndex] = variant;
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < VIVID_DEFERRED_VARIANT_COUNT)
    {
        uint localTileCount = gs_LocalVariantCounts[groupIndex];

        if (localTileCount > 0u)
        {
            uint globalTileOffset = 0u;
            uint argsOffset = groupIndex * VIVID_INDIRECT_ARGS_ELEMENT_COUNT;
            InterlockedAdd(_MaterialFeatureIndirectArgs[argsOffset], localTileCount, globalTileOffset);
            gs_GlobalVariantOffsets[groupIndex] = globalTileOffset;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (tileIndex >= _MaterialTileCount || variant >= VIVID_DEFERRED_VARIANT_COUNT)
        return;

    uint globalTileOffset = gs_GlobalVariantOffsets[variant] + gs_LocalTileOffsets[groupIndex];
    WriteDeferredVariantTile(tileIndex, variant, globalTileOffset);
#endif
}

[numthreads(VIVID_DEFERRED_VARIANT_COUNT, 1, 1)]
void ClearDeferredVariantArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint variant = dispatchThreadId.x;
    uint argsOffset = variant * VIVID_INDIRECT_ARGS_ELEMENT_COUNT;

    _MaterialFeatureIndirectArgs[argsOffset + 0u] = 0u;
    _MaterialFeatureIndirectArgs[argsOffset + 1u] = 1u;
    _MaterialFeatureIndirectArgs[argsOffset + 2u] = 1u;
    _MaterialFeatureIndirectArgs[argsOffset + 3u] = 0u;
}

[numthreads(1, 1, 1)]
void ClearDualSlabSidecarDrawArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    _MaterialFeatureIndirectArgs[0u] = 3u;
    _MaterialFeatureIndirectArgs[1u] = 0u;
    _MaterialFeatureIndirectArgs[2u] = 0u;
    _MaterialFeatureIndirectArgs[3u] = 0u;
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void ClassifyDualSlabSidecarTiles(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    uint dualSlabClass = 0u;
    if (dispatchThreadId.x < _ClassificationWidth
        && dispatchThreadId.y < _ClassificationHeight)
    {
        uint2 pixelCoord = dispatchThreadId.xy;
        float4 gbuffer0 = _GBuffer0.Load(int3(pixelCoord, 0));
        float4 gbuffer1 = _GBuffer1.Load(int3(pixelCoord, 0));
        if (VividIsSurfaceSummaryGBufferABIValid(gbuffer1.a))
        {
            uint deferredExportHeader = VividDecodeDeferredExportHeader(
                gbuffer0.a);
            uint deferredExportClass = VividGetDeferredExportClass(
                deferredExportHeader);
            dualSlabClass = deferredExportClass
                    == VIVID_DEFERRED_EXPORT_CLASS_DUAL_SLAB
                ? VIVID_DEFERRED_CLASS_BIT_DUAL_SLAB
                : 0u;
        }
    }

    TileClassifaction::InitializeTileClassification(groupIndex);
    TileClassifaction::SubmitPixelClassification(dualSlabClass);
    if (groupIndex == 0u
        && (gs_TileMask & VIVID_DEFERRED_CLASS_BIT_DUAL_SLAB) != 0u)
    {
        uint tileOffset;
        InterlockedAdd(
            _MaterialFeatureIndirectArgs[1u],
            1u,
            tileOffset);
        _MaterialFeatureTileList[tileOffset] =
            TileClassifaction::PackTileCoord(groupId.xy);
    }
}

void ClassifyDeferredExportsInternal(
    uint3 dispatchThreadId,
    uint3 groupId,
    uint groupIndex)
{
    uint deferredClassOneHot = 0u;

    if (dispatchThreadId.x < _ClassificationWidth && dispatchThreadId.y < _ClassificationHeight)
    {
        uint2 pixelCoord = dispatchThreadId.xy;
        float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

        if (deviceDepth != UNITY_RAW_FAR_CLIP_VALUE)
        {
            float4 gbuffer0 = _GBuffer0.Load(int3(pixelCoord, 0));
            float4 gbuffer1 = _GBuffer1.Load(int3(pixelCoord, 0));
            uint deferredExportHeader = VividIsSurfaceSummaryGBufferABIValid(gbuffer1.a)
                ? VividDecodeDeferredExportHeader(gbuffer0.a)
                : VIVID_DEFERRED_EXPORT_CLASS_ERROR;
            uint deferredExportClass = VividGetDeferredExportClass(deferredExportHeader);
            deferredClassOneHot = GetDeferredClassOneHot(deferredExportClass);
        }
    }

    WriteDeferredClassTileMask(deferredClassOneHot, groupId, groupIndex);
}

void BuildDeferredVariantIndirectArgsInternalEntry(
    uint3 dispatchThreadId,
    uint groupIndex)
{
    uint tileIndex = dispatchThreadId.x;
    BuildDeferredVariantIndirectArgsInternal(tileIndex, groupIndex);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void ClassifyDeferredExports(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    ClassifyDeferredExportsInternal(dispatchThreadId, groupId, groupIndex);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void ClassifyDeferredExportsWave32(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    ClassifyDeferredExportsInternal(dispatchThreadId, groupId, groupIndex);
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void ClassifyDeferredExportsWave64(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    ClassifyDeferredExportsInternal(dispatchThreadId, groupId, groupIndex);
}

[numthreads(BUILD_INDIRECT_THREADS, 1, 1)]
void BuildDeferredVariantIndirectArgs(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex)
{
    BuildDeferredVariantIndirectArgsInternalEntry(dispatchThreadId, groupIndex);
}

[numthreads(BUILD_INDIRECT_THREADS, 1, 1)]
void BuildDeferredVariantIndirectArgsWave32(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex)
{
    BuildDeferredVariantIndirectArgsInternalEntry(dispatchThreadId, groupIndex);
}

[numthreads(BUILD_INDIRECT_THREADS, 1, 1)]
void BuildDeferredVariantIndirectArgsWave64(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex)
{
    BuildDeferredVariantIndirectArgsInternalEntry(dispatchThreadId, groupIndex);
}
