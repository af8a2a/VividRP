#pragma kernel ClearMaterialFeatureArgs
#pragma kernel ClassifyMaterialFeatures
#pragma kernel BuildMaterialFeatureIndirectArgs

#define CLASSIFY_TILE_SIZE 8
#define BUILD_INDIRECT_THREADS 64
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/GBuffer.hlsl"
#include "Packages/com.af8a2a.vividrp/Shaders/Core/Public/TileClassification.hlsl"

#define VIVID_MATERIAL_FEATURE_VARIANT_COUNT 7
#define VIVID_MATERIAL_FEATURE_VARIANT_CATCH_ALL 6
#define VIVID_INDIRECT_ARGS_ELEMENT_COUNT 4
#define VIVID_INVALID_MATERIAL_FEATURE_VARIANT VIVID_MATERIAL_FEATURE_VARIANT_COUNT

Texture2D<float4> _GBuffer0;
Texture2D<float> _DepthTexture;

RWStructuredBuffer<uint> _MaterialTileFeatureFlags;
RWStructuredBuffer<uint> _MaterialFeatureTileList;
RWStructuredBuffer<uint> _MaterialFeatureIndirectArgs;

uint _ClassificationWidth;
uint _ClassificationHeight;
uint _MaterialTileCount;
uint _MaterialTileCountX;

groupshared uint gs_LocalVariantCounts[VIVID_MATERIAL_FEATURE_VARIANT_COUNT];
groupshared uint gs_GlobalVariantOffsets[VIVID_MATERIAL_FEATURE_VARIANT_COUNT];
groupshared uint gs_LocalTileOffsets[BUILD_INDIRECT_THREADS];
groupshared uint gs_LocalTileVariants[BUILD_INDIRECT_THREADS];

uint GetMaterialFeatureVariantFlags(uint variant)
{
    if (variant == 0u)
        return VIVID_MATERIALFEATURE_LIT;

    if (variant == 1u)
        return VIVID_MATERIALFEATURE_LIT | VIVID_MATERIALFEATURE_SSR_RECEIVE;

    if (variant == 2u)
        return VIVID_MATERIALFEATURE_LIT | VIVID_MATERIALFEATURE_CLEAR_COAT;

    if (variant == 3u)
        return VIVID_MATERIALFEATURE_LIT | VIVID_MATERIALFEATURE_CLEAR_COAT | VIVID_MATERIALFEATURE_SSR_RECEIVE;

    if (variant == 4u)
        return VIVID_MATERIALFEATURE_LIT | VIVID_MATERIALFEATURE_FABRIC;

    if (variant == 5u)
        return VIVID_MATERIALFEATURE_LIT | VIVID_MATERIALFEATURE_FABRIC | VIVID_MATERIALFEATURE_SSR_RECEIVE;

    return VIVID_MATERIALFEATURE_DEFERRED_MASK;
}

uint SelectMaterialFeatureVariant(uint materialFeatures)
{
    uint deferredFeatures = materialFeatures & VIVID_MATERIALFEATURE_DEFERRED_MASK;

    if (!HasVividMaterialFeature(deferredFeatures, VIVID_MATERIALFEATURE_LIT))
        return VIVID_INVALID_MATERIAL_FEATURE_VARIANT;

    [unroll]
    for (uint variant = 0u; variant < VIVID_MATERIAL_FEATURE_VARIANT_CATCH_ALL; variant++)
    {
        uint variantFeatures = GetMaterialFeatureVariantFlags(variant);

        if ((deferredFeatures & variantFeatures) == deferredFeatures)
            return variant;
    }

    return VIVID_MATERIAL_FEATURE_VARIANT_CATCH_ALL;
}

bool IsValidMaterialFeatureMask(uint materialFeatures)
{
    if (!HasVividMaterialFeature(materialFeatures, VIVID_MATERIALFEATURE_LIT))
        return false;

    bool isFabric = HasVividMaterialFeature(materialFeatures, VIVID_MATERIALFEATURE_FABRIC);
    bool isClearCoat = HasVividMaterialFeature(materialFeatures, VIVID_MATERIALFEATURE_CLEAR_COAT);
    return !(isFabric && isClearCoat);
}

bool TryDecodeValidMaterialFeatures(float encodedMaterialFeatureId, out uint materialFeatures)
{
    uint rawFeatureId = (uint)min(round(saturate(encodedMaterialFeatureId) * 255.0), 255.0);
    uint decodedFeatures = rawFeatureId & VIVID_MATERIALFEATURE_ID_MASK;

    if (rawFeatureId > VIVID_MATERIALFEATURE_ID_MASK || !IsValidMaterialFeatureMask(decodedFeatures))
    {
        materialFeatures = 0u;
        return false;
    }

    materialFeatures = decodedFeatures;
    return true;
}

void InitializeMaterialFeatureTileListBuild(uint groupIndex)
{
    if (groupIndex < VIVID_MATERIAL_FEATURE_VARIANT_COUNT)
    {
        gs_LocalVariantCounts[groupIndex] = 0u;
        gs_GlobalVariantOffsets[groupIndex] = 0u;
    }

    gs_LocalTileOffsets[groupIndex] = 0u;
    gs_LocalTileVariants[groupIndex] = VIVID_INVALID_MATERIAL_FEATURE_VARIANT;
    GroupMemoryBarrierWithGroupSync();
}

[numthreads(VIVID_MATERIAL_FEATURE_VARIANT_COUNT, 1, 1)]
void ClearMaterialFeatureArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint variant = dispatchThreadId.x;
    uint argsOffset = variant * VIVID_INDIRECT_ARGS_ELEMENT_COUNT;

    _MaterialFeatureIndirectArgs[argsOffset + 0u] = 0u;
    _MaterialFeatureIndirectArgs[argsOffset + 1u] = 1u;
    _MaterialFeatureIndirectArgs[argsOffset + 2u] = 1u;
    _MaterialFeatureIndirectArgs[argsOffset + 3u] = 0u;
}

[numthreads(CLASSIFY_TILE_SIZE, CLASSIFY_TILE_SIZE, 1)]
void ClassifyMaterialFeatures(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    TileClassifaction::InitializeTileClassification(groupIndex);

    uint materialFeatures = 0u;

    if (dispatchThreadId.x < _ClassificationWidth && dispatchThreadId.y < _ClassificationHeight)
    {
        uint2 pixelCoord = dispatchThreadId.xy;
        float deviceDepth = _DepthTexture.Load(int3(pixelCoord, 0));

        if (deviceDepth != UNITY_RAW_FAR_CLIP_VALUE)
        {
            float4 gbuffer0 = _GBuffer0.Load(int3(pixelCoord, 0));
            TryDecodeValidMaterialFeatures(gbuffer0.a, materialFeatures);
        }
    }

    TileClassifaction::SubmitPixelClassification(materialFeatures);

    if (groupIndex != 0u)
        return;

    uint tileIndex = groupId.y * _MaterialTileCountX + groupId.x;
    _MaterialTileFeatureFlags[tileIndex] = gs_TileMask;
}

[numthreads(BUILD_INDIRECT_THREADS, 1, 1)]
void BuildMaterialFeatureIndirectArgs(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex)
{
    InitializeMaterialFeatureTileListBuild(groupIndex);

    uint tileIndex = dispatchThreadId.x;
    uint variant = VIVID_INVALID_MATERIAL_FEATURE_VARIANT;
    uint localTileOffset = 0u;

    if (tileIndex < _MaterialTileCount)
    {
        variant = SelectMaterialFeatureVariant(_MaterialTileFeatureFlags[tileIndex]);

        if (variant < VIVID_MATERIAL_FEATURE_VARIANT_COUNT)
        {
            InterlockedAdd(gs_LocalVariantCounts[variant], 1u, localTileOffset);
        }
    }

    gs_LocalTileOffsets[groupIndex] = localTileOffset;
    gs_LocalTileVariants[groupIndex] = variant;
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < VIVID_MATERIAL_FEATURE_VARIANT_COUNT)
    {
        uint localTileCount = gs_LocalVariantCounts[groupIndex];

        if (localTileCount > 0u)
        {
            uint globalTileOffset = 0u;
            uint argsOffset = groupIndex * VIVID_INDIRECT_ARGS_ELEMENT_COUNT;
            InterlockedAdd(_MaterialFeatureIndirectArgs[argsOffset], localTileCount, globalTileOffset);
            gs_GlobalVariantOffsets[groupIndex] = globalTileOffset;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (tileIndex >= _MaterialTileCount || variant >= VIVID_MATERIAL_FEATURE_VARIANT_COUNT)
        return;

    uint tileY = tileIndex / _MaterialTileCountX;
    uint tileX = tileIndex - tileY * _MaterialTileCountX;
    uint packedTileCoord = TileClassifaction::PackTileCoord(uint2(tileX, tileY));
    uint globalTileOffset = gs_GlobalVariantOffsets[variant] + gs_LocalTileOffsets[groupIndex];
    _MaterialFeatureTileList[variant * _MaterialTileCount + globalTileOffset] = packedTileCoord;
}
