// VividRP Substrate Opaque Base Template (Phase S1)
// Referenced by *.slab.shader via:
//   // @vivid-base "Packages/com.vivid.render-pipelines/Shaders/Material/Templates/SubstrateOpaque.slab.template"
//
// Expands PreDepth, ShadowCaster, VividGBuffer (Substrate UAV u5 + TopLayer Summary),
// and VividGBufferGPUDrivenDecal while injecting MaterialGraph and custom surface hooks.
SubShader
{
    Tags
    {
        "RenderType" = "Opaque"
        "Queue" = "Geometry"
        "RenderPipeline" = "VividRenderPipeline"
    }

    Pass
    {
        Name "VividPreDepth"
        Tags { "LightMode" = "VividPreDepth" }

        Blend One Zero
        ZWrite On
        ZTest LEqual
        Cull Back
        ColorMask 0

        HLSLPROGRAM
        #pragma use_dxc
        #pragma multi_compile_instancing
        #pragma vertex VertSlabDepth
        #pragma fragment FragSlabDepth

        #include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Core.hlsl"

        struct Attributes
        {
            float3 positionOS : POSITION;
            UNITY_VERTEX_INPUT_INSTANCE_ID
        };

        struct Varyings
        {
            float4 positionCS : SV_POSITION;
        };

        Varyings VertSlabDepth(Attributes input)
        {
            Varyings o;
            UNITY_SETUP_INSTANCE_ID(input);
            o.positionCS = TransformObjectToHClip(input.positionOS);
            return o;
        }

        void FragSlabDepth(Varyings input)
        {
        }
        ENDHLSL
    }

    Pass
    {
        Name "ShadowCaster"
        Tags { "LightMode" = "ShadowCaster" "VividVSMCaster" = "2" "VividVSMConservativeBounds" = "1" }

        ZWrite On
        ZTest LEqual
        Cull Back
        ColorMask 0

        HLSLPROGRAM
        #pragma use_dxc
        #pragma multi_compile_instancing
        #pragma vertex VertSlabShadow
        #pragma fragment FragSlabShadow

        #include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Core.hlsl"

        struct Attributes
        {
            float3 positionOS : POSITION;
            UNITY_VERTEX_INPUT_INSTANCE_ID
        };

        struct Varyings
        {
            float4 positionCS : SV_POSITION;
        };

        Varyings VertSlabShadow(Attributes input)
        {
            Varyings o;
            UNITY_SETUP_INSTANCE_ID(input);
            o.positionCS = TransformObjectToHClip(input.positionOS);
            return o;
        }

        void FragSlabShadow(Varyings input)
        {
        }
        ENDHLSL
    }

    Pass
    {
        Name "VividGBuffer"
        Tags { "LightMode" = "VividGBuffer" }

        Blend One Zero
        ZWrite Off
        ZTest Equal
        Cull Back

        HLSLPROGRAM
        #pragma target 5.0
        #pragma require randomwrite
        #pragma use_dxc
        #pragma multi_compile_instancing
        #pragma vertex VertSlabGBuffer
        #pragma fragment FragSlabGBuffer

        #define VIVID_SLAB_TARGET_RASTER 1
        #include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/Core.hlsl"
        #define VIVIDRP_STANDARD_LIT_TO_OPENPBR_SUBSTRATE_ONLY 1
        #include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/VividStandardLitToOpenPBR.hlsl"
        #include "Packages/com.vivid.render-pipelines/Shaders/Core/Public/VividSlabSurfaceContract.hlsl"

        CBUFFER_START(UnityPerMaterial)
            VIVID_SLAB_GRAPH_CBUFFER
            VIVID_SLAB_USER_CBUFFER
        CBUFFER_END

        VIVID_SLAB_GRAPH_TEXTURES
        VIVID_SLAB_USER_TEXTURES

        uint _WriteSubstrateClosureBuffer;
        RWTexture2DArray<uint> _OutSubstrateClosureBuffer : register(u5);

        VIVID_SLAB_GRAPH_EVALUATE
        VIVID_SLAB_USER_SURFACE_HOOK

        struct Attributes
        {
            float3 positionOS : POSITION;
            float3 normalOS : NORMAL;
            float4 tangentOS : TANGENT;
            float2 uv0 : TEXCOORD0;
            UNITY_VERTEX_INPUT_INSTANCE_ID
        };

        struct Varyings
        {
            float4 positionCS : SV_POSITION;
            float3 positionWS : TEXCOORD0;
            float3 normalWS : TEXCOORD1;
            float4 tangentWS : TEXCOORD2;
            float2 uv0 : TEXCOORD3;
        };

        Varyings VertSlabGBuffer(Attributes input)
        {
            Varyings o;
            UNITY_SETUP_INSTANCE_ID(input);
            o.positionWS = TransformObjectToWorld(input.positionOS);
            o.positionCS = TransformWorldToHClip(o.positionWS);
            o.normalWS = TransformObjectToWorldNormal(input.normalOS);
            o.tangentWS = float4(
                TransformObjectToWorldDir(input.tangentOS.xyz),
                input.tangentOS.w * GetOddNegativeScale());
            o.uv0 = input.uv0;
            return o;
        }

        [earlydepthstencil]
        VividSurfaceSummaryGBufferOutput FragSlabGBuffer(Varyings input)
        {
            VividSlabEvalContext ctx;
            ctx.uv0 = input.uv0;
            ctx.uv0Ddx = ddx(input.uv0);
            ctx.uv0Ddy = ddy(input.uv0);
            ctx.geometryNormalWS = SafeNormalize(input.normalWS);
            ctx.geometryTangentWS = float4(
                SafeNormalize(input.tangentWS.xyz),
                input.tangentWS.w);
            ctx.positionWS = input.positionWS;
            ctx.positionCS = input.positionCS;
            ctx.parameterAddress = 0u;
            ctx.resourceAddress = 0u;

            VividOpenPBRV2Inputs v2Inputs;
            float ambientOcclusion = 1.0f;
            VividSlabEvaluateGraphSurface(ctx, v2Inputs, ambientOcclusion);
            #if defined(VIVID_SLAB_HAS_CUSTOM_POST_SURFACE)
                VividSlabPostEvaluateSurface(ctx, v2Inputs, ambientOcclusion);
            #endif

            uint2 pixelCoord = (uint2)input.positionCS.xy;
            if (_WriteSubstrateClosureBuffer != 0u)
            {
                uint headerFlags = VIVID_SUBSTRATE_FLAG_RECEIVE_DECALS;
                if (any(v2Inputs.core.emissionLuminance * v2Inputs.core.emissionColor > 0.0f))
                    headerFlags |= VIVID_SUBSTRATE_FLAG_HAS_EMISSION;
                VividWriteSubstrateOpenPBRV2Single(
                    _OutSubstrateClosureBuffer,
                    pixelCoord,
                    v2Inputs,
                    headerFlags);
            }

            VividSurfaceSummaryData summary = VividBuildStandardLitSubstrateTopLayerSummary(
                v2Inputs,
                ambientOcclusion,
                true,
                true);
            return VividPackSurfaceSummaryGBuffer(summary);
        }
        ENDHLSL
    }
}
