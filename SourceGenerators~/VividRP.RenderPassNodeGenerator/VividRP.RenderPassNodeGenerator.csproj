<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VividRP.RenderPassNodeGenerator</AssemblyName>
    <RootNamespace>VividRP.RenderPassNodeGenerator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"
                      Version="4.3.0"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <Target Name="DeployToUnity" DependsOnTargets="Build">
    <PropertyGroup>
      <UnityAnalyzerDirectory>$(MSBuildProjectDirectory)\..\..\Editor\SourceGenerators</UnityAnalyzerDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(UnityAnalyzerDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(UnityAnalyzerDirectory)\$(TargetFileName)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
