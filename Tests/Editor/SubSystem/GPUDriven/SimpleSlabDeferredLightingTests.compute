#pragma kernel PrepareInputs
#pragma kernel ReferenceLighting
#pragma use_dxc
#pragma target 5.0

// Include the new path FIRST: this must compile without the legacy header.
#include "../../../../Shaders/Core/Public/VividSimpleSlabDeferredLighting.hlsl"

RWTexture2D<float4> _TestGBuffer0;
RWTexture2D<float4> _TestGBuffer1;
RWTexture2D<float4> _TestGBuffer2;
RWTexture2D<float4> _TestGBuffer3;
RWTexture2D<float4> _TestGBuffer4;
RWTexture2D<float> _TestDepth;
RWStructuredBuffer<float4> _Expected;
float _TestSSRWeight;
float _TestExposure;
uint _TestLutReady;
uint _TestMixedTile;
uint _TestEnvironment;
uint _TestSSREnabled;

// The fixture's mip levels are constant-colored, so expected filtering and
// hierarchy arithmetic need not call production sky/probe sampling helpers.
float3 ReferenceEnvironment(float roughness, float3 direction)
{
    float mip = roughness * (1.7f - 0.7f * roughness);
    float3 sky = float3(0.2f, 0.4f, 0.6f);
    if (_TestEnvironment != 0u) sky = lerp(sky, float3(0.7f, 0.15f, 0.05f), mip);
    if (_TestEnvironment < 2u) return sky;
    float first = _TestEnvironment == 3u ? 0.75f : 0.25f;
    float second = _TestEnvironment == 3u ? 0.25f : 0.5f;
    if (_TestEnvironment == 4u) first = 0; // invalid first atlas entry
    if (_TestEnvironment == 5u)
    {
        // First probe only accepts its -X face. N and R have different coverage.
        float fade = saturate(-4.0f * normalize(direction).x - 1.0f);
        first *= fade * fade * (3.0f - 2.0f * fade);
    }
    float3 a = lerp(float3(0.8f, 0.2f, 0.1f), float3(0.1f, 0.6f, 0.3f), mip) * 1.4f;
    float3 b = lerp(float3(0.1f, 0.2f, 0.9f), float3(0.6f, 0.15f, 0.8f), mip) * 0.7f;
    return sky * (1.0f - first - second) + a * first + b * second;
}

float ReferenceRectangleIntegral(float3 center, float3 right, float3 up, float width, float height)
{
    // Independent midpoint area quadrature, including the LTC transform's
    // Jacobian. The test deliberately uses different GGX and Lambert shapes.
    float3 formFactor = 0;
    const uint count = 64u;
    for (uint y = 0; y < count; ++y)
    for (uint x = 0; x < count; ++x)
    {
        float3 offset = center + right * (width * ((x + 0.5f) / count - 0.5f))
            + up * (height * ((y + 0.5f) / count - 0.5f));
        float distanceSquared = dot(offset, offset);
        float3 light = normalize(offset);
        formFactor += light * abs(dot(cross(right, up), light)) / distanceSquared;
    }
    formFactor *= width * height / (count * count * PI);
    // Retain the existing LTC primitive's clipped-sphere horizon approximation;
    // test its independently integrated vector form factor, not an exact-quad claim.
    float magnitude = length(formFactor);
    return max(0, (magnitude * magnitude + formFactor.z) / (magnitude + 1));
}

float3 ReferenceArea(VividSimpleSlabData slab, VividSimpleSlabEnergy energy,
    float3 position, float3 view, float3 singleScatter, float3 multipleScatter)
{
    AreaLightData area = GetAreaLight(0);
    ApplyRectangularAreaLightBarnDoor(area, position);
    float intensity = EvaluateAreaLightIntensity(area, position);
    if (intensity <= 0) return 0;
    float3x3 basis = GetOrthoBasisViewNormal(view, slab.normalWS, dot(view, slab.normalWS));
    float3 center = mul(basis, area.positionWS - position);
    float3 right = mul(basis, area.rightWS);
    float3 up = mul(basis, area.upWS);
    // Matches the synthetic texture, not production's sampled matrix.
    float3x3 specularTransform = float3x3(2, 0, 0, 0, 1.3f, 0, 0, 0, 1);
    float diffuseIntegral;
    float specularIntegral;
    if (area.lightType == VIVID_AREA_LIGHT_TYPE_RECTANGLE)
    {
        diffuseIntegral = ReferenceRectangleIntegral(center, right, up, area.width, area.height);
        specularIntegral = ReferenceRectangleIntegral(mul(specularTransform, center),
            mul(specularTransform, right), mul(specularTransform, up), area.width, area.height);
    }
    else
    {
        // The existing tube primitive is retained; only its lobe weights change.
        diffuseIntegral = EvaluateLTC_Area(false, center, right, up, area.width * 0.5f,
            area.height * 0.5f, float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1)).a;
        specularIntegral = EvaluateLTC_Area(false, center, right, up, area.width * 0.5f,
            area.height * 0.5f, specularTransform).a;
    }
    return area.color * intensity * (specularIntegral * singleScatter
        + diffuseIntegral * (multipleScatter + slab.diffuseAlbedo * energy.diffuseTransmission));
}

VividSurfaceSummaryData TestSummary(uint column)
{
    VividSurfaceSummaryData summary;
    summary.diffuseAlbedo = float3(0.27f, 0.48f, 0.13f);
    summary.specularF0 = float3(0.19f, 0.05f, 0.35f);
    summary.perceptualRoughness = 0.42f;
    summary.normalWS = float3(0, 0, 1);
    summary.ambientOcclusion = column == 1u ? 0.0f : 1.0f;
    summary.emissive = float3(0.11f, 0.07f, 0.03f);
    summary.diffuseIrradiance = float3(0.3f, 0.2f, 0.1f);
    uint exportClass = column == 4u ? VIVID_DEFERRED_EXPORT_CLASS_UNLIT
        : (column == 5u && _TestMixedTile != 0u ? VIVID_DEFERRED_EXPORT_CLASS_ERROR : VIVID_DEFERRED_EXPORT_CLASS_FAST_SLAB);
    summary.deferredExportHeader = VividBuildDeferredExportHeader(exportClass,
        false, true, column != 1u && column != 6u, false);
    if (column == 2u)
    {
        summary.diffuseAlbedo = 0;
        summary.specularF0 = float3(0.95f, 0.64f, 0.54f);
        summary.perceptualRoughness = 0.85f;
    }
    if (column == 3u) summary.specularF0 = 0.01f;
    return summary;
}

[numthreads(8, 8, 1)]
void PrepareInputs(uint3 id : SV_DispatchThreadID)
{
    VividSurfaceSummaryGBufferOutput packed = VividPackSurfaceSummaryGBuffer(TestSummary(id.x));
    _TestGBuffer0[id.xy] = packed.rt0;
    _TestGBuffer1[id.xy] = packed.rt1;
    _TestGBuffer2[id.xy] = packed.rt2;
    _TestGBuffer3[id.xy] = packed.rt3;
    _TestGBuffer4[id.xy] = packed.rt4;
    _TestDepth[id.xy] = id.x == 7u ? UNITY_RAW_FAR_CLIP_VALUE : 0.5f;
}

[numthreads(8, 8, 1)]
void ReferenceLighting(uint3 id : SV_DispatchThreadID)
{
    VividSurfaceSummaryGBufferOutput packed = VividPackSurfaceSummaryGBuffer(TestSummary(id.x));
    VividSurfaceSummaryData summary = VividUnpackSurfaceSummaryGBuffer(
        packed.rt0, packed.rt1, packed.rt2, packed.rt3, packed.rt4);
    float3 expected;
    float3 sky = float3(0.2f, 0.4f, 0.6f);
    if (id.x == 7u) expected = sky;
    else if ((id.x == 5u && _TestMixedTile != 0u) || (_TestLutReady == 0u && id.x != 4u)) expected = float3(1, 0, 1);
    else if (id.x == 4u) expected = summary.emissive;
    else
    {
        VividSimpleSlabData slab;
        slab.diffuseAlbedo = summary.diffuseAlbedo;
        slab.specularF0 = summary.specularF0;
        slab.perceptualRoughness = summary.perceptualRoughness;
        slab.normalWS = summary.normalWS;
        float3 view = _TestEnvironment == 5u ? float3(0.8f, 0, 0.6f) : float3(0, 0, 1);
        float3 position = ComputeWorldSpacePosition((id.xy + 0.5f) / 8.0f, 0.5f, UNITY_MATRIX_I_VP);
        VividSimpleSlabEnergy energy = VividLoadSimpleSlabEnergy(slab, view);
        float4 lut = VividSampleSlabLut(dot(slab.normalWS, view), slab.perceptualRoughness);
        float2 directional = VividSlabNormalizeAlbedoBasis(lut.xy);
        float2 average = VividSlabNormalizeAlbedoBasis(lut.zw);
        float f90 = saturate(50.0f * dot(slab.specularF0, 1.0f / 3.0f));
        float3 averageFresnel = slab.specularF0 + (f90 - slab.specularF0) / 21.0f;
        float3 singleScatter = slab.specularF0 * (1 - directional.x - directional.y) + f90 * directional.x;
        float3 multipleScatter = averageFresnel * averageFresnel * (1 - average.y)
            / max(1 - averageFresnel * average.y, 1e-6f) * directional.y;
        float3 direct = 0;
        if (_DirectionalLightCount > 0u)
        {
            VividSimpleSlabDirectLighting light = VividEvaluateSimpleSlabDirectionalLight(
                slab, energy, view, GetDirectionalLight(0), 0.25f);
            direct += light.diffuse + light.specular;
            light = VividEvaluateSimpleSlabPunctualLight(slab, energy, position, view, GetPunctualLight(0));
            direct += light.diffuse + light.specular;

            direct += ReferenceArea(slab, energy, position, view, singleScatter, multipleScatter);
        }
        float ao = summary.ambientOcclusion * 0.5f; // material AO times GTAO, once
        float ssr = _TestSSREnabled != 0u && VividHasDeferredExportFlag(summary.deferredExportHeader,
            VIVID_DEFERRED_EXPORT_FLAG_RECEIVE_SSR) ? _TestSSRWeight : 0.0f;
        float3 reflection = GetSpecularDominantDir(slab.normalWS, reflect(-view, slab.normalWS),
            slab.perceptualRoughness, dot(slab.normalWS, view));
        expected = summary.emissive + direct
            + summary.diffuseIrradiance * slab.diffuseAlbedo * energy.diffuseTransmission * ao
            + ReferenceEnvironment(slab.perceptualRoughness, reflection) * singleScatter * ao * (1.0f - ssr)
            + ReferenceEnvironment(1.0f, slab.normalWS) * multipleScatter * ao
            + float3(0.8f, 0.1f, 0.3f) * singleScatter * ssr;
    }
    _Expected[id.y * 8u + id.x] = float4(expected * _TestExposure, 1);
}
