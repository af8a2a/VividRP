#pragma kernel SampleProbes
#pragma use_dxc
#pragma multi_compile _ PROBE_VOLUMES_L1 PROBE_VOLUMES_L2
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/AmbientProbe.hlsl"
#include "Packages/com.unity.render-pipelines.core/Runtime/Lighting/ProbeVolume/ProbeVolume.hlsl"

StructuredBuffer<float4> _ProbePositions;
StructuredBuffer<float4> _ProbeNormals;
RWStructuredBuffer<float4> _ProbeResults;
uint _ProbeCount;

[numthreads(1, 1, 1)]
void SampleProbes(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ProbeCount) return;
    APVSample sample = SampleAPV(_ProbePositions[id.x].xyz, _ProbeNormals[id.x].xyz,
        0xFFFFFFFFu, float3(0, 0, -1));
    float3 lighting = 0;
    EvaluateAdaptiveProbeVolume(sample, _ProbeNormals[id.x].xyz, lighting);
    _ProbeResults[id.x] = float4(lighting, sample.status);
}
