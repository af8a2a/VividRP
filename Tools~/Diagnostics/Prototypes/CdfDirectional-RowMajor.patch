@@ -89,0 +92,57 @@ float DirectionalOctRegionImportance(float importance[16], uint4 rect)
+#if defined(VIVID_SDF_CDF_PROPOSAL)
+float DirectionalCdfBoundary(float importance[16], float total, uint boundary)
+{
+    if (boundary == 0u) return 0.0;
+    if (boundary == DirectionalBinCount) return float(DirectionalGatherBinCount);
+    if (total <= 0.0) return 2.0 * float(boundary);
+
+    // Half uniform exploration, half radiance importance. Quantiles choose
+    // interval boundaries; samples remain uniform in baseline cosine measure.
+    float exploration = total / float(DirectionalGatherBinCount);
+    float target = 2.0 * total * float(boundary) / float(DirectionalBinCount);
+    float cdf = 0.0;
+    [loop]
+    for (uint cell = 0u; cell < DirectionalGatherBinCount; ++cell)
+    {
+        float mass = importance[cell] + exploration;
+        if (target <= cdf + mass)
+            return float(cell) + saturate((target - cdf) / mass);
+        cdf += mass;
+    }
+    return float(DirectionalGatherBinCount);
+}
+
+void StoreDirectionalCdfGuide(uint2 tile, float importance[16], float total, int source)
+{
+    float start = 0.0;
+    [loop]
+    for (uint ray = 0u; ray < DirectionalBinCount; ++ray)
+    {
+        float end = DirectionalCdfBoundary(importance, total, ray + 1u);
+        // Shared endpoints undergo identical RGBA16F quantization. No gap or
+        // overlap is introduced, and the telescoping mass sum remains eight.
+        _SdfDirectionalGuideOutput[DirectionalAddress(tile, ray)] = float4(start, end, source, DirectionalCdfStratum);
+        start = end;
+    }
+}
+#endif
+
+#if defined(VIVID_SDF_CDF_VALIDATION)
+StructuredBuffer<float4> _SdfCdfValidationInput;
+uint _SdfCdfValidationCount;
+[numthreads(8, 1, 1)]
+void InspectSdfDirectionalCdfGuideCS(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= _SdfCdfValidationCount) return;
+    float importance[16];
+    float total = 0.0;
+    [unroll]
+    for (uint cell = 0u; cell < DirectionalGatherBinCount; ++cell)
+    {
+        importance[cell] = _SdfCdfValidationInput[4u * id.x + cell / 4u][cell & 3u];
+        total += importance[cell];
+    }
+    StoreDirectionalCdfGuide(uint2(id.x, 0u), importance, total, DirectionalOctScreen);
+}
+#endif
+
