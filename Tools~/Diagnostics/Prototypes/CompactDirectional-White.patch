+#if defined(VIVID_SDF_COMPACT_PROPOSAL)
+float CompactDirectionalMedian(float importance[16], float exploration, float4 rect, uint axis)
+{
+    float masses[4];
+    float total = 0.0;
+    uint other = 1u - axis;
+    [unroll]
+    for (uint band = 0u; band < 4u; ++band)
+    {
+        float density = 0.0;
+        [unroll]
+        for (uint crossCell = 0u; crossCell < 4u; ++crossCell)
+        {
+            uint cell = axis == 0u ? band + 4u * crossCell : crossCell + 4u * band;
+            float overlap = max(0.0, min(rect[other + 2u], float(crossCell + 1u)) - max(rect[other], float(crossCell)));
+            density += (importance[cell] + exploration) * overlap;
+        }
+        float width = max(0.0, min(rect[axis + 2u], float(band + 1u)) - max(rect[axis], float(band)));
+        masses[band] = width * density;
+        total += masses[band];
+    }
+    float target = 0.5 * total;
+    float prefix = 0.0;
+    float cut = 0.5 * (rect[axis] + rect[axis + 2u]);
+    [unroll]
+    for (uint band = 0u; band < 4u; ++band)
+    {
+        if (masses[band] > 0.0 && target <= prefix + masses[band])
+        {
+            float lower = max(rect[axis], float(band));
+            float upper = min(rect[axis + 2u], float(band + 1u));
+            cut = lerp(lower, upper, saturate((target - prefix) / masses[band]));
+            break;
+        }
+        prefix += masses[band];
+    }
+    // Shared endpoints and area weights remain exactly representable in the
+    // half guide/ray metadata. Keep both children nonempty after quantization.
+    return clamp(round(cut * 16.0) / 16.0, rect[axis] + 0.0625, rect[axis + 2u] - 0.0625);
+}
+
+void StoreCompactDirectionalGuide(uint2 tile, float importance[16], float total)
+{
+    float4 rects[8];
+    rects[0] = float4(0.0, 0.0, 4.0, 4.0);
+    float exploration = total > 0.0 ? total / 16.0 : 1.0;
+    [loop]
+    for (uint level = 0u; level < 3u; ++level)
+    {
+        // Traverse backwards so in-place child writes cannot replace a parent
+        // that has not yet been split at this level.
+        [loop]
+        for (int parent = int(1u << level) - 1; parent >= 0; --parent)
+        {
+            float4 rect = rects[parent];
+            float2 extent = rect.zw - rect.xy;
+            uint axis = extent.x >= extent.y ? 0u : 1u;
+            float cut = CompactDirectionalMedian(importance, exploration, rect, axis);
+            float4 a = rect, b = rect;
+            a[axis + 2u] = cut;
+            b[axis] = cut;
+            rects[2 * parent] = a;
+            rects[2 * parent + 1] = b;
+        }
+    }
+    [unroll]
+    for (uint ray = 0u; ray < DirectionalBinCount; ++ray)
+    {
+        float4 rect = rects[ray];
+        _SdfDirectionalGuideOutput[DirectionalAddress(tile, ray)] = float4(rect.xyz, -8.0 - rect.w);
+    }
+}
+#endif
+
+#if defined(VIVID_SDF_COMPACT_VALIDATION)
+StructuredBuffer<float4> _SdfCompactValidationInput;
+uint _SdfCompactValidationCount;
+[numthreads(8, 1, 1)]
+void InspectSdfDirectionalCompactGuideCS(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= _SdfCompactValidationCount) return;
+    float importance[16];
+    float total = 0.0;
+    [unroll]
+    for (uint cell = 0u; cell < DirectionalGatherBinCount; ++cell)
+    {
+        importance[cell] = _SdfCompactValidationInput[4u * id.x + cell / 4u][cell & 3u];
+        total += importance[cell];
+    }
+    StoreCompactDirectionalGuide(uint2(id.x, 0u), importance, total);
+}
+#endif
