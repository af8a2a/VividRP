+#if defined(VIVID_SDF_FINE_IMPORTANCE)
+RWStructuredBuffer<float4> _SdfFineProposalValidation;
+uint _SdfFineValidationProbeCount;
+uint _SdfFineValidationOffset;
+
+[numthreads(4, 1, 1)]
+void InspectSdfFineDirectionalProposalsCS(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= 4u)
+        return;
+    float2 prefix[64];
+    float total = 0.0, peak = 0.0;
+    [loop]
+    for (uint i = 0u; i < 64u; ++i)
+    {
+        uint2 cell = uint2(i & 7u, i >> 3u);
+        float value = 1.0;
+        if (id.x == 1u && all(cell == uint2(5u, 2u))) value += 255.0;
+        if (id.x == 2u && cell.x == 2u) value += 100.0;
+        if (id.x == 3u && all(cell == uint2(1u, 5u))) value += 800.0;
+        if (id.x == 3u && all(cell == uint2(6u, 1u))) value += 200.0;
+        prefix[i] = float2(value, 0.0); total += value; peak = max(peak, value);
+    }
+    uint4 rects[8];
+    bool valid = BuildFineDirectionalPartition(prefix, total, peak, rects);
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+        _SdfFineProposalValidation[id.x * 8u + ray] = valid ? PackFineDirectionalRect(rects[ray], DirectionalFineOctScreen) : -100.0;
+}
+
+[numthreads(8, 1, 1)]
+void InspectSdfFineDirectionalSamplesCS(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= _SdfFineValidationProbeCount)
+        return;
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+    {
+        uint bin; float inversePdf;
+        float3 direction = SampleDiffuseProbeRay(uint2(id.x, 0u), ray, ProbeSeed(uint2(id.x, 0u)),
+            float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1), bin, inversePdf);
+        _SdfFineProposalValidation[_SdfFineValidationOffset + id.x * 8u + ray] = float4(direction, inversePdf);
+    }
+}
+#endif
