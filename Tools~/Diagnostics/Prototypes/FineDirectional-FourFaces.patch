+float2 FineDirectionalUV(float3 local)
+{
+    float radius = length(local.xy);
+    if (radius < 1e-5)
+        return 0.5;
+    bool horizontal = abs(local.x) > abs(local.y);
+    float dominant = horizontal ? local.x : local.y;
+    float secondary = horizontal ? local.y : local.x;
+    float signDominant = dominant >= 0.0 ? 1.0 : -1.0;
+    float a = radius * signDominant;
+    float b = a * atan2(secondary * signDominant, abs(dominant)) * (8.0 / TWO_PI);
+    return saturate(0.5 + 0.5 * (horizontal ? float2(a, b) : float2(b, a)));
+}
+
+float2 FineRectMoments(float2 prefix[64], uint4 rect)
+{
+    uint2 end = rect.xy + rect.zw - 1u;
+    float2 sum = prefix[end.y * 8u + end.x];
+    if (rect.x > 0u)
+        sum -= prefix[end.y * 8u + rect.x - 1u];
+    if (rect.y > 0u)
+        sum -= prefix[(rect.y - 1u) * 8u + end.x];
+    if (rect.x > 0u && rect.y > 0u)
+        sum += prefix[(rect.y - 1u) * 8u + rect.x - 1u];
+    return max(sum, 0.0);
+}
+
+float FineRectVariance(float2 moments, float area, float explorationVariance)
+{
+    return max(0.0, area * moments.y - moments.x * moments.x) + explorationVariance * area * area;
+}
+
+bool BuildFineDirectionalPartition(inout float2 prefix[64], float total, float peak, out uint4 rects[8])
+{
+    // Normalize HDR priorities before squared moments, independently of the
+    // actual radiance returned by tracing. This is only a proposal density.
+    if (peak <= 0.0 || !isfinite(peak))
+        return false;
+    float inversePeak = rcp(peak);
+    float mean = total * inversePeak / 64.0;
+    [loop]
+    for (uint y = 0u; y < 8u; ++y)
+    {
+        float2 row = 0.0;
+        [loop]
+        for (uint x = 0u; x < 8u; ++x)
+        {
+            uint i = y * 8u + x;
+            float value = prefix[i].x * inversePeak;
+            row += float2(value, value * value);
+            prefix[i] = row;
+            if (y > 0u)
+                prefix[i] += prefix[i - 8u];
+        }
+    }
+    float explorationVariance = 0.25 * mean * mean;
+    // Preserve a ray on each upper octahedron face. An unconstrained root can
+    // leave most of the hemisphere in one large, high-weight noisy stratum.
+    [unroll]
+    for (uint face = 0u; face < 4u; ++face)
+        rects[face] = uint4(4u * (face & 1u), 4u * (face >> 1u), 4u, 4u);
+    [loop]
+    for (uint leafCount = 4u; leafCount < 8u; ++leafCount)
+    {
+        float bestGain = -1.0;
+        uint bestLeaf = 8u;
+        uint4 bestA = 0u, bestB = 0u;
+        [loop]
+        for (uint leaf = 0u; leaf < leafCount; ++leaf)
+        {
+            uint4 parent = rects[leaf];
+            float2 moments = FineRectMoments(prefix, parent);
+            float variance = FineRectVariance(moments, float(parent.z * parent.w), explorationVariance);
+            [unroll]
+            for (uint axis = 0u; axis < 2u; ++axis)
+            {
+                uint extent = axis == 0u ? parent.z : parent.w;
+                [loop]
+                for (uint cut = 1u; cut < extent; ++cut)
+                {
+                    uint4 a = parent, b = parent;
+                    if (axis == 0u) { a.z = cut; b.x += cut; b.z -= cut; }
+                    else { a.w = cut; b.y += cut; b.w -= cut; }
+                    float2 left = FineRectMoments(prefix, a);
+                    float2 right = max(0.0, moments - left);
+                    float gain = variance - FineRectVariance(left, float(a.z * a.w), explorationVariance)
+                        - FineRectVariance(right, float(b.z * b.w), explorationVariance);
+                    if (gain > bestGain)
+                    {
+                        bestGain = gain; bestLeaf = leaf; bestA = a; bestB = b;
+                    }
+                }
+            }
+        }
+        if (bestLeaf == 8u)
+            return false;
+        rects[bestLeaf] = bestA;
+        rects[leafCount] = bestB;
+    }
+    return true;
+}
+
+float4 PackFineDirectionalRect(uint4 rect, int source)
+{
+    return float4(rect.x | (rect.y << 3u), (rect.z - 1u) | ((rect.w - 1u) << 3u), 0.0, source);
+}
