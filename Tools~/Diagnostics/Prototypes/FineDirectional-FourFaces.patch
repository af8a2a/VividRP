+bool BuildFineDirectionalGuide(uint2 tile, float3 position, float3 normal, float3x3 basis,
+    bool hasPrevious, uint2 previousTile, float3x3 previousBasis)
+{
+    int3 worldCell = 0;
+    if (!hasPrevious && !FindDirectionalWorldProbe(position, normal, worldCell))
+        return false;
+    float3 offset = FarProbePosition(worldCell) - position;
+    // A cached ray endpoint supplies sub-bin location evidence. Filtered 4x4
+    // radiance alone cannot locate a small bright source inside a coarse cell.
+    float4 cues[16];
+    [loop]
+    for (uint bin = 0u; bin < 16u; ++bin)
+    {
+        cues[bin] = 0.0;
+        if (!hasPrevious || _SdfDirectionalHasTraceHistory == 0u)
+            continue;
+        uint2 address = DirectionalGatherAddress(previousTile, bin);
+        float4 radiance = _SdfDirectionalTraceHistory.Load(int3(address, 0));
+        float4 hit = _SdfDirectionalTraceHistory.Load(int3(address + DirectionalMetadataOffset(DirectionalGrid()), 0));
+        if (radiance.a <= 0.0 || hit.x == 0.0 || hit.y == 0.0)
+            continue;
+        float3 direction = VividDecodeSurfaceSummaryNormal(hit.zw);
+        if (hit.x > 0.0)
+        {
+            float3 oldPosition = _SdfDiffusePreviousGeometry.Load(int3(previousTile, 0)).xyz;
+            direction = SafeNormalize(oldPosition + direction * hit.x - position);
+        }
+        float3 local = mul(basis, direction);
+        if (local.z <= 0.001)
+            continue;
+        float importance = max(0.0, dot(radiance.rgb * _SdfHistoryLightScale.rgb,
+            float3(0.2126, 0.7152, 0.0722)) * radiance.a);
+        // Half a fine cell standard deviation; each old cone has 1/16 cosine mass.
+        const float sigma = 0.5 / 8.0;
+        cues[bin] = float4(FineDirectionalUV(local), importance / (16.0 * TWO_PI * sigma * sigma), 0.5 / (sigma * sigma));
+    }
+    float2 prefix[64];
+    float total = 0.0, peak = 0.0;
+    float coarseTotal = 0.0, coarsePeak = 0.0;
+    [loop]
+    for (uint i = 0u; i < 64u; ++i)
+    {
+        float2 uv = (float2(i & 7u, i >> 3u) + 0.5) / 8.0;
+        float3 direction = DirectionalOctDirection(uv, basis);
+        float coarse;
+        if (hasPrevious)
+        {
+            float4 previous = _SdfDirectionalPrevious.Load(int3(
+                DirectionalGatherAddress(previousTile, DirectionalGatherBin(direction, previousBasis)), 0));
+            coarse = max(0.0, dot(previous.rgb * _SdfHistoryLightScale.rgb,
+                float3(0.2126, 0.7152, 0.0722)) * previous.a);
+        }
+        else
+            coarse = DirectionalWorldImportance(worldCell, offset, direction);
+        coarseTotal += coarse;
+        coarsePeak = max(coarsePeak, coarse);
+        float cueDensity = 0.0;
+        [loop]
+        for (uint cue = 0u; cue < 16u; ++cue)
+        {
+            float2 delta = uv - cues[cue].xy;
+            cueDensity += cues[cue].z * exp2(-1.442695 * dot(delta, delta) * cues[cue].w);
+        }
+        float importance = 0.5 * (coarse + cueDensity);
+        prefix[i] = float2(importance, 0.0);
+        total += importance;
+        peak = max(peak, importance);
+    }
+    // Sparse endpoints can form a sharp KDE peak even under broad lighting.
+    // Only refine when the filtered radiance itself justifies adaptive strata.
+    if (coarsePeak <= 3.0 * coarseTotal / 64.0 || peak <= 3.0 * total / 64.0)
+        return false;
+    uint4 rects[8];
+    if (!BuildFineDirectionalPartition(prefix, total, peak, rects))
+        return false;
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+        _SdfDirectionalGuideOutput[DirectionalAddress(tile, ray)] = PackFineDirectionalRect(rects[ray],
+            hasPrevious ? DirectionalFineOctScreen : DirectionalFineOctWorld);
+    return true;
+}
+#endif
