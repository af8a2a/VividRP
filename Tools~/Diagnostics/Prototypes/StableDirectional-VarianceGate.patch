+
+#if defined(VIVID_SDF_STABLE_PROPOSAL)
+StructuredBuffer<float4> _SdfStableValidationInput; // Four importance vectors, eight candidate descriptors per case.
+RWStructuredBuffer<float4> _SdfStableValidationResult;
+uint _SdfStableValidationCount;
+
+[numthreads(8, 1, 1)]
+void InspectSdfStableDirectionalGuideCS(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= _SdfStableValidationCount)
+        return;
+    float importance[16];
+    uint4 candidate[8];
+    [unroll]
+    for (uint i = 0u; i < 16u; ++i)
+        importance[i] = _SdfStableValidationInput[id.x * 12u + i / 4u][i & 3u];
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+        candidate[ray] = UnpackDirectionalOctRect(uint(_SdfStableValidationInput[id.x * 12u + 4u + ray].x));
+    float2 costs;
+    bool retained = TryRetainDirectionalPartition(uint2(id.x, 0u), importance, candidate, costs);
+    if (!retained)
+    {
+        [unroll]
+        for (uint ray = 0u; ray < 8u; ++ray)
+            _SdfDirectionalGuideOutput[DirectionalAddress(uint2(id.x, 0u), ray)] = _SdfStableValidationInput[id.x * 12u + 4u + ray];
+    }
+    _SdfStableValidationResult[id.x] = float4(costs, retained ? 1.0 : 0.0, 1.0);
+}
+#endif
