+#if defined(VIVID_SDF_STABLE_PROPOSAL)
+float DirectionalPartitionVariance(float importance[16], uint4 rects[8])
+{
+    float peak = 0.0;
+    [unroll]
+    for (uint i = 0u; i < 16u; ++i)
+        peak = max(peak, importance[i]);
+    float inversePeak = rcp(max(peak, 1e-10));
+    float variance = 0.0;
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+    {
+        uint4 rect = rects[ray];
+        float sum = 0.0, squares = 0.0;
+        [unroll]
+        for (uint y = 0u; y < 2u; ++y)
+        {
+            [unroll]
+            for (uint x = 0u; x < 2u; ++x)
+            {
+                if (x < rect.z && y < rect.w)
+                {
+                    float value = importance[(rect.y + y) * 4u + rect.x + x] * inversePeak;
+                    sum += value; squares += value * value;
+                }
+            }
+        }
+        // The common 1/16^2 factor cancels when comparing partitions.
+        variance += max(0.0, float(rect.z * rect.w) * squares - sum * sum);
+    }
+    return variance;
+}
+
+bool TryRetainDirectionalPartition(uint2 tile, float importance[16], uint4 candidate[8], out float2 costs)
+{
+    costs = 0.0;
+    if (_SdfDirectionalHasProposalHistory == 0u)
+        return false;
+    uint4 previous[8];
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+    {
+        float4 descriptor = _SdfDirectionalProposalHistory.Load(int3(DirectionalAddress(tile, ray), 0));
+        if ((descriptor.w != DirectionalOctScreen && descriptor.w != DirectionalOctWorld)
+            || descriptor.x < 0.0 || descriptor.x > 63.0)
+            return false;
+        previous[ray] = UnpackDirectionalOctRect(uint(descriptor.x));
+        if (any(previous[ray].xy + previous[ray].zw > 4u))
+            return false;
+    }
+    costs = float2(DirectionalPartitionVariance(importance, previous), DirectionalPartitionVariance(importance, candidate));
+    // Editor experiment: change topology only for a predicted reduction >20%.
+    // Every retained stratum still traces the current scene with its exact PDF.
+    if (costs.y < 0.8 * costs.x)
+        return false;
+    [unroll]
+    for (uint ray = 0u; ray < 8u; ++ray)
+    {
+        uint2 address = DirectionalAddress(tile, ray);
+        _SdfDirectionalGuideOutput[address] = _SdfDirectionalProposalHistory.Load(int3(address, 0));
+    }
+    return true;
+}
+#endif
